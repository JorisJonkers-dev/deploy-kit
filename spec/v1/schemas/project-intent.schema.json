{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Project",
  "$defs": {
    "Project": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "intent.jorisjonkers.dev/v1"
        },
        "kind": {
          "type": "string",
          "const": "Project"
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "secrets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/KvGrant"
              },
              {
                "$ref": "#/$defs/DatabaseGrant"
              },
              {
                "$ref": "#/$defs/TransitGrant"
              }
            ]
          }
        },
        "dependsOn": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/DependencyEdge"
          }
        },
        "assets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Asset"
          }
        },
        "writablePaths": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "startupBudget": {
          "type": "string",
          "minLength": 1
        },
        "cutover": {
          "$ref": "#/$defs/Cutover"
        },
        "applications": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Application"
          }
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "schemaVersion",
        "project",
        "owner",
        "applications"
      ],
      "additionalProperties": false
    },
    "KvGrant": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "minItems": 1,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/GeneratedKey"
              }
            ]
          }
        },
        "access": {
          "$ref": "#/$defs/AccessTier"
        },
        "delivery": {
          "$ref": "#/$defs/Delivery"
        },
        "mountAt": {
          "type": "string",
          "minLength": 1
        },
        "fileMode": {
          "type": "string",
          "minLength": 1
        },
        "rotation": {
          "$ref": "#/$defs/Rotation"
        }
      },
      "required": [
        "path",
        "keys",
        "access",
        "delivery",
        "rotation"
      ],
      "additionalProperties": false
    },
    "GeneratedKey": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "generate": {
          "$ref": "#/$defs/Generate"
        }
      },
      "required": [
        "name",
        "generate"
      ],
      "additionalProperties": false
    },
    "Generate": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 16,
          "maximum": 512
        },
        "encoding": {
          "$ref": "#/$defs/KeyEncoding"
        },
        "adopt": {
          "type": "string",
          "pattern": "^secret\\/data(\\/[A-Za-z0-9_-][A-Za-z0-9._-]*)+#[A-Za-z0-9._-]+$"
        }
      },
      "additionalProperties": false
    },
    "KeyEncoding": {
      "type": "string",
      "enum": [
        "hex",
        "base64",
        "base64url"
      ]
    },
    "AccessTier": {
      "type": "string",
      "enum": [
        "read",
        "self-renew",
        "self-roll",
        "custody"
      ]
    },
    "Delivery": {
      "type": "string",
      "enum": [
        "env",
        "file",
        "self"
      ]
    },
    "Rotation": {
      "type": "object",
      "properties": {
        "tolerates": {
          "$ref": "#/$defs/Tolerance"
        },
        "maxAge": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tolerates"
      ],
      "additionalProperties": false
    },
    "Tolerance": {
      "type": "string",
      "enum": [
        "restart",
        "reload"
      ]
    },
    "DatabaseGrant": {
      "type": "object",
      "properties": {
        "engine": {
          "$ref": "#/$defs/DatabaseEngine"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "delivery": {
          "$ref": "#/$defs/Delivery"
        },
        "mountAt": {
          "type": "string",
          "minLength": 1
        },
        "fileMode": {
          "type": "string",
          "minLength": 1
        },
        "rotation": {
          "$ref": "#/$defs/Rotation"
        }
      },
      "required": [
        "engine",
        "role",
        "delivery",
        "rotation"
      ],
      "additionalProperties": false
    },
    "DatabaseEngine": {
      "type": "string",
      "enum": [
        "database"
      ]
    },
    "TransitGrant": {
      "type": "object",
      "properties": {
        "engine": {
          "$ref": "#/$defs/TransitEngine"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/TransitOp"
          }
        },
        "delivery": {
          "$ref": "#/$defs/Delivery"
        },
        "mountAt": {
          "type": "string",
          "minLength": 1
        },
        "fileMode": {
          "type": "string",
          "minLength": 1
        },
        "rotation": {
          "$ref": "#/$defs/Rotation"
        }
      },
      "required": [
        "engine",
        "key",
        "operations",
        "delivery",
        "rotation"
      ],
      "additionalProperties": false
    },
    "TransitEngine": {
      "type": "string",
      "enum": [
        "transit"
      ]
    },
    "TransitOp": {
      "type": "string",
      "enum": [
        "sign",
        "verify",
        "encrypt",
        "decrypt",
        "rotate",
        "read"
      ]
    },
    "DependencyEdge": {
      "type": "object",
      "properties": {
        "application": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "credentials": {
          "$ref": "#/$defs/Credentials"
        }
      },
      "required": [
        "application",
        "surface"
      ],
      "additionalProperties": false
    },
    "Credentials": {
      "type": "object",
      "properties": {
        "delivery": {
          "$ref": "#/$defs/Delivery"
        },
        "mountAt": {
          "type": "string",
          "minLength": 1
        },
        "fileMode": {
          "type": "string",
          "minLength": 1
        },
        "rotation": {
          "$ref": "#/$defs/Rotation"
        }
      },
      "required": [
        "rotation"
      ],
      "additionalProperties": false
    },
    "Asset": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "mountAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "from",
        "mountAt"
      ],
      "additionalProperties": false
    },
    "Placement": {
      "type": "object",
      "properties": {
        "memory": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Arch"
          }
        },
        "site": {
          "type": "string",
          "minLength": 1
        },
        "disk": {
          "$ref": "#/$defs/DiskRequest"
        },
        "gpu": {
          "$ref": "#/$defs/GpuRequest"
        },
        "capabilities": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "Arch": {
      "type": "string",
      "enum": [
        "amd64",
        "arm64"
      ]
    },
    "DiskRequest": {
      "type": "object",
      "properties": {
        "media": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Media"
          }
        }
      },
      "required": [
        "media"
      ],
      "additionalProperties": false
    },
    "Media": {
      "type": "string",
      "enum": [
        "nvme",
        "ssd",
        "hdd"
      ]
    },
    "GpuRequest": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "model": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "Cutover": {
      "type": "string",
      "enum": [
        "continuous",
        "interrupted"
      ]
    },
    "Application": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "observability": {
          "$ref": "#/$defs/Observability"
        },
        "exposure": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Exposure"
          }
        },
        "migration": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelfMigration"
            },
            {
              "$ref": "#/$defs/NoMigration"
            },
            {
              "$ref": "#/$defs/ManagedMigration"
            }
          ]
        },
        "client": {
          "$ref": "#/$defs/Client"
        },
        "secrets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/KvGrant"
              },
              {
                "$ref": "#/$defs/DatabaseGrant"
              },
              {
                "$ref": "#/$defs/TransitGrant"
              }
            ]
          }
        },
        "dependsOn": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/DependencyEdge"
          }
        },
        "assets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Asset"
          }
        },
        "writablePaths": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "startupBudget": {
          "type": "string",
          "minLength": 1
        },
        "cutover": {
          "$ref": "#/$defs/Cutover"
        },
        "processes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Process"
          }
        }
      },
      "required": [
        "id",
        "processes"
      ],
      "additionalProperties": false
    },
    "Observability": {
      "type": "object",
      "properties": {
        "alertClass": {
          "$ref": "#/$defs/AlertClass"
        },
        "scrape": {
          "$ref": "#/$defs/Scrape"
        }
      },
      "required": [
        "alertClass"
      ],
      "additionalProperties": false
    },
    "AlertClass": {
      "type": "string",
      "enum": [
        "business-hours",
        "urgent",
        "page"
      ]
    },
    "Scrape": {
      "type": "object",
      "properties": {
        "process": {
          "type": "string",
          "minLength": 1,
          "reference": "Process"
        },
        "surface": {
          "type": "string",
          "minLength": 1,
          "reference": "Surface"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "process",
        "surface",
        "path"
      ],
      "additionalProperties": false
    },
    "Exposure": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "pattern": "^(?!.*\\.(svc|local|internal|localhost)$)(?!.*\\.svc\\.)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "audience": {
          "$ref": "#/$defs/Audience"
        },
        "contentPolicy": {
          "$ref": "#/$defs/ContentPolicy"
        },
        "routes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Route"
          }
        }
      },
      "required": [
        "name",
        "host",
        "audience",
        "routes"
      ],
      "additionalProperties": false
    },
    "Audience": {
      "type": "string",
      "enum": [
        "anonymous",
        "authenticated",
        "internal",
        "lan"
      ]
    },
    "ContentPolicy": {
      "type": "string",
      "enum": [
        "strict",
        "admin",
        "workflow"
      ]
    },
    "Route": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\/$|^(\\/[A-Za-z0-9._~!$&'()*+,;=:@%-]+)+\\/?$"
        },
        "match": {
          "$ref": "#/$defs/Match"
        },
        "process": {
          "type": "string",
          "minLength": 1,
          "reference": "Process"
        },
        "surface": {
          "type": "string",
          "minLength": 1,
          "reference": "Surface"
        },
        "audience": {
          "$ref": "#/$defs/Audience"
        },
        "redirectTo": {
          "type": "string",
          "minLength": 1
        },
        "rateLimit": {
          "$ref": "#/$defs/RateLimit"
        }
      },
      "required": [
        "path",
        "match",
        "process",
        "surface"
      ],
      "additionalProperties": false
    },
    "Match": {
      "type": "string",
      "enum": [
        "prefix",
        "exact"
      ]
    },
    "RateLimit": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "per": {
          "type": "string",
          "pattern": "^[1-9]\\d*(s|m|h)$"
        }
      },
      "required": [
        "requests",
        "per"
      ],
      "additionalProperties": false
    },
    "SelfMigration": {
      "type": "string",
      "const": "self"
    },
    "NoMigration": {
      "type": "string",
      "const": "none"
    },
    "ManagedMigration": {
      "type": "object",
      "properties": {
        "changelog": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "changelog"
      ],
      "additionalProperties": false
    },
    "Client": {
      "type": "object",
      "properties": {
        "signIn": {
          "$ref": "#/$defs/SignInMode"
        },
        "exposure": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "iconPath": {
          "type": "string",
          "pattern": "^\\/$|^(\\/[A-Za-z0-9._~!$&'()*+,;=:@%-]+)+\\/?$"
        },
        "launchPath": {
          "type": "string",
          "pattern": "^\\/$|^(\\/[A-Za-z0-9._~!$&'()*+,;=:@%-]+)+\\/?$"
        },
        "redirectPaths": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\/$|^(\\/[A-Za-z0-9._~!$&'()*+,;=:@%-]+)+\\/?$"
          }
        },
        "protectedPath": {
          "type": "string",
          "pattern": "^\\/$|^(\\/[A-Za-z0-9._~!$&'()*+,;=:@%-]+)+\\/?$"
        },
        "credential": {
          "$ref": "#/$defs/ClientCredential"
        },
        "roles": {
          "minItems": 1,
          "maxItems": 63,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          }
        }
      },
      "required": [
        "signIn"
      ],
      "additionalProperties": false
    },
    "SignInMode": {
      "type": "string",
      "enum": [
        "native",
        "gated",
        "token"
      ]
    },
    "ClientCredential": {
      "type": "string",
      "enum": [
        "secret",
        "pkce"
      ]
    },
    "Process": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "$ref": "#/$defs/Lifecycle"
        },
        "schedule": {
          "type": "string",
          "pattern": "^[0-9A-Za-z*/,?-]+( [0-9A-Za-z*/,?-]+){4}$"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "$ref": "#/$defs/Runtime"
        },
        "engine": {
          "$ref": "#/$defs/Engine"
        },
        "provides": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "entry": "Surface"
        },
        "sidecars": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sidecar"
          }
        },
        "probes": {
          "anyOf": [
            {
              "$ref": "#/$defs/NoProbes"
            },
            {
              "$ref": "#/$defs/Probes"
            }
          ]
        },
        "volumes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Volume"
          }
        },
        "libraries": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/LibraryMount"
          }
        },
        "replicas": {
          "$ref": "#/$defs/Capacity"
        },
        "api": {
          "$ref": "#/$defs/ApiAccess"
        },
        "egress": {
          "$ref": "#/$defs/Egress"
        },
        "vpn": {
          "$ref": "#/$defs/VpnAttachment"
        },
        "secrets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/KvGrant"
              },
              {
                "$ref": "#/$defs/DatabaseGrant"
              },
              {
                "$ref": "#/$defs/TransitGrant"
              }
            ]
          }
        },
        "dependsOn": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/DependencyEdge"
          }
        },
        "assets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Asset"
          }
        },
        "writablePaths": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "startupBudget": {
          "type": "string",
          "minLength": 1
        },
        "cutover": {
          "$ref": "#/$defs/Cutover"
        }
      },
      "required": [
        "name",
        "lifecycle",
        "image",
        "runtime"
      ],
      "additionalProperties": false
    },
    "Lifecycle": {
      "type": "string",
      "enum": [
        "application",
        "job",
        "prepare",
        "scheduled"
      ]
    },
    "Runtime": {
      "type": "string",
      "enum": [
        "jvm",
        "python",
        "node",
        "static",
        "none"
      ]
    },
    "Engine": {
      "type": "string",
      "enum": [
        "postgres",
        "rabbitmq",
        "valkey",
        "mongo",
        "files"
      ]
    },
    "Sidecar": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "image",
        "memory",
        "cpu"
      ],
      "additionalProperties": false
    },
    "NoProbes": {
      "type": "string",
      "const": "none"
    },
    "Probes": {
      "type": "object",
      "properties": {
        "readiness": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpProbe"
            },
            {
              "$ref": "#/$defs/TcpProbe"
            }
          ]
        },
        "liveness": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpProbe"
            },
            {
              "$ref": "#/$defs/TcpProbe"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "HttpProbe": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\/$|^(\\/[A-Za-z0-9._~!$&'()*+,;=:@%-]+)+\\/?$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "path",
        "port"
      ],
      "additionalProperties": false
    },
    "TcpProbe": {
      "type": "object",
      "properties": {
        "tcp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "tcp"
      ],
      "additionalProperties": false
    },
    "Volume": {
      "type": "object",
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "mountAt": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "durability": {
          "$ref": "#/$defs/DurabilityClass"
        }
      },
      "required": [
        "claim",
        "mountAt",
        "size",
        "durability"
      ],
      "additionalProperties": false
    },
    "DurabilityClass": {
      "type": "string",
      "enum": [
        "reconstructible",
        "recoverable",
        "irreplaceable"
      ]
    },
    "LibraryMount": {
      "type": "object",
      "properties": {
        "library": {
          "type": "string",
          "minLength": 1
        },
        "mountAt": {
          "type": "string",
          "minLength": 1
        },
        "subPath": {
          "type": "string",
          "pattern": "^(?!\\.\\.?(?:\\/|$))[^/]+(\\/(?!\\.\\.?(?:\\/|$))[^/]+)*$"
        },
        "access": {
          "$ref": "#/$defs/LibraryAccess"
        }
      },
      "required": [
        "library",
        "mountAt",
        "access"
      ],
      "additionalProperties": false
    },
    "LibraryAccess": {
      "type": "string",
      "enum": [
        "read",
        "write"
      ]
    },
    "Capacity": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "across": {
          "$ref": "#/$defs/Spread"
        }
      },
      "required": [
        "count",
        "reason"
      ],
      "additionalProperties": false
    },
    "Spread": {
      "type": "string",
      "enum": [
        "node"
      ]
    },
    "ApiAccess": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApiRule"
          }
        }
      },
      "required": [
        "reason",
        "rules"
      ],
      "additionalProperties": false
    },
    "ApiRule": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "objects": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verbs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApiVerb"
          }
        }
      },
      "required": [
        "group",
        "objects",
        "verbs"
      ],
      "additionalProperties": false
    },
    "ApiVerb": {
      "type": "string",
      "enum": [
        "get",
        "list",
        "watch",
        "create",
        "update",
        "patch",
        "delete"
      ]
    },
    "Egress": {
      "type": "object",
      "properties": {
        "to": {
          "$ref": "#/$defs/EgressTarget"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "to",
        "reason"
      ],
      "additionalProperties": false
    },
    "EgressTarget": {
      "type": "string",
      "enum": [
        "internet"
      ]
    },
    "VpnAttachment": {
      "type": "object",
      "properties": {
        "forwardedPort": {
          "type": "boolean"
        }
      },
      "required": [
        "forwardedPort"
      ],
      "additionalProperties": false
    }
  }
}
