{
  "schema": "project-intent.schema.json",
  "cases": [
    {
      "name": "the worked example examples/auth/auth.project.yml",
      "verdict": "accept",
      "file": "examples/auth/auth.project.yml"
    },
    {
      "name": "the worked example examples/data/data.project.yml",
      "verdict": "accept",
      "file": "examples/data/data.project.yml"
    },
    {
      "name": "the worked example examples/delivery/delivery.project.yml",
      "verdict": "accept",
      "file": "examples/delivery/delivery.project.yml"
    },
    {
      "name": "the worked example examples/edge/edge.project.yml",
      "verdict": "accept",
      "file": "examples/edge/edge.project.yml"
    },
    {
      "name": "the worked example examples/knowledge/knowledge.project.yml",
      "verdict": "accept",
      "file": "examples/knowledge/knowledge.project.yml"
    },
    {
      "name": "the worked example examples/minimal/notes.project.yml",
      "verdict": "accept",
      "file": "examples/minimal/notes.project.yml"
    },
    {
      "name": "the worked example examples/observability/observability.project.yml",
      "verdict": "accept",
      "file": "examples/observability/observability.project.yml"
    },
    {
      "name": "the worked example examples/secrets/secrets.project.yml",
      "verdict": "accept",
      "file": "examples/secrets/secrets.project.yml"
    },
    {
      "name": "a field the model does not have",
      "verdict": "refuse",
      "breaks": "unknown-field",
      "file": "examples/minimal/notes.project.yml",
      "patch": [
        {
          "op": "add",
          "path": "/colour",
          "value": "blue"
        }
      ]
    },
    {
      "name": "a Project with no project name",
      "verdict": "refuse",
      "breaks": "missing-required",
      "file": "examples/minimal/notes.project.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/project"
        }
      ]
    },
    {
      "name": "applications written as one string",
      "verdict": "refuse",
      "breaks": "wrong-type",
      "file": "examples/minimal/notes.project.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/applications",
          "value": "notes"
        }
      ]
    },
    {
      "name": "a cutover outside the vocabulary",
      "verdict": "refuse",
      "breaks": "enum",
      "file": "examples/minimal/notes.project.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/applications/0/processes/0/cutover",
          "value": "eventual"
        }
      ]
    },
    {
      "name": "a document of another kind",
      "verdict": "refuse",
      "breaks": "enum",
      "file": "examples/minimal/notes.project.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/kind",
          "value": "Platform"
        }
      ]
    },
    {
      "name": "probes that are neither none nor a probe set",
      "verdict": "refuse",
      "breaks": "union",
      "file": "examples/minimal/notes.project.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/applications/0/processes/0/probes",
          "value": "some"
        }
      ]
    },
    {
      "name": "an API verb outside the vocabulary",
      "verdict": "refuse",
      "breaks": "enum",
      "file": "examples/delivery/delivery.project.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/applications/1/processes/0/api/rules/0/verbs/0",
          "value": "sudo"
        }
      ]
    },
    {
      "name": "API access with no reason",
      "verdict": "refuse",
      "breaks": "missing-required",
      "file": "examples/delivery/delivery.project.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/applications/1/processes/0/api/reason"
        }
      ]
    },
    {
      "name": "an API rule spelled with a Kubernetes field",
      "verdict": "refuse",
      "breaks": "unknown-field",
      "file": "examples/delivery/delivery.project.yml",
      "patch": [
        {
          "op": "add",
          "path": "/applications/1/processes/0/api/rules/0/resources",
          "value": [
            "secrets"
          ]
        }
      ]
    },
    {
      "name": "a library mount with nowhere to mount it",
      "verdict": "refuse",
      "breaks": "missing-required",
      "file": "examples/minimal/notes.project.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/applications/0/processes/0/libraries/0/mountAt"
        }
      ]
    },
    {
      "name": "a library mounted for something other than reading or writing",
      "verdict": "refuse",
      "breaks": "enum",
      "file": "examples/minimal/notes.project.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/applications/0/processes/0/libraries/0/access",
          "value": "own"
        }
      ]
    },
    {
      "name": "an edge's credential delivered to files under a directory",
      "verdict": "accept",
      "file": "examples/knowledge-platform/knowledge-platform.project.yml"
    },
    {
      "name": "an edge's credential with a directory written as a number",
      "verdict": "refuse",
      "breaks": "wrong-type",
      "file": "examples/knowledge-platform/knowledge-platform.project.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/applications/1/processes/1/dependsOn/0/credentials/mountAt",
          "value": 7
        }
      ]
    },
    {
      "name": "internet egress with a reason",
      "verdict": "accept",
      "file": "examples/knowledge-platform/knowledge-platform.project.yml",
      "patch": [
        {
          "op": "add",
          "path": "/applications/0/processes/0/egress",
          "value": {
            "to": "internet",
            "reason": "fetches documents"
          }
        }
      ]
    },
    {
      "name": "egress to a target outside the vocabulary",
      "verdict": "refuse",
      "breaks": "enum",
      "file": "examples/knowledge-platform/knowledge-platform.project.yml",
      "patch": [
        {
          "op": "add",
          "path": "/applications/0/processes/0/egress",
          "value": {
            "to": "lan",
            "reason": "x"
          }
        }
      ]
    },
    {
      "name": "a GPU asking for a count of cards",
      "verdict": "refuse",
      "breaks": "unknown-field",
      "file": "examples/minimal/notes.project.yml",
      "patch": [
        {
          "op": "add",
          "path": "/applications/0/processes/0/placement/gpu/count",
          "value": 2
        }
      ]
    },
    {
      "name": "a GPU locked by vendor alone",
      "verdict": "accept",
      "file": "examples/minimal/notes.project.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/applications/0/processes/0/placement/gpu",
          "value": {
            "vendor": [
              "nvidia"
            ]
          }
        }
      ]
    }
  ]
}
