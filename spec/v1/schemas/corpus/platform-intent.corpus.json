{
  "schema": "platform-intent.schema.json",
  "cases": [
    {
      "name": "the worked Platform document",
      "verdict": "accept",
      "file": "examples/platform/platform.intent.yml"
    },
    {
      "name": "a field the model does not have",
      "verdict": "refuse",
      "breaks": "unknown-field",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "add",
          "path": "/colour",
          "value": "blue"
        }
      ]
    },
    {
      "name": "a Platform with no owner",
      "verdict": "refuse",
      "breaks": "missing-required",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/owner"
        }
      ]
    },
    {
      "name": "a server count written as a word",
      "verdict": "refuse",
      "breaks": "wrong-type",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/substrate/serverCount",
          "value": "one"
        }
      ]
    },
    {
      "name": "a datastore outside the vocabulary",
      "verdict": "refuse",
      "breaks": "enum",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/substrate/datastore",
          "value": "postgres"
        }
      ]
    },
    {
      "name": "a document of another kind",
      "verdict": "refuse",
      "breaks": "enum",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/kind",
          "value": "Project"
        }
      ]
    },
    {
      "name": "API access with no server to admit",
      "verdict": "refuse",
      "breaks": "missing-required",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/apiAccess/server"
        }
      ]
    },
    {
      "name": "a Vault policy job with no role to log in as",
      "verdict": "refuse",
      "breaks": "missing-required",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/policyJob/role"
        }
      ]
    },
    {
      "name": "a Vault policy job that names a namespace",
      "verdict": "refuse",
      "breaks": "unknown-field",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "add",
          "path": "/policyJob/namespace",
          "value": "delivery-system"
        }
      ]
    },
    {
      "name": "a library with no group",
      "verdict": "refuse",
      "breaks": "missing-required",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/libraries/media/gid"
        }
      ]
    },
    {
      "name": "a library granted for something other than reading or writing",
      "verdict": "refuse",
      "breaks": "enum",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/libraries/media/grants/notes",
          "value": "own"
        }
      ]
    },
    {
      "name": "a library that grants no project",
      "verdict": "refuse",
      "breaks": "rule",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/libraries/media/grants",
          "value": {}
        }
      ]
    },
    {
      "name": "a GPU vendor with no runtime class",
      "verdict": "refuse",
      "breaks": "missing-required",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/gpus/nvidia/runtimeClass"
        }
      ]
    },
    {
      "name": "a VPN with no credential",
      "verdict": "refuse",
      "breaks": "missing-required",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/vpn/credential"
        }
      ]
    },
    {
      "name": "a VPN that authors a setting the render derives",
      "verdict": "refuse",
      "breaks": "rule",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "add",
          "path": "/vpn/settings/VPN_PORT_FORWARDING",
          "value": "on"
        }
      ]
    },
    {
      "name": "a tier no forwarder proxies",
      "verdict": "accept",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/tiers/0/proxiedBy"
        }
      ]
    },
    {
      "name": "a tier proxied by a forwarder outside the vocabulary",
      "verdict": "refuse",
      "breaks": "enum",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/tiers/0/proxiedBy",
          "value": "fastly"
        }
      ]
    },
    {
      "name": "a mongo engine with no backup method",
      "verdict": "refuse",
      "breaks": "missing-required",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/engines/mongo/backup"
        }
      ]
    },
    {
      "name": "a mongo engine naming a field an engine entry does not have",
      "verdict": "refuse",
      "breaks": "unknown-field",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "add",
          "path": "/engines/mongo/replicaSet",
          "value": "overleaf"
        }
      ]
    },
    {
      "name": "a monitor label whose key the API server refuses",
      "verdict": "refuse",
      "breaks": "rule",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "add",
          "path": "/monitors/labels/not a key",
          "value": "x"
        }
      ]
    },
    {
      "name": "a monitor label whose value the API server refuses",
      "verdict": "refuse",
      "breaks": "rule",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/monitors/labels/release",
          "value": "metrics stack"
        }
      ]
    },
    {
      "name": "monitors that name no labels",
      "verdict": "accept",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/monitors/labels"
        }
      ]
    },
    {
      "name": "a Platform that grants no human a cluster role",
      "verdict": "accept",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/humanGrants"
        }
      ]
    },
    {
      "name": "a human grant of each built-in role to a group",
      "verdict": "accept",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/humanGrants",
          "value": [
            {
              "group": "oidc:k8s-admin",
              "clusterRole": "cluster-admin",
              "reason": "administers the cluster"
            },
            {
              "group": "oidc:k8s-operators",
              "clusterRole": "admin",
              "reason": "operates every Project"
            },
            {
              "group": "oidc:k8s-editors",
              "clusterRole": "edit",
              "reason": "edits every Project"
            },
            {
              "group": "oidc:k8s-viewers",
              "clusterRole": "view",
              "reason": "reads every Project"
            }
          ]
        }
      ]
    },
    {
      "name": "a human grant to a user",
      "verdict": "refuse",
      "breaks": "unknown-field",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/humanGrants/0",
          "value": {
            "user": "joris",
            "group": "oidc:k8s-admin",
            "clusterRole": "cluster-admin",
            "reason": "administers the cluster"
          }
        }
      ]
    },
    {
      "name": "a human grant scoped to a namespace",
      "verdict": "refuse",
      "breaks": "unknown-field",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "add",
          "path": "/humanGrants/0/namespace",
          "value": "notes-system"
        }
      ]
    },
    {
      "name": "a human grant of a role outside the built-in four",
      "verdict": "refuse",
      "breaks": "enum",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/humanGrants/0/clusterRole",
          "value": "secret-reader"
        }
      ]
    },
    {
      "name": "a human grant with no reason",
      "verdict": "refuse",
      "breaks": "missing-required",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/humanGrants/0/reason"
        }
      ]
    },
    {
      "name": "a human grant to a group no binding can be named for",
      "verdict": "refuse",
      "breaks": "rule",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/humanGrants/0/group",
          "value": "oidc:/k8s-admin"
        }
      ]
    },
    {
      "name": "an empty list of human grants",
      "verdict": "refuse",
      "breaks": "rule",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/humanGrants",
          "value": []
        }
      ]
    },
    {
      "name": "a priority class whose name is no Kubernetes name",
      "verdict": "refuse",
      "breaks": "rule",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/priority/data/name",
          "value": "Platform Data"
        }
      ]
    },
    {
      "name": "a priority policy with no critical class",
      "verdict": "refuse",
      "breaks": "missing-required",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/priority/critical"
        }
      ]
    },
    {
      "name": "a priority policy that names no critical Application",
      "verdict": "accept",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/priority/criticalApplications"
        }
      ]
    },
    {
      "name": "an L4 Address whose range is no IPv4 range",
      "verdict": "refuse",
      "breaks": "rule",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/l4Addresses/lan-mqtt/range",
          "value": "192.168.0.97"
        }
      ]
    },
    {
      "name": "an L4 Address of a kind the platform offers none of",
      "verdict": "refuse",
      "breaks": "enum",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "replace",
          "path": "/l4Addresses/lan-mqtt/kind",
          "value": "bgp"
        }
      ]
    },
    {
      "name": "an L4 Address with no site",
      "verdict": "refuse",
      "breaks": "missing-required",
      "file": "examples/platform/platform.intent.yml",
      "patch": [
        {
          "op": "remove",
          "path": "/l4Addresses/lan-mqtt/site"
        }
      ]
    }
  ]
}
