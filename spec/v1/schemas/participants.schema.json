{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Participants",
  "$defs": {
    "Participants": {
      "type": "object",
      "properties": {
        "participants": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/Participant"
          }
        }
      },
      "required": [
        "participants"
      ],
      "additionalProperties": false
    },
    "Participant": {
      "type": "object",
      "properties": {
        "maxAge": {
          "type": "string",
          "pattern": "^\\d+d$"
        },
        "dormant": {
          "type": "boolean",
          "const": true
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "reviewBy": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "maxAge": [
          "reason"
        ],
        "dormant": [
          "owner",
          "reason",
          "reviewBy"
        ]
      }
    }
  }
}
