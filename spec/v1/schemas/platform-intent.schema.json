{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Platform",
  "$defs": {
    "Platform": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "intent.jorisjonkers.dev/v1"
        },
        "kind": {
          "type": "string",
          "const": "Platform"
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "$ref": "#/$defs/PlatformMetadata"
        },
        "substrate": {
          "$ref": "#/$defs/Substrate"
        },
        "bootstrap": {
          "$ref": "#/$defs/Bootstrap"
        },
        "tiers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tier"
          }
        },
        "durability": {
          "$ref": "#/$defs/DurabilityPolicies"
        },
        "engines": {
          "$ref": "#/$defs/EnginePolicies"
        },
        "monitors": {
          "$ref": "#/$defs/MonitorCadence"
        },
        "telemetry": {
          "$ref": "#/$defs/TelemetryPolicy"
        },
        "secretStore": {
          "type": "string",
          "pattern": "^[^/\\s]+\\/[^/\\s]+$",
          "reference": "Application"
        },
        "signIn": {
          "$ref": "#/$defs/SignIn"
        },
        "mesh": {
          "$ref": "#/$defs/Mesh"
        },
        "hardening": {
          "$ref": "#/$defs/HardeningClass"
        },
        "probes": {
          "$ref": "#/$defs/ProbeCadence"
        },
        "ephemeral": {
          "$ref": "#/$defs/EphemeralPolicy"
        },
        "migration": {
          "$ref": "#/$defs/MigrationPolicy"
        },
        "delivery": {
          "$ref": "#/$defs/DeliveryPolicy"
        },
        "apiAccess": {
          "$ref": "#/$defs/ApiAccessPolicy"
        },
        "policyJob": {
          "$ref": "#/$defs/VaultPolicyJob"
        },
        "handover": {
          "$ref": "#/$defs/HandoverLedger"
        },
        "providers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Provider"
          }
        },
        "libraries": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/LibraryDeclaration"
          },
          "entry": "Library"
        },
        "gpus": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/GpuVendorPolicy"
          },
          "entry": "GpuVendor"
        },
        "vpn": {
          "$ref": "#/$defs/VpnPolicy"
        },
        "nodeAgents": {
          "$ref": "#/$defs/NodeAgents"
        },
        "humanGrants": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/HumanGrant"
          }
        },
        "priority": {
          "$ref": "#/$defs/PriorityPolicy"
        },
        "l4Addresses": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/PoolAddress"
              },
              {
                "$ref": "#/$defs/NodeAddress"
              }
            ]
          },
          "entry": "L4Address"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "schemaVersion",
        "owner",
        "metadata",
        "substrate",
        "bootstrap",
        "tiers",
        "durability",
        "engines",
        "monitors",
        "hardening",
        "probes",
        "ephemeral"
      ],
      "additionalProperties": false
    },
    "PlatformMetadata": {
      "type": "object",
      "properties": {
        "cluster": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "nodeContract": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "cluster",
        "project",
        "nodeContract"
      ],
      "additionalProperties": false
    },
    "Substrate": {
      "type": "object",
      "properties": {
        "kubernetesVersion": {
          "type": "string",
          "minLength": 1
        },
        "datastore": {
          "$ref": "#/$defs/Datastore"
        },
        "serverCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "secretsEncryption": {
          "type": "boolean"
        },
        "cni": {
          "type": "string",
          "minLength": 1
        },
        "networkPolicyController": {
          "$ref": "#/$defs/PolicyController"
        },
        "clusterDns": {
          "type": "string",
          "minLength": 1
        },
        "imagePull": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kubernetesVersion",
        "datastore",
        "serverCount",
        "secretsEncryption",
        "cni",
        "networkPolicyController",
        "clusterDns"
      ],
      "additionalProperties": false
    },
    "Datastore": {
      "type": "string",
      "enum": [
        "sqlite",
        "etcd"
      ]
    },
    "PolicyController": {
      "type": "string",
      "enum": [
        "none",
        "embedded",
        "cni"
      ]
    },
    "Bootstrap": {
      "type": "object",
      "properties": {
        "flux": {
          "$ref": "#/$defs/FluxSource"
        },
        "vault": {
          "$ref": "#/$defs/VaultState"
        },
        "crds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "flux",
        "vault",
        "crds"
      ],
      "additionalProperties": false
    },
    "FluxSource": {
      "type": "object",
      "properties": {
        "sourceRef": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "$ref": "#/$defs/RenderedArtifacts"
        }
      },
      "required": [
        "sourceRef",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "RenderedArtifacts": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "signer": {
          "$ref": "#/$defs/ArtifactSigner"
        },
        "pullSecret": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "signer"
      ],
      "additionalProperties": false
    },
    "ArtifactSigner": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "issuer",
        "subject"
      ],
      "additionalProperties": false
    },
    "VaultState": {
      "type": "object",
      "properties": {
        "unsealed": {
          "type": "boolean"
        }
      },
      "required": [
        "unsealed"
      ],
      "additionalProperties": false
    },
    "Tier": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "audiences": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Audience"
          }
        },
        "listener": {
          "$ref": "#/$defs/Listener"
        },
        "certificates": {
          "$ref": "#/$defs/CertificateSource"
        },
        "forwardAuth": {
          "$ref": "#/$defs/ForwardAuth"
        },
        "proxiedBy": {
          "$ref": "#/$defs/ProxiedBy"
        },
        "traefik": {
          "type": "string",
          "pattern": "^[^/\\s]+\\/[^/\\s]+$",
          "reference": "Application"
        },
        "ingressClass": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "dns": {
          "$ref": "#/$defs/TierDns"
        }
      },
      "required": [
        "name",
        "audiences",
        "listener",
        "certificates",
        "traefik"
      ],
      "additionalProperties": false
    },
    "Audience": {
      "type": "string",
      "enum": [
        "anonymous",
        "authenticated",
        "internal",
        "lan"
      ]
    },
    "Listener": {
      "type": "string",
      "enum": [
        "tls",
        "plain"
      ]
    },
    "CertificateSource": {
      "type": "string",
      "enum": [
        "acme",
        "none"
      ]
    },
    "ForwardAuth": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[^/\\s]+\\/[^/\\s]+$",
          "reference": "Application"
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(\\/[A-Za-z0-9._~!$&'()*+,;=:@%-]+)+\\/?$"
        },
        "responseHeaders": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+$"
          }
        }
      },
      "required": [
        "provider",
        "surface",
        "path"
      ],
      "additionalProperties": false
    },
    "ProxiedBy": {
      "type": "string",
      "enum": [
        "cloudflare"
      ]
    },
    "TierDns": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "proxied": {
          "type": "boolean"
        }
      },
      "required": [
        "target",
        "proxied"
      ],
      "additionalProperties": false
    },
    "DurabilityPolicies": {
      "type": "object",
      "properties": {
        "reconstructible": {
          "$ref": "#/$defs/DurabilityPolicy"
        },
        "recoverable": {
          "$ref": "#/$defs/DurabilityPolicy"
        },
        "irreplaceable": {
          "$ref": "#/$defs/DurabilityPolicy"
        }
      },
      "additionalProperties": false
    },
    "DurabilityPolicy": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "retain": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "offCluster": {
          "$ref": "#/$defs/OffClusterCopy"
        }
      },
      "additionalProperties": false
    },
    "OffClusterCopy": {
      "type": "object",
      "properties": {
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "credential": {
          "type": "string",
          "minLength": 1
        },
        "egress": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/DestinationRange"
          }
        }
      },
      "required": [
        "destination",
        "credential",
        "egress"
      ],
      "additionalProperties": false
    },
    "DestinationRange": {
      "type": "object",
      "properties": {
        "cidr": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "cidr",
        "port"
      ],
      "additionalProperties": false
    },
    "EnginePolicies": {
      "type": "object",
      "properties": {
        "postgres": {
          "$ref": "#/$defs/EnginePolicy"
        },
        "rabbitmq": {
          "$ref": "#/$defs/EnginePolicy"
        },
        "valkey": {
          "$ref": "#/$defs/EnginePolicy"
        },
        "mongo": {
          "$ref": "#/$defs/EnginePolicy"
        },
        "files": {
          "$ref": "#/$defs/EnginePolicy"
        }
      },
      "additionalProperties": false
    },
    "EnginePolicy": {
      "type": "object",
      "properties": {
        "backup": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "catalog": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "backup"
      ],
      "additionalProperties": false
    },
    "MonitorCadence": {
      "type": "object",
      "properties": {
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "timeout": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^([a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?\\/)?[A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^([A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?)?$"
          }
        }
      },
      "required": [
        "interval",
        "timeout"
      ],
      "additionalProperties": false
    },
    "TelemetryPolicy": {
      "type": "object",
      "properties": {
        "collector": {
          "type": "string",
          "pattern": "^[^/\\s]+\\/[^/\\s]+$",
          "reference": "Application"
        },
        "metrics": {
          "type": "string",
          "pattern": "^[^/\\s]+\\/[^/\\s]+$",
          "reference": "Application"
        }
      },
      "required": [
        "collector",
        "metrics"
      ],
      "additionalProperties": false
    },
    "SignIn": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string",
          "pattern": "^https:\\/\\/[^\\s/]+(\\/[^\\s]*)?$"
        },
        "provider": {
          "type": "string",
          "pattern": "^[^/\\s]+\\/[^/\\s]+$",
          "reference": "Application"
        }
      },
      "required": [
        "issuer",
        "provider"
      ],
      "additionalProperties": false
    },
    "Mesh": {
      "type": "object",
      "properties": {
        "enrolled": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "enrolled"
      ],
      "additionalProperties": false
    },
    "HardeningClass": {
      "type": "string",
      "enum": [
        "restricted"
      ]
    },
    "ProbeCadence": {
      "type": "object",
      "properties": {
        "period": {
          "type": "string",
          "minLength": 1
        },
        "timeout": {
          "type": "string",
          "minLength": 1
        },
        "failures": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "period",
        "timeout",
        "failures"
      ],
      "additionalProperties": false
    },
    "EphemeralPolicy": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "size"
      ],
      "additionalProperties": false
    },
    "MigrationPolicy": {
      "type": "object",
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "deadline": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "runner",
        "deadline",
        "memory",
        "cpu"
      ],
      "additionalProperties": false
    },
    "DeliveryPolicy": {
      "type": "object",
      "properties": {
        "machinery": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^/\\s]+\\/[^/\\s]+$",
            "reference": "Application"
          }
        },
        "gate": {
          "type": "string",
          "pattern": "^[^/\\s]+\\/[^/\\s]+$",
          "reference": "Application"
        },
        "analysis": {
          "$ref": "#/$defs/AnalysisPolicy"
        },
        "reporter": {
          "type": "string",
          "pattern": "^[^/\\s]+\\/[^/\\s]+$",
          "reference": "Application"
        }
      },
      "required": [
        "machinery",
        "gate",
        "analysis"
      ],
      "additionalProperties": false
    },
    "AnalysisPolicy": {
      "type": "object",
      "properties": {
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "errorRate": {
          "type": "string",
          "pattern": "^(100|\\d{1,2}(\\.\\d{1,2})?)%$"
        },
        "latency": {
          "type": "string",
          "pattern": "^[1-9]\\d*(ms|s)$"
        }
      },
      "required": [
        "interval",
        "iterations",
        "threshold",
        "errorRate",
        "latency"
      ],
      "additionalProperties": false
    },
    "ApiAccessPolicy": {
      "type": "object",
      "properties": {
        "holders": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^/\\s]+\\/[^/\\s]+$",
            "reference": "Application"
          }
        },
        "server": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/DestinationRange"
          }
        }
      },
      "required": [
        "holders",
        "server"
      ],
      "additionalProperties": false
    },
    "VaultPolicyJob": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "deadline": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "image",
        "role",
        "memory",
        "cpu",
        "deadline"
      ],
      "additionalProperties": false
    },
    "HandoverLedger": {
      "type": "object",
      "properties": {
        "retireBy": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "legacy": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "estate": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "serving": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ServingLocation"
          }
        }
      },
      "required": [
        "retireBy"
      ],
      "additionalProperties": false
    },
    "ServingLocation": {
      "type": "object",
      "properties": {
        "application": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "instance": {
          "type": "string",
          "minLength": 1
        },
        "admin": {
          "$ref": "#/$defs/AdminLogin"
        }
      },
      "required": [
        "application",
        "namespace"
      ],
      "additionalProperties": false
    },
    "AdminLogin": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "user",
        "password"
      ],
      "additionalProperties": false
    },
    "Provider": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "surfaces": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "entry": "ProviderSurface"
        }
      },
      "required": [
        "name",
        "address",
        "surfaces"
      ],
      "additionalProperties": false
    },
    "LibraryDeclaration": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(\\/(?!\\.\\.?(?:\\/|$))[^/]+)+$"
        },
        "gid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "grants": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/LibraryAccess"
          },
          "entry": "LibraryGrant"
        }
      },
      "required": [
        "node",
        "path",
        "gid",
        "grants"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "grants": {
              "type": "object",
              "minProperties": 1
            }
          }
        }
      ]
    },
    "LibraryAccess": {
      "type": "string",
      "enum": [
        "read",
        "write"
      ]
    },
    "GpuVendorPolicy": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "runtimeClass": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "resource",
        "runtimeClass"
      ],
      "additionalProperties": false
    },
    "VpnPolicy": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "credential": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          },
          "entry": "VpnSetting"
        }
      },
      "required": [
        "image",
        "credential",
        "memory",
        "cpu"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "settings": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "enum": [
                    "FIREWALL_INPUT_PORTS",
                    "VPN_PORT_FORWARDING",
                    "VPN_PORT_FORWARDING_UP_COMMAND"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "NodeAgents": {
      "type": "object",
      "properties": {
        "gpu-device": {
          "$ref": "#/$defs/NodeAgentPolicy"
        },
        "gpu-metrics": {
          "$ref": "#/$defs/NodeAgentPolicy"
        },
        "node-metrics": {
          "$ref": "#/$defs/NodeAgentPolicy"
        },
        "l4-speaker": {
          "$ref": "#/$defs/SpeakerPolicy"
        }
      },
      "additionalProperties": false
    },
    "NodeAgentPolicy": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "image",
        "memory",
        "cpu"
      ],
      "additionalProperties": false
    },
    "SpeakerPolicy": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "controller": {
          "$ref": "#/$defs/NodeAgentPolicy"
        }
      },
      "required": [
        "image",
        "memory",
        "cpu",
        "controller"
      ],
      "additionalProperties": false
    },
    "HumanGrant": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "pattern": "^[^/%\\s]+$"
        },
        "clusterRole": {
          "$ref": "#/$defs/HumanGrantRole"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "group",
        "clusterRole",
        "reason"
      ],
      "additionalProperties": false
    },
    "HumanGrantRole": {
      "type": "string",
      "enum": [
        "cluster-admin",
        "admin",
        "edit",
        "view"
      ]
    },
    "PriorityPolicy": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/PriorityClass"
        },
        "critical": {
          "$ref": "#/$defs/PriorityClass"
        },
        "criticalApplications": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^/\\s]+\\/[^/\\s]+$",
            "reference": "Application"
          }
        }
      },
      "required": [
        "data",
        "critical"
      ],
      "additionalProperties": false
    },
    "PriorityClass": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false
    },
    "PoolAddress": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "pool"
        },
        "site": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "string",
          "pattern": "^((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\/(3[0-2]|[12]?\\d)$"
        }
      },
      "required": [
        "kind",
        "site",
        "range"
      ],
      "additionalProperties": false
    },
    "NodeAddress": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "node"
        },
        "node": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "node"
      ],
      "additionalProperties": false
    }
  }
}
