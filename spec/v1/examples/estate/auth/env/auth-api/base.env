# The Process scope of auth-api (deploy-kit spec/v1, chapter 10, Configuration).
#
# Every variable the old path's Deployment sets, carried over as it is today
# (fleet-infra cluster/flux/apps/stateless/auth-api/deployment.yaml), except:
# - the coordinates of what auth-api depends on and its own public address,
#   which are placeholders now, so they follow the composition;
# - the values the Vault Agent Injector templated into /vault/secrets/auth-api.env,
#   which are ${secret:...} placeholders now, synced by VSO into Secrets;
# - DEPLOYMENT_ENVIRONMENT, OTEL_SERVICE_NAME and OTEL_EXPORTER_OTLP_ENDPOINT, which
#   the jvm Runtime Profile injects;
# - the PYROSCOPE_* variables: their agent came from an init container the render
#   has no counterpart for, so nothing would read them.
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=prod

# The old path's java flags: ZGC, and a heap of 55% of the limit, which leaves room
# under it for the OpenTelemetry agent's native memory during the cold start.
JAVA_TOOL_OPTIONS=-XX:+UseZGC -XX:MaxRAMPercentage=55

# Spring Cloud Vault, `delivery: self`: the transit key the tokens are signed with,
# and the dynamic database login that takes precedence over DB_USER below.
#
# It logs in as the old path's role, auth-api, not as the role the render derives
# (auth-system-auth-api), on purpose. The token's JWKS is read from
# transit/keys/auth-api-jwt, and deploy-kit 0.31 can declare a transit operation
# (sign, verify, encrypt, decrypt, rotate) but not a read of the key, so the derived
# policy cannot cover what auth-api reads at startup. The old role still binds this
# ServiceAccount (auth-api in auth-system), and the old path's Vault bootstrap still
# writes it, with database/creds/auth-api beside the transit grants.
SPRING_CONFIG_IMPORT=vault://
VAULT_ENABLED=true
VAULT_ADDR=http://vault.data-system.svc.cluster.local:8200
VAULT_AUTHENTICATION=KUBERNETES
VAULT_KUBERNETES_ROLE=${identity:vaultRole}
VAULT_DB_ENABLED=true
AUTH_TRANSIT_ENABLED=true
AUTH_TRANSIT_KEY_NAME=auth-api-jwt

DB_HOST=${dependency:platform-postgres.host}
DB_PORT=${dependency:platform-postgres.port}
DB_USER=${secret:secret/data/platform/postgres#auth.user}
DB_PASSWORD=${secret:secret/data/platform/postgres#auth.password}

VALKEY_HOST=${dependency:platform-valkey.host}
VALKEY_PORT=${dependency:platform-valkey.port}

# The static broker login: a dynamic one was revoked under a running pod once.
SPRING_RABBITMQ_HOST=${dependency:platform-rabbitmq.host}
SPRING_RABBITMQ_PORT=${dependency:platform-rabbitmq.port}
SPRING_RABBITMQ_USERNAME=${secret:secret/data/platform/rabbitmq#rabbitmq.user}
SPRING_RABBITMQ_PASSWORD=${secret:secret/data/platform/rabbitmq#rabbitmq.password}

# The submission account stalwart provisions; its password has one source,
# secret/platform/mail.
MAIL_HOST=${dependency:stalwart.host}
MAIL_PORT=${dependency:stalwart.port}
MAIL_USERNAME=auth@jorisjonkers.dev
MAIL_PASSWORD=${secret:secret/data/platform/mail#account.password}

AUTH_ISSUER=${exposure:auth.public#url}
AUTH_LOGIN_URL=${exposure:auth.public#url}/login
CONFIRMATION_URL=${exposure:auth.public#url}/confirm-email
PASSWORD_RESET_URL=${exposure:auth.public#url}/reset-password
SESSION_COOKIE_DOMAIN=jorisjonkers.dev
SESSION_COOKIE_SECURE=true

# Every forward-auth host belongs here, whether or not it uses WebSockets today:
# a missing host breaks only a WebSocket handshake, with a 403 from Spring's CORS
# filter that logs nothing (the workspace's agent contract records the Overleaf case).
AUTH_CORS_ALLOWED_ORIGINS=https://jorisjonkers.dev,https://auth.jorisjonkers.dev,https://agents.jorisjonkers.dev,https://vault.jorisjonkers.dev,https://n8n.jorisjonkers.dev,https://grafana.jorisjonkers.dev,https://dashboard.jorisjonkers.dev,https://rabbitmq.jorisjonkers.dev,https://status.jorisjonkers.dev,https://overleaf.jorisjonkers.dev,https://notes.jorisjonkers.dev,https://hindsight.jorisjonkers.dev,https://hindsight-api.jorisjonkers.dev,https://hindsight-private.jorisjonkers.dev,https://karakeep.jorisjonkers.dev,https://tribelt.jorisjonkers.dev,https://grimoire.jorisjonkers.dev

# Each OIDC client's secret, one key of secret/auth-api each.
AUTH_CLIENTS_ESTATE_DASHBOARD_SECRET=${secret:secret/data/auth-api#auth.clients.estate-dashboard.secret}
AUTH_CLIENTS_FINDABILITY_EXPLORER_SECRET=${secret:secret/data/auth-api#auth.clients.findability-explorer.secret}
AUTH_CLIENTS_GRAFANA_SECRET=${secret:secret/data/auth-api#auth.clients.grafana.secret}
AUTH_CLIENTS_GRIMOIRE_SECRET=${secret:secret/data/auth-api#auth.clients.grimoire.secret}
AUTH_CLIENTS_N8N_SECRET=${secret:secret/data/auth-api#auth.clients.n8n.secret}
AUTH_CLIENTS_OUTLINE_SECRET=${secret:secret/data/auth-api#auth.clients.outline.secret}
AUTH_CLIENTS_TRIBELT_SECRET=${secret:secret/data/auth-api#auth.clients.tribelt.secret}
AUTH_CLIENTS_VAULT_SECRET=${secret:secret/data/auth-api#auth.clients.vault.secret}

# The trace exporter's tuning from the old path.
OTEL_LOGS_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_TIMEOUT=5000
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_MAX_QUEUE_SIZE=16384
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=2048
# The profile's endpoint is the collector's otlp surface, 4317, which speaks gRPC; the
# agent's default protocol, http/protobuf, is the old path's port 4318.
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
