{"apiVersion":"resolved.jorisjonkers.dev/v1","id":"tempo","kind":"ResolvedApplication","namespace":"observability-system","processes":[{"args":["-config.file=/etc/tempo/tempo.yaml"],"assets":[{"content":"# Tempo with its metrics generator, as fleet-infra's tempo chart renders it\n# today (its `tempo` ConfigMap, read 2026-10-29): 7 days of traces on its own\n# claim, OTLP and Jaeger receivers, and span and service-graph metrics\n# remote-written into Prometheus. Only the addresses change.\nmultitenancy_enabled: false\nusage_report:\n  reporting_enabled: false\ncompactor:\n  compaction:\n    block_retention: 168h\ndistributor:\n  receivers:\n    jaeger:\n      protocols:\n        grpc:\n          endpoint: 0.0.0.0:14250\n        thrift_binary:\n          endpoint: 0.0.0.0:6832\n        thrift_compact:\n          endpoint: 0.0.0.0:6831\n        thrift_http:\n          endpoint: 0.0.0.0:14268\n    otlp:\n      protocols:\n        grpc:\n          endpoint: 0.0.0.0:4317\n        http:\n          endpoint: 0.0.0.0:4318\nserver:\n  http_listen_port: 3200\nstorage:\n  trace:\n    backend: local\n    local:\n      path: /var/tempo/traces\n    wal:\n      path: /var/tempo/wal\noverrides:\n  defaults:\n    metrics_generator:\n      generate_native_histograms: both\n      processors:\n        - service-graphs\n        - span-metrics\n        - local-blocks\nmetrics_generator:\n  processor:\n    local_blocks:\n      flush_to_storage: true\n    service_graphs: {}\n    span_metrics:\n      dimensions:\n        - http.method\n        - http.route\n        - http.status_code\n        - k8s.pod.name\n        - service.version\n  storage:\n    path: /var/tempo/generator/wal\n    remote_write:\n      - url: http://prometheus:9090/api/v1/write\n  traces_storage:\n    path: /var/tempo/generator/traces\n","from":"config/tempo.yaml","mountAt":"/etc/tempo/tempo.yaml","name":"tempo-tempo-yaml-942a4b035f"}],"consumes":["prometheus.http"],"cpu":"100m","cutover":"interrupted","deadline":"480s","dependencies":[{"address":"prometheus:9090","application":"prometheus","peers":[{"namespace":"observability-system","port":9090,"process":"prometheus"}],"surface":"http"}],"egress":[{"namespace":"kube-system","port":53,"rule":"cluster-dns"}],"gid":10001,"hardening":"restricted","identity":"tempo","identityToken":false,"image":"docker.io/grafana/tempo@sha256:65a5789759435f1ef696f1953258b9bbdb18eb571d5ce711ff812d2e128288a4","imageVersion":"2.9.0","ingress":[{"namespace":"observability-system","port":3200,"process":"prometheus","rule":"metrics-stack"},{"consumes":"tempo.http","port":3200,"rule":"consumer"},{"consumes":"tempo.otlp","port":4317,"rule":"consumer"},{"consumes":"tempo.otlp-http","port":4318,"rule":"consumer"}],"lifecycle":"application","liveness":{"failures":3,"path":"/ready","period":"10s","port":3200,"timeout":"5s"},"memory":"1Gi","name":"tempo","placement":{"boundTo":"enschede-t1000-1","eligibleNodes":["enschede-gtx-960m-1","enschede-t1000-1","enschede-pi-1","enschede-pi-2","enschede-pi-3"],"from":"cluster-state"},"readiness":{"failures":3,"path":"/ready","period":"10s","port":3200,"timeout":"5s"},"replicas":1,"runtime":"none","startup":{"failures":12,"path":"/ready","period":"5s","port":3200,"timeout":"5s"},"surfaces":[{"name":"http","port":3200},{"name":"otlp","port":4317},{"name":"otlp-http","port":4318}],"switchover":"stop-start","uid":10001,"volumes":[{"claim":"tempo-data","durability":"reconstructible","mountAt":"/var/tempo","size":"20Gi"}],"writablePaths":[{"path":"/tmp","size":"64Mi"}]}],"project":"observability","provenance":{"inputDigests":[{"digest":"sha256:65310020392340fc3f120a6a2fecc10dd7d376449748bcbea3661216ca8a12d0","input":"intent-fragment","name":"arr"},{"digest":"sha256:002ac73d31c2a24d3488f92833f2114cc89595b2a21a6a71cd69675304cb8e4a","input":"intent-fragment","name":"auth"},{"digest":"sha256:c8111532b0a816e25231be11cf62673910b190143fa5c3f92f60748479f910c2","input":"intent-fragment","name":"data"},{"digest":"sha256:a5ef4589ef4e9145e1