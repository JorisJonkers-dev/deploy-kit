{"apiVersion":"resolved.jorisjonkers.dev/v1","exposure":[{"certificates":"acme","dns":{"proxied":true,"target":"ingress.jorisjonkers.dev"},"host":"faro.jorisjonkers.dev","ingressClass":"traefik-public","listener":"tls","name":"faro","proxy":{"application":"traefik-public","namespace":"edge-system"},"routes":[{"audience":"anonymous","match":"prefix","middleware":[{"kind":"security-headers"}],"path":"/","precedence":1,"process":"alloy","surface":"faro"}],"tier":"public-frankfurt"}],"id":"alloy","kind":"ResolvedApplication","namespace":"observability-system","processes":[{"api":{"reason":"Alloy tails every pod's log through the API, cluster-wide","rules":[{"group":"core","objects":["pods","pods/log","namespaces"],"scope":"cluster","verbs":["get","list","watch"]}],"server":[{"cidr":"10.43.0.1/32","port":443}]},"args":["run","/etc/alloy/config.alloy","--storage.path=/var/lib/alloy/data","--server.http.listen-addr=0.0.0.0:12345"],"assets":[{"content":"// The log collector: one copy that tails every pod's log through the\n// Kubernetes API, and the receiver for the sites' browser telemetry. Both are\n// fleet-infra's Alloy configuration (cluster/flux/apps/observability/alloy/\n// release.yaml), unchanged but for the addresses. Its OTLP pipeline moved to\n// the otel-collector Application.\n\nlogging {\n  level  = \"info\"\n  format = \"logfmt\"\n}\n\ndiscovery.kubernetes \"pods\" {\n  role = \"pod\"\n}\n\ndiscovery.relabel \"pods\" {\n  targets = discovery.kubernetes.pods.targets\n\n  rule {\n    source_labels = [\"__meta_kubernetes_namespace\"]\n    target_label  = \"namespace\"\n  }\n\n  rule {\n    source_labels = [\"__meta_kubernetes_pod_name\"]\n    target_label  = \"pod\"\n  }\n\n  // The workload's app.kubernetes.io/name, as `service_name`: the join key\n  // the dashboards and Grafana's traces-to-logs link look logs up by.\n  rule {\n    source_labels = [\"__meta_kubernetes_pod_label_app_kubernetes_io_name\"]\n    target_label  = \"service_name\"\n  }\n\n  rule {\n    source_labels = [\"__meta_kubernetes_pod_container_name\"]\n    target_label  = \"container\"\n  }\n\n  // The pod's release, for the estate dashboard; absent without the label.\n  rule {\n    source_labels = [\"__meta_kubernetes_pod_label_app_kubernetes_io_version\"]\n    target_label  = \"version\"\n  }\n}\n\n// Spring services log JSON through the Logstash encoder: `level` becomes a\n// label, traceId and spanId structured metadata (never labels).\nloki.process \"pods\" {\n  forward_to = [loki.write.default.receiver]\n\n  stage.json {\n    expressions = {\n      level   = \"level\",\n      traceId = \"traceId\",\n      spanId  = \"spanId\",\n    }\n  }\n\n  stage.labels {\n    values = {\n      level = \"\",\n    }\n  }\n\n  stage.structured_metadata {\n    values = {\n      traceId = \"\",\n      spanId  = \"\",\n    }\n  }\n}\n\nloki.source.kubernetes \"pods\" {\n  targets    = discovery.relabel.pods.output\n  forward_to = [loki.process.pods.receiver]\n}\n\nloki.write \"default\" {\n  endpoint {\n    url = \"http://loki:3100/loki/api/v1/push\"\n  }\n}\n\n// Browser RUM: the sites post Faro's envelope to faro.jorisjonkers.dev, which\n// routes here. Logs go to Loki; spans to the collector, which drops health\n// checks and names them like every other span.\nfaro.receiver \"default\" {\n  server {\n    listen_address       = \"0.0.0.0\"\n    listen_port          = 12347\n    cors_allowed_origins = [\n      \"https://jorisjonkers.dev\",\n      \"https://auth.jorisjonkers.dev\",\n      \"https://agents.jorisjonkers.dev\",\n    ]\n  }\n\n  extra_log_labels = {\n    source = \"faro\",\n  }\n\n  output {\n    logs   = [loki.write.default.receiver]\n    traces = [otelcol.exporter.otlp.collector.input]\n  }\n}\n\notelcol.exporter.otlp \"collector\" {\n  client {\n    endpoint = \"otel-collector:4317\"\n    tls {\n      insecure = true\n    }\n  }\n}\n","from":"config/alloy.alloy","mountAt":"/etc/alloy/config.alloy","name":"alloy-alloy-alloy-204d288c20"}],"consumes":["loki.http","otel-collector.otlp"],"cpu":"100m","cutover":"interrupted","deadline":"390s","dependencies":[{"address":"loki:3100","application":"loki","peers":[{"namespace":"observability-system","port":3100,"process":"loki"}],"surface":"http"},{"address":"otel-collector:4317","application":"otel-collector","peers":[{"namespace":"observability-system","port":4317,"process":"otel-collector"}],"surface":"otlp"}],"egress":[{"namespace":"kube-system","port":53,"rule":"cluster-dns"}],"gid":473,"hardening":"restricted","identity":"alloy","identityToken":true,"image":"docker.io/grafana/alloy@sha256:b8ec653c44235fbe910879145dac3597d66b0aaecf60bcbbe82580767771a839","imageVersion":"v1.19.2","ingress":[{"namespace":"edge-system","port":12347,"process":"traefik-public","rule":"tier-proxy"},{"namespace":"observability-system","port":12345,"process":"prometheus","rule":"metrics-stack"},{"consumes":"alloy.http","port":12345,"rule":"consumer"},{"consumes":"alloy.faro","port":12347,"rule":"consumer"}],"lifecycle":"application","liveness":{"failures":3,"path":"/-/ready","period":"10s","port":12345,"timeout":"5s"},"memory":"1Gi","name":"alloy","placement":{"eligibleNodes":["enschede-gtx-960m-1","enschede-t1000-1","enschede-pi-1","enschede-pi-2","enschede-pi-3"]},"priorityClass":"platform-critical-app","readiness":{"failures":3,"path":"/-/ready","period":"10s","port":12345,"timeout":"5s"},"replicas":1,"runtime":"none","startup":{"failures":6,"path":"/-/ready","period":"5s","port":12345,"timeout":"5s"},"surfaces":[{"name":"http","port":12345},{"name":"faro","port":12347}],"switchover":"stop-start","uid":473,"writablePaths":[{"path":"/var/lib/alloy/data","size":"64Mi"}]}],"project":"observability","provenance":{"inputDigests":[{"digest":"sha256:65310020392340fc3f120a6a2fecc10dd7d376449748bcbea3661216ca8a12d0","input":"intent-fragment","name":"arr"},{"digest":"sha256:002ac73d31c2a24d3488f92833f2114cc89595b2a21a6a71cd69675304cb8e4a","input":"intent-fragment","name":"auth"},{"digest":"sha25