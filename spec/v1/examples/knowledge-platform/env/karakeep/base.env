# karakeep. meilisearch and chrome share the pod's environment and answer on
# localhost.
NEXTAUTH_SECRET=${secret:secret/data/platform/karakeep#nextauth-secret}
NEXTAUTH_URL=${exposure:karakeep.public#url}
DATA_DIR=/data
MEILI_ADDR=http://localhost:7700
MEILI_MASTER_KEY=${secret:secret/data/platform/karakeep#meili-master-key}
MEILI_NO_ANALYTICS=true
BROWSER_WEB_URL=http://localhost:9222

# Tagging and summaries, through OpenRouter.
OPENAI_API_KEY=${secret:secret/data/platform/karakeep#openrouter-api-key}
OPENAI_API_BASE=https://eu.openrouter.ai/api/v1
INFERENCE_TEXT_MODEL=mistralai/mistral-small-2603
INFERENCE_CONTEXT_LENGTH=2048
INFERENCE_ENABLE_AUTO_TAGGING=true
INFERENCE_ENABLE_AUTO_SUMMARIZATION=true

# Assets in the object store's bucket, with the key the edge derives.
ASSET_STORE_S3_ENDPOINT=${dependency:platform-garage.endpoint}
ASSET_STORE_S3_REGION=garage
ASSET_STORE_S3_BUCKET=knowledge-platform-assets
ASSET_STORE_S3_FORCE_PATH_STYLE=true
ASSET_STORE_S3_ACCESS_KEY_ID=${dependency:platform-garage.accessKeyId}
ASSET_STORE_S3_SECRET_ACCESS_KEY=${dependency:platform-garage.secretAccessKey}
