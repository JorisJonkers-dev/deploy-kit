# The language model hindsight reasons with, through OpenRouter.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=https://eu.openrouter.ai/api/v1
HINDSIGHT_API_LLM_MODEL=mistralai/mistral-small-2603
HINDSIGHT_API_LLM_API_KEY=${secret:secret/data/platform/hindsight#llm-api-key}

# The embedding model, the Application's own tei-embedding Process. Its URL
# and the database URL are composed of two coordinates each, which no env value
# can say (RENDER-GAPS.md); the edges are the coordinates' only home here.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=tei

# The API serves; the worker Process runs the queue.
HINDSIGHT_API_WORKER_ENABLED=false
HINDSIGHT_API_PORT=8888
