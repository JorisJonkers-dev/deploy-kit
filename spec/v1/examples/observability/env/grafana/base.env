# grafana signs people in itself, as a native Client of the Identity Provider.
# Everything it needs to know about that Client is a placeholder: the Issuer is
# the Platform document's, the Client id is the Application Id, and the secret
# is read from the credential path the Client derives, which the provider
# writes (spec/v1/17-sign-in.md#credentials-and-placeholders).

GF_SERVER_ROOT_URL=${exposure:grafana.public#url}
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=jorisjonkers.dev
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=${client:id}
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=${client:secret}
GF_AUTH_GENERIC_OAUTH_AUTH_URL=${client:issuer}/oauth2/authorize
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=${client:issuer}/oauth2/token
GF_AUTH_GENERIC_OAUTH_API_URL=${client:issuer}/userinfo
GF_AUTH_GENERIC_OAUTH_SCOPES=openid,profile,email
GF_AUTH_DISABLE_LOGIN_FORM=true
