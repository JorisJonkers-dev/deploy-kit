{"apiVersion":"intent.jorisjonkers.dev/v1","applications":[{"id":"flagger","processes":[{"api":{"reason":"Flagger switches every blue-green Process, so it scales its Deployment, generates its Services and copies, and records the Canary","rules":[{"group":"flagger.app","objects":["canaries","canaries/status"],"verbs":["get","list","watch","update","patch"]},{"group":"apps","objects":["deployments"],"verbs":["get","list","watch","create","update","patch","delete"]},{"group":"autoscaling","objects":["horizontalpodautoscalers"],"verbs":["get","list","watch","create","update","patch","delete"]},{"group":"core","objects":["services","configmaps"],"verbs":["get","list","watch","create","update","patch","delete"]},{"group":"core","objects":["secrets"],"verbs":["get"]},{"group":"core","objects":["events"],"verbs":["create","update","patch"]}]},"cutover":"continuous","dependsOn":[{"application":"release-gate","surface":"http"}],"image":"flagger","lifecycle":"application","name":"flagger","placement":{"cpu":"10m","memory":"64Mi"},"probes":{"liveness":{"path":"/healthz","port":8080},"readiness":{"path":"/healthz","port":8080}},"provides":{"http":8080},"runtime":"none","startupBudget":"30s","writablePaths":["/tmp"]}]},{"id":"release-gate","processes":[{"api":{"reason":"the Release Gate answers Flagger from what the cluster holds, so it reads each gated Application's inputs, Canaries, Deployments, Jobs and pods, and writes nothing","rules":[{"group":"core","objects":["configmaps"],"verbs":["get"]},{"group":"core","objects":["pods"],"verbs":["list"]},{"group":"apps","objects":["deployments"],"verbs":["get"]},{"group":"batch","objects":["jobs"],"verbs":["list"]},{"group":"flagger.app","objects":["canaries"],"verbs":["get"]}]},"cutover":"continuous","image":"release-gate","lifecycle":"application","name":"release-gate","placement":{"cpu":"25m","memory":"64Mi"},"probes":{"liveness":{"path":"/healthz","port":8080},"readiness":{"path":"/readyz","port":8080}},"provides":{"http":8080},"runtime":"none","startupBudget":"10s"}]},{"id":"collector","processes":[{"api":{"reason":"the Collector captures where each bound claim and each rendered pod is, so it lists the three kinds that say so, cluster-wide, and writes nothing","rules":[{"group":"core","objects":["persistentvolumes","persistentvolumeclaims","pods"],"verbs":["get","list"]}]},"cutover":"interrupted","image":"collector","lifecycle":"application","name":"collector","placement":{"cpu":"10m","memory":"64Mi"},"probes":{"liveness":{"path":"/fresh","port":8080},"readiness":{"path":"/readyz","port":8080}},"provides":{"http":8080},"runtime":"none","startupBudget":"10s"}]}],"kind":"Project","owner":"joris","project":"delivery","schemaVersion":"1.0.0"}