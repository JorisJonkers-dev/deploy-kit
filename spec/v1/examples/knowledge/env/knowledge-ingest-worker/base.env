# applications/knowledge/platform/env/knowledge-ingest-worker/base.env
#
# The second Process of the same Application, and therefore the second file:
# Processes of one Application do not share every variable
# (docs/adr/model/0011-configuration-env-files-per-process.md). What they do
# share is one directory up, in env/_applications/knowledge/base.env, which is
# where the Postgres and RabbitMQ coordinates and credentials now live: nine
# lines that used to sit in both Process files, identically.
#
# Note what is not here either. The deploy key is a Process-level grant with
# delivery: file, so it has no placeholder at all -- it lands on disk at 0400.

# --- app knobs, none of them shared with the api
INGEST_QUEUE=knowledge.ingest
INGEST_PREFETCH=4
LOG_LEVEL=INFO
