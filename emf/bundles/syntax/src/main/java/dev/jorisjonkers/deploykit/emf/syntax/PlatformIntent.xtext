grammar dev.jorisjonkers.deploykit.emf.syntax.PlatformIntent with dev.jorisjonkers.deploykit.emf.syntax.ProjectIntent
	hidden(WS, SL_COMMENT)

import "https://jorisjonkers.dev/deploy-kit/project-intent/1"
import "http://www.eclipse.org/emf/2002/Ecore" as ecore

// The Platform document, in the YAML subset the project language reads: its
// terminals, its block tokens and its scalars are inherited, and only the
// document's own rules are here. A policy keyed by a closed vocabulary is a
// block with one optional key per literal, so a missing policy is an absent key.

Platform returns Platform:
	(('apiVersion' ':' apiVersion=Text)
	& ('kind' ':' kind=Text)
	& ('schemaVersion' ':' schemaVersion=Text)
	& ('owner' ':' owner=Text)
	& ('metadata' ':' BEGIN metadata=PlatformMetadata END)
	& ('substrate' ':' BEGIN substrate=Substrate END)
	& ('bootstrap' ':' BEGIN bootstrap=Bootstrap END)
	& ('tiers' ':' BEGIN (DASH BEGIN tiers+=Tier END)+ END)
	& ('durability' ':' BEGIN durability=DurabilityPolicies END)
	& ('engines' ':' BEGIN engines=EnginePolicies END)
	& ('monitors' ':' BEGIN monitors=MonitorCadence END)
	& ('telemetry' ':' BEGIN telemetry=TelemetryPolicy END)?
	& ('secretStore' ':' secretStore=[Application|Text])?
	& ('hardening' ':' hardening=HardeningClass)
	& ('probes' ':' BEGIN probes=ProbeCadence END)
	& ('ephemeral' ':' BEGIN ephemeral=EphemeralPolicy END)
	& ('migration' ':' BEGIN migration=MigrationPolicy END)?
	& ('delivery' ':' BEGIN delivery=DeliveryPolicy END)?
	& ('apiAccess' ':' BEGIN apiAccess=ApiAccessPolicy END)?
	& ('policyJob' ':' BEGIN policyJob=VaultPolicyJob END)?
	& ('handover' ':' BEGIN handover=HandoverLedger END)?
	& ('providers' ':' BEGIN (DASH BEGIN providers+=Provider END)+ END)?
	& ('libraries' ':' BEGIN libraries+=Library+ END)?
	& ('gpus' ':' BEGIN gpus+=GpuVendor+ END)?
	& ('vpn' ':' BEGIN vpn=VpnPolicy END)?
	& ('monitoring' ':' BEGIN monitoring=Monitoring END)?
	& ('signIn' ':' BEGIN signIn=SignIn END)?
	& ('mesh' ':' BEGIN mesh=Mesh END)?
	& ('seeder' ':' BEGIN seeder=Seeder END)?
	& ('nodeAgents' ':' BEGIN nodeAgents=NodeAgents END)?
	& ('acme' ':' BEGIN acme=AcmePolicy END)?
	& ('humanGrants' ':' BEGIN (DASH BEGIN humanGrants+=HumanGrant END)+ END)?
	& ('priority' ':' BEGIN priority=PriorityPolicy END)?
	& ('l4Addresses' ':' BEGIN l4Addresses+=L4Address+ END)?);

PlatformMetadata returns PlatformMetadata:
	(('cluster' ':' cluster=Text)
	& ('project' ':' project=Text)
	& ('nodeContract' ':' nodeContract=Text));

Substrate returns Substrate:
	(('kubernetesVersion' ':' kubernetesVersion=Text)
	& ('datastore' ':' datastore=Datastore)
	& ('serverCount' ':' serverCount=Port)
	& ('secretsEncryption' ':' secretsEncryption=Bool)
	& ('cni' ':' cni=Text)
	& ('networkPolicyController' ':' networkPolicyController=PolicyController)
	& ('clusterDns' ':' clusterDns=Text)
	& ('imagePull' ':' imagePull=Text)?
	& ('upstreamNameservers' ':' BEGIN (DASH BEGIN upstreamNameservers+=Text END | upstreamNameservers+=Text)+ END)?);

Bootstrap returns Bootstrap:
	(('k3s' ':' BEGIN k3s=K3sInstall END)?
	& ('flux' ':' BEGIN flux=FluxSource END)
	& ('vault' ':' BEGIN vault=VaultState END)
	& ('crds' ':' BEGIN (DASH BEGIN crds+=Text END | crds+=Text)+ END));

// Where k3s serves its own metrics: each component the set records is scraped.
K3sInstall returns K3sInstall:
	'metrics' ':' BEGIN metrics=K3sMetrics END;

K3sMetrics returns K3sMetrics:
	{K3sMetrics}
	(('kubelet' ':' BEGIN kubelet=KubeletMetrics END)?
	& ('apiServer' ':' BEGIN apiServer=ApiServerMetrics END)?
	& ('coreDns' ':' BEGIN coreDns=CoreDnsMetrics END)?);

KubeletMetrics returns KubeletMetrics:
	'port' ':' port=Port;

ApiServerMetrics returns ApiServerMetrics:
	(('service' ':' service=Text)
	& ('port' ':' port=Text));

CoreDnsMetrics returns CoreDnsMetrics:
	'port' ':' port=Port;

HandoverLedger returns HandoverLedger:
	(('retireBy' ':' retireBy=Text)
	& ('legacy' ':' BEGIN (DASH BEGIN legacy+=Text END | legacy+=Text)+ END)?
	& ('estate' ':' BEGIN (DASH BEGIN estate+=Text END | estate+=Text)+ END)?
	& ('serving' ':' BEGIN (DASH BEGIN serving+=ServingLocation END)+ END)?);

ServingLocation returns ServingLocation:
	(('application' ':' application=Text)
	& ('namespace' ':' namespace=Text)
	& ('instance' ':' instance=Text)?
	& ('admin' ':' BEGIN admin=AdminCredential END)?);

// Where the old path keeps a datastore's administrative login: a user and password, or a token.
// Spelled out key order by key order: both open on `path`.
AdminCredential returns AdminCredential:
	{AdminLogin} 'path' ':' path=Text 'user' ':' user=Text 'password' ':' password=Text
	| {AdminLogin} 'path' ':' path=Text 'password' ':' password=Text 'user' ':' user=Text
	| {AdminLogin} 'user' ':' user=Text 'path' ':' path=Text 'password' ':' password=Text
	| {AdminLogin} 'user' ':' user=Text 'password' ':' password=Text 'path' ':' path=Text
	| {AdminLogin} 'password' ':' password=Text 'path' ':' path=Text 'user' ':' user=Text
	| {AdminLogin} 'password' ':' password=Text 'user' ':' user=Text 'path' ':' path=Text
	| {AdminToken} 'path' ':' path=Text 'token' ':' token=Text
	| {AdminToken} 'token' ':' token=Text 'path' ':' path=Text;

FluxSource returns FluxSource:
	(('sourceRef' ':' sourceRef=Text)
	& ('artifacts' ':' BEGIN artifacts=RenderedArtifacts END)
	& ('metrics' ':' BEGIN metrics=FluxMetrics END)?);

// Where Flux's controllers serve their metrics, as its install sets them.
FluxMetrics returns FluxMetrics:
	(('port' ':' port=Port)
	& ('path' ':' path=Text));

RenderedArtifacts returns RenderedArtifacts:
	(('repository' ':' repository=Text)
	& ('signer' ':' BEGIN signer=ArtifactSigner END)
	& ('pullSecret' ':' pullSecret=Text)?);

ArtifactSigner returns ArtifactSigner:
	(('issuer' ':' issuer=Text)
	& ('subject' ':' subject=Text));

VaultState returns VaultState:
	'unsealed' ':' unsealed=Bool;

// A tier's proxy is an Application a project file declares: a reference into
// another document, linked across the set of documents read together.
Tier returns Tier:
	(('name' ':' name=Text)
	& ('audiences' ':' BEGIN (DASH BEGIN audiences+=Audience END | audiences+=Audience)+ END)
	& ('listener' ':' listener=Listener)
	& ('certificates' ':' certificates=CertificateSource)
	& ('certificateFrom' ':' certificateFrom=Text)?
	& ('forwardAuth' ':' BEGIN forwardAuth=ForwardAuth END)?
	& ('proxiedBy' ':' proxiedBy=ProxiedBy)?
	& ('traefik' ':' traefik=[Application|Text])
	& ('ingressClass' ':' ingressClass=Text)?
	& ('dns' ':' BEGIN dns=TierDns END)?
	& ('address' ':' address=Text)?);

// The sign-in provider's endpoint a tier asks before a gated route.
ForwardAuth returns ForwardAuth:
	(('provider' ':' provider=[Application|Text])
	& ('surface' ':' surface=Text)
	& ('path' ':' path=Text)
	& ('responseHeaders' ':' BEGIN (DASH BEGIN responseHeaders+=Text END | responseHeaders+=Text)+ END)?);

TierDns returns TierDns:
	(('target' ':' target=Text)
	& ('proxied' ':' proxied=Bool)
	& ('direct' ':' direct=Text)?);

DurabilityPolicies returns DurabilityPolicies:
	{DurabilityPolicies}
	(('reconstructible' ':' BEGIN reconstructible=DurabilityPolicy END)?
	& ('recoverable' ':' BEGIN recoverable=DurabilityPolicy END)?
	& ('irreplaceable' ':' BEGIN irreplaceable=DurabilityPolicy END)?);

DurabilityPolicy returns DurabilityPolicy:
	{DurabilityPolicy}
	(('schedule' ':' schedule=Text)?
	& ('retain' ':' retain=Port)?
	& ('offCluster' ':' BEGIN offCluster=OffClusterCopy END)?);

OffClusterCopy returns OffClusterCopy:
	(('destination' ':' destination=Text)
	& ('credential' ':' credential=Text)
	& ('recipient' ':' recipient=Text)
	& ('egress' ':' BEGIN (DASH BEGIN egress+=DestinationRange END)+ END));

// Where an off-cluster copy goes, as a network policy can say it: a range and a port.
DestinationRange returns DestinationRange:
	(('cidr' ':' cidr=Text)
	& ('port' ':' port=Port));

EnginePolicies returns EnginePolicies:
	{EnginePolicies}
	(('postgres' ':' BEGIN postgres=EnginePolicy END)?
	& ('rabbitmq' ':' BEGIN rabbitmq=EnginePolicy END)?
	& ('valkey' ':' BEGIN valkey=EnginePolicy END)?
	& ('mongo' ':' BEGIN mongo=EnginePolicy END)?
	& ('files' ':' BEGIN files=EnginePolicy END)?
	& ('s3' ':' BEGIN s3=EnginePolicy END)?);

// The method image, and the surface of the Process it dumps where it dumps over the network; and
// for an engine that owns databases, the method that applies their catalog.
EnginePolicy returns EnginePolicy:
	(('backup' ':' backup=Text)
	& ('surface' ':' surface=Text)?
	& ('catalog' ':' catalog=Text)?
	& ('catalogSurface' ':' catalogSurface=Text)?
	& ('move' ':' BEGIN move=MoveMethod END)?);

MoveMethod returns MoveMethod:
	(('image' ':' image=Text)
	& ('breaksOn' ':' breaksOn=MoveBreak)
	& ('reverse' ':' reverse=MoveReverse));

MonitorCadence returns MonitorCadence:
	(('interval' ':' interval=Text)
	& ('timeout' ':' timeout=Text)
	& ('labels' ':' BEGIN labels+=MonitorLabel+ END)?);

MonitorLabel returns MonitorLabel:
	key=Text ':' value=Text;

// The collector names an Application a project file declares, linked across the
// documents read together, as a tier's proxy is.
TelemetryPolicy returns TelemetryPolicy:
	(('collector' ':' collector=[Application|Text])
	& ('metrics' ':' metrics=[Application|Text])
	& ('dashboards' ':' BEGIN dashboards=DashboardPolicy END)?);

DashboardPolicy returns DashboardPolicy:
	(('instance' ':' BEGIN instance+=DashboardInstance+ END)
	& ('datasource' ':' datasource=Text));

DashboardInstance returns DashboardInstance:
	key=Text ':' value=Text;

ProbeCadence returns ProbeCadence:
	(('period' ':' period=Text)
	& ('timeout' ':' timeout=Text)
	& ('failures' ':' failures=Port));

EphemeralPolicy returns EphemeralPolicy:
	'size' ':' size=Text;

// Who may hold Kubernetes API access, and where the API answers. A holder names an
// Application a project file declares, linked across the documents read together, as the
// machinery is.
ApiAccessPolicy returns ApiAccessPolicy:
	(('holders' ':' BEGIN (DASH BEGIN holders+=[Application|Text] END | holders+=[Application|Text])+ END)
	& ('namespaceHolders' ':' BEGIN (DASH BEGIN namespaceHolders+=[Application|Text] END | namespaceHolders+=[Application|Text])+ END)?
	& ('server' ':' BEGIN (DASH BEGIN server+=DestinationRange END)+ END));

// The machinery names Applications a project file declares, linked across the
// documents read together, as a tier's proxy is.
DeliveryPolicy returns DeliveryPolicy:
	(('machinery' ':' BEGIN (DASH BEGIN machinery+=[Application|Text] END | machinery+=[Application|Text])+ END)
	& ('gate' ':' gate=[Application|Text])
	& ('reporter' ':' reporter=[Application|Text])?
	& ('analysis' ':' BEGIN analysis=AnalysisPolicy END)
	& ('move' ':' BEGIN move=MovePolicy END)?);

MovePolicy returns MovePolicy:
	(('timeout' ':' timeout=Text)
	& ('retention' ':' retention=Text)
	& ('memory' ':' memory=Text)
	& ('cpu' ':' cpu=Text));

AnalysisPolicy returns AnalysisPolicy:
	(('interval' ':' interval=Text)
	& ('iterations' ':' iterations=Port)
	& ('threshold' ':' threshold=Port)
	& ('errorRate' ':' errorRate=Text)
	& ('latency' ':' latency=Text));

MigrationPolicy returns MigrationPolicy:
	(('runner' ':' runner=Text)
	& ('deadline' ':' deadline=Text)
	& ('memory' ':' memory=Text)
	& ('cpu' ':' cpu=Text));

// The job that writes the rendered Vault policies and auth roles into the Secret Store: its
// image alias, the Vault role it logs in as, what it requests and how long it may take.
VaultPolicyJob returns VaultPolicyJob:
	(('image' ':' image=Text)
	& ('role' ':' role=Text)
	& ('memory' ':' memory=Text)
	& ('cpu' ':' cpu=Text)
	& ('deadline' ':' deadline=Text));

Provider returns Provider:
	(('name' ':' name=Text)
	& ('address' ':' address=Text)
	& ('surfaces' ':' BEGIN surfaces+=ProviderSurface+ END));

ProviderSurface returns ProviderSurface:
	key=Text ':' value=Port;

// A directory on one node, keyed by the library's name, and the projects it is granted to.
Library returns Library:
	key=Text ':' BEGIN value=LibraryDeclaration END;

LibraryDeclaration returns LibraryDeclaration:
	(('node' ':' node=Text)
	& ('path' ':' path=Text)
	& ('gid' ':' gid=Port)
	& ('grants' ':' BEGIN grants+=LibraryGrant+ END));

LibraryGrant returns LibraryGrant:
	key=Text ':' value=LibraryAccess;

// What a Process that requires a GPU of one vendor is handed, keyed by the vendor.
GpuVendor returns GpuVendor:
	key=Text ':' BEGIN value=GpuVendorPolicy END;

GpuVendorPolicy returns GpuVendorPolicy:
	(('resource' ':' resource=Text)
	& ('runtimeClass' ':' runtimeClass=Text));

// The VPN beside every attached Process: its image, credential, quantities and literal settings.
VpnPolicy returns VpnPolicy:
	(('image' ':' image=Text)
	& ('credential' ':' credential=Text)
	& ('memory' ':' memory=Text)
	& ('cpu' ':' cpu=Text)
	& ('settings' ':' BEGIN settings+=VpnSetting+ END)?);

VpnSetting returns VpnSetting:
	key=Text ':' value=Text;

// The monitoring stack and where its alerts go.
Monitoring returns Monitoring:
	(('grafana' ':' grafana=[Application|Text])
	& ('prometheus' ':' prometheus=[Application|Text])
	& ('alertmanager' ':' alertmanager=[Application|Text])
	& ('stores' ':' BEGIN stores=MonitoringStores END)?
	& ('receivers' ':' BEGIN (DASH BEGIN receivers+=Receiver END)+ END)
	& ('routes' ':' BEGIN (DASH BEGIN routes+=SeverityRoute END)+ END));

// The stores Grafana reads beside the stack.
MonitoringStores returns MonitoringStores:
	{MonitoringStores}
	(('loki' ':' loki=[Application|Text])?
	& ('tempo' ':' tempo=[Application|Text])?
	& ('pyroscope' ':' pyroscope=[Application|Text])?);

Receiver returns Receiver:
	(('name' ':' name=Text)
	& ('discord' ':' BEGIN discord=DiscordReceiver END));

DiscordReceiver returns DiscordReceiver:
	'webhook' ':' BEGIN webhook=VaultValue END;

VaultValue returns VaultValue:
	(('path' ':' path=Text)
	& ('key' ':' key=Text));

SeverityRoute returns SeverityRoute:
	(('severity' ':' severity=Text)
	& ('receiver' ':' receiver=Text)
	& ('repeat' ':' repeat=Text));

SignIn returns SignIn:
	(('issuer' ':' issuer=Text)
	& ('provider' ':' provider=[Application|Text])
	& ('contract' ':' contract=Text)?);

Mesh returns Mesh:
	'enrolled' ':' BEGIN (DASH BEGIN enrolled+=Text END | enrolled+=Text)+ END;

Seeder returns Seeder:
	(('image' ':' image=Text)
	& ('memory' ':' memory=Text)
	& ('cpu' ':' cpu=Text));

NodeAgents returns NodeAgents:
	{NodeAgents}
	(('gpu-device' ':' BEGIN gpuDevice=NodeAgentPolicy END)?
	& ('gpu-metrics' ':' BEGIN gpuMetrics=NodeAgentPolicy END)?
	& ('node-metrics' ':' BEGIN nodeMetrics=NodeAgentPolicy END)?
	& ('l4-speaker' ':' BEGIN l4Speaker=SpeakerPolicy END)?);

NodeAgentPolicy returns NodeAgentPolicy:
	(('image' ':' image=Text)
	& ('memory' ':' memory=Text)
	& ('cpu' ':' cpu=Text));

SpeakerPolicy returns SpeakerPolicy:
	(('image' ':' image=Text)
	& ('memory' ':' memory=Text)
	& ('cpu' ':' cpu=Text)
	& ('controller' ':' BEGIN controller=NodeAgentPolicy END));

AcmePolicy returns AcmePolicy:
	(('email' ':' email=Text)
	& ('dnsProvider' ':' dnsProvider=DnsProvider)
	& ('token' ':' token=Text));

HumanGrant returns HumanGrant:
	(('group' ':' group=Text)
	& ('clusterRole' ':' clusterRole=HumanGrantRole)
	& ('reason' ':' reason=Text));

PriorityPolicy returns PriorityPolicy:
	(('data' ':' BEGIN data=PriorityClass END)
	& ('critical' ':' BEGIN critical=PriorityClass END)
	& ('criticalApplications' ':' BEGIN (DASH BEGIN criticalApplications+=[Application|Text] END | criticalApplications+=[Application|Text])+ END)?);

PriorityClass returns PriorityClass:
	(('name' ':' name=Text)
	& ('value' ':' value=Port));

// An address an L4 port is served on, keyed by its name: a range of a site's pool, or one node's.
L4Address returns L4Address:
	key=Text ':' BEGIN value=L4AddressDeclaration END;

// Spelled out key order by key order: `kind` says which, wherever it is written.
L4AddressDeclaration returns L4AddressDeclaration:
	{PoolAddress} 'kind' ':' kind='pool' 'site' ':' site=Text 'range' ':' range=Text
	| {PoolAddress} 'kind' ':' kind='pool' 'range' ':' range=Text 'site' ':' site=Text
	| {PoolAddress} 'site' ':' site=Text 'kind' ':' kind='pool' 'range' ':' range=Text
	| {PoolAddress} 'site' ':' site=Text 'range' ':' range=Text 'kind' ':' kind='pool'
	| {PoolAddress} 'range' ':' range=Text 'kind' ':' kind='pool' 'site' ':' site=Text
	| {PoolAddress} 'range' ':' range=Text 'site' ':' site=Text 'kind' ':' kind='pool'
	| {NodeAddress} 'kind' ':' kind='node' 'node' ':' node=Text
	| {NodeAddress} 'node' ':' node=Text 'kind' ':' kind='node';

// Every keyword this document adds is also a scalar, as the project language's are.
@Override
Text returns ecore::EString:
	SCALAR | STRING | INT | Keyword | PlatformKeyword;

PlatformKeyword:
	'acme' | 'alertmanager' | 'always' | 'analysis' | 'apiAccess' | 'apiServer' | 'artifacts' | 'audiences' | 'backup' |
	'bootstrap' | 'breaksOn' | 'catalog' | 'catalogSurface' | 'certificateFrom' | 'certificates' | 'cidr' | 'cloudflare' |
	'cluster-admin' | 'clusterDns' | 'clusterRole' | 'cni' | 'collector' | 'contract' | 'controller' | 'coreDns' | 'crds' |
	'critical' | 'criticalApplications' | 'data' | 'datasource' | 'datastore' | 'deadline' | 'destination' | 'direct' |
	'discord' | 'dns' | 'dnsProvider' | 'edit' | 'email' | 'embedded' | 'engines' | 'enrolled' | 'ephemeral' |
	'errorRate' | 'estate' | 'etcd' | 'failures' | 'flux' | 'forwardAuth' | 'gate' | 'gid' | 'gpu-device' | 'gpu-metrics' |
	'gpus' | 'grafana' | 'grants' | 'handover' | 'hardening' | 'holders' | 'humanGrants' | 'imagePull' | 'ingressClass' |
	'instance' | 'interval' | 'issuer' | 'iterations' | 'k3s' | 'kubelet' | 'kubernetesVersion' | 'l4-speaker' |
	'l4Addresses' | 'labels' | 'latency' | 'legacy' | 'listener' | 'loki' | 'machinery' | 'major' | 'mesh' | 'metadata' |
	'metrics' | 'minor' | 'monitoring' | 'monitors' | 'move' | 'namespaceHolders' | 'networkPolicyController' | 'never' |
	'node-metrics' | 'nodeAgents' | 'nodeContract' | 'offCluster' | 'password' | 'period' | 'plain' | 'policyJob' |
	'pool' | 'priority' | 'prometheus' | 'provider' | 'providers' | 'proxiedBy' | 'pullSecret' | 'pyroscope' | 'range' |
	'receiver' | 'receivers' | 'recipient' | 'repeat' | 'reporter' | 'repository' | 'resource' | 'responseHeaders' |
	'restricted' | 'retain' | 'retention' | 'retireBy' | 'reverse' | 'runner' | 'runtimeClass' | 'same-major' |
	'secretsEncryption' | 'secretStore' | 'seeder' | 'server' | 'serverCount' | 'service' | 'serving' | 'settings' |
	'severity' | 'signer' | 'sourceRef' | 'sqlite' | 'stores' | 'subject' | 'substrate' | 'surfaces' | 'target' |
	'telemetry' | 'tempo' | 'threshold' | 'tiers' | 'timeout' | 'tls' | 'traefik' | 'unsealed' | 'upstreamNameservers' |
	'user' | 'value' | 'vault' | 'view' | 'webhook';

enum Datastore returns Datastore:
	sqlite='sqlite' | etcd='etcd';

enum PolicyController returns PolicyController:
	none='none' | embedded='embedded' | cni='cni';

enum ProxiedBy returns ProxiedBy:
	cloudflare='cloudflare';

enum Listener returns Listener:
	tls='tls' | plain='plain';

enum CertificateSource returns CertificateSource:
	acme='acme' | none='none';

enum DnsProvider returns DnsProvider:
	cloudflare='cloudflare';

enum HumanGrantRole returns HumanGrantRole:
	clusterAdmin='cluster-admin' | admin='admin' | edit='edit' | view='view';

enum MoveBreak returns MoveBreak:
	major='major' | minor='minor';

enum MoveReverse returns MoveReverse:
	always='always' | sameMajor='same-major' | never='never';

enum HardeningClass returns HardeningClass:
	restricted='restricted';
