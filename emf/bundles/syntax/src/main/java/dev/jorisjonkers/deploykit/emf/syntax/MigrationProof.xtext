grammar dev.jorisjonkers.deploykit.emf.syntax.MigrationProof with dev.jorisjonkers.deploykit.emf.syntax.ProjectIntent
	hidden(WS, SL_COMMENT)

import "https://jorisjonkers.dev/deploy-kit/pinned-inputs/1"
import "http://www.eclipse.org/emf/2002/Ecore" as ecore

// The migration proof an Application's CI writes beside the project file, in the
// YAML subset the project language reads.

MigrationProof returns MigrationProof:
	(('apiVersion' ':' apiVersion=Text)
	& ('kind' ':' kind=Text)
	& ('schemaVersion' ':' schemaVersion=Text)
	& ('applications' ':' BEGIN (DASH BEGIN applications+=ProvenApplication END)* END));

ProvenApplication returns ProvenApplication:
	(('id' ':' id=Text)
	& ('testedAgainst' ':' testedAgainst=Text)?
	& ('nonTransactional' ':' nonTransactional=Bool));

// Every keyword this document adds is also a scalar, as the project language's are.
@Override
Text returns ecore::EString:
	SCALAR | STRING | INT | Keyword | MigrationProofKeyword;

MigrationProofKeyword:
	'nonTransactional' | 'testedAgainst';
