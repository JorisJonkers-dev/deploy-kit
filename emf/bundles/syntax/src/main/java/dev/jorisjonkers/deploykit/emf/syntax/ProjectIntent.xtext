grammar dev.jorisjonkers.deploykit.emf.syntax.ProjectIntent hidden(WS, SL_COMMENT)

import "https://jorisjonkers.dev/deploy-kit/project-intent/1"
import "http://www.eclipse.org/emf/2002/Ecore" as ecore

// The YAML subset the authored project files use. Block structure arrives as
// the synthetic BEGIN and END tokens the blocks package produces, so an
// indented block, a flow mapping and a flow sequence parse through one rule.
// Keys are unordered groups, because the order of keys in a mapping is not
// meaning. A union in the model is a union here.

Project returns Project:
	(('apiVersion' ':' apiVersion=Text)
	& ('kind' ':' kind=Text)
	& ('schemaVersion' ':' schemaVersion=Text)
	& ('project' ':' project=Text)
	& ('owner' ':' owner=Text)
	& ('secrets' ':' BEGIN (DASH BEGIN secrets+=Grant END)+ END)?
	& ('dependsOn' ':' BEGIN (DASH BEGIN dependsOn+=DependencyEdge END)+ END)?
	& ('assets' ':' BEGIN (DASH BEGIN assets+=AssetDeclaration END)+ END)?
	& ('writablePaths' ':' BEGIN (DASH BEGIN writablePaths+=WritablePath END | writablePaths+=PlainPath | BEGIN writablePaths+=MemoryPath END)+ END)?
	& ('placement' ':' BEGIN placement=Placement END)?
	& ('startupBudget' ':' startupBudget=Text)?
	& ('cutover' ':' cutover=Cutover)?
	& ('applications' ':' BEGIN (DASH BEGIN applications+=Application END)+ END));

Application returns Application:
	(('id' ':' id=Text)
	& ('description' ':' description=Text)?
	& ('client' ':' BEGIN client=Client END)?
	& ('l4Exposure' ':' BEGIN (DASH BEGIN l4Exposure+=L4Exposure END | BEGIN l4Exposure+=L4Exposure END)+ END)?
	& ('dashboards' ':' BEGIN (DASH BEGIN dashboards+=Dashboard END | BEGIN dashboards+=Dashboard END)+ END)?
	& ('alertRules' ':' BEGIN (DASH BEGIN alertRules+=AlertRules END | BEGIN alertRules+=AlertRules END)+ END)?
	& ('migration' ':' migration=Migration)?
	& ('observability' ':' BEGIN observability=Observability END)?
	& ('exposure' ':' BEGIN (DASH BEGIN exposure+=Exposure END)+ END)?
	& ('secrets' ':' BEGIN (DASH BEGIN secrets+=Grant END)+ END)?
	& ('dependsOn' ':' BEGIN (DASH BEGIN dependsOn+=DependencyEdge END)+ END)?
	& ('assets' ':' BEGIN (DASH BEGIN assets+=AssetDeclaration END)+ END)?
	& ('writablePaths' ':' BEGIN (DASH BEGIN writablePaths+=WritablePath END | writablePaths+=PlainPath | BEGIN writablePaths+=MemoryPath END)+ END)?
	& ('placement' ':' BEGIN placement=Placement END)?
	& ('startupBudget' ':' startupBudget=Text)?
	& ('cutover' ':' cutover=Cutover)?
	& ('processes' ':' BEGIN (DASH BEGIN processes+=Process END)+ END));

Observability returns Observability:
	'scrape' ':' BEGIN scrape=Scrape END;

// How an Application signs its users in through the platform's provider.
Client returns Client:
	(('signIn' ':' signIn=SignInMode)
	& ('exposure' ':' exposure=Text)?
	& ('label' ':' label=Text)?
	& ('description' ':' description=Text)?
	& ('iconPath' ':' iconPath=Text)?
	& ('launchPath' ':' launchPath=Text)?
	& ('redirectPaths' ':' BEGIN (DASH BEGIN redirectPaths+=Text END | redirectPaths+=Text)+ END)?
	& ('protectedPath' ':' protectedPath=Text)?
	& ('backChannelLogoutPath' ':' backChannelLogoutPath=Text)?
	& ('credential' ':' credential=ClientCredential)?
	& ('roles' ':' BEGIN (DASH BEGIN roles+=Text END | roles+=Text)+ END)?);

L4Exposure returns L4Exposure:
	(('address' ':' address=Text)
	& ('port' ':' port=Port)
	& ('protocol' ':' protocol=L4Protocol)
	& ('process' ':' process=[Process|Text])
	& ('surface' ':' surface=[Surface|Text]));

Dashboard returns Dashboard:
	'from' ':' from=Text;

AlertRules returns AlertRules:
	'from' ':' from=Text;

Scrape returns Scrape:
	(('process' ':' process=[Process|Text])
	& ('surface' ':' surface=[Surface|Text])
	& ('path' ':' path=Text));

Exposure returns Exposure:
	(('name' ':' name=Text)
	& ('host' ':' host=Text)
	& ('audience' ':' audience=Audience)
	& ('contentPolicy' ':' contentPolicy=ContentPolicy)?
	& ('proxied' ':' proxied=Bool)?
	& ('routes' ':' BEGIN (DASH BEGIN routes+=Route END)+ END));

Route returns Route:
	(('path' ':' path=Text)
	& ('match' ':' match=Match)
	& ('process' ':' process=[Process|Text])
	& ('surface' ':' surface=[Surface|Text])
	& ('audience' ':' audience=Audience)?
	& ('redirectTo' ':' redirectTo=Text)?
	& ('rateLimit' ':' BEGIN rateLimit=RateLimit END)?);

// How many requests one client may send a route over a period.
RateLimit returns RateLimit:
	(('requests' ':' requests=Port)
	& ('per' ':' per=Text));

Process returns Process:
	(('name' ':' name=Text)
	& ('lifecycle' ':' lifecycle=Lifecycle)
	& ('image' ':' image=Text)
	& ('runtime' ':' runtime=Runtime)
	& ('engine' ':' engine=Engine)?
	& ('provides' ':' BEGIN provides+=Surface+ END)?
	& ('placement' ':' BEGIN placement=Placement END)?
	& ('writablePaths' ':' BEGIN (DASH BEGIN writablePaths+=WritablePath END | writablePaths+=PlainPath | BEGIN writablePaths+=MemoryPath END)+ END)?
	& ('sidecars' ':' BEGIN (DASH BEGIN sidecars+=Sidecar END)+ END)?
	& ('dependsOn' ':' BEGIN (DASH BEGIN dependsOn+=DependencyEdge END)+ END)?
	& ('assets' ':' BEGIN (DASH BEGIN assets+=AssetDeclaration END)+ END)?
	& ('probes' ':' probes=ProbePolicy)?
	& ('volumes' ':' BEGIN (DASH BEGIN volumes+=Volume END)+ END)?
	& ('libraries' ':' BEGIN (DASH BEGIN libraries+=LibraryMount END)+ END)?
	& ('replicas' ':' BEGIN replicas=Capacity END)?
	& ('api' ':' BEGIN api=ApiAccess END)?
	& ('egress' ':' BEGIN egress=Egress END)?
	& ('vpn' ':' BEGIN vpn=VpnAttachment END)?
	& ('secrets' ':' BEGIN (DASH BEGIN secrets+=Grant END)+ END)?
	& ('startupBudget' ':' startupBudget=Text)?
	& ('cutover' ':' cutover=Cutover)?
	& ('description' ':' description=Text)?
	& ('schedule' ':' schedule=Text)?
	& ('parked' ':' BEGIN parked=Parked END)?
	& ('command' ':' BEGIN (DASH BEGIN command+=Text END | command+=Text)+ END)?
	& ('args' ':' BEGIN (DASH BEGIN args+=Text END | args+=Text)+ END)?
	& ('spawns' ':' BEGIN (DASH BEGIN spawns+=SpawnTemplate END)+ END)?
	& ('rollback' ':' rollback=Rollback)?);

Parked returns Parked:
	'reason' ':' reason=Text;

Rollback returns Rollback:
	{Rollback} 'forward-only';

// A pod the Process creates through the API, from a template the platform renders.
SpawnTemplate returns SpawnTemplate:
	(('name' ':' name=Text)
	& ('image' ':' image=Text)
	& ('placement' ':' BEGIN placement=SpawnPlacement END)
	& ('provides' ':' BEGIN provides+=Surface+ END)?
	& ('dependsOn' ':' BEGIN (DASH BEGIN dependsOn+=DependencyEdge END)+ END)?
	& ('egress' ':' BEGIN egress=Egress END)?);

SpawnPlacement returns SpawnPlacement:
	(('memory' ':' memory=Text)
	& ('cpu' ':' cpu=Text));

// A path the Process may write: plain, or held in memory at a size.
WritablePath returns WritablePathDeclaration:
	PlainPath | MemoryPath;

PlainPath returns PlainPath:
	path=Text;

MemoryPath returns MemoryPath:
	(('path' ':' path=Text)
	& ('memory' ':' memory=Text));

Surface returns Surface:
	key=Text ':' value=Port;

Placement returns Placement:
	(('memory' ':' memory=Text)?
	& ('cpu' ':' cpu=Text)?
	& ('arch' ':' BEGIN (DASH BEGIN arch+=Arch END | arch+=Arch)+ END)?
	& ('site' ':' site=Text)?
	& ('disk' ':' BEGIN disk=DiskRequest END)?
	& ('gpu' ':' BEGIN gpu=GpuRequest END)?
	& ('capabilities' ':' BEGIN (DASH BEGIN capabilities+=Text END | capabilities+=Text)+ END)?);

DiskRequest returns DiskRequest:
	'media' ':' BEGIN (DASH BEGIN media+=Media END | media+=Media)+ END;

// Every term is optional, so `gpu: {}` is any card.
GpuRequest returns GpuRequest:
	{GpuRequest}
	(('class' ':' class=Text)?
	& ('memory' ':' memory=Text)?
	& ('vendor' ':' BEGIN (DASH BEGIN vendor+=Text END | vendor+=Text)+ END)?
	& ('model' ':' BEGIN (DASH BEGIN model+=Text END | model+=Text)+ END)?);

Sidecar returns Sidecar:
	(('name' ':' name=Text)
	& ('image' ':' image=Text)
	& ('command' ':' BEGIN (DASH BEGIN command+=Text END | command+=Text)+ END)?
	& ('args' ':' BEGIN (DASH BEGIN args+=Text END | args+=Text)+ END)?
	& ('memory' ':' memory=Text)
	& ('cpu' ':' cpu=Text)
	& ('volumes' ':' BEGIN (DASH BEGIN volumes+=SidecarMount END | BEGIN volumes+=SidecarMount END)+ END)?
	& ('assets' ':' BEGIN (DASH BEGIN assets+=SidecarAsset END | BEGIN assets+=SidecarAsset END)+ END)?
	& ('init' ':' init=Bool)?);

SidecarMount returns SidecarMount:
	(('claim' ':' claim=Text)
	& ('mountAt' ':' mountAt=Text));

SidecarAsset returns SidecarAsset:
	(('from' ':' from=Text)
	& ('mountAt' ':' mountAt=Text));

DependencyEdge returns DependencyEdge:
	(('application' ':' application=Text)
	& ('surface' ':' surface=Text)
	& ('required' ':' required=Bool)?
	& ('buckets' ':' BEGIN (DASH BEGIN buckets+=Text END | buckets+=Text)+ END)?
	& ('credentials' ':' BEGIN credentials=Credentials END)?);

Credentials returns Credentials:
	(('delivery' ':' delivery=Delivery)?
	& ('mountAt' ':' mountAt=Text)?
	& ('fileMode' ':' fileMode=Text)?
	& ('rotation' ':' BEGIN rotation=Rotation END));

// How an Application's schema moves: `self`, `none`, or a changelog block.
Migration returns Migration:
	SelfMigration | NoMigration | ManagedMigration;

SelfMigration returns SelfMigration:
	{SelfMigration} 'self';

NoMigration returns NoMigration:
	{NoMigration} 'none';

ManagedMigration returns ManagedMigration:
	BEGIN 'changelog' ':' changelog=Text END;

// A file beside the project: mounted read-only, or seeded once onto a volume.
// Spelled out key order by key order: the two kinds share `from`, and only the
// key after it says which one a block is.
AssetDeclaration returns AssetDeclaration:
	{Asset} 'from' ':' from=Text 'mountAt' ':' mountAt=Text
	| {Asset} 'mountAt' ':' mountAt=Text 'from' ':' from=Text
	| {SeededAsset} 'from' ':' from=Text 'seedAt' ':' seedAt=Text
	| {SeededAsset} 'seedAt' ':' seedAt=Text 'from' ':' from=Text;

ProbePolicy returns ProbePolicy:
	NoProbes | Probes;

NoProbes returns NoProbes:
	{NoProbes} 'none';

Probes returns Probes:
	BEGIN
	(('readiness' ':' BEGIN readiness=Probe END)?
	& ('liveness' ':' BEGIN liveness=Probe END)?)
	END;

Probe returns Probe:
	HttpProbe | TcpProbe;

HttpProbe returns HttpProbe:
	(('path' ':' path=Text)
	& ('port' ':' port=Port));

TcpProbe returns TcpProbe:
	'tcp' ':' tcp=Port;

Volume returns Volume:
	(('claim' ':' claim=Text)
	& ('mountAt' ':' mountAt=Text)
	& ('size' ':' size=Text)
	& ('durability' ':' durability=DurabilityClass));

// A library the Platform document grants, mounted by its name.
LibraryMount returns LibraryMount:
	(('library' ':' library=Text)
	& ('mountAt' ':' mountAt=Text)
	& ('subPath' ':' subPath=Text)?
	& ('access' ':' access=LibraryAccess));

Capacity returns Capacity:
	(('count' ':' count=Port)
	& ('reason' ':' reason=Text)
	& ('across' ':' across=Spread)?);

// The Kubernetes API access a Process needs: what it may ask of which objects, and why.
// Whether the provider forwards the attached Process a port.
VpnAttachment returns VpnAttachment:
	'forwardedPort' ':' forwardedPort=Bool;

Egress returns Egress:
	(('to' ':' to=EgressTarget)
	& ('reason' ':' reason=Text));

ApiAccess returns ApiAccess:
	(('reason' ':' reason=Text)
	& ('rules' ':' BEGIN (DASH BEGIN rules+=ApiRule END)+ END)?);

ApiRule returns ApiRule:
	(('group' ':' group=Text)
	& ('objects' ':' BEGIN (DASH BEGIN objects+=Text END | objects+=Text)+ END)
	& ('verbs' ':' BEGIN (DASH BEGIN verbs+=ApiVerb END | verbs+=ApiVerb)+ END)
	& ('scope' ':' scope=ApiScope)?);

Grant returns Grant:
	KvGrant | DatabaseGrant | TransitGrant;

KvGrant returns KvGrant:
	(('path' ':' path=Text)
	& ('keys' ':' BEGIN (DASH BEGIN keys+=KvKey END | keys+=PlainKey | BEGIN keys+=BlockKey END)+ END)
	& ('access' ':' access=AccessTier)
	& ('delivery' ':' delivery=Delivery)
	& ('mountAt' ':' mountAt=Text)?
	& ('fileMode' ':' fileMode=Text)?
	& ('rotation' ':' BEGIN rotation=Rotation END));

// A key is its name, or a block naming it and how the Vault policy job generates it.
KvKey returns KvKey:
	PlainKey | BlockKey;

// A generated key or one the Process starts without when the Secret Store holds no
// value for it, spelled out key order by key order: both open on `name`.
BlockKey returns KvKey:
	{GeneratedKey} 'name' ':' name=Text 'generate' ':' BEGIN ^generate=Generate END
	| {GeneratedKey} 'generate' ':' BEGIN ^generate=Generate END 'name' ':' name=Text
	| {OptionalKey} 'name' ':' name=Text 'optional' ':' optional=Bool
	| {OptionalKey} 'optional' ':' optional=Bool 'name' ':' name=Text;

PlainKey returns PlainKey:
	name=Text;

Generate returns Generate:
	{Generate}
	(('bytes' ':' bytes=Port)?
	& ('encoding' ':' encoding=KeyEncoding)?
	& ('adopt' ':' adopt=Text)?);

DatabaseGrant returns DatabaseGrant:
	'engine' ':' engine=DatabaseEngine
	(('role' ':' role=Text)
	& ('delivery' ':' delivery=Delivery)
	& ('mountAt' ':' mountAt=Text)?
	& ('fileMode' ':' fileMode=Text)?
	& ('rotation' ':' BEGIN rotation=Rotation END));

TransitGrant returns TransitGrant:
	'engine' ':' engine=TransitEngine
	(('key' ':' key=Text)
	& ('operations' ':' BEGIN (DASH BEGIN operations+=TransitOp END | operations+=TransitOp)+ END)
	& ('delivery' ':' delivery=Delivery)
	& ('mountAt' ':' mountAt=Text)?
	& ('fileMode' ':' fileMode=Text)?
	& ('rotation' ':' BEGIN rotation=Rotation END));

Rotation returns Rotation:
	(('tolerates' ':' tolerates=Tolerance)
	& ('maxAge' ':' maxAge=Text)?);

Port returns ecore::EInt:
	INT;

Bool returns ecore::EBooleanObject:
	'true' | 'false';

// A scalar, quoted, folded or plain. Every keyword above is also a scalar, so a
// value that happens to read like a key is still a value.
Text returns ecore::EString:
	SCALAR | STRING | INT | Keyword;

Keyword:
	'access' | 'across' | 'address' | 'admin' | 'adopt' | 'alertRules' | 'amd64' | 'anonymous' | 'api' | 'apiVersion' |
	'application' | 'applications' | 'arch' | 'args' | 'arm64' | 'assets' | 'audience' | 'authenticated' | 'backChannelLogoutPath' |
	'base64' | 'base64url' | 'buckets' | 'bytes' | 'capabilities' | 'changelog' | 'claim' | 'class' | 'client' | 'cluster' |
	'command' | 'contentPolicy' | 'continuous' | 'count' | 'cpu' | 'create' | 'credential' | 'credentials' | 'custody' | 'cutover' |
	'dashboards' | 'database' | 'decrypt' | 'delete' | 'delivery' | 'dependsOn' | 'description' | 'disk' | 'durability' | 'egress' |
	'encoding' | 'encrypt' | 'engine' | 'env' | 'exact' | 'exposure' | 'false' | 'file' | 'fileMode' | 'files' | 'forward-only' |
	'forwardedPort' | 'from' | 'gated' | 'generate' | 'get' | 'gpu' | 'group' | 'hdd' | 'hex' | 'host' | 'iconPath' | 'id' |
	'image' | 'init' | 'internal' | 'internet' | 'interrupted' | 'irreplaceable' | 'job' | 'jvm' | 'key' | 'keys' | 'kind' | 'kv' |
	'l4Exposure' | 'label' | 'lan' | 'launchPath' | 'libraries' | 'library' | 'lifecycle' | 'list' | 'liveness' | 'match' |
	'maxAge' | 'media' | 'memory' | 'migration' | 'model' | 'mongo' | 'mountAt' | 'name' | 'namespace' | 'native' | 'node' |
	'none' | 'nvme' | 'objects' | 'observability' | 'operations' | 'optional' | 'owner' | 'parked' | 'patch' | 'path' | 'per' |
	'pkce' | 'placement' | 'port' | 'postgres' | 'prefix' | 'prepare' | 'probes' | 'process' | 'processes' | 'project' |
	'protectedPath' | 'protocol' | 'provides' | 'proxied' | 'python' | 'rabbitmq' | 'rateLimit' | 'read' | 'readiness' | 'reason' |
	'reconstructible' | 'recoverable' | 'redirectPaths' | 'redirectTo' | 'reload' | 'replicas' | 'requests' | 'required' |
	'restart' | 'role' | 'roles' | 'rollback' | 'rotate' | 'rotation' | 'routes' | 'rules' | 'runtime' | 's3' | 'schedule' |
	'scheduled' | 'schemaVersion' | 'scope' | 'scrape' | 'secret' | 'secrets' | 'seedAt' | 'self' | 'self-renew' | 'self-roll' |
	'sidecars' | 'sign' | 'signIn' | 'site' | 'size' | 'spawns' | 'ssd' | 'startupBudget' | 'static' | 'strict' | 'subPath' |
	'surface' | 'tcp' | 'to' | 'token' | 'tolerates' | 'transit' | 'true' | 'udp' | 'update' | 'valkey' | 'vendor' | 'verbs' |
	'verify' | 'volumes' | 'vpn' | 'watch' | 'workflow' | 'writablePaths' | 'write';

enum Lifecycle returns Lifecycle:
	application='application' | job='job' | prepare='prepare' | scheduled='scheduled';

enum Runtime returns Runtime:
	jvm='jvm' | python='python' | node='node' | static='static' | none='none';

enum Engine returns Engine:
	postgres='postgres' | rabbitmq='rabbitmq' | valkey='valkey' | mongo='mongo' | files='files' | s3='s3';

enum Cutover returns Cutover:
	continuous='continuous' | interrupted='interrupted';

enum DurabilityClass returns DurabilityClass:
	reconstructible='reconstructible' | recoverable='recoverable' | irreplaceable='irreplaceable';

enum Arch returns Arch:
	amd64='amd64' | arm64='arm64';

enum Media returns Media:
	nvme='nvme' | ssd='ssd' | hdd='hdd';

enum ApiScope returns ApiScope:
	namespace='namespace' | cluster='cluster';

enum Spread returns Spread:
	node='node';

enum L4Protocol returns L4Protocol:
	tcp='tcp' | udp='udp';

enum SignInMode returns SignInMode:
	native='native' | gated='gated' | token='token';

enum ClientCredential returns ClientCredential:
	secret='secret' | pkce='pkce';

enum Audience returns Audience:
	anonymous='anonymous' | authenticated='authenticated' | internal='internal' | lan='lan';

enum ContentPolicy returns ContentPolicy:
	strict='strict' | admin='admin' | workflow='workflow';

enum Match returns Match:
	prefix='prefix' | exact='exact';

enum DatabaseEngine returns DatabaseEngine:
	database='database';

enum TransitEngine returns TransitEngine:
	transit='transit';

enum AccessTier returns AccessTier:
	read='read' | selfRenew='self-renew' | selfRoll='self-roll' | custody='custody';

enum ApiVerb returns ApiVerb:
	get='get' | list='list' | watch='watch' | create='create' | update='update' | patch='patch' | delete='delete';

enum EgressTarget returns EgressTarget:
	internet='internet';

enum LibraryAccess returns LibraryAccess:
	read='read' | write='write';

enum TransitOp returns TransitOp:
	sign='sign' | verify='verify' | encrypt='encrypt' | decrypt='decrypt' | rotate='rotate' | read='read';

enum Delivery returns Delivery:
	env='env' | file='file' | selfDelivery='self';

enum KeyEncoding returns KeyEncoding:
	hex='hex' | base64='base64' | base64url='base64url';

enum Tolerance returns Tolerance:
	restart='restart' | reload='reload';

terminal BEGIN: 'synthetic:BEGIN';
terminal END: 'synthetic:END';

// The block markers the token source rewrites: a dash opens a sequence item, a
// flow collection opens and closes a block on one line, and a fold introduces a
// scalar written over several lines. The parser sees none of them: they arrive
// as BEGIN, END and SCALAR.
terminal DASH: '-';
terminal FLOW_BEGIN: '{';
terminal FLOW_END: '}';
terminal FLOW_SEP: ',';
terminal LIST_BEGIN: '[';
terminal LIST_END: ']';
terminal FOLD: ('>' | '|') '-'?;

terminal INT returns ecore::EInt: ('0'..'9')+;

terminal SCALAR:
	(!(' ' | '\t' | '\r' | '\n' | ':' | ',' | '{' | '}' | '[' | ']' | '#' | '"' | "'" | '-' | '>' | '|')
	| '-' !(' ' | '\t' | '\r' | '\n' | ':' | ',' | '{' | '}' | '[' | ']' | '#' | '"' | "'" | '-' | '>' | '|')
	| '--' !(' ' | '\t' | '\r' | '\n' | ':' | ',' | '{' | '}' | '[' | ']' | '#' | '"' | "'" | '-' | '>' | '|'))
	(!(' ' | '\t' | '\r' | '\n' | ':' | ',' | '{' | '}' | '[' | ']' | '#'))*;

terminal STRING:
	'"' !('"')* '"' | "'" !("'")* "'";

terminal SL_COMMENT: '#' !('\n' | '\r')*;

terminal WS: (' ' | '\t' | '\r' | '\n')+;
