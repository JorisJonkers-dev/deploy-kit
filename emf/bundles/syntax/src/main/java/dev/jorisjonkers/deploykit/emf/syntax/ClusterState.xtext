grammar dev.jorisjonkers.deploykit.emf.syntax.ClusterState with dev.jorisjonkers.deploykit.emf.syntax.ProjectIntent
	hidden(WS, SL_COMMENT)

import "https://jorisjonkers.dev/deploy-kit/pinned-inputs/1"
import "http://www.eclipse.org/emf/2002/Ecore" as ecore

// The ClusterState snapshot, in the YAML subset the project language reads:
// its terminals, its block tokens and its scalars are inherited, as the
// Platform document's are. An empty list is an empty block.

ClusterState returns ClusterState:
	(('apiVersion' ':' apiVersion=Text)
	& ('kind' ':' kind=Text)
	& ('schemaVersion' ':' schemaVersion=Text)
	& ('cluster' ':' cluster=Text)
	& ('capturedAt' ':' capturedAt=Text)
	& ('bindings' ':' BEGIN (DASH BEGIN bindings+=Binding END)* END)
	& ('placements' ':' BEGIN (DASH BEGIN placements+=CurrentPlacement END)* END)
	& ('backups' ':' BEGIN (DASH BEGIN backups+=RollbackBackup END)* END)?);

Binding returns Binding:
	(('claim' ':' claim=Text)
	& ('node' ':' node=Text));

CurrentPlacement returns CurrentPlacement:
	(('process' ':' process=Text)
	& ('node' ':' node=Text));

// How a Rollback's one-shot backup Job ended, as the Collector reports it.
RollbackBackup returns RollbackBackup:
	(('request' ':' request=Text)
	& ('project' ':' project=Text)
	& ('job' ':' job=Text)
	& ('outcome' ':' outcome=BackupOutcome)
	& ('finishedAt' ':' finishedAt=Text));

enum BackupOutcome returns BackupOutcome:
	succeeded | failed;

// Every keyword this document adds is also a scalar, as the project language's are.
@Override
Text returns ecore::EString:
	SCALAR | STRING | INT | Keyword | ClusterStateKeyword;

ClusterStateKeyword:
	'backups' | 'bindings' | 'capturedAt' | 'failed' | 'finishedAt' | 'outcome'
	| 'placements' | 'request' | 'succeeded';
