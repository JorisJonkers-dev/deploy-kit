<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Resolved Deployment target metamodel, written by hand (docs/adr/emf/0109).

  It holds two halves in one package, and that is deliberate
  (emf/docs/architecture.md#metamodels). The first half is every decision
  layer 2 takes, in the words CONTEXT.md gives them. The second is the typed
  resources the Acceleo templates walk, with the path each one is written to.
  The production implementation keeps those two apart, because nothing there
  reads them together; a model-to-text template reads one model, so here they
  are one package. That difference is why the parity contract compares the two
  implementations through dependency edges and generated files rather than
  through `resolved.json`.

  Every value in the first half is a decision someone could review. Every value
  in the second is a spelling of one, and no name there appears in the first.
-->
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="resolveddeployment" nsURI="https://jorisjonkers.dev/deploy-kit/resolved-deployment/1"
    nsPrefix="resolveddeployment">

  <!-- ==================================================== the decisions -->

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedDeployment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="apiVersion" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="provenance" lowerBound="1" eType="#//Provenance" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="applications" lowerBound="1" upperBound="-1" eType="#//ResolvedApplication" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="reconcileUnits" lowerBound="1" upperBound="-1" eType="#//ReconcileUnit" containment="true"/>
    <!-- Layer 2 assigns every output path (docs/adr/model/0070). -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="deliverables" lowerBound="1" upperBound="-1" eType="#//Deliverable" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Provenance">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="renderHash" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="schemaPackageIntegrity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="inputDigests" lowerBound="1" upperBound="-1" eType="#//InputDigest" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="InputDigest">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="input" lowerBound="1" eType="#//PinnedInput"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="digest" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ReconcileUnit">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- An arrow means: must be Ready first. A reference, never a string. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="after" upperBound="-1" eType="#//ReconcileUnit"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedApplication">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The digest of this element, itself excluded
         (spec/v1/20-resolved-deployment.md#the-application-revision). -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="revision" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="project" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="alertClass" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="reconcileUnit" lowerBound="1" eType="#//ReconcileUnit"/>
    <!-- Absent on an `interrupted` Application: it stops before it starts, so no
         switch waits on a gate (docs/adr/model/0128). -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="releaseGate" eType="#//ReleaseGate" containment="true"/>
    <!-- The Secret Store's endpoint, where a Process or its backup holds a grant. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="secretStore" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Present where the Application moves its schema with a changelog. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="migration" eType="#//ResolvedMigration" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="exposure" upperBound="-1" eType="#//ResolvedExposure" containment="true"/>
    <!-- Where the metrics stack scrapes the Application, at the platform's cadence. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="scrape" eType="#//ResolvedScrape" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedScrape">
    <eStructuralFeatures xsi:type="ecore:EReference" name="process" lowerBound="1" eType="#//ResolvedProcess"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="surface" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="interval" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeout" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- The runner image the changelog was built into, and the serving revision its
       compatibility was proven against (spec/v1/20-resolved-deployment.md#the-migration). -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedMigration">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="runner" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="testedAgainst" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Whether the release holds a changeset that cannot run in a transaction:
         no automatic undo touches such a release (spec/v1/55-delivery.md#failure-and-undo). -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nonTransactional" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ReleaseGate">
    <!-- The gate's own address, which every Canary's webhooks ask. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endpoint" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deadline" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The Platform document's cadence, carried so the projection is all the gate reads. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="analysis" lowerBound="1" eType="#//GateAnalysis" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="members" lowerBound="1" upperBound="-1" eType="#//GateMember" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="GateAnalysis">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="interval" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iterations" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="threshold" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- What a member is analysed on beside its readiness, from its Runtime Profile. -->
  <eClassifiers xsi:type="ecore:EEnum" name="AnalysisCheck">
    <eLiterals name="errorRate" literal="error-rate"/>
    <eLiterals name="latency" value="1" literal="latency"/>
  </eClassifiers>

  <!-- A Process declaring `probes: none` publishes no readiness and is no member. -->
  <eClassifiers xsi:type="ecore:EClass" name="GateMember">
    <eStructuralFeatures xsi:type="ecore:EReference" name="process" lowerBound="1" eType="#//ResolvedProcess"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="readiness" lowerBound="1" eType="#//ProbeTarget" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="checks" upperBound="-1" eType="#//AnalysisCheck"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedProcess">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lifecycle" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="image" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Unset on a `lifecycle: prepare` Process: it runs once and cuts over nothing. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cutover" unsettable="true" eType="#//Cutover"/>
    <!-- Set on a `lifecycle: application` Process; a job has no switchover. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="switchover" unsettable="true" eType="#//Switchover"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deadline" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="replicas" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memory" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cpu" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hardening" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- True only where a grant carries `delivery: self` (docs/adr/model/0087). -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identityToken" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="component" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="readiness" eType="#//ResolvedProbe" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="liveness" eType="#//ResolvedProbe" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="startup" eType="#//StartupProbe" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="surfaces" upperBound="-1" eType="#//ResolvedSurface" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="placement" lowerBound="1" eType="#//ResolvedPlacement" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="volumes" upperBound="-1" eType="#//ResolvedVolume" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="secrets" upperBound="-1" eType="#//ResolvedGrant" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assets" upperBound="-1" eType="#//ResolvedAsset" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sidecars" upperBound="-1" eType="#//ResolvedSidecar" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="dependencies" upperBound="-1" eType="#//ResolvedEdge" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="writablePaths" upperBound="-1" eType="#//WritablePath" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="environment" upperBound="-1" eType="#//EnvEntry" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedSurface">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- A probe answers on a path and a port, or on a port alone. -->
  <eClassifiers xsi:type="ecore:EClass" name="ProbeTarget" abstract="true"/>

  <eClassifiers xsi:type="ecore:EClass" name="HttpTarget" eSuperTypes="#//ProbeTarget">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="TcpTarget" eSuperTypes="#//ProbeTarget">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tcp" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- Readiness and liveness take the Platform document's cadence. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedProbe">
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1" eType="#//ProbeTarget" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="period" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeout" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="failures" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!--
    Its own class, because its cadence derives from a different input: the
    Process's own `startupBudget`, where the other two take the estate's
    cadence (docs/adr/model/0088).
  -->
  <eClassifiers xsi:type="ecore:EClass" name="StartupProbe">
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1" eType="#//ProbeTarget" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="period" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The probe policy's own timeout, as readiness and liveness carry it. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeout" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="failures" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedPlacement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="eligibleNodes" lowerBound="1" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- A bound volume pins a Process; the binding is read from the snapshot. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="boundTo" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="from" eType="#//PinnedInput"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedVolume">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="claim" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mountAt" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="size" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="durability" lowerBound="1" eType="#//DurabilityClass"/>
    <!-- `reconstructible` earns none, which is the absence rather than a class. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="backup" eType="#//BackupPlan" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="BackupPlan">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="schedule" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="retain" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="offCluster" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="method" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The method image's own user, the identity it runs as, the claim its
         copies land on, and the destination's credential only that identity holds. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="claim" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="credential" eType="#//ResolvedGrant" containment="true"/>
    <!-- What the backup identity's own policy admits: the Process it dumps, on the
         surface its engine's method connects to, and the cluster's DNS; and the
         address ranges an off-cluster copy goes to. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="egress" upperBound="-1" eType="#//PolicyPeer" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="destinations" upperBound="-1" eType="#//AdmittedRange" containment="true"/>
  </eClassifiers>

  <!-- An address range outside the cluster a policy admits, on one port. Layer 1 states it as
       a DestinationRange; a render admits it. -->
  <eClassifiers xsi:type="ecore:EClass" name="AdmittedRange">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cidr" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- A `kv` grant names its path, keys and access tier; a `transit` or `database`
       grant names its engine and the paths its policy covers, derived from it. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedGrant">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="keys" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="access" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="engine" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="paths" upperBound="-1" eType="#//PolicyPath" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="delivery" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The Secret an `env` or `file` grant is synced to; a `self` grant is synced nowhere. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="destination" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mountAt" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fileMode" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="restartTargets" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- A path a grant's policy covers, and what it may do there. -->
  <eClassifiers xsi:type="ecore:EClass" name="PolicyPath">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="allows" lowerBound="1" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- A settings file, by the content-hashed name an edit changes (spec/v1/10-project-intent.md#assets). -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedAsset">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="from" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mountAt" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="content" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- A container beside the Process in its pod, its image pinned by digest. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedSidecar">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="image" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memory" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cpu" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!--
    A resolved dependency edge: the provider, the surface, the address the
    consumer is given and the peers the policy allows. This is the half of
    resolution both implementations must agree on before either renders, and
    it is exported as the parity contract's `dependencies.json`.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedEdge">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="application" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="surface" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="peers" upperBound="-1" eType="#//PolicyPeer" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="PolicyPeer">
    <!-- What admits the peer: a tier proxy, the metrics stack, a consumer, the Process's own
         backup, the DNS, the Secret Store, the datastore a backup dumps.
         Absent on an edge's own peer. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rule" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="process" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="WritablePath">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="size" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- A variable is a value, or one key of a granted path (spec/v1/10-project-intent.md#secret-references). -->
  <eClassifiers xsi:type="ecore:EClass" name="EnvEntry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="secret" eType="#//SecretReference" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="SecretReference">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedExposure">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="host" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tier" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The tier's listener and certificates, and the proxy Application that serves it. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="listener" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="certificates" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="proxyApplication" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="proxyNamespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="routes" lowerBound="1" upperBound="-1" eType="#//ResolvedRoute" containment="true"/>
  </eClassifiers>

  <!--
    The middleware chain hangs off the route, not off the host: it derives from
    the tier, the audience and the content policy, and a route may override the
    audience, so an anonymous path inside an authenticated host derives a chain
    with no forward-auth.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedRoute">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="match" lowerBound="1" eType="#//Match"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="audience" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Specificity alone, smallest evaluated first (docs/adr/model/0093). -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="precedence" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="process" lowerBound="1" eType="#//ResolvedProcess"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="surface" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="middleware" upperBound="-1" eType="#//MiddlewareStep" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="MiddlewareStep">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="#//MiddlewareKind"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="contentPolicy" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endpoint" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="redirectTo" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- ============================================ the generated resources -->

  <!--
    One class per resource family of the project proposal's generated-resources
    table, each carrying the path it is written to. A template walks these; it
    decides nothing, so no attribute here is a value a reviewer would argue
    with, only the spelling of one decided above.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="Deliverable" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="adapter" lowerBound="1" eType="#//AdapterName"/>
  </eClassifiers>

  <!-- A named cluster partition for the project. -->
  <eClassifiers xsi:type="ecore:EClass" name="NamespaceFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- An index file listing what to deploy. -->
  <eClassifiers xsi:type="ecore:EClass" name="IndexFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="resources" lowerBound="1" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!--
    The definitions that run a Process, give it an identity and keep enough
    instances available during maintenance: the controller and its Service, the
    identity it runs as, and the budget a drain honours.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="WorkloadFile" eSuperTypes="#//Deliverable">
    <!-- One file per Application, holding every Process it applies to. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="controller" lowerBound="1" eType="#//ControllerKind"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="strategy" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="disruptionBudget" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- What Flagger switches a blue-green Process by: its Canary, whose webhooks
       ask the Release Gate (spec/v1/30-deliverables.md#flagger-ready-objects). -->
  <eClassifiers xsi:type="ecore:EClass" name="SwitchoverFile" eSuperTypes="#//Deliverable">
    <!-- One file per Application, holding every Process it applies to. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="IdentityFile" eSuperTypes="#//Deliverable">
    <!-- One file per Application, holding every Process it applies to. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess"/>
  </eClassifiers>

  <!-- Firewall rules allowing the declared connections and blocking the rest. -->
  <!-- A project's file holds its default-deny and no policy; an Application's holds
       one policy per Process. -->
  <eClassifiers xsi:type="ecore:EClass" name="NetworkPolicyFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="policies" upperBound="-1" eType="#//ProcessPolicy" containment="true"/>
  </eClassifiers>

  <!-- Who may reach one Process, and what it may reach. -->
  <eClassifiers xsi:type="ecore:EClass" name="ProcessPolicy">
    <eStructuralFeatures xsi:type="ecore:EReference" name="process" lowerBound="1" eType="#//ResolvedProcess"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ingress" upperBound="-1" eType="#//PolicyPeer" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="egress" upperBound="-1" eType="#//PolicyPeer" containment="true"/>
  </eClassifiers>

  <!-- Web proxy rules sending each address and path to the right Process. -->
  <eClassifiers xsi:type="ecore:EClass" name="IngressRouteFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="exposure" lowerBound="1" eType="#//ResolvedExposure"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="entryPoint" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="certificateResolver" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Where metrics are collected, and how often. -->
  <eClassifiers xsi:type="ecore:EClass" name="MonitorFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="process" lowerBound="1" eType="#//ResolvedProcess"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="surface" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="scrapePath" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="interval" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeout" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- A blue-green Process is scraped by its pods, because Flagger owns its
         Services; a stop-start one by the Service the render gives it. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="#//MonitorKind"/>
  </eClassifiers>

  <!-- The Services of the Processes Flagger does not switch: each stop-start
       Process that serves a surface, reached on every surface it serves. -->
  <eClassifiers xsi:type="ecore:EClass" name="ServiceFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess"/>
  </eClassifiers>

  <!-- The claims of every volume the Processes hold, and of each backed-up
       volume's copies; the volumes carry the claim names and sizes. -->
  <eClassifiers xsi:type="ecore:EClass" name="ClaimFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess"/>
  </eClassifiers>

  <!-- The ConfigMaps of one Application: first, where it is gated, the one the
       Release Gate reads, named for the Application and holding its release-gate
       inputs as one line of canonical JSON; then one immutable ConfigMap per
       Asset the Processes mount, under its content-named name. -->
  <eClassifiers xsi:type="ecore:EClass" name="ConfigMapFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" upperBound="-1" eType="#//ResolvedProcess"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="application" lowerBound="1" eType="#//ResolvedApplication"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="releaseGate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- One scheduled backup per backed-up volume of the Processes, from the plan
       each volume carries. -->
  <eClassifiers xsi:type="ecore:EClass" name="BackupFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess"/>
  </eClassifiers>

  <!-- The permissions granting each Process only its allowed secrets: for every
       identity of one Application that holds a synced grant, how the operator
       authenticates as it, and one synced Secret per grant. -->
  <eClassifiers xsi:type="ecore:EClass" name="SecretFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="application" lowerBound="1" eType="#//ResolvedApplication"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="holders" lowerBound="1" upperBound="-1" eType="#//SecretHolder" containment="true"/>
  </eClassifiers>

  <!-- An identity that holds grants: a Process, or a backup identity holding
       its destination's credential. Its name is its ServiceAccount, its Vault
       role and its label set's name. -->
  <eClassifiers xsi:type="ecore:EClass" name="SecretHolder">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="component" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="grants" lowerBound="1" upperBound="-1" eType="#//ResolvedGrant"/>
  </eClassifiers>

  <!-- The operator's connection to the Secret Store, one per project namespace
       that syncs anything. -->
  <eClassifiers xsi:type="ecore:EClass" name="ConnectionFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- The Vault policy one identity's grants derive, rendered and applied by
       no kustomization (spec/v1/30-deliverables.md#vault-configuration-is-rendered-not-applied). -->
  <eClassifiers xsi:type="ecore:EClass" name="VaultPolicyFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="grants" lowerBound="1" upperBound="-1" eType="#//ResolvedGrant"/>
  </eClassifiers>

  <!-- The Kubernetes auth role that binds one identity to its policy. -->
  <eClassifiers xsi:type="ecore:EClass" name="VaultRoleFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- ==================================================== vocabularies -->

  <eClassifiers xsi:type="ecore:EEnum" name="PinnedInput">
    <eLiterals name="intentFragment" literal="intent-fragment"/>
    <eLiterals name="platformIntent" value="1" literal="platform-intent"/>
    <eLiterals name="nodeContract" value="2" literal="node-contract"/>
    <eLiterals name="imagesLock" value="3" literal="images-lock"/>
    <eLiterals name="clusterState" value="4" literal="cluster-state"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="Cutover">
    <eLiterals name="continuous" literal="continuous"/>
    <eLiterals name="interrupted" value="1" literal="interrupted"/>
  </eClassifiers>

  <!-- How the new version replaces the old (spec/v1/55-delivery.md#switchover):
       `continuous` derives blue-green, or rolling on delivery machinery, which no
       gate switches; `interrupted` derives stop-start. -->
  <eClassifiers xsi:type="ecore:EEnum" name="Switchover">
    <eLiterals name="blueGreen" literal="blue-green"/>
    <eLiterals name="stopStart" value="1" literal="stop-start"/>
    <eLiterals name="rolling" value="2" literal="rolling"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="Match">
    <eLiterals name="prefix" literal="prefix"/>
    <eLiterals name="exact" value="1" literal="exact"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="DurabilityClass">
    <eLiterals name="reconstructible" literal="reconstructible"/>
    <eLiterals name="recoverable" value="1" literal="recoverable"/>
    <eLiterals name="irreplaceable" value="2" literal="irreplaceable"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="MiddlewareKind">
    <eLiterals name="forwardAuth" literal="forward-auth"/>
    <eLiterals name="securityHeaders" value="1" literal="security-headers"/>
    <eLiterals name="redirect" value="2" literal="redirect"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="AdapterName">
    <eLiterals name="kubernetes" literal="kubernetes"/>
    <eLiterals name="networking" value="1" literal="networking"/>
    <eLiterals name="prometheus" value="2" literal="prometheus"/>
    <eLiterals name="traefik" value="3" literal="traefik"/>
    <eLiterals name="vaultPolicy" value="4" literal="vault-policy"/>
    <eLiterals name="vso" value="5" literal="vso"/>
  </eClassifiers>

  <!-- The kind derives from `lifecycle` and `volumes`; the template spells it. -->
  <eClassifiers xsi:type="ecore:EEnum" name="MonitorKind">
    <eLiterals name="podMonitor" literal="PodMonitor"/>
    <eLiterals name="serviceMonitor" value="1" literal="ServiceMonitor"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="ControllerKind">
    <eLiterals name="deployment" literal="Deployment"/>
    <eLiterals name="statefulSet" value="1" literal="StatefulSet"/>
    <eLiterals name="cronJob" value="2" literal="CronJob"/>
  </eClassifiers>

</ecore:EPackage>
