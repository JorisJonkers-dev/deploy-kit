<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Resolved Deployment target metamodel, written by hand (docs/adr/emf/0109).

  It holds two halves in one package, and that is deliberate
  (emf/docs/architecture.md#metamodels). The first half is every decision
  layer 2 takes, in the words CONTEXT.md gives them. The second is the typed
  resources the Acceleo templates walk, with the path each one is written to.
  The production implementation keeps those two apart, because nothing there
  reads them together; a model-to-text template reads one model, so here they
  are one package. That difference is why the parity contract compares the two
  implementations through dependency edges and generated files rather than
  through `resolved.json`.

  Every value in the first half is a decision someone could review. Every value
  in the second is a spelling of one, and no name there appears in the first.
-->
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="resolveddeployment" nsURI="https://jorisjonkers.dev/deploy-kit/resolved-deployment/1"
    nsPrefix="resolveddeployment">

  <!-- ==================================================== the decisions -->

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedDeployment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="apiVersion" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="provenance" lowerBound="1" eType="#//Provenance" containment="true"/>
    <!-- None for the `node` Project, which no project file declares: its Node Agents alone. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="applications" upperBound="-1" eType="#//ResolvedApplication" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="reconcileUnits" lowerBound="1" upperBound="-1" eType="#//ReconcileUnit" containment="true"/>
    <!-- The Vault policy job, where the platform names one and a Secret Store answers
         (spec/v1/20-resolved-deployment.md#the-vault-policy-job). -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="policyJob" eType="#//ResolvedPolicyJob" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="catalogJobs" upperBound="-1" eType="#//ResolvedCatalogJob" containment="true"/>
    <!-- Where Flux's events about every Project's unit go, where the platform names a
         Reporter (spec/v1/55-delivery.md#rollouts). -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="events" eType="#//ResolvedEvents" containment="true"/>
    <!-- The `node` Project's agents and the address pools its speaker answers for. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="nodeAgents" upperBound="-1" eType="#//ResolvedNodeAgent" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="addressPools" upperBound="-1" eType="#//ResolvedAddressPool" containment="true"/>
    <!-- Layer 2 assigns every output path (docs/adr/model/0070). -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="deliverables" lowerBound="1" upperBound="-1" eType="#//Deliverable" containment="true"/>
  </eClassifiers>

  <!-- The route Flux's events take to the Reporter: the namespace Flux's own objects live in,
       and the address of the Reporter's `http` surface that receives them. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedEvents">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- The one identity that writes the rendered Vault policies and auth roles into the Secret
       Store, in the Secret Store's own namespace, with what its policy admits. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedPolicyJob">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="image" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="imageVersion" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="role" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memory" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cpu" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deadline" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Every node the job may land on, by name: none that holds an sdcard medium. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="eligibleNodes" lowerBound="1" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="egress" upperBound="-1" eType="#//PolicyPeer" containment="true"/>
  </eClassifiers>

  <!-- The method that applies one datastore's database catalog
       (spec/v1/16-dependencies.md#applying-the-catalog), beside the datastore. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedCatalogJob">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="image" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="imageVersion" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="role" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memory" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cpu" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deadline" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Every node the job may land on, by name: none that holds an sdcard medium. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="eligibleNodes" lowerBound="1" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="catalog" lowerBound="1" eType="#//ResolvedCatalog" containment="true"/>
    <!-- The datastore's surface, as the consumer label the method's pods carry names it
         (spec/v1/16-dependencies.md#the-consumer-label). -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="consumes" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="egress" upperBound="-1" eType="#//PolicyPeer" containment="true"/>
    <!-- What the method may do at each path: read its login and its metadata, and create, read
         and update each database role the catalog names, in the catalog's order. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="policy" lowerBound="1" upperBound="-1" eType="#//PolicyPath" containment="true"/>
  </eClassifiers>
  <!-- A database catalog names its connection and its databases; an object store's bucket
       catalog names neither, but the key each reading project is given and its buckets
       (spec/v1/16-dependencies.md#the-bucket-catalog). -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedCatalog">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="host" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="connection" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="admin" lowerBound="1" eType="#//CatalogAdmin" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="databases" upperBound="-1" eType="#//CatalogDatabase" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="keys" upperBound="-1" eType="#//CatalogKey" containment="true"/>
  </eClassifiers>
  <!-- A login to a database's admin, or a token to an object store's admin API. -->
  <eClassifiers xsi:type="ecore:EClass" name="CatalogAdmin">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="user" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="password" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="token" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <!-- One reading project's key to an object store: where it is written, and its buckets. -->
  <eClassifiers xsi:type="ecore:EClass" name="CatalogKey">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="buckets" lowerBound="1" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CatalogDatabase">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="owner" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="data" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Provenance">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="renderHash" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="schemaPackageIntegrity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="inputDigests" lowerBound="1" upperBound="-1" eType="#//InputDigest" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="InputDigest">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="input" lowerBound="1" eType="#//PinnedInput"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="digest" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ReconcileUnit">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- An arrow means: must be Ready first. A reference, never a string. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="after" upperBound="-1" eType="#//ReconcileUnit"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedApplication">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The digest of this element, itself excluded
         (spec/v1/20-resolved-deployment.md#the-application-revision). -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="revision" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="project" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="alertClass" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="reconcileUnit" lowerBound="1" eType="#//ReconcileUnit"/>
    <!-- Absent on an `interrupted` Application: it stops before it starts, so no
         switch waits on a gate (docs/adr/model/0128). -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="releaseGate" eType="#//ReleaseGate" containment="true"/>
    <!-- The Secret Store's endpoint, where a Process or its backup holds a grant. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="secretStore" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Present where the Application moves its schema with a changelog. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="migration" eType="#//ResolvedMigration" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="exposure" upperBound="-1" eType="#//ResolvedExposure" containment="true"/>
    <!-- Where the metrics stack scrapes the Application, at the platform's cadence. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="scrape" eType="#//ResolvedScrape" containment="true"/>
    <!-- The sign-in Client the Application declares (spec/v1/17-sign-in.md#the-client). -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="client" eType="#//ResolvedClient" containment="true"/>
    <!-- What the monitoring stack's Application carries for the estate: its rule files, the one
         routing of every alert, and the scrape of Flux's controllers
         (spec/v1/14-platform-intent.md#monitoring). -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="alertRules" upperBound="-1" eType="#//ResolvedAlertRules" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="alerting" eType="#//ResolvedAlerting" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="fluxScrape" eType="#//ResolvedFluxScrape" containment="true"/>
    <!-- The dashboard files the Application ships, for the Grafana the Platform document names. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="dashboards" eType="#//ResolvedDashboards" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedScrape">
    <eStructuralFeatures xsi:type="ecore:EReference" name="process" lowerBound="1" eType="#//ResolvedProcess"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="surface" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="interval" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeout" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The labels the metrics stack selects a monitor by, which the render's own never give way to. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="labels" upperBound="-1" eType="#//KeyValue" containment="true"/>
  </eClassifiers>

  <!-- The migration plan (spec/v1/20-resolved-deployment.md#the-migration): the runner image
       the changelog was built into, the serving revision its compatibility was proven
       against, and everything its Jobs run with. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedMigration">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="runner" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="runnerVersion" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="testedAgainst" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Whether the release holds a changeset that cannot run in a transaction:
         no automatic undo touches such a release (spec/v1/55-delivery.md#failure-and-undo). -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nonTransactional" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"/>
    <!-- What the migration's Jobs run with: the runner image's own user, the identity
         apart from every Process's, the platform's terms for a migration, the size of
         the runner's one writable path, the database it moves, the owner credential
         only that identity holds, and what its own policy admits. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deadline" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memory" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cpu" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="scratch" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="database" lowerBound="1" eType="#//MigratedDatabase" containment="true"/>
    <!-- The datastore's surface, as the consumer label the runner's pods carry names it
         (spec/v1/16-dependencies.md#the-consumer-label). -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="consumes" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="credential" lowerBound="1" eType="#//ResolvedGrant" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="egress" upperBound="-1" eType="#//PolicyPeer" containment="true"/>
    <!-- The home its variables point at, where it mounts a writable /tmp and names no HOME of its
         own (docs/adr/model/0141); none for a container with no writable /tmp. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="home" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- The database a migration moves: where the project's datastore answers, and
       the one database of the project on it. -->
  <eClassifiers xsi:type="ecore:EClass" name="MigratedDatabase">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="host" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ReleaseGate">
    <!-- The gate's own address, which every Canary's webhooks ask. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endpoint" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deadline" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The Platform document's cadence, carried so the projection is all the gate reads. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="analysis" lowerBound="1" eType="#//GateAnalysis" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="members" lowerBound="1" upperBound="-1" eType="#//GateMember" containment="true"/>
    <!-- Present where the Application moves its schema with a changelog. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="migration" eType="#//GateMigration" containment="true"/>
  </eClassifiers>

  <!-- What the gate needs of a migration to start it and to undo it
       (spec/v1/55-delivery.md#failure-and-undo): the identity its Jobs are named for, the
       serving revision the release was proven against, and whether a changeset of it cannot
       run in a transaction. The Jobs' names are not here: they carry the revision's tag, and
       the revision covers this element. -->
  <eClassifiers xsi:type="ecore:EClass" name="GateMigration">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="testedAgainst" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nonTransactional" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="GateAnalysis">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="interval" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iterations" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="threshold" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- What a check must stay under, the same for every Application. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="errorRate" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="latency" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- What a member is analysed on beside its readiness, from its Runtime Profile. -->
  <eClassifiers xsi:type="ecore:EEnum" name="AnalysisCheck">
    <eLiterals name="errorRate" literal="error-rate"/>
    <eLiterals name="latency" value="1" literal="latency"/>
  </eClassifiers>

  <!-- A Process declaring `probes: none` publishes no readiness and is no member. -->
  <eClassifiers xsi:type="ecore:EClass" name="GateMember">
    <eStructuralFeatures xsi:type="ecore:EReference" name="process" lowerBound="1" eType="#//ResolvedProcess"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="readiness" lowerBound="1" eType="#//ProbeTarget" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="checks" upperBound="-1" eType="#//AnalysisCheck"/>
    <!-- What the member waits for before its new version starts
         (spec/v1/55-delivery.md#release-order), in name order. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="waitsFor" upperBound="-1" eType="#//GateProvider" containment="true"/>
  </eClassifiers>

  <!-- A Process of another Application of the same Project that a member requires and that
       switches stop-start. Named, never by revision, so a release of the provider does not
       release the member. -->
  <eClassifiers xsi:type="ecore:EClass" name="GateProvider">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="application" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="process" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedProcess">
    <!-- Unique within its Application only, and often the Application's own Id, so no ID. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lifecycle" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="image" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="imageVersion" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Unset on a `lifecycle: prepare` Process: it runs once and cuts over nothing. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cutover" unsettable="true" eType="#//Cutover"/>
    <!-- Set on a `lifecycle: application` Process; a job has no switchover. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="switchover" unsettable="true" eType="#//Switchover"/>
    <!-- The Deployment that serves between releases, and the label its pods are selected by: a
         blue-green Process's primary, by the name Flagger gives it, or the Process itself, by its
         instance. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="serving" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="servingLabel" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deadline" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="replicas" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memory" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cpu" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Set where the Process declares `gpu`: its vendor's resource and runtime class. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="gpu" eType="#//ResolvedGpu" containment="true"/>
    <!-- Set where the Process attaches to the VPN: the container beside it. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="vpn" eType="#//ResolvedVpn" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hardening" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- True only where a grant carries `delivery: self` (docs/adr/model/0087). -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identityToken" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="api" eType="#//ResolvedApiAccess" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="internetEgress" eType="#//InternetEgress" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="component" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="readiness" eType="#//ResolvedProbe" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="liveness" eType="#//ResolvedProbe" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="startup" eType="#//StartupProbe" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="surfaces" upperBound="-1" eType="#//ResolvedSurface" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="placement" lowerBound="1" eType="#//ResolvedPlacement" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="volumes" upperBound="-1" eType="#//ResolvedVolume" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="libraries" upperBound="-1" eType="#//ResolvedLibraryMount" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="secrets" upperBound="-1" eType="#//ResolvedGrant" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assets" upperBound="-1" eType="#//ResolvedAsset" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sidecars" upperBound="-1" eType="#//ResolvedSidecar" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="dependencies" upperBound="-1" eType="#//ResolvedEdge" containment="true"/>
    <!-- The surface of every Application its edges reach, as the consumer label its pods carry
         names it (spec/v1/16-dependencies.md#the-consumer-label). -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="consumes" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="writablePaths" upperBound="-1" eType="#//WritablePath" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="environment" upperBound="-1" eType="#//EnvEntry" containment="true"/>
    <!-- The arguments the container is handed: the authored ones, then those a tier's proxy derives
         for its static configuration. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="arguments" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The command it runs where the image's own entrypoint is not it, as written. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="command" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The priority class its pods schedule under, where it names one. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priorityClass" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The nameservers a Process that serves DNS resolves through, never the cluster's own. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nameservers" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Whether its replicas repel each other across nodes, within one revision. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="spread" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- The step that seeds its Assets onto its volumes before each start. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="seeder" eType="#//ResolvedSeeder" containment="true"/>
    <!-- The L4 Addresses it is exposed on (spec/v1/14-platform-intent.md#l4-addresses): a pool's,
         as a load balancer Service of its own, and a node's, as ports of the node's own address
         that are not a surface's own number over TCP. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="l4Services" upperBound="-1" eType="#//ResolvedL4Service" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nodePorts" upperBound="-1" eType="#//L4Port" containment="true"/>
    <!-- The templates it makes pods from through the Kubernetes API (spec/v1/16-dependencies.md#spawned-pods). -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="spawns" upperBound="-1" eType="#//ResolvedSpawn" containment="true"/>
    <!-- Set on an Instance a Move starts: the Process it is an Instance of, whose instance label
         its pods carry while its name label names the Instance. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="instance" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Whether its workload is created once and never rewritten: the source a Move carries data
         out of, which still serves. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="frozen" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- An open Move of the Process (spec/v1/55-delivery.md#the-move), where one is open. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="move" eType="#//ResolvedMove" containment="true"/>
    <!-- A `scheduled` Process's schedule, whether it is parked, and how late a run may still start. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="schedule" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="parked" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="startDeadline" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The home its variables point at, where it mounts a writable /tmp and names no HOME of its
         own (docs/adr/model/0141); none for a container with no writable /tmp. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="home" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The capabilities its container adds back to the restricted posture: `NET_BIND_SERVICE`
         where it listens below 1024. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="addedPrivileges" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- The seeder: the platform's image, run first as the Process's own user, with the command that seeds each Asset and the mounts it reads and writes. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedSeeder">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="image" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="imageVersion" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memory" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cpu" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="command" lowerBound="1" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mounts" upperBound="-1" eType="#//ContainerMount" containment="true"/>
  </eClassifiers>
  <!-- A volume of the pod one container mounts, where, and whether it writes it. -->
  <eClassifiers xsi:type="ecore:EClass" name="ContainerMount">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mountAt" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="subPath" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="readOnly" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- The load balancer Service a pool L4 Address asks its address from, under its own name. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedL4Service">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pool" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ports" lowerBound="1" upperBound="-1" eType="#//L4Port" containment="true"/>
  </eClassifiers>
  <!-- A port a client dials on an L4 Address, its protocol, and the port of the container it reaches. -->
  <eClassifiers xsi:type="ecore:EClass" name="L4Port">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="protocol" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="targetPort" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- An open Move: the identity its step Jobs run as, under the Move's tag; the engine's move image and its user; the Instance it moves from and the one it moves to, on the engine's surface; the Stable Address its flip moves, in the estate's namespace; and the Vault role and path of the credential it holds. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedMove">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tag" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="image" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="imageVersion" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memory" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cpu" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sourceHost" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="targetHost" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flips" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flipNamespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="role" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="credentialsPath" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="secretStore" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="steps" lowerBound="1" upperBound="-1" eType="#//MoveStep" containment="true"/>
    <!-- The Instances the method reaches on the engine's surface, which each Instance also reaches,
         and what the move identity's own policy admits: those, the Secret Store, the cluster's DNS,
         and where the Kubernetes API answers, which the flip writes to. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="instancePeers" upperBound="-1" eType="#//PolicyPeer" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="egress" upperBound="-1" eType="#//PolicyPeer" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="server" upperBound="-1" eType="#//AdmittedRange" containment="true"/>
  </eClassifiers>
  <!-- One step of a Move, by the name of its Job and the step it runs. -->
  <eClassifiers xsi:type="ecore:EClass" name="MoveStep">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="command" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- A template a Process makes pods from: the label its pods carry, the surfaces they serve the Process on, their edges, what their baseline reaches, and the public internet where the template declares it. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedSpawn">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="surfaces" upperBound="-1" eType="#//ResolvedSurface" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="dependencies" upperBound="-1" eType="#//ResolvedEdge" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="egress" upperBound="-1" eType="#//PolicyPeer" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="internetEgress" eType="#//InternetEgress" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedSurface">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- The port of the node's own address a client dials the surface on, where an L4 exposure
         of kind `node` reaches it over TCP at the surface's own number. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hostPort" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"/>
  </eClassifiers>

  <!-- A probe answers on a path and a port, or on a port alone. -->
  <eClassifiers xsi:type="ecore:EClass" name="ProbeTarget" abstract="true"/>

  <eClassifiers xsi:type="ecore:EClass" name="HttpTarget" eSuperTypes="#//ProbeTarget">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="TcpTarget" eSuperTypes="#//ProbeTarget">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tcp" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- Readiness and liveness take the Platform document's cadence. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedProbe">
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1" eType="#//ProbeTarget" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="period" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeout" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="failures" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!--
    Its own class, because its cadence derives from a different input: the
    Process's own `startupBudget`, where the other two take the estate's
    cadence (docs/adr/model/0088).
  -->
  <eClassifiers xsi:type="ecore:EClass" name="StartupProbe">
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1" eType="#//ProbeTarget" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="period" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The probe policy's own timeout, as readiness and liveness carry it. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeout" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="failures" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedPlacement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="eligibleNodes" lowerBound="1" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- A bound volume pins a Process; the binding is read from the snapshot. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="boundTo" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="from" eType="#//PinnedInput"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedVolume">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="claim" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mountAt" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="size" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="durability" lowerBound="1" eType="#//DurabilityClass"/>
    <!-- `reconstructible` earns none, which is the absence rather than a class. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="backup" eType="#//BackupPlan" containment="true"/>
  </eClassifiers>

  <!-- A library the Process mounts: the directory on its node, the group the
       Process runs with, and the volume and claim its project derives onto it. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedVpn">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="image" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="imageVersion" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memory" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cpu" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="forwardedPort" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="environment" lowerBound="1" upperBound="-1" eType="#//EnvEntry" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="credential" lowerBound="1" eType="#//ResolvedGrant" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedGpu">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="resource" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="runtimeClass" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedLibraryMount">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="library" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="claim" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="volume" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="node" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mountAt" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="subPath" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="access" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="BackupPlan">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="schedule" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="retain" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="offCluster" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Where below the destination an off-cluster copy lands, and the recipient it is encrypted to
         before it leaves the cluster. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="offClusterPath" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="offClusterRecipient" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="method" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="methodVersion" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The method image's own user, the identity it runs as, the claim its
         copies land on, and the destination's credential only that identity holds. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gid" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="claim" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="credential" eType="#//ResolvedGrant" containment="true"/>
    <!-- Where a method that dumps over the network connects; none for one that
         reads the volume alone. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="peer" eType="#//BackupPeer" containment="true"/>
    <!-- What the backup identity's own policy admits: the Process it dumps, on the
         surface its engine's method connects to, and the cluster's DNS; and the
         address ranges an off-cluster copy goes to. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="egress" upperBound="-1" eType="#//PolicyPeer" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="destinations" upperBound="-1" eType="#//AdmittedRange" containment="true"/>
  </eClassifiers>

  <!-- The Process a method dumps over the network, and the credential it logs in
       with: the Process's Service on the port of the surface the platform names
       for its engine, and a path derived from the Process, held by the backup
       identity alone. -->
  <eClassifiers xsi:type="ecore:EClass" name="BackupPeer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="host" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="credential" lowerBound="1" eType="#//ResolvedGrant" containment="true"/>
  </eClassifiers>

  <!-- An address range outside the cluster a policy admits, on one port. Layer 1 states it as
       a DestinationRange; a render admits it. -->
  <!-- The Kubernetes API access a Process holds
       (spec/v1/16-dependencies.md#kubernetes-api-access-is-declared-and-admitted): its rules
       as declared, the reason its owner gave, and where the platform says the API answers. -->
  <!-- The public internet a Process reaches, and the reason its owner gave
       (spec/v1/16-dependencies.md#internet-egress). -->
  <eClassifiers xsi:type="ecore:EClass" name="InternetEgress">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reason" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedApiAccess">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reason" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- None where the Process acts on the API only with each signed-in user's own token. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="rules" upperBound="-1" eType="#//ResolvedApiRule" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="server" lowerBound="1" upperBound="-1" eType="#//AdmittedRange" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedApiRule">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="group" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="objects" lowerBound="1" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="verbs" lowerBound="1" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Whether the rule holds in the Process's own namespace or across the cluster. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="scope" lowerBound="1" eType="#//RuleScope"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AdmittedRange">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cidr" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- A `kv` grant names its path, keys and access tier; a `transit` or `database`
       grant names its engine and the paths its policy covers, derived from it. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedGrant">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="keys" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="access" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="engine" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="paths" upperBound="-1" eType="#//PolicyPath" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="delivery" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The Secret an `env` or `file` grant is synced to; a `self` grant is synced nowhere. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="destination" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mountAt" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fileMode" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="restartTargets" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="generated" upperBound="-1" eType="#//ResolvedGeneratedKey" containment="true"/>
  </eClassifiers>

  <!-- A key the Vault policy job generates, its defaults filled in. A grant's
       key names no path, since the grant does; the job's document names one. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedGeneratedKey">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bytes" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="encoding" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The kv path and key the value starts from, where the key adopts one. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="adoptPath" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="adoptKey" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- A path a grant's policy covers, and what it may do there. -->
  <eClassifiers xsi:type="ecore:EClass" name="PolicyPath">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="allows" lowerBound="1" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- A settings file, by the content-hashed name an edit changes (spec/v1/10-project-intent.md#assets). -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedAsset">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="from" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Where the Process reads it; a seeded Asset is read by none. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mountAt" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="content" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Where a seeded Asset is copied onto a volume before each start; a seeded Asset is the
         seeder's to read, never the Process's. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="seedAt" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- A container beside the Process in its pod, its image pinned by digest. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedSidecar">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="image" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="imageVersion" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memory" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cpu" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Whether it runs to completion before the Process starts, rather than beside it. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="init" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- The Process's volumes and Assets it names, each where it says. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="mounts" upperBound="-1" eType="#//ContainerMount" containment="true"/>
    <!-- The home its variables point at, where it mounts a writable /tmp and names no HOME of its
         own (docs/adr/model/0141); none for a container with no writable /tmp. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="home" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- What it runs where the image's own entrypoint is not it: the command and the arguments, as written. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="command" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="arguments" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!--
    A resolved dependency edge: the provider, the surface, the address the
    consumer is given and the peers the policy allows. This is the half of
    resolution both implementations must agree on before either renders, and
    it is exported as the parity contract's `dependencies.json`.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedEdge">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="application" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="surface" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Where the consumer's alias points, on an edge that derives one. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="target" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="peers" upperBound="-1" eType="#//PolicyPeer" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="PolicyPeer">
    <!-- What admits the peer: a tier proxy, the metrics stack, a consumer, the Process's own
         backup, the DNS, the Secret Store, the datastore a backup dumps.
         Absent on an edge's own peer. A consumer names no namespace and no Process: it is
         every pod carrying the consumer label of the surface `consumes` names
         (spec/v1/16-dependencies.md#the-consumer-label). -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rule" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="consumes" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="process" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- A client off the cluster an L4 Address carries to the Process, by the range it may come
         from, and the protocol of the port it reaches; such a peer names no namespace. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cidr" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="protocol" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="WritablePath">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="size" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Whether the path is held in memory rather than on the node's disk. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memory" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- A variable is a value, or one key of a granted path (spec/v1/10-project-intent.md#secret-references). -->
  <eClassifiers xsi:type="ecore:EClass" name="EnvEntry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="secret" eType="#//SecretReference" containment="true"/>
    <!-- A field of the pod's own, such as the node it runs on, read by the API. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="field" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="SecretReference">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Whether the Process starts without the key, where its grant marks the key optional. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="optional" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResolvedExposure">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="host" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tier" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The tier's listener and certificates, and the proxy Application that serves it. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="listener" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="certificates" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="proxyApplication" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="proxyNamespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The class the tier's proxy admits a route by, and the record the DNS controller writes for
         the host: the tier's target, proxied or not, where the tier names a DNS provider. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ingressClass" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="dns" eType="#//ExposureDns" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="routes" lowerBound="1" upperBound="-1" eType="#//ResolvedRoute" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ExposureDns">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="target" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="proxied" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!--
    The middleware chain hangs off the route, not off the host: it derives from
    the tier, the audience and the content policy, and a route may override the
    audience, so an anonymous path inside an authenticated host derives a chain
    with no forward-auth.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedRoute">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="match" lowerBound="1" eType="#//Match"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="audience" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Specificity alone, smallest evaluated first (docs/adr/model/0093). -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="precedence" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="process" eType="#//ResolvedProcess"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="surface" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="middleware" upperBound="-1" eType="#//MiddlewareStep" containment="true"/>
    <!-- A gated Client's derived /.auth/ route names the Gate that answers it instead of a Process and
         surface of its own Application (spec/v1/17-sign-in.md#what-the-edge-derives). -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="gate" eType="#//GateRoute" containment="true"/>
  </eClassifiers>

  <!-- The Service a gated route is served by: the sign-in provider's, in its namespace and on its port. -->
  <eClassifiers xsi:type="ecore:EClass" name="GateRoute">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="MiddlewareStep">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="#//MiddlewareKind"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="contentPolicy" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endpoint" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="redirectTo" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- A rate-limit step: the route's allowance and period, the derived burst,
         and the address its tier counts a client by. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="allowance" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="per" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="burst" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="clientAddress" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The Middleware a route names for this step, and its namespace: a shared one in the
         proxy's namespace, named for its kind and content policy, or a route's own beside its
         IngressRoute, numbered by the route's position. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- A Node Agent (spec/v1/14-platform-intent.md#node-agents): a controller the `node` Project
       runs on the nodes its facts name, with the privileges its catalog entry fixes, carried here
       so the template only spells them. A DaemonSet agent runs one pod per node; the speaker's
       controller runs once, as a Deployment of `replicas`. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedNodeAgent">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="application" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="controller" lowerBound="1" eType="#//ControllerKind"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="replicas" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="image" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memory" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cpu" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The device resource one share of which the agent asks, and the runtime class its pod runs in. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deviceShare" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="runtimeClass" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priorityClass" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identityToken" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- The host's own network and process namespaces, where the agent reads the node itself. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hostNetwork" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hostProcesses" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="eligibleNodes" lowerBound="1" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="arguments" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="environment" upperBound="-1" eType="#//EnvEntry" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="surfaces" upperBound="-1" eType="#//ResolvedSurface" containment="true"/>
    <!-- The posture its catalog entry fixes: a privileged agent is that alone; any other drops every
         capability but those it adds, and a confined one also writes no root filesystem and never
         escalates. `nonRoot`, `uid` and `gid` are stated only where the entry states them. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="privileged" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nonRoot" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uid" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gid" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="confined" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="addedPrivileges" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mounts" upperBound="-1" eType="#//HostMount" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="config" eType="#//AgentConfig" containment="true"/>
    <!-- What it may ask of the Kubernetes API, across the cluster or in its own namespace alone, as
         each rule's scope says; none for an agent that asks nothing. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="rules" upperBound="-1" eType="#//ResolvedApiRule" containment="true"/>
    <!-- The speaker's memberlist, where a Vault policy job can generate its key. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="memberlist" eType="#//ResolvedMemberlist" containment="true"/>
  </eClassifiers>
  <!-- How the speakers find each other fast (spec/v1/14-platform-intent.md#node-agents): the Secret
       Store's endpoint the operator reads the key from, the document the `node` Project's own
       policy job generates it in, the key's name, and the Secret it lands in and the speaker
       mounts. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedMemberlist">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="store" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="secret" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <!-- A directory of the node an agent mounts, read-only or not, and whether a mount below it
       made on the host reaches the agent. -->
  <eClassifiers xsi:type="ecore:EClass" name="HostMount">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hostPath" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mountAt" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="readOnly" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="propagated" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>
  <!-- The one settings file an agent reads, handed to it in a ConfigMap named for it. -->
  <eClassifiers xsi:type="ecore:EClass" name="AgentConfig">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="file" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Where the Process reads it; a seeded Asset is read by none. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mountAt" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="content" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- The address pools the L4 speaker answers for (spec/v1/14-platform-intent.md#l4-addresses):
       each one address no Service takes unless it names the pool, advertised from the nodes
       named. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedAddressPool">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="range" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nodes" lowerBound="1" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- The Client an Application declares, named by its Application Id: how a person signs in to it, where it answers and is launched from, what it shows, and the roles it knows. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedClient">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="signIn" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="host" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="launchUrl" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iconUrl" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="redirectUris" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Where the provider ends a session on the Client's behalf, on the host and its own path. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="backChannelLogoutUri" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="credential" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="secretPath" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roles" lowerBound="1" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <!-- One rule file of the monitoring stack, named for its Application and its base name, and its groups as written. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedAlertRules">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="groups" lowerBound="1" upperBound="-1" eType="#//AlertRuleGroup" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AlertRuleGroup">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rules" lowerBound="1" upperBound="-1" eType="#//AlertRule" containment="true"/>
  </eClassifiers>
  <!-- An alerting rule: what it alerts as, on what expression, held how long, and its labels and annotations. -->
  <eClassifiers xsi:type="ecore:EClass" name="AlertRule">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="alert" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="expr" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="duration" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="labels" upperBound="-1" eType="#//KeyValue" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="annotations" upperBound="-1" eType="#//KeyValue" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="KeyValue">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <!-- Where an alert of each severity goes, how often it repeats there, and each receiver with the Secret key its address is read from. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedAlerting">
    <eStructuralFeatures xsi:type="ecore:EReference" name="routes" lowerBound="1" upperBound="-1" eType="#//AlertRoute" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="receivers" lowerBound="1" upperBound="-1" eType="#//AlertReceiver" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AlertRoute">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="severity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="receiver" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="repeat" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AlertReceiver">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="secret" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <!-- Flux's controllers, scraped from the monitoring stack's namespace: no Process, so selected by the labels Flux's install gives them and reached by port number. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedFluxScrape">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="port" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="interval" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeout" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="labels" upperBound="-1" eType="#//KeyValue" containment="true"/>
  </eClassifiers>
  <!-- The dashboard files of an Application, the folder they land in, the Grafana instance that imports them, and the data source each file's inputs map to. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedDashboards">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="folder" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="instance" lowerBound="1" upperBound="-1" eType="#//KeyValue" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="datasource" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="files" lowerBound="1" upperBound="-1" eType="#//ResolvedDashboard" containment="true"/>
  </eClassifiers>
  <!-- One dashboard file, named for its Application and its uid, as written, with its data source inputs. -->
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedDashboard">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="content" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="inputs" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <!-- ============================================ the generated resources -->

  <!--
    One class per resource family of the project proposal's generated-resources
    table, each carrying the path it is written to. A template walks these; it
    decides nothing, so no attribute here is a value a reviewer would argue
    with, only the spelling of one decided above.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="Deliverable" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="adapter" lowerBound="1" eType="#//AdapterName"/>
  </eClassifiers>

  <!-- A named cluster partition for the project. -->
  <eClassifiers xsi:type="ecore:EClass" name="NamespaceFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- An index file listing what to deploy. -->
  <eClassifiers xsi:type="ecore:EClass" name="IndexFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="resources" lowerBound="1" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!--
    The definitions that run a Process, give it an identity and keep enough
    instances available during maintenance: the controller and its Service, the
    identity it runs as, and the budget a drain honours.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="WorkloadFile" eSuperTypes="#//Deliverable">
    <!-- One file per Application, holding every Process it applies to. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="controller" lowerBound="1" eType="#//ControllerKind"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="strategy" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="disruptionBudget" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- What Flagger switches a blue-green Process by: its Canary, whose webhooks
       ask the Release Gate (spec/v1/30-deliverables.md#flagger-ready-objects). -->
  <eClassifiers xsi:type="ecore:EClass" name="SwitchoverFile" eSuperTypes="#//Deliverable">
    <!-- One file per Application, holding every Process it applies to. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="IdentityFile" eSuperTypes="#//Deliverable">
    <!-- One file per Application, holding every Process it applies to. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess"/>
  </eClassifiers>

  <!-- Firewall rules allowing the declared connections and blocking the rest. -->
  <!-- A project's file holds its default-deny and no policy; an Application's holds
       one policy per Process. -->
  <eClassifiers xsi:type="ecore:EClass" name="NetworkPolicyFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="policies" upperBound="-1" eType="#//ProcessPolicy" containment="true"/>
    <!-- The Application's migration, whose identity has a policy of its own after every Process's. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="migration" eType="#//ResolvedMigration"/>
  </eClassifiers>

  <!-- The migration identity and its Jobs (spec/v1/55-delivery.md#failure-and-undo): `upTag` names
       this revision's, `downTag` the revision a down returns to, absent on a first release, and
       `role` is the Vault role the identity logs in as. -->
  <eClassifiers xsi:type="ecore:EClass" name="MigrationFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="application" lowerBound="1" eType="#//ResolvedApplication"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="upTag" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="downTag" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="role" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- The disruption budget of every Process of an Application above one replica. -->
  <eClassifiers xsi:type="ecore:EClass" name="BudgetFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess"/>
  </eClassifiers>

  <!-- Who may reach one Process, and what it may reach. -->
  <eClassifiers xsi:type="ecore:EClass" name="ProcessPolicy">
    <eStructuralFeatures xsi:type="ecore:EReference" name="process" lowerBound="1" eType="#//ResolvedProcess"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ingress" upperBound="-1" eType="#//PolicyPeer" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="egress" upperBound="-1" eType="#//PolicyPeer" containment="true"/>
  </eClassifiers>

  <!-- Web proxy rules sending each address and path to the right Process. -->
  <eClassifiers xsi:type="ecore:EClass" name="IngressRouteFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="exposure" lowerBound="1" eType="#//ResolvedExposure"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="entryPoint" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="certificateResolver" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Whether the route set terminates TLS: on a tls tier that issues no certificate, with the
         one its proxy already holds, so it names no resolver. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="terminatesTls" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- Where metrics are collected, and how often. -->
  <eClassifiers xsi:type="ecore:EClass" name="MonitorFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="process" lowerBound="1" eType="#//ResolvedProcess"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="surface" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="scrapePath" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="interval" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeout" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- A blue-green Process is scraped by its pods, because Flagger owns its
         Services; a stop-start one by the Service the render gives it. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="#//MonitorKind"/>
  </eClassifiers>

  <!-- The Services of the Processes Flagger does not switch: each stop-start
       Process that serves a surface, reached on every surface it serves. -->
  <!-- The ClusterRole and its binding of every Process that holds Kubernetes API access. -->
  <eClassifiers xsi:type="ecore:EClass" name="RbacFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ServiceFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess"/>
  </eClassifiers>

  <!-- Per library a project mounts, the local volume onto its directory and the
       claim bound to it, in library name order; each mount names both. -->
  <eClassifiers xsi:type="ecore:EClass" name="LibraryFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The nominal size the volume and its claim both state; it binds nothing. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="size" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="libraries" lowerBound="1" upperBound="-1" eType="#//ResolvedLibraryMount"/>
  </eClassifiers>

  <!-- Per name a project's edges dial a provider outside its namespace by, the
       alias that holds it there, in name order (spec/v1/16-dependencies.md#the-alias). -->
  <eClassifiers xsi:type="ecore:EClass" name="AliasFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="aliases" lowerBound="1" upperBound="-1" eType="#//Alias" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Alias">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="target" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- The claims of every volume the Processes hold, and of each backed-up
       volume's copies; the volumes carry the claim names and sizes. -->
  <eClassifiers xsi:type="ecore:EClass" name="ClaimFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess"/>
  </eClassifiers>

  <!-- The ConfigMaps of one Application: first, where it is gated, the one the
       Release Gate reads, named for the Application and holding its release-gate
       inputs as one line of canonical JSON; then one immutable ConfigMap per
       Asset the Processes mount, under its content-named name. -->
  <eClassifiers xsi:type="ecore:EClass" name="ConfigMapFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" upperBound="-1" eType="#//ResolvedProcess"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="application" lowerBound="1" eType="#//ResolvedApplication"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="releaseGate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The external checks of the Application's routes, one per route the internet reaches, as
         one line of canonical JSON for the checker to gather (docs/adr/model/0117). -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="externalChecks" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- One scheduled backup per backed-up volume of the Processes, from the plan
       each volume carries. -->
  <eClassifiers xsi:type="ecore:EClass" name="BackupFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//ResolvedProcess"/>
  </eClassifiers>

  <!-- The permissions granting each Process only its allowed secrets: for every
       identity of one Application that holds a synced grant, how the operator
       authenticates as it, and one synced Secret per grant. -->
  <eClassifiers xsi:type="ecore:EClass" name="SecretFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="application" lowerBound="1" eType="#//ResolvedApplication"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="holders" lowerBound="1" upperBound="-1" eType="#//SecretHolder" containment="true"/>
  </eClassifiers>

  <!-- An identity that holds grants: a Process, or a backup identity holding
       its destination's and its peer's credentials. Its name is its ServiceAccount, its Vault
       role and its label set's name. -->
  <eClassifiers xsi:type="ecore:EClass" name="SecretHolder">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="component" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="grants" lowerBound="1" upperBound="-1" eType="#//ResolvedGrant"/>
  </eClassifiers>

  <!-- The operator's connection to the Secret Store, one per project namespace
       that syncs anything. -->
  <eClassifiers xsi:type="ecore:EClass" name="ConnectionFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- The Vault policy one identity's grants derive, rendered and applied by
       no kustomization (spec/v1/30-deliverables.md#vault-configuration-is-rendered-not-applied). -->
  <eClassifiers xsi:type="ecore:EClass" name="VaultPolicyFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- None for a policy no grant derives: the speaker's, which reads its memberlist key. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="grants" upperBound="-1" eType="#//ResolvedGrant"/>
    <!-- What the policy allows at each path, in its grants' order: an engine's own paths, or `read`
         on a kv grant's document and on the same document's metadata. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="paths" lowerBound="1" upperBound="-1" eType="#//PolicyPath" containment="true"/>
  </eClassifiers>

  <!-- One file of a Vault policy job (spec/v1/30-deliverables.md#vault-configuration-is-rendered-not-applied):
       its ServiceAccount, the ConfigMap of the documents it is handed, the Job, or its policy.
       `name` is the name the ConfigMap and the Job share, from the documents' digest, and
       `namespace` the one its objects land in: its own Project's, or, for the estate-scoped
       job, that of the catalog it writes. `job` is what every policy job runs with. -->
  <eClassifiers xsi:type="ecore:EClass" name="PolicyJobFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="part" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="job" lowerBound="1" eType="#//ResolvedPolicyJob"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="documents" lowerBound="1" upperBound="-1" eType="#//PolicyDocument" containment="true"/>
  </eClassifiers>
  <!-- One file of a catalog method (spec/v1/16-dependencies.md#applying-the-catalog): its
       objects, its network policy, or its Vault policy. `name` is the name its ConfigMap and Job
       share, and `catalogJson` the catalog as canonical JSON, both planned estate-wide. -->
  <eClassifiers xsi:type="ecore:EClass" name="CatalogJobFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="part" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="catalogJson" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="job" lowerBound="1" eType="#//ResolvedCatalogJob"/>
  </eClassifiers>
  <!-- One file of the route Flux's events about one Project's unit take (spec/v1/30-deliverables.md#the-rollout-events), in that Project's share:
       the Provider that names where they are posted, or the Alert that sends them. -->
  <eClassifiers xsi:type="ecore:EClass" name="EventsFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="part" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="project" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="events" lowerBound="1" eType="#//ResolvedEvents"/>
  </eClassifiers>
  <!-- One Vault document as the job is handed it: its file name and its canonical JSON. -->
  <eClassifiers xsi:type="ecore:EClass" name="PolicyDocument">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="file" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="json" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Every key the Vault policy job generates for one project, once, in path
       then key order (spec/v1/30-deliverables.md#vault-configuration-is-rendered-not-applied). -->
  <eClassifiers xsi:type="ecore:EClass" name="GeneratedKeysFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="keys" lowerBound="1" upperBound="-1" eType="#//ResolvedGeneratedKey" containment="true"/>
  </eClassifiers>

  <!-- The Kubernetes auth role that binds one identity to its policy. -->
  <eClassifiers xsi:type="ecore:EClass" name="VaultRoleFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="identity" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- The two priority classes the Platform document declares, estate-scoped
       (spec/v1/14-platform-intent.md#priority): a datastore's, and the foundation's. Each
       class's description is fixed by which of the two it is, so the template spells it. -->
  <eClassifiers xsi:type="ecore:EClass" name="PriorityClassFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="data" lowerBound="1" eType="#//ResolvedPriority" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="critical" lowerBound="1" eType="#//ResolvedPriority" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ResolvedPriority">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- Every Human Grant the Platform document declares, each a group of the sign-in provider bound
       to a cluster role, estate-scoped (spec/v1/14-platform-intent.md#human-grants). -->
  <eClassifiers xsi:type="ecore:EClass" name="HumanGrantFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="grants" lowerBound="1" upperBound="-1" eType="#//HumanGrantBinding" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="HumanGrantBinding">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="group" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="clusterRole" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- One file of the Node Agents of the `node` Project: their workloads, their ServiceAccounts,
       their cluster roles and bindings, or the ConfigMap of the one that reads a settings file. -->
  <eClassifiers xsi:type="ecore:EClass" name="NodeAgentFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="part" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="agents" lowerBound="1" upperBound="-1" eType="#//ResolvedNodeAgent"/>
  </eClassifiers>
  <!-- The L4 speaker's address pools and the advertisement of each, in the agents' namespace. -->
  <eClassifiers xsi:type="ecore:EClass" name="AddressPoolFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="pools" lowerBound="1" upperBound="-1" eType="#//ResolvedAddressPool"/>
  </eClassifiers>

  <!-- The Client an Application declares, cluster-scoped. -->
  <eClassifiers xsi:type="ecore:EClass" name="ClientFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="application" lowerBound="1" eType="#//ResolvedApplication"/>
  </eClassifiers>
  <!-- One PrometheusRule per rule file of an Application. -->
  <eClassifiers xsi:type="ecore:EClass" name="AlertRulesFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="application" lowerBound="1" eType="#//ResolvedApplication"/>
  </eClassifiers>
  <!-- The monitoring stack's one routing of every alert, by severity: an alert that matches none reaches no one. -->
  <eClassifiers xsi:type="ecore:EClass" name="AlertingFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="application" lowerBound="1" eType="#//ResolvedApplication"/>
  </eClassifiers>
  <!-- The monitor of Flux's controllers. -->
  <eClassifiers xsi:type="ecore:EClass" name="FluxMonitorFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="application" lowerBound="1" eType="#//ResolvedApplication"/>
  </eClassifiers>
  <!-- One GrafanaDashboard per dashboard file of an Application. -->
  <eClassifiers xsi:type="ecore:EClass" name="DashboardFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="application" lowerBound="1" eType="#//ResolvedApplication"/>
  </eClassifiers>
  <!-- The shared Middlewares of a tier proxy's namespace, in the directory of the first proxy there by name: its forward-auth, where a tier there names one, the security-headers baseline, and the baseline with each content policy's Content-Security-Policy. -->
  <eClassifiers xsi:type="ecore:EClass" name="SharedMiddlewareFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="application" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="forwardAuth" eType="#//ForwardAuthEndpoint" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="policies" lowerBound="1" upperBound="-1" eType="#//ContentPolicyHeaders" containment="true"/>
  </eClassifiers>
  <!-- The endpoint a forward-auth asks. -->
  <eClassifiers xsi:type="ecore:EClass" name="ForwardAuthEndpoint">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <!-- A content policy, by name, and what it lets a page load. -->
  <eClassifiers xsi:type="ecore:EClass" name="ContentPolicyHeaders">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="contentSecurityPolicy" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <!-- Every Stable Address the render's Projects resolve, estate-scoped: each a name of the estate's own namespace that holds where its provider answers, created once and then moved by the flip of a Move alone (spec/v1/16-dependencies.md#the-stable-address). -->
  <eClassifiers xsi:type="ecore:EClass" name="StableAddressFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="namespace" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="addresses" lowerBound="1" upperBound="-1" eType="#//Alias" containment="true"/>
  </eClassifiers>
  <!-- The move identity of a Process's open Move, the role that lets it flip the Stable Address, and one suspended Job per step, each created once. -->
  <eClassifiers xsi:type="ecore:EClass" name="MoveFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="process" lowerBound="1" eType="#//ResolvedProcess"/>
  </eClassifiers>
  <!-- What Flux pulls one Project's pinned render from, and the units it applies from it (spec/v1/55-delivery.md): the OCI repository at the pinned digest, verified as the estate's own composition signed it, and each unit's path, order and rollout facts. -->
  <eClassifiers xsi:type="ecore:EClass" name="SourceFile" eSuperTypes="#//Deliverable">
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" lowerBound="1" eType="#//RenderSource" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="units" lowerBound="1" upperBound="-1" eType="#//FluxUnit" containment="true"/>
  </eClassifiers>
  <!-- An OCI repository of a pinned render: its name, where it is, its digest, and the identity its signature must carry. -->
  <eClassifiers xsi:type="ecore:EClass" name="RenderSource">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="url" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="digest" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="issuer" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="subject" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <!-- One unit Flux applies from a source: its name and path, what it waits for, the rollout facts its events carry, and whether it forces a Deployment whose selector changed. -->
  <eClassifiers xsi:type="ecore:EClass" name="FluxUnit">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dependsOn" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="annotations" upperBound="-1" eType="#//KeyValue" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="forcesDeployments" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>
  <!-- ==================================================== vocabularies -->

  <eClassifiers xsi:type="ecore:EEnum" name="PinnedInput">
    <eLiterals name="intentFragment" literal="intent-fragment"/>
    <eLiterals name="platformIntent" value="1" literal="platform-intent"/>
    <eLiterals name="nodeContract" value="2" literal="node-contract"/>
    <eLiterals name="imagesLock" value="3" literal="images-lock"/>
    <eLiterals name="clusterState" value="4" literal="cluster-state"/>
  </eClassifiers>

  <!-- Where an API rule holds: across the cluster, or in the Process's own namespace. -->
  <eClassifiers xsi:type="ecore:EEnum" name="RuleScope">
    <eLiterals name="cluster" literal="cluster"/>
    <eLiterals name="namespace" value="1" literal="namespace"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="Cutover">
    <eLiterals name="continuous" literal="continuous"/>
    <eLiterals name="interrupted" value="1" literal="interrupted"/>
  </eClassifiers>

  <!-- How the new version replaces the old (spec/v1/55-delivery.md#switchover):
       `continuous` derives blue-green, or rolling on delivery machinery, which no
       gate switches; `interrupted` derives stop-start. -->
  <eClassifiers xsi:type="ecore:EEnum" name="Switchover">
    <eLiterals name="blueGreen" literal="blue-green"/>
    <eLiterals name="stopStart" value="1" literal="stop-start"/>
    <eLiterals name="rolling" value="2" literal="rolling"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="Match">
    <eLiterals name="prefix" literal="prefix"/>
    <eLiterals name="exact" value="1" literal="exact"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="DurabilityClass">
    <eLiterals name="reconstructible" literal="reconstructible"/>
    <eLiterals name="recoverable" value="1" literal="recoverable"/>
    <eLiterals name="irreplaceable" value="2" literal="irreplaceable"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="MiddlewareKind">
    <eLiterals name="forwardAuth" literal="forward-auth"/>
    <eLiterals name="securityHeaders" value="1" literal="security-headers"/>
    <eLiterals name="redirect" value="2" literal="redirect"/>
    <eLiterals name="rateLimit" value="3" literal="rate-limit"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="AdapterName">
    <eLiterals name="kubernetes" literal="kubernetes"/>
    <eLiterals name="networking" value="1" literal="networking"/>
    <eLiterals name="prometheus" value="2" literal="prometheus"/>
    <eLiterals name="traefik" value="3" literal="traefik"/>
    <eLiterals name="vaultPolicy" value="4" literal="vault-policy"/>
    <eLiterals name="vso" value="5" literal="vso"/>
    <eLiterals name="grafana" value="6" literal="grafana"/>
  </eClassifiers>

  <!-- The kind derives from `lifecycle` and `volumes`; the template spells it. -->
  <eClassifiers xsi:type="ecore:EEnum" name="MonitorKind">
    <eLiterals name="podMonitor" literal="PodMonitor"/>
    <eLiterals name="serviceMonitor" value="1" literal="ServiceMonitor"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="ControllerKind">
    <eLiterals name="deployment" literal="Deployment"/>
    <eLiterals name="statefulSet" value="1" literal="StatefulSet"/>
    <eLiterals name="cronJob" value="2" literal="CronJob"/>
    <eLiterals name="daemonSet" value="3" literal="DaemonSet"/>
  </eClassifiers>

</ecore:EPackage>
