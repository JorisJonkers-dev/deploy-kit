  <!-- The runner every managed changelog builds on, and its terms
       (spec/v1/14-platform-intent.md#migration-policy). -->
  <!-- How a release is switched (spec/v1/14-platform-intent.md#delivery-policy):
       the Applications that perform the switch and are never switched by it,
       linked across the documents read together, and the analysis cadence. -->
  <eClassifiers xsi:type="ecore:EClass" name="DeliveryPolicy">
    <eStructuralFeatures xsi:type="ecore:EReference" name="machinery" lowerBound="1" upperBound="-1" eType="#//Application"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="gate" lowerBound="1" eType="#//Application"/>
    <!-- The Reporter, which Flux's events about every Project's unit are sent to, on its
         `http` surface (spec/v1/55-delivery.md#rollouts); a platform may name none. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="reporter" eType="#//Application"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="analysis" lowerBound="1" eType="#//AnalysisPolicy" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="move" eType="#//MovePolicy" containment="true"/>
  </eClassifiers>
  <!-- Who may hold Kubernetes API access, and where the API answers
       (spec/v1/14-platform-intent.md#kubernetes-api-access): the Applications whose Processes
       may declare `api`, linked across the documents read together, and the ranges a holder's
