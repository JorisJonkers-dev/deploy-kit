  <eClassifiers xsi:type="ecore:EEnum" name="Runtime">
    <eLiterals name="jvm" literal="jvm"/>
    <eLiterals name="python" value="1" literal="python"/>
    <eLiterals name="node" value="2" literal="node"/>
    <eLiterals name="static" value="3" literal="static"/>
