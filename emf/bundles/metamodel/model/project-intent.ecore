    <eAnnotations source="https://jorisjonkers.dev/deploy-kit/json">
      <details key="absent" value="absent"/>
    </eAnnotations>
    <eLiterals name="absent" literal=""/>
    <eLiterals name="postgres" value="1" literal="postgres"/>
    <eLiterals name="rabbitmq" value="2" literal="rabbitmq"/>
    <eLiterals name="valkey" value="3" literal="valkey"/>
    <eLiterals name="files" value="4" literal="files"/>
