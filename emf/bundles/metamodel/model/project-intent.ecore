<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Project Intent source metamodel, written by hand
  (emf/docs/adr/emf/0073-source-and-target-metamodels-are-hand-written.md).
  Names are CONTEXT.md's, and every feature is named as the authored YAML key
  it holds, so the canonical intent is read off the model reflectively. A
  union in the language is a union here: a probe is HTTP or TCP, a probe
  policy is a block or `none`, and a grant is keyed by its engine.

  SharedIntent is the eight families of
  spec/v1/10-project-intent.md#shared-intent. `env` is the one authored beside
  the document rather than in it, in dotenv files a second grammar parses.
  EffectiveProject and EffectiveApplication are what the lowering writes
  (docs/adr/model/0012-shared-intent-descends-and-is-lowered.md). Nobody
  authors the Effective Intent, so it carries no apiVersion, kind or
  schemaVersion (spec/v1/10-project-intent.md#the-effective-intent).
-->
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="projectintent" nsURI="https://jorisjonkers.dev/deploy-kit/project-intent/1"
    nsPrefix="projectintent">
  <eClassifiers xsi:type="ecore:EClass" name="Project" eSuperTypes="#//SharedIntent">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="apiVersion" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="schemaVersion" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="project" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="owner" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="applications" lowerBound="1" upperBound="-1" eType="#//Application" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Application" eSuperTypes="#//SharedIntent">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="client" eType="#//Client" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="l4Exposure" upperBound="-1" eType="#//L4Exposure" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="dashboards" upperBound="-1" eType="#//Dashboard" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="alertRules" upperBound="-1" eType="#//AlertRules" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="migration" eType="#//Migration" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="observability" eType="#//Observability" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="exposure" upperBound="-1" eType="#//Exposure" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//Process" containment="true"/>
  </eClassifiers>
  <!-- How an Application's schema moves (spec/v1/10-project-intent.md#migration):
       the platform's runner over a changelog, the image itself, or not at all. -->
  <eClassifiers xsi:type="ecore:EClass" name="Migration" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="ManagedMigration" eSuperTypes="#//Migration">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="changelog" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SelfMigration" eSuperTypes="#//Migration">
    <eAnnotations source="https://jorisjonkers.dev/deploy-kit/json">
      <details key="scalar" value="self"/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="NoMigration" eSuperTypes="#//Migration">
    <eAnnotations source="https://jorisjonkers.dev/deploy-kit/json">
      <details key="scalar" value="none"/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Observability">
    <eStructuralFeatures xsi:type="ecore:EReference" name="scrape" lowerBound="1" eType="#//Scrape" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Scrape">
    <eStructuralFeatures xsi:type="ecore:EReference" name="process" lowerBound="1" eType="#//Process"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="surface" lowerBound="1" eType="#//Surface"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Exposure">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="host" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="audience" lowerBound="1" eType="#//Audience"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="contentPolicy" eType="#//ContentPolicy"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="routes" lowerBound="1" upperBound="-1" eType="#//Route" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="proxied" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Route">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="match" lowerBound="1" eType="#//Match"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="process" lowerBound="1" eType="#//Process"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="surface" lowerBound="1" eType="#//Surface"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="audience" eType="#//Audience"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="redirectTo" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rateLimit" eType="#//RateLimit" containment="true"/>
  </eClassifiers>
  <!-- How many requests one client may send a route over a period
       (spec/v1/10-project-intent.md#exposure); the burst and who counts as a
       client derive. -->
  <eClassifiers xsi:type="ecore:EClass" name="RateLimit">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="requests" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="per" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SharedIntent" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EReference" name="secrets" upperBound="-1" eType="#//Grant" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="dependsOn" upperBound="-1" eType="#//DependencyEdge" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assets" upperBound="-1" eType="#//AssetDeclaration" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="writablePaths" upperBound="-1" eType="#//WritablePathDeclaration" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="env" upperBound="-1" eType="#//EnvFile" containment="true">
      <eAnnotations source="https://jorisjonkers.dev/deploy-kit/json">
        <details key="document" value="no"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="placement" eType="#//Placement" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="startupBudget" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="cutover" eType="#//Cutover"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Process" eSuperTypes="#//SharedIntent">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lifecycle" lowerBound="1" eType="#//Lifecycle"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="image" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="runtime" lowerBound="1" eType="#//Runtime"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="engine" eType="#//Engine"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="provides" upperBound="-1" eType="#//Surface" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sidecars" upperBound="-1" eType="#//Sidecar" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="probes" eType="#//ProbePolicy" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="volumes" upperBound="-1" eType="#//Volume" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="replicas" eType="#//Capacity" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="api" eType="#//ApiAccess" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="libraries" upperBound="-1" eType="#//LibraryMount" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="egress" eType="#//Egress" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="vpn" eType="#//VpnAttachment" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="schedule" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parked" eType="#//Parked" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="command" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="args" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="spawns" upperBound="-1" eType="#//SpawnTemplate" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rollback" eType="#//Rollback" containment="true"/>
  </eClassifiers>
  <!-- A Process whose traffic leaves through the platform's VPN, and whether it
       receives the forwarded port (spec/v1/10-project-intent.md#vpn-attachment). -->
  <eClassifiers xsi:type="ecore:EClass" name="VpnAttachment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="forwardedPort" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"/>
  </eClassifiers>
  <!-- A destination outside the cluster a Process reaches, and why
       (spec/v1/16-dependencies.md#internet-egress). -->
  <eClassifiers xsi:type="ecore:EClass" name="Egress">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="to" lowerBound="1" eType="#//EgressTarget"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reason" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="EgressTarget">
    <eLiterals name="internet" literal="internet"/>
  </eClassifiers>
  <!-- A library the Platform document grants, mounted by name
       (spec/v1/10-project-intent.md#libraries). The name stays a name, as an
       edge's application does: it is checked when the documents are read together. -->
  <eClassifiers xsi:type="ecore:EClass" name="LibraryMount">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="library" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mountAt" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="subPath" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="access" lowerBound="1" eType="#//LibraryAccess"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="LibraryAccess">
    <eLiterals name="read" literal="read"/>
    <eLiterals name="write" value="1" literal="write"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="EffectiveProject">
    <eAnnotations source="https://jorisjonkers.dev/deploy-kit/json">
      <details key="authored" value="no"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="project" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="owner" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="applications" lowerBound="1" upperBound="-1" eType="#//EffectiveApplication" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="EffectiveApplication">
    <eAnnotations source="https://jorisjonkers.dev/deploy-kit/json">
      <details key="authored" value="no"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="migration" eType="#//Migration" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="observability" eType="#//Observability" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="exposure" upperBound="-1" eType="#//Exposure" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="processes" lowerBound="1" upperBound="-1" eType="#//Process" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="client" eType="#//Client" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="l4Exposure" upperBound="-1" eType="#//L4Exposure" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="dashboards" upperBound="-1" eType="#//Dashboard" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="alertRules" upperBound="-1" eType="#//AlertRules" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Surface" instanceClassName="java.util.Map$Entry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Placement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="memory" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="cpu" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="arch" upperBound="-1" eType="#//Arch"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="site" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="disk" eType="#//DiskRequest" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="gpu" eType="#//GpuRequest" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="capabilities" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DiskRequest">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="media" lowerBound="1" upperBound="-1" eType="#//Media"/>
  </eClassifiers>
  <!-- One card on the node matches every term the request declares; `vendor` and
       `model` are sets of acceptable values (spec/v1/10-project-intent.md#placement). -->
  <eClassifiers xsi:type="ecore:EClass" name="GpuRequest">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="class" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memory" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="vendor" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="model" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Sidecar">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="image" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="memory" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cpu" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="command" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="args" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="volumes" upperBound="-1" eType="#//SidecarMount" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assets" upperBound="-1" eType="#//SidecarAsset" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="init" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DependencyEdge">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="application" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="surface" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="required" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="credentials" eType="#//Credentials" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="buckets" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <!-- Only on an edge to a database: how the credential it derives is delivered and rotates;
       delivered to a file, the directory its username and password land in, and their mode. -->
  <eClassifiers xsi:type="ecore:EClass" name="Credentials">
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="delivery" eType="#//Delivery" defaultValueLiteral="self"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="mountAt" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" unsettable="true" name="fileMode" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rotation" lowerBound="1" eType="#//Rotation" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="EnvFile">
    <eStructuralFeatures xsi:type="ecore:EReference" name="entries" upperBound="-1" eType="#//EnvVariable" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="EnvVariable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="value" lowerBound="1" eType="#//EnvValue" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="EnvValue" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="EnvLiteral" eSuperTypes="#//EnvValue">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="text" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Placeholder" eSuperTypes="#//EnvValue">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="#//PlaceholderKind"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="source" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Literal text after the placeholder: a path after a host, never after a secret. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="suffix" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" unsettable="true"/>
  </eClassifiers>
  <!-- A file beside the project mounted read-only, or seeded once onto a volume
       where the Process may change it (spec/v1/10-project-intent.md#assets). -->
  <eClassifiers xsi:type="ecore:EClass" name="AssetDeclaration" abstract="true">
