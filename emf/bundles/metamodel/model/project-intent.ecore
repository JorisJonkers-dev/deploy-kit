    <eLiterals name="dependency" value="1" literal="dependency"/>
    <eLiterals name="exposure" value="2" literal="exposure"/>
    <eLiterals name="identity" value="3" literal="identity"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Cutover">
    <eAnnotations source="https://jorisjonkers.dev/deploy-kit/json">
      <details key="absent" value="absent"/>
    </eAnnotations>
    <eLiterals name="absent" literal=""/>
    <eLiterals name="continuous" value="1" literal="continuous"/>
    <eLiterals name="interrupted" value="2" literal="interrupted"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="DurabilityClass">
    <eLiterals name="reconstructible" literal="reconstructible"/>
    <eLiterals name="recoverable" value="1" literal="recoverable"/>
    <eLiterals name="irreplaceable" value="2" literal="irreplaceable"/>
