-- The document-level constraints of the Project Intent model, in the graded
-- constraint language (docs/adr/emf/0110). An invariant is named by the
-- diagnostic code it emits, and its context is the object the diagnostic points
-- at, so a violation maps to a (code, path) pair without a lookup table.
--
-- Constraints that need every project at once belong to composition. The Shared
-- Intent invariants are not among them: a declaration and the level above it are
-- always in one document, because a project never spans files.
--
-- The constraints a Platform document and the project files read beside it
-- answer together are here too, because Eclipse OCL binds one Complete OCL
-- document to a package for the thread that loads it. They read the other
-- documents through `allInstances()`, whose extent is the resource set a
-- document was read into, and hold trivially over a document read alone: a
-- `forAll` over no Platform is true, and an `exists` is guarded by one.

-- The registered package, not the file: the constraints must bind to the same
-- classes the parser instantiates.
import 'https://jorisjonkers.dev/deploy-kit/project-intent/1'

package projectintent

context Observability
	-- The block is whole or absent: a class states how loudly to wake someone,
	-- and means nothing without a signal to wake them about.
	inv E_ALERT_CLASS_WITHOUT_SIGNAL: scrape <> null

context Process
	-- A volume cannot attach to the surge a rolling cutover needs, and a silent
	-- downgrade is what makes an owner believe in continuity they do not have.
	-- The effective answer: an RWO volume under an Application declaring
	-- `rolling` is the same defect written one level up.
	inv E_CUTOVER_UNHONOURABLE:
		effectiveCutover = Cutover::rolling implies volumes->isEmpty()

	-- The engine keys the backup method, so it names one nothing asks for when no
	-- volume derives a backup. `Engine::absent` is the literal a document cannot
	-- write: EMF reads an unset enumeration as its first literal, so the model
	-- gives absence one of its own.
	inv E_ENGINE_WITHOUT_DURABILITY:
		engine <> Engine::absent implies
			volumes->exists(durability = DurabilityClass::recoverable or durability = DurabilityClass::irreplaceable)

context Volume
	-- The backup method comes from the Process's engine, and a guessed backup is
	-- the kind nobody finds out about until a restore.
	inv E_DURABILITY_WITHOUT_ENGINE:
		(durability = DurabilityClass::recoverable or durability = DurabilityClass::irreplaceable) implies
			oclContainer().oclAsType(Process).engine <> Engine::absent

context Rotation
	-- An environment variable is read once, when the process starts.
	inv E_ENV_CANNOT_RELOAD:
		tolerates = Tolerance::reload implies oclContainer().oclAsType(Grant).delivery <> Delivery::env

context KvGrant
	-- Custody creates and deletes paths at runtime, and a renewal tier holds no
	-- capability on its path: neither has anything to project.
	inv E_ILLEGAL_DELIVERY_FOR_ACCESS:
		not ((access = AccessTier::custody and (delivery = Delivery::env or delivery = Delivery::file))
			or (access = AccessTier::selfRenew and delivery = Delivery::env))

context TransitGrant
	-- A transit key is used, never read: there is no value to write anywhere.
	inv E_NON_KV_DELIVERY: delivery = Delivery::selfDelivery

context DatabaseGrant
	-- A database credential is minted per lease and re-read at runtime.
	inv E_NON_KV_DELIVERY: delivery = Delivery::selfDelivery

context Route
	-- Precedence is derived, and two routes sharing a path and a match cannot be
	-- ordered by it.
	inv E_DUPLICATE_ROUTE_MATCH:
		oclContainer().oclAsType(Exposure).routes
			->select(r | r.path = self.path and r.match = self.match)->first() = self

context Tier
	-- An authenticated route reaches the proxy with nothing to ask whether the
	-- visitor is allowed in unless the tier names the endpoint that decides.
	inv E_NO_FORWARD_AUTH_ENDPOINT:
		audiences->includes(Audience::authenticated) implies forwardAuth <> null

-- Across documents (spec/v1/14-platform-intent.md#the-model). An invariant sits
-- on the object the author must change, which is why most are on a project's
-- classes. A tier's proxy that names no declared Application is
-- E_UNKNOWN_TIER_PROXY, and is a link that does not resolve rather than an
-- invariant: the reference is an Ecore reference, and the linker finds it has
-- no target.

context Exposure
	-- A route's audience is the only way it reaches a tier.
	inv E_NO_TIER_FOR_AUDIENCE:
		Tier.allInstances()->notEmpty() implies Tier.allInstances()->exists(audiences->includes(self.audience))

context Route
	-- A route that writes its own audience reaches the tier carrying that one.
	-- `Audience::absent` is what an unset audience reads as.
	inv E_NO_TIER_FOR_AUDIENCE:
		(audience <> Audience::absent and Tier.allInstances()->notEmpty())
			implies Tier.allInstances()->exists(audiences->includes(self.audience))

context Process
	-- The backup method is the image the platform names for the engine.
	inv E_NO_ENGINE_POLICY:
		EnginePolicies.allInstances()->forAll(policies |
			(engine = Engine::postgres implies policies.postgres <> null)
			and (engine = Engine::rabbitmq implies policies.rabbitmq <> null)
			and (engine = Engine::valkey implies policies.valkey <> null)
			and (engine = Engine::files implies policies.files <> null))

context Volume
	-- A Durability Class names a guarantee only a platform policy keeps.
	inv E_NO_DURABILITY_POLICY:
		DurabilityPolicies.allInstances()->forAll(policies |
			(durability = DurabilityClass::reconstructible implies policies.reconstructible <> null)
			and (durability = DurabilityClass::recoverable implies policies.recoverable <> null)
			and (durability = DurabilityClass::irreplaceable implies policies.irreplaceable <> null))

context Grant
	-- A secret written into the cluster is readable on disk unless the platform
	-- encrypts secrets at rest.
	inv E_SECRETS_AT_REST_REQUIRED:
		delivery <> Delivery::selfDelivery implies Substrate.allInstances()->forAll(secretsEncryption)

-- Shared Intent (spec/v1/10-project-intent.md#shared-intent). Every invariant
-- below sits on the lower declaration, and on the object that has one where the
-- family has an object at all: a grant, an edge, an asset.

context SharedIntent
	-- The chain is two hops, Project > Application > Process, so this enumerates
	-- rather than closes over it.
	def: levelsAbove : OrderedSet(SharedIntent) =
		if self.oclIsKindOf(Process) and oclContainer().oclIsKindOf(Application)
		then OrderedSet{oclContainer().oclAsType(SharedIntent),
			oclContainer().oclContainer().oclAsType(SharedIntent)}
		else
			if self.oclIsKindOf(Application)
			then OrderedSet{oclContainer().oclAsType(SharedIntent)}
			else OrderedSet{}
			endif
		endif

	-- `absent` when no level answered.
	def: effectiveCutover : Cutover =
		if cutover <> Cutover::absent then cutover
		else
			let answered : OrderedSet(SharedIntent) =
				levelsAbove->select(l | l.cutover <> Cutover::absent) in
			if answered->isEmpty() then Cutover::absent else answered->first().cutover endif
		endif

context Placement
	-- Eligibility sums every container's quantity, so a shared one means
	-- something different for each Process that holds it.
	inv E_SHARED_QUANTITY:
		(memory <> null or cpu <> null) implies oclContainer().oclIsKindOf(Process)

context SharedIntent
	-- The families with no object of their own share one invariant, because they
	-- share the one context an invariant can point at. Each `placement` key
	-- counts separately: `site` above and `arch` below is two declarations of
	-- two things.
	inv E_SHARED_DECLARATION_DUPLICATED:
		levelsAbove->forAll(above |
			(startupBudget <> null implies startupBudget <> above.startupBudget)
			and (cutover <> Cutover::absent implies cutover <> above.cutover)
			and writablePaths->excludesAll(above.writablePaths)
			and ((placement <> null and above.placement <> null) implies
				(placement.arch->notEmpty() implies placement.arch <> above.placement.arch)
				and (placement.site <> null implies placement.site <> above.placement.site)
				and (placement.capabilities->notEmpty() implies
					placement.capabilities <> above.placement.capabilities)
				and (placement.disk <> null implies
					above.placement.disk = null
						or placement.disk.media <> above.placement.disk.media)
				and (placement.gpu <> null implies
					above.placement.gpu = null
						or placement.gpu.memory <> above.placement.gpu.memory
						or placement.gpu._'class' <> above.placement.gpu._'class')))

context DependencyEdge
	-- `required` is included: an edge differing in it is a replacement.
	inv E_SHARED_DECLARATION_DUPLICATED:
		oclContainer().oclAsType(SharedIntent).levelsAbove->forAll(above |
			above.dependsOn->forAll(other |
				not (application = other.application and surface = other.surface
					and required = other.required)))

context Asset
	-- The mount is the identity: two files cannot arrive at one path.
	inv E_SHARED_DECLARATION_DUPLICATED:
		oclContainer().oclAsType(SharedIntent).levelsAbove->forAll(above |
			above.assets->forAll(other | not (mountAt = other.mountAt and from = other.from)))

context Grant
	-- A grant states its rotation or states none, and either way the restatement
	-- has to match for the second declaration to be a duplicate.
	def: sameRotationAs(other : Grant) : Boolean =
		if rotation = null or other.rotation = null then rotation = other.rotation
		else rotation.tolerates = other.rotation.tolerates
			and rotation.maxAge = other.rotation.maxAge
		endif

context KvGrant
	-- The derived read path is the identity; equal terms make it a duplicate
	-- rather than a replacement.
	inv E_SHARED_DECLARATION_DUPLICATED:
		oclContainer().oclAsType(SharedIntent).levelsAbove->forAll(above |
			above.secrets->selectByKind(KvGrant)->forAll(other |
				not (path = other.path and access = other.access and keys = other.keys
					and delivery = other.delivery and mountAt = other.mountAt
					and fileMode = other.fileMode and sameRotationAs(other))))

context DatabaseGrant
	-- The derived read path is `database/creds/<role>`, so the role is the identity.
	inv E_SHARED_DECLARATION_DUPLICATED:
		oclContainer().oclAsType(SharedIntent).levelsAbove->forAll(above |
			above.secrets->selectByKind(DatabaseGrant)->forAll(other |
				not (role = other.role and delivery = other.delivery
					and mountAt = other.mountAt and fileMode = other.fileMode
					and sameRotationAs(other))))

context TransitGrant
	-- One derived read path per operation, so key and operations are the identity.
	inv E_SHARED_DECLARATION_DUPLICATED:
		oclContainer().oclAsType(SharedIntent).levelsAbove->forAll(above |
			above.secrets->selectByKind(TransitGrant)->forAll(other |
				not (key = other.key and operations = other.operations
					and delivery = other.delivery and mountAt = other.mountAt
					and fileMode = other.fileMode and sameRotationAs(other))))

context Process
	-- A quantity is never shared, so nothing above the Process supplies one.
	inv E_PLACEMENT_INCOMPLETE:
		placement <> null and placement.memory <> null and placement.cpu <> null

	-- Required on every Process, and answerable above one, so what is refused is
	-- a Process no level answers for.
	inv E_CUTOVER_MISSING: effectiveCutover <> Cutover::absent

endpackage
