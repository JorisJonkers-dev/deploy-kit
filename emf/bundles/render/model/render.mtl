[module render('https://jorisjonkers.dev/deploy-kit/resolved-deployment/1')/]

[comment The Deliverable Set (spec/v1/30-deliverables.md): one file per Deliverable a Resolved
  Deployment carries, at the path the path plan assigned it. The templates spell the target
  formats and decide nothing: every value is read from the model. A block's body carries two
  spaces of margin that are not written, and a call written at a column repeats that column's
  text before every line it writes, so a shared fragment is spelled once, unindented. /]

[comment @main /]
[template public render(deployment : resolveddeployment::ResolvedDeployment)]
  [for (d : resolveddeployment::Deliverable | deployment.deliverables)]
    [file (d.path, overwrite, 'UTF-8')]
      [d.document()/]
    [/file]
  [/for]
[/template]

[comment A YAML document opens on the one header line, and each object on its own separator. A
  Vault document is JSON, which carries no comment and so no header. /]
[template private document(d : resolveddeployment::Deliverable)]
  [if (d.oclIsKindOf(resolveddeployment::VaultPolicyFile))]
    [d.oclAsType(resolveddeployment::VaultPolicyFile).json()/]
  [elseif (d.oclIsKindOf(resolveddeployment::VaultRoleFile))]
    [d.oclAsType(resolveddeployment::VaultRoleFile).json()/]
  [else]
    # GENERATED. Never hand-edit.
    [d.yaml()/]
  [/if]
[/template]

[template private yaml(d : resolveddeployment::Deliverable)]
  [if (d.oclIsKindOf(resolveddeployment::NamespaceFile))]
    [d.oclAsType(resolveddeployment::NamespaceFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::IndexFile))]
    [d.oclAsType(resolveddeployment::IndexFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::NetworkPolicyFile))]
    [d.oclAsType(resolveddeployment::NetworkPolicyFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::WorkloadFile))]
    [d.oclAsType(resolveddeployment::WorkloadFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::SwitchoverFile))]
    [d.oclAsType(resolveddeployment::SwitchoverFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::IdentityFile))]
    [d.oclAsType(resolveddeployment::IdentityFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::MonitorFile))]
    [d.oclAsType(resolveddeployment::MonitorFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::IngressRouteFile))]
    [d.oclAsType(resolveddeployment::IngressRouteFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::ServiceFile))]
    [d.oclAsType(resolveddeployment::ServiceFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::BudgetFile))]
    [d.oclAsType(resolveddeployment::BudgetFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::MigrationFile))]
    [d.oclAsType(resolveddeployment::MigrationFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::RbacFile))]
    [d.oclAsType(resolveddeployment::RbacFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::PolicyJobFile))]
    [d.oclAsType(resolveddeployment::PolicyJobFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::ClaimFile))]
    [d.oclAsType(resolveddeployment::ClaimFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::ConfigMapFile))]
    [d.oclAsType(resolveddeployment::ConfigMapFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::BackupFile))]
    [d.oclAsType(resolveddeployment::BackupFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::SecretFile))]
    [d.oclAsType(resolveddeployment::SecretFile).objects()/]
  [elseif (d.oclIsKindOf(resolveddeployment::ConnectionFile))]
    [d.oclAsType(resolveddeployment::ConnectionFile).objects()/]
  [/if]
[/template]

[comment ======================================================= project files /]

[template private objects(d : resolveddeployment::NamespaceFile)]
  ---
  apiVersion: v1
  kind: Namespace
  metadata:
    name: [d.namespace/]
    labels:
      app.kubernetes.io/managed-by: deploy-kit
[/template]

[comment An index the estate shares, a tier's under the edge, lists what every Deployment rendered
  beside it puts there, so each writes the same whole file. /]
[template private objects(d : resolveddeployment::IndexFile)]
  ---
  apiVersion: kustomize.config.k8s.io/v1beta1
  kind: Kustomization
  resources:
  [for (r : String | d.listed())]
      - [r/]
  [/for]
[/template]

[comment A project-level file holds no policy: it is the project's default-deny, which selects
  every pod and belongs to no Process. /]
[template private objects(d : resolveddeployment::NetworkPolicyFile)]
  [if (d.policies->isEmpty())]
    ---
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      name: default-deny
      namespace: [d.projectNamespace()/]
      labels:
        app.kubernetes.io/managed-by: deploy-kit
    spec:
      podSelector:
        matchLabels: {}
      policyTypes:
        - Ingress
        - Egress
  [else]
    [for (p : resolveddeployment::ProcessPolicy | d.policies)]
      [p.policy()/]
      [if (p.process.backups()->notEmpty())]
        [p.process.backupPolicy()/]
      [/if]
    [/for]
    [if (d.migration <> null)]
      [d.migration.migrationPolicy()/]
    [/if]
  [/if]
[/template]

[comment The migration identity's own policy: what its plan admits, and nothing in. Its Jobs' pods
  carry the identity as their instance. /]
[template private migrationPolicy(m : resolveddeployment::ResolvedMigration)]
  ---
  apiVersion: networking.k8s.io/v1
  kind: NetworkPolicy
  metadata:
    name: [m.identity/]
    namespace: [m.application().namespace/]
    labels:
      [m.identity.labelSet('none', m.application().id)/]
  spec:
    podSelector:
      matchLabels:
        app.kubernetes.io/instance: [m.identity/]
    policyTypes:
      - Ingress
      - Egress
    egress:
  [for (peer : resolveddeployment::PolicyPeer | m.egress)]
        - to:
            [peer.peer()/]
          ports:
    [if (peer.rule = 'cluster-dns')]
              - protocol: UDP
                port: [peer.port/]
    [/if]
            - protocol: TCP
              port: [peer.port/]
  [/for]
[/template]

[comment A backup identity's own policy. Every backup of a Process runs as the one identity, so
  the policy admits what all of them need: the Process they dump and the cluster's DNS, which
  every plan of the Process shares, and each range any of them copies off-cluster to, once.
  Nothing reaches the identity's pods. /]
[template private backupPolicy(p : resolveddeployment::ResolvedProcess)]
  ---
  apiVersion: networking.k8s.io/v1
  kind: NetworkPolicy
  metadata:
    name: [p.backups()->first().backup.identity/]
    namespace: [p.application().namespace/]
    labels:
      [p.backups()->first().backup.identity.labelSet('none', p.application().id)/]
  spec:
    podSelector:
      matchLabels:
        app.kubernetes.io/instance: [p.backups()->first().backup.identity/]
    policyTypes:
      - Ingress
      - Egress
    egress:
  [for (peer : resolveddeployment::PolicyPeer | p.backups()->first().backup.egress)]
        - to:
            [peer.peer()/]
          ports:
    [if (peer.rule = 'cluster-dns')]
              - protocol: UDP
                port: [peer.port/]
    [/if]
            - protocol: TCP
              port: [peer.port/]
  [/for]
  [for (range : String | p.backupRanges())]
        - to:
            - ipBlock:
                cidr: [range.tokenize(' ')->first()/]
          ports:
            - protocol: TCP
              port: [range.tokenize(' ')->last()/]
  [/for]
[/template]

[template private policy(p : resolveddeployment::ProcessPolicy)]
  ---
  apiVersion: networking.k8s.io/v1
  kind: NetworkPolicy
  metadata:
    [p.process.metadata()/]
  spec:
    podSelector:
      matchLabels:
        app.kubernetes.io/instance: [p.process.name/]
    policyTypes:
      - Ingress
      - Egress
  [if (p.ingress->notEmpty())]
      ingress:
    [for (peer : resolveddeployment::PolicyPeer | p.ingress)]
          - from:
              [peer.peer()/]
            ports:
              - protocol: TCP
                port: [peer.port/]
    [/for]
  [/if]
    egress:
  [comment Every peer of every edge, in one loop: a loop within a loop indents its lines by
    where the policy's other blocks left off, which a policy with no ingress shows. /]
  [for (peer : resolveddeployment::PolicyPeer | p.process.dependencies.peers)]
        - to:
            [peer.peer()/]
          ports:
            - protocol: TCP
              port: [peer.port/]
  [/for]
  [comment The cluster's DNS answers on UDP, and on TCP for a truncated response. /]
  [for (peer : resolveddeployment::PolicyPeer | p.egress)]
        - to:
            [peer.peer()/]
          ports:
            - protocol: UDP
              port: [peer.port/]
            - protocol: TCP
              port: [peer.port/]
  [/for]
  [comment Where the Kubernetes API answers, for a Process that holds access to it: an address,
    because the API server is no pod a selector reaches. /]
  [if (p.process.api <> null)]
    [for (range : resolveddeployment::AdmittedRange | p.process.api.server)]
          - to:
              - ipBlock:
                  cidr: [range.cidr/]
            ports:
              - protocol: TCP
                port: [range.port/]
    [/for]
  [/if]
[/template]

[template private peer(peer : resolveddeployment::PolicyPeer)]
  - namespaceSelector:
      matchLabels:
        kubernetes.io/metadata.name: [peer.namespace/]
  [if (peer.process <> null)]
      podSelector:
        matchLabels:
          app.kubernetes.io/instance: [peer.process/]
  [/if]
[/template]

[comment =================================================== application files /]

[template private metadata(p : resolveddeployment::ResolvedProcess)]
  name: [p.name/]
  namespace: [p.application().namespace/]
  labels:
    [p.labels()/]
[/template]

[template private labels(p : resolveddeployment::ResolvedProcess)]
  [p.name.labelSet(p.component, p.application().id)/]
[/template]

[comment The fixed label set: the name twice, the Application, the manager and the runtime. /]
[template private labelSet(name : String, component : String, application : String)]
  app.kubernetes.io/name: [name/]
  app.kubernetes.io/instance: [name/]
  app.kubernetes.io/part-of: [application/]
  app.kubernetes.io/managed-by: deploy-kit
  app.kubernetes.io/component: [component/]
[/template]

[comment The Process's own ServiceAccount, and one for the backup identity every backup of it runs as. /]
[template private objects(d : resolveddeployment::IdentityFile)]
  [for (p : resolveddeployment::ResolvedProcess | d.processes)]
    ---
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      [p.metadata()/]
    [if (p.backups()->notEmpty())]
      ---
      apiVersion: v1
      kind: ServiceAccount
      metadata:
        [p.backups()->first().backup.backupMetadata(p)/]
    [/if]
  [/for]
[/template]

[template private backupMetadata(b : resolveddeployment::BackupPlan, p : resolveddeployment::ResolvedProcess)]
  name: [b.identity/]
  namespace: [p.application().namespace/]
  labels:
    [b.identity.labelSet('none', p.application().id)/]
[/template]

[template private objects(d : resolveddeployment::MonitorFile)]
  ---
  apiVersion: monitoring.coreos.com/v1
  kind: [d.kind.toString()/]
  metadata:
    [d.process.metadata()/]
  spec:
    jobLabel: app.kubernetes.io/instance
    selector:
      matchLabels:
        app.kubernetes.io/instance: [d.process.name/]
    namespaceSelector:
      matchNames:
        - [d.process.application().namespace/]
    [if (d.kind.toString() = 'PodMonitor')]podMetricsEndpoints[else]endpoints[/if]:
      - port: [d.surface/]
        path: [d.scrapePath/]
        interval: [d.interval/]
        scrapeTimeout: [d.timeout/]
[/template]

[template private objects(d : resolveddeployment::SwitchoverFile)]
  [for (p : resolveddeployment::ResolvedProcess | d.processes)]
    ---
    apiVersion: flagger.app/v1beta1
    kind: Canary
    metadata:
      [p.metadata()/]
    spec:
      provider: kubernetes
      targetRef:
        apiVersion: apps/v1
        kind: Deployment
        name: [p.name/]
    [if (p.replicas > 1)]
        autoscalerRef:
          apiVersion: autoscaling/v2
          kind: HorizontalPodAutoscaler
          name: [p.name/]
    [/if]
      progressDeadlineSeconds: [p.deadline.seconds()/]
      service:
        port: [p.surfaces->first().port/]
        targetPort: [p.surfaces->first().name/]
        portName: [p.surfaces->first().name/]
      analysis:
        interval: [p.application().releaseGate.analysis.interval/]
        iterations: [p.application().releaseGate.analysis.iterations/]
        threshold: [p.application().releaseGate.analysis.threshold/]
        webhooks:
          [p.webhook('may-start', 'confirm-rollout')/]
          [p.webhook('checks', 'rollout')/]
          [p.webhook('may-promote', 'confirm-promotion')/]
    [if (p.replicas > 1)]
      ---
      apiVersion: autoscaling/v2
      kind: HorizontalPodAutoscaler
      metadata:
        [p.metadata()/]
      spec:
        scaleTargetRef:
          apiVersion: apps/v1
          kind: Deployment
          name: [p.name/]
        minReplicas: [p.replicas/]
        maxReplicas: [p.replicas/]
    [/if]
  [/for]
[/template]

[comment The budget of a Process above one replica. A blue-green one's selects the primary by the
  name Flagger gives it, which is what serves between releases; any other's its own pods. /]
[template private objects(d : resolveddeployment::BudgetFile)]
  [for (p : resolveddeployment::ResolvedProcess | d.processes)]
    ---
    apiVersion: policy/v1
    kind: PodDisruptionBudget
    metadata:
      [p.metadata()/]
    spec:
      maxUnavailable: 1
      selector:
        matchLabels:
    [if (p.switchover.toString() = 'blue-green')]
            app.kubernetes.io/name: [p.name/]-primary
    [else]
            app.kubernetes.io/instance: [p.name/]
    [/if]
  [/for]
[/template]

[comment The migration identity and its Jobs (spec/v1/55-delivery.md#failure-and-undo): the up of
  this revision and, where the release was proven against a serving one, the down to it. Both are
  named by the revision's tag, suspended, and created once: the Release Gate alone writes
  `suspend` afterwards. /]
[template private objects(d : resolveddeployment::MigrationFile)]
  ---
  apiVersion: v1
  kind: ServiceAccount
  metadata:
    name: [d.application.migration.identity/]
    namespace: [d.application.namespace/]
    labels:
      [d.application.migration.identity.labelSet('none', d.application.id)/]
  [d.migrationJob(d.application.migration.identity + '-' + d.upTag, 'up', d.upTag)/]
  [if (d.downTag <> null)]
    [d.migrationJob(d.application.migration.identity + '-down-' + d.upTag, 'down', d.downTag)/]
  [/if]
[/template]

[template private migrationJob(d : resolveddeployment::MigrationFile, name : String, command : String, tag : String)]
  ---
  apiVersion: batch/v1
  kind: Job
  metadata:
    name: [name/]
    namespace: [d.application.namespace/]
    labels:
      [d.application.migration.identity.labelSet('none', d.application.id)/]
    annotations:
      kustomize.toolkit.fluxcd.io/ssa: IfNotPresent
  spec:
    suspend: true
    backoffLimit: 0
    activeDeadlineSeconds: [d.application.migration.deadline.seconds()/]
    template:
      metadata:
        labels:
          [d.application.migration.identity.labelSet('none', d.application.id)/]
      spec:
        serviceAccountName: [d.application.migration.identity/]
        automountServiceAccountToken: true
        restartPolicy: Never
        securityContext:
          runAsNonRoot: true
          runAsUser: [d.application.migration.uid/]
          runAsGroup: [d.application.migration.gid/]
          seccompProfile:
            type: RuntimeDefault
        containers:
          - name: migration
            image: [d.application.migration.runner/]
            args:
              - [command/]
              - [tag.scalar()/]
            env:
              - name: DATABASE_HOST
                value: [d.application.migration.database.host/]
              - name: DATABASE_PORT
                value: [d.application.migration.database.port.toString().scalar()/]
              - name: DATABASE_NAME
                value: [d.application.migration.database.name/]
              - name: VAULT_ADDR
                value: [d.application.secretStore/]
              - name: VAULT_ROLE
                value: [d.role/]
              - name: VAULT_CREDENTIALS_PATH
                value: [d.application.migration.credential.paths->first().path/]
            resources:
              requests:
                memory: [d.application.migration.memory/]
                cpu: [d.application.migration.cpu/]
              limits:
                memory: [d.application.migration.memory/]
            securityContext:
              readOnlyRootFilesystem: true
              capabilities:
                drop:
                  - ALL
            volumeMounts:
              - name: scratch
                mountPath: /tmp
        volumes:
          - name: scratch
            emptyDir:
              sizeLimit: [d.application.migration.scratch/]
[/template]

[template private webhook(p : resolveddeployment::ResolvedProcess, name : String, type : String)]
  - name: [name/]
    type: [type/]
    url: [p.application().releaseGate.endpoint/]/[name/]
    metadata:
      application: [p.application().id/]
      process: [p.name/]
      revision: [p.application().revision/]
[/template]

[template private objects(d : resolveddeployment::WorkloadFile)]
  [for (p : resolveddeployment::ResolvedProcess | d.processes)]
    [p.workload(d)/]
  [/for]
[/template]

[comment Flagger scales and promotes a blue-green Deployment, so it carries no replica count and
  its new version starts beside the old one; a rolling one is the delivery machinery's, pod by
  pod under its own count and never a pod more, because a proxy on a host port and a controller
  with no leader election cannot run two copies; a stop-start one keeps its count and stops
  before it starts again. /]
[template private workload(p : resolveddeployment::ResolvedProcess, d : resolveddeployment::WorkloadFile)]
  ---
  apiVersion: apps/v1
  kind: [d.controller.toString()/]
  metadata:
    [p.metadata()/]
  spec:
  [if (p.switchover.toString() = 'blue-green')]
      strategy:
        type: RollingUpdate
        rollingUpdate:
          maxSurge: 1
          maxUnavailable: 0
  [elseif (p.switchover.toString() = 'rolling')]
      replicas: [p.replicas/]
      strategy:
        type: RollingUpdate
        rollingUpdate:
          maxSurge: 0
          maxUnavailable: 1
  [else]
      replicas: [p.replicas/]
      strategy:
        type: Recreate
  [/if]
    progressDeadlineSeconds: [p.deadline.seconds()/]
    selector:
      matchLabels:
        app.kubernetes.io/name: [p.name/]
        app.kubernetes.io/instance: [p.name/]
    template:
      metadata:
        labels:
          [p.labels()/]
      spec:
        serviceAccountName: [p.identity/]
        automountServiceAccountToken: [p.identityToken/]
        securityContext:
          runAsNonRoot: true
          runAsUser: [p.uid/]
          runAsGroup: [p.gid/]
  [comment A volume is written as the image's group, and only a volume is. /]
  [if (p.volumes->notEmpty())]
            fsGroup: [p.gid/]
  [/if]
          seccompProfile:
            type: RuntimeDefault
        containers:
          [p.container()/]
  [for (c : resolveddeployment::ResolvedSidecar | p.sidecars)]
            [c.sidecar(p)/]
  [/for]
  [if (p.volumes->notEmpty() or p.assets->notEmpty() or p.writablePaths->notEmpty() or p.files()->notEmpty())]
          volumes:
    [for (v : resolveddeployment::ResolvedVolume | p.volumes)]
              - name: [v.claim/]
                persistentVolumeClaim:
                  claimName: [v.claim/]
    [/for]
    [for (a : resolveddeployment::ResolvedAsset | p.assets)]
              - name: [a.name/]
                configMap:
                  name: [a.name/]
                  items:
                    - key: [a._from.fileOf()/]
                      path: [a._from.fileOf()/]
    [/for]
    [for (w : resolveddeployment::WritablePath | p.writablePaths)]
              - name: [w.path.writableOf()/]
                emptyDir:
                  sizeLimit: [w.size/]
    [/for]
    [for (g : resolveddeployment::ResolvedGrant | p.files())]
              - name: secret-[g.destination/]
                secret:
                  secretName: [g.destination/]
                  items:
                    - key: [g.keys->first()/]
                      path: [g.mountAt.fileOf()/]
                  defaultMode: [g.fileMode.octal()/]
    [/for]
  [/if]
[/template]

[comment A container beside the Process, under the same posture, the same variables and the same
  file grants: a grant is the Process's, and every container of its pod is the Process. /]
[template private sidecar(c : resolveddeployment::ResolvedSidecar, p : resolveddeployment::ResolvedProcess)]
  - name: [c.name/]
    image: [c.image/]
  [if (p.environment->notEmpty())]
      env:
        [p.env()/]
  [/if]
    resources:
      requests:
        memory: [c.memory/]
        cpu: [c.cpu/]
      limits:
        memory: [c.memory/]
    securityContext:
      readOnlyRootFilesystem: true
      capabilities:
        drop:
          - ALL
  [if (p.files()->notEmpty())]
      volumeMounts:
    [for (g : resolveddeployment::ResolvedGrant | p.files())]
          - name: secret-[g.destination/]
            mountPath: [g.directoryOf()/]
            readOnly: true
    [/for]
  [/if]
[/template]

[comment A variable as written, or a secret reference as one key of the Secret its grant syncs to. /]
[template private env(p : resolveddeployment::ResolvedProcess)]
  [for (e : resolveddeployment::EnvEntry | p.environment)]
    [if (e.secret = null)]
      - name: [e.name/]
        value: [e.value.scalar()/]
    [else]
      - name: [e.name/]
        valueFrom:
          secretKeyRef:
            name: [p.destinationOf(e.secret.path)/]
            key: [e.secret.key/]
    [/if]
  [/for]
[/template]

[template private container(p : resolveddeployment::ResolvedProcess)]
  - name: [p.name/]
    image: [p.image/]
  [if (p.surfaces->notEmpty())]
      ports:
    [for (s : resolveddeployment::ResolvedSurface | p.surfaces)]
          - name: [s.name/]
            containerPort: [s.port/]
    [/for]
  [/if]
  [if (p.environment->notEmpty())]
      env:
        [p.env()/]
  [/if]
    resources:
      requests:
        memory: [p.memory/]
        cpu: [p.cpu/]
      limits:
        memory: [p.memory/]
    securityContext:
      readOnlyRootFilesystem: true
      capabilities:
        drop:
          - ALL
  [if (p.volumes->notEmpty() or p.assets->notEmpty() or p.writablePaths->notEmpty() or p.files()->notEmpty())]
      volumeMounts:
    [for (v : resolveddeployment::ResolvedVolume | p.volumes)]
          - name: [v.claim/]
            mountPath: [v.mountAt/]
    [/for]
    [for (a : resolveddeployment::ResolvedAsset | p.assets)]
          - name: [a.name/]
            mountPath: [a.mountAt/]
            subPath: [a._from.fileOf()/]
            readOnly: true
    [/for]
    [for (w : resolveddeployment::WritablePath | p.writablePaths)]
          - name: [w.path.writableOf()/]
            mountPath: [w.path/]
    [/for]
    [for (g : resolveddeployment::ResolvedGrant | p.files())]
          - name: secret-[g.destination/]
            mountPath: [g.directoryOf()/]
            readOnly: true
    [/for]
  [/if]
  [if (p.readiness <> null)]
      readinessProbe:
        [p.readiness.target.probeTarget()/]
        periodSeconds: [p.readiness.period.seconds()/]
        timeoutSeconds: [p.readiness.timeout.seconds()/]
        failureThreshold: [p.readiness.failures/]
        initialDelaySeconds: 0
  [/if]
  [if (p.liveness <> null)]
      livenessProbe:
        [p.liveness.target.probeTarget()/]
        periodSeconds: [p.liveness.period.seconds()/]
        timeoutSeconds: [p.liveness.timeout.seconds()/]
        failureThreshold: [p.liveness.failures/]
        initialDelaySeconds: 0
  [/if]
  [if (p.startup <> null)]
      startupProbe:
        [p.startup.target.probeTarget()/]
        periodSeconds: [p.startup.period.seconds()/]
        timeoutSeconds: [p.startup.timeout.seconds()/]
        failureThreshold: [p.startup.failures/]
  [/if]
[/template]

[template private probeTarget(t : resolveddeployment::ProbeTarget)]
  [if (t.oclIsKindOf(resolveddeployment::HttpTarget))]
    httpGet:
      path: [t.oclAsType(resolveddeployment::HttpTarget).path/]
      port: [t.oclAsType(resolveddeployment::HttpTarget).port/]
  [else]
    tcpSocket:
      port: [t.oclAsType(resolveddeployment::TcpTarget).tcp/]
  [/if]
[/template]

[comment What a Process that holds Kubernetes API access may ask of it: a ClusterRole of its
  declared rules, bound to its one ServiceAccount, both under the name its namespace and
  identity make. `core` is the group Kubernetes itself spells as no name at all. /]
[template private objects(d : resolveddeployment::RbacFile)]
  [for (p : resolveddeployment::ResolvedProcess | d.processes)]
    ---
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      name: [p.application().namespace/]-[p.identity/]
      labels:
        [p.labels()/]
    rules:
    [for (r : resolveddeployment::ResolvedApiRule | p.api.rules)]
        - apiGroups:
            - [if (r.group = 'core')]""[else][r.group/][/if]
          resources:
      [for (o : String | r.objects)]
              - [o/]
      [/for]
          verbs:
      [for (v : String | r.verbs)]
              - [v/]
      [/for]
    [/for]
    ---
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: [p.application().namespace/]-[p.identity/]
      labels:
        [p.labels()/]
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: [p.application().namespace/]-[p.identity/]
    subjects:
      - kind: ServiceAccount
        name: [p.identity/]
        namespace: [p.application().namespace/]
  [/for]
[/template]

[comment The Service a Process Flagger does not switch is reached by; Flagger generates a
  blue-green one's. /]
[template private objects(d : resolveddeployment::ServiceFile)]
  [for (p : resolveddeployment::ResolvedProcess | d.processes)]
    ---
    apiVersion: v1
    kind: Service
    metadata:
      [p.metadata()/]
    spec:
      selector:
        app.kubernetes.io/instance: [p.name/]
      ports:
    [for (s : resolveddeployment::ResolvedSurface | p.surfaces)]
          - name: [s.name/]
            port: [s.port/]
            targetPort: [s.name/]
    [/for]
  [/for]
[/template]

[comment A claim for each volume, and for each backed-up one the claim its copies land on, at the same
  size. A claim whose class derives a backup is never pruned, and neither is its copies'. /]
[template private objects(d : resolveddeployment::ClaimFile)]
  [for (p : resolveddeployment::ResolvedProcess | d.processes)]
    [for (v : resolveddeployment::ResolvedVolume | p.volumes)]
      [p.claim(v.claim, v.size, v.backup <> null)/]
      [if (v.backup <> null)]
        [p.claim(v.backup.claim, v.size, true)/]
      [/if]
    [/for]
  [/for]
[/template]

[template private claim(p : resolveddeployment::ResolvedProcess, name : String, size : String, kept : Boolean)]
  ---
  apiVersion: v1
  kind: PersistentVolumeClaim
  metadata:
    name: [name/]
    namespace: [p.application().namespace/]
    labels:
      [p.labels()/]
  [if (kept)]
      annotations:
        kustomize.toolkit.fluxcd.io/prune: disabled
  [/if]
  spec:
    accessModes:
      - ReadWriteOnce
    resources:
      requests:
        storage: [size/]
[/template]

[comment The Release Gate's inputs first, in a ConfigMap named for the Application that keeps its
  name across releases and so is not immutable; then an immutable ConfigMap per Asset, under the
  content-named name an edit changes. /]
[template private objects(d : resolveddeployment::ConfigMapFile)]
  [if (d.releaseGate <> null)]
    ---
    apiVersion: v1
    kind: ConfigMap
    metadata:
      name: [d.application.id/]-release-gate
      namespace: [d.application.namespace/]
      labels:
        app.kubernetes.io/part-of: [d.application.id/]
        app.kubernetes.io/managed-by: deploy-kit
    data:
      releaseGate.json: |
        [d.releaseGate/]
  [/if]
  [for (p : resolveddeployment::ResolvedProcess | d.processes)]
    [for (a : resolveddeployment::ResolvedAsset | p.assets)]
      ---
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: [a.name/]
        namespace: [p.application().namespace/]
        labels:
          [p.labels()/]
      immutable: true
      data:
        [a._from.fileOf()/]: [a.content.chomping()/]
      [a.content.blockOf('    ')/]
    [/for]
  [/for]
[/template]

[comment A backup per backed-up volume, at its class's schedule: the engine's method image, run as the
  backup identity, reading the volume at `/data` and writing its copies to the backup claim at
  `/backup`, pruned to `retain`. /]
[template private objects(d : resolveddeployment::BackupFile)]
  [for (p : resolveddeployment::ResolvedProcess | d.processes)]
    [for (v : resolveddeployment::ResolvedVolume | p.backups())]
      [v.backup.cronJob(v, p)/]
    [/for]
  [/for]
[/template]

[template private cronJob(b : resolveddeployment::BackupPlan, v : resolveddeployment::ResolvedVolume, p : resolveddeployment::ResolvedProcess)]
  ---
  apiVersion: batch/v1
  kind: CronJob
  metadata:
    name: [b.claim/]
    namespace: [p.application().namespace/]
    labels:
      [b.identity.labelSet('none', p.application().id)/]
  spec:
    schedule: [b.schedule.scalar()/]
    concurrencyPolicy: Forbid
    jobTemplate:
      spec:
        template:
          metadata:
            labels:
              [b.identity.labelSet('none', p.application().id)/]
          spec:
            serviceAccountName: [b.identity/]
            automountServiceAccountToken: false
            restartPolicy: OnFailure
            securityContext:
              runAsNonRoot: true
              runAsUser: [b.uid/]
              runAsGroup: [b.gid/]
              fsGroup: [b.gid/]
              seccompProfile:
                type: RuntimeDefault
            containers:
              - name: backup
                image: [b.method/]
                env:
                  - name: BACKUP_RETAIN
                    value: [b.retain.toString().scalar()/]
  [if (b.offCluster <> null)]
                    - name: BACKUP_OFF_CLUSTER
                      value: [b.offCluster.scalar()/]
  [/if]
  [if (b.credential <> null)]
                  envFrom:
                    - secretRef:
                        name: [b.credential.destination/]
  [/if]
                securityContext:
                  readOnlyRootFilesystem: true
                  capabilities:
                    drop:
                      - ALL
                volumeMounts:
                  - name: data
                    mountPath: /data
                    readOnly: true
                  - name: backup
                    mountPath: /backup
            volumes:
              - name: data
                persistentVolumeClaim:
                  claimName: [v.claim/]
                  readOnly: true
              - name: backup
                persistentVolumeClaim:
                  claimName: [b.claim/]
[/template]

[comment ========================================================= the operator /]

[comment The operator's connection to the Secret Store. TLS is never skipped: the schema asks, and
  the answer is fixed. /]
[template private objects(d : resolveddeployment::ConnectionFile)]
  ---
  apiVersion: secrets.hashicorp.com/v1beta1
  kind: VaultConnection
  metadata:
    name: secret-store
    namespace: [d.namespace/]
    labels:
      app.kubernetes.io/managed-by: deploy-kit
  spec:
    address: [d.address/]
    skipTLSVerify: false
[/template]

[comment For each holder, how the operator authenticates as it, then one synced Secret per grant, read
  every hour from the kv mount, never tracked by Flagger, and restarting what is serving. /]
[template private objects(d : resolveddeployment::SecretFile)]
  [for (h : resolveddeployment::SecretHolder | d.holders)]
    ---
    apiVersion: secrets.hashicorp.com/v1beta1
    kind: VaultAuth
    metadata:
      [h.holderMetadata(d.application)/]
    spec:
      vaultConnectionRef: secret-store
      method: kubernetes
      mount: kubernetes
      kubernetes:
        role: [d.application.namespace/]-[h.identity/]
        serviceAccount: [h.identity/]
    [for (g : resolveddeployment::ResolvedGrant | h.grants)]
      ---
      apiVersion: secrets.hashicorp.com/v1beta1
      kind: VaultStaticSecret
      metadata:
        name: [g.destination/]
        namespace: [d.application.namespace/]
        labels:
          [h.identity.labelSet(h.component, d.application.id)/]
      spec:
        vaultAuthRef: [h.identity/]
        mount: secret
        type: kv-v2
        path: [g.path.substring(13)/]
        refreshAfter: 1h
        destination:
          name: [g.destination/]
          create: true
          annotations:
            flagger.app/config-tracking: disabled
      [if (g.restartTargets->notEmpty())]
          rolloutRestartTargets:
        [for (t : String | g.restartTargets)]
              - kind: Deployment
                name: [d.application.serving(t)/]
        [/for]
      [/if]
    [/for]
  [/for]
[/template]

[template private holderMetadata(h : resolveddeployment::SecretHolder, a : resolveddeployment::ResolvedApplication)]
  name: [h.identity/]
  namespace: [a.namespace/]
  labels:
    [h.identity.labelSet(h.component, a.id)/]
[/template]

[comment ============================================================ Vault /]

[comment What each grant may do: the paths a transit or database grant's engine derives, or `read` on
  a kv grant's path and on the same document's metadata. /]
[template private json(d : resolveddeployment::VaultPolicyFile)]
  {
    "path": {
  [for (k : String | d.policyPaths()) separator(',\n')]
        "[k/]": {
          "capabilities": ['['/]
    [for (c : String | d.allowsAt(k)) separator(',\n')]
              "[c/]"[/for]
          ]
        }[/for]
    }
  }
[/template]

[template private json(d : resolveddeployment::VaultRoleFile)]
  {
    "bound_service_account_names": [ '[' /]
      "[d.identity/]"
    ],
    "bound_service_account_namespaces": [ '[' /]
      "[d.namespace/]"
    ],
    "token_policies": [ '[' /]
      "[d.namespace/]-[d.identity/]"
    ]
  }
[/template]

[comment The Vault policy job: the ServiceAccount it runs as, the ConfigMap that hands it every
  document of this render as canonical JSON on one line, the Job that writes them into the Secret
  Store, and the job's own policy. The ConfigMap and the Job share the name the documents' digest
  gives them. /]
[template private objects(d : resolveddeployment::PolicyJobFile)]
  [if (d.part = 'serviceaccount')]
    ---
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      name: [d.job.identity/]
      namespace: [d.job.namespace/]
      labels:
        [d.job.identity.labelSet('none', d.job.identity)/]
  [elseif (d.part = 'configmap')]
    ---
    apiVersion: v1
    kind: ConfigMap
    metadata:
      name: [d.name/]
      namespace: [d.job.namespace/]
      labels:
        [d.job.identity.labelSet('none', d.job.identity)/]
    immutable: true
    data:
    [for (document : resolveddeployment::PolicyDocument | d.documents)]
        [document.file/]: |
          [document.json/]
    [/for]
  [elseif (d.part = 'job')]
    ---
    apiVersion: batch/v1
    kind: Job
    metadata:
      name: [d.name/]
      namespace: [d.job.namespace/]
      labels:
        [d.job.identity.labelSet('none', d.job.identity)/]
    spec:
      activeDeadlineSeconds: [d.job.deadline.seconds()/]
      template:
        metadata:
          labels:
            [d.job.identity.labelSet('none', d.job.identity)/]
        spec:
          serviceAccountName: [d.job.identity/]
          automountServiceAccountToken: true
          restartPolicy: OnFailure
          securityContext:
            runAsNonRoot: true
            runAsUser: [d.job.uid/]
            runAsGroup: [d.job.gid/]
            seccompProfile:
              type: RuntimeDefault
          containers:
            - name: [d.job.identity/]
              image: [d.job.image/]
              env:
                - name: VAULT_ADDR
                  value: [d.job.address/]
                - name: VAULT_ROLE
                  value: [d.job.role/]
                - name: POLICIES_DIR
                  value: /policies
              resources:
                requests:
                  memory: [d.job.memory/]
                  cpu: [d.job.cpu/]
                limits:
                  memory: [d.job.memory/]
              securityContext:
                readOnlyRootFilesystem: true
                capabilities:
                  drop:
                    - ALL
              volumeMounts:
                - name: policies
                  mountPath: /policies
                  readOnly: true
          volumes:
            - name: policies
              configMap:
                name: [d.name/]
                items:
    [for (document : resolveddeployment::PolicyDocument | d.documents)]
                    - key: [document.file/]
                      path: [document.file/]
    [/for]
  [else]
    ---
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      name: [d.job.identity/]
      namespace: [d.job.namespace/]
      labels:
        [d.job.identity.labelSet('none', d.job.identity)/]
    spec:
      podSelector:
        matchLabels:
          app.kubernetes.io/instance: [d.job.identity/]
      policyTypes:
        - Ingress
        - Egress
      egress:
    [for (peer : resolveddeployment::PolicyPeer | d.job.egress)]
          - to:
              [peer.peer()/]
            ports:
      [if (peer.rule = 'cluster-dns')]
                - protocol: UDP
                  port: [peer.port/]
      [/if]
              - protocol: TCP
                port: [peer.port/]
    [/for]
  [/if]
[/template]

[comment ============================================================ the edge /]

[comment A route set belongs to an Application and to none of its Processes. /]
[template private objects(d : resolveddeployment::IngressRouteFile)]
  ---
  apiVersion: traefik.io/v1alpha1
  kind: IngressRoute
  metadata:
    name: [d.exposure.application().id/]-[d.exposure.name/]
    namespace: [d.exposure.application().namespace/]
    labels:
      app.kubernetes.io/part-of: [d.exposure.application().id/]
      app.kubernetes.io/managed-by: deploy-kit
  spec:
    entryPoints:
      - [d.entryPoint/]
    routes:
  [for (r : resolveddeployment::ResolvedRoute | d.exposure.routes)]
        [r.route(d.exposure)/]
  [/for]
  [if (d.certificateResolver <> null)]
      tls:
        certResolver: [d.certificateResolver/]
  [/if]
[/template]

[comment Traefik tries the higher priority first, and precedence 1 is matched first. /]
[template private route(r : resolveddeployment::ResolvedRoute, e : resolveddeployment::ResolvedExposure)]
  - kind: Rule
    match: Host(`[e.host/]`) && [if (r.match.toString() = 'exact')]Path[else]PathPrefix[/if](`[r.path/]`)
    priority: [1000 - r.precedence/]
    middlewares:
  [for (m : resolveddeployment::MiddlewareStep | r.middleware)]
        - name: [m.middlewareName()/]
          namespace: [e.proxyNamespace/]
  [/for]
    services:
      - name: [r.process.name/]
        namespace: [e.application().namespace/]
        port: [r.process.surfaces->select(s | s.name = r.surface)->first().port/]
[/template]

[comment ============================================================= queries /]

[query private application(p : resolveddeployment::ResolvedProcess) : resolveddeployment::ResolvedApplication =
  p.eContainer().oclAsType(resolveddeployment::ResolvedApplication) /]

[query private application(m : resolveddeployment::ResolvedMigration) : resolveddeployment::ResolvedApplication =
  m.eContainer().oclAsType(resolveddeployment::ResolvedApplication) /]

[query private application(e : resolveddeployment::ResolvedExposure) : resolveddeployment::ResolvedApplication =
  e.eContainer().oclAsType(resolveddeployment::ResolvedApplication) /]

[query private projectNamespace(d : resolveddeployment::Deliverable) : String =
  d.eContainer().oclAsType(resolveddeployment::ResolvedDeployment).applications->first().namespace /]

[comment A duration as whole seconds: `60s` is 60, `10m` 600 and `1h` 3600. /]
[query private seconds(duration : String) : Integer =
  let amount : Integer = duration.substring(1, duration.size() - 1).toInteger() in
  if duration.endsWith('h') then amount * 3600
  else if duration.endsWith('m') then amount * 60 else amount endif endif /]

[query private listed(d : resolveddeployment::IndexFile) : Sequence(String) =
  resolveddeployment::IndexFile.allInstances()->select(i | i.path = d.path).resources
    ->asOrderedSet()->sortedBy(r | r) /]

[comment The volumes whose class derives a backup. /]
[comment Every range a backup of the Process copies off-cluster to, as `<cidr> <port>`, once each
  in the order met. /]
[query private backupRanges(p : resolveddeployment::ResolvedProcess) : Sequence(String) =
  p.backups().backup.destinations
    ->collect(r | r.cidr + ' ' + r.port.toString())->asOrderedSet()->asSequence() /]

[query private backups(p : resolveddeployment::ResolvedProcess) : Sequence(resolveddeployment::ResolvedVolume) =
  p.volumes->select(v | v.backup <> null) /]

[comment The file an Asset arrives as: the last segment of the path it is read from. /]
[query private fileOf(source : String) : String = source.tokenize('/')->last() /]

[comment A writable path's volume, named for the path. /]
[query private writableOf(path : String) : String = 'writable' + path.replaceAll('[^a-z0-9]+', '-') /]

[comment The Secret a kv grant on `path` syncs to, for the Process's own variables. /]
[comment The Process's grants delivered as files, each synced to a Secret. /]
[query private files(p : resolveddeployment::ResolvedProcess) : OrderedSet(resolveddeployment::ResolvedGrant) =
  p.secrets->select(g | g.delivery = 'file' and g.destination <> null) /]

[comment Where a file grant's file lands is mounted whole, the directory of its mountAt, so a rotated
  value reaches the file, which a mount of the one file would never see again. /]
[query private directoryOf(g : resolveddeployment::ResolvedGrant) : String =
  g.mountAt.substring(1, g.mountAt.size() - g.mountAt.fileOf().size() - 1) /]

[comment An octal file mode, such as 0400, as the number a volume's defaultMode holds. /]
[query private octal(mode : String) : Integer =
  if mode.size() = 1 then mode.toInteger()
  else mode.substring(1, mode.size() - 1).octal() * 8 + mode.substring(mode.size(), mode.size()).toInteger() endif /]

[query private destinationOf(p : resolveddeployment::ResolvedProcess, path : String) : String =
  p.secrets->select(g | g.destination <> null and g.path = path)->first().destination /]

[comment The Deployment a rotation restarts: a blue-green Process serves from its primary. /]
[query private serving(a : resolveddeployment::ResolvedApplication, name : String) : String =
  if a.processes->select(p | p.name = name)->first().switchover.toString() = 'blue-green'
  then name + '-primary' else name endif /]

[comment Every path a policy names, in its grants' order: the paths a transit or database grant's
  engine derives, or a kv grant's path and the same document's metadata. /]
[query private policyPaths(d : resolveddeployment::VaultPolicyFile) : Sequence(String) =
  d.grants->collect(g | if g.engine <> null then g.paths.path
    else Sequence{g.path, g.path.replace('^secret/data/', 'secret/metadata/')} endif) /]

[comment What a policy allows at one path: an engine's own, or `read` on a kv grant's document. /]
[query private allowsAt(d : resolveddeployment::VaultPolicyFile, path : String) : Sequence(String) =
  let derived : Sequence(resolveddeployment::PolicyPath) = d.grants.paths->select(e | e.path = path) in
  if derived->isEmpty() then Sequence{'read'} else derived->first().allows endif /]

[comment How a block scalar keeps its last line break: once, not at all, or every one. /]
[query private chomping(content : String) : String =
  if content.endsWith('\n\n') then '|+' else if content.endsWith('\n') then '|' else '|-' endif endif /]

[comment A block scalar's body: every line under `indent`, a blank line left blank. /]
[query private blockOf(content : String, indent : String) : String =
  (if content.endsWith('\n') then content.substring(1, content.size() - 1) else content endif)
    .replaceAll('(?m)^(?=.)', indent) /]

[query private middlewareName(m : resolveddeployment::MiddlewareStep) : String =
  if m.kind.toString() = 'forward-auth' then 'forward-auth'
  else if m.contentPolicy = null then 'security-headers' else 'security-headers-' + m.contentPolicy endif endif /]

[comment A string scalar, double-quoted where the YAML 1.2 core schema would read it as null, a
  boolean, an integer or a float, and written plain otherwise. /]
[query private scalar(value : String) : String =
  if value.matches('|~|null|Null|NULL|true|True|TRUE|false|False|FALSE|[-+]?[0-9]+|0o[0-7]+|0x[0-9a-fA-F]+|[-+]?([.][0-9]+|[0-9]+([.][0-9]*)?)([eE][-+]?[0-9]+)?|[-+]?[.](inf|Inf|INF)|[.](nan|NaN|NAN)')
  then '"' + value + '"' else value endif /]
