<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Runs model/render.mtl over minimal in Eclipse, the run the pipeline makes
  headless: the Resolved Deployment `./mvnw verify` leaves under the pipeline's
  parity output in, its Deliverable Set out, under this project's target/.
-->
<launchConfiguration type="org.eclipse.acceleo.aql.ls.debug.ide.launchConfigurationType">
    <stringAttribute key="module" value="/dev.jorisjonkers.deploykit.emf.render/model/render.mtl"/>
    <stringAttribute key="model" value="/dev.jorisjonkers.deploykit.emf.cli/target/parity/minimal/notes.resolveddeployment"/>
    <stringAttribute key="destination" value="/dev.jorisjonkers.deploykit.emf.render/target/render"/>
</launchConfiguration>
