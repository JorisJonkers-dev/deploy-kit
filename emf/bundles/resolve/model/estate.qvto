-- The estate-wide pass (spec/v1/30-deliverables.md#vault-configuration-is-rendered-not-applied):
-- the Resolved Deployments of every project rendered together, to what no single project's
-- resolution owns while the estate is handed over: the catalog of a datastore the old path
-- still runs, and the job that writes that catalog's documents.
-- Each Project's own policy job is its resolution's. What is planned here is added to the first
-- document's Deliverables.
--
-- Hashing is the one operation done outside the language, as in the resolution.
import dev.jorisjonkers.deploykit.emf.hashing;

modeltype RD uses 'https://jorisjonkers.dev/deploy-kit/resolved-deployment/1';

transformation estate(inout rendered : RD)
	access library Hashing;

-- The estate-wide directory the job's objects land in, beside the documents.
property DIRECTORY : String = 'estate/vso-secrets/';

-- Where every identity's Vault documents land, a catalog method's among them.
property POLICIES : String = 'estate/vso-secrets/policies/';


-- How many hex digits of the documents' digest the job's name carries, after
-- the algorithm a digest opens with.
property ALGORITHM : String = 'sha256:';
property NAME_DIGITS : Integer = 12;

main() {
	var deployments : Sequence(ResolvedDeployment) := rendered.rootObjects()[ResolvedDeployment]->asSequence();
	-- Each catalog method of a datastore the old path still runs, whose catalog names a project
	-- of the render: one its datastore's own project planned, on the estate path, is that
	-- project's, and so is the job that writes its documents.
	var catalogs : Sequence(String) := Sequence{};
	var namespaces : Set(String) := Set{};
	if (deployments->notEmpty()) {
		var projectsRendered : Set(String) := deployments.applications.project->asSet();
		var owned : Set(String) := deployments.deliverables
			->select(d | d.oclIsKindOf(CatalogJobFile))->collect(d | d.oclAsType(CatalogJobFile))
			->select(f | f.part = 'objects')->collect(f | f.job.namespace + '/' + f.job.identity)->asSet();
		deployments->first().catalogJobs
			->select(c | not owned->includes(c.namespace + '/' + c.identity))
			->select(c | c.catalog.databases->exists(db | projectsRendered->exists(p | db.name = p + '_db')))
			->forEach(c) {
				var catalog : String := c.catalog.catalogJson();
				var digest : String := obj(Sequence{
					Tuple{k = 'catalog', v = catalog},
					Tuple{k = 'image', v = str(c.image)},
					Tuple{k = 'uid', v = c.uid.toString()},
					Tuple{k = 'gid', v = c.gid.toString()},
					Tuple{k = 'memory', v = str(c.memory)},
					Tuple{k = 'cpu', v = str(c.cpu)},
					Tuple{k = 'deadline', v = str(c.deadline)},
					Tuple{k = 'eligibleNodes', v = arr(c.eligibleNodes->collect(n | str(n)))}}).rawDigestOf();
				var named : String := c.identity + '-'
					+ digest.substring(ALGORITHM.size() + 1, ALGORITHM.size() + NAME_DIGITS);
				deployments->first().deliverables += object CatalogJobFile {
					path := DIRECTORY + c.identity + '.yaml';
					adapter := AdapterName::kubernetes;
					part := 'objects'; name := named; catalogJson := catalog; job := c; };
				deployments->first().deliverables += object CatalogJobFile {
					path := DIRECTORY + c.identity + '-networkpolicy.yaml';
					adapter := AdapterName::networking;
					part := 'networkpolicy'; job := c; };
				deployments->first().deliverables += object CatalogJobFile {
					path := POLICIES + c.role + '.policy.json';
					adapter := AdapterName::vaultPolicy;
					part := 'policy'; job := c; };
				deployments->first().deliverables += object VaultRoleFile {
					path := POLICIES + c.role + '.role.json';
					adapter := AdapterName::vaultPolicy;
					namespace := c.namespace;
					identity := c.identity; };
				catalogs := catalogs->append(c.identity + '.yaml');
				namespaces := namespaces->including(c.namespace);
			};
	};
	-- One estate-scoped job writes one namespace's names: its writer is confined to them.
	if (namespaces->size() > 1) {
		assert fatal (false) with log('catalogs the old path runs in more than one namespace');
	};
	var jobs : Sequence(ResolvedPolicyJob) := deployments.policyJob->select(j | j <> null)->asSequence();
	var held : Sequence(Tuple(file : String, json : String)) := deployments.deliverables
		->select(d | d.path.startsWith(POLICIES))
		->collect(d | d.documentOf())->select(d | d <> null)->asSequence()->sortedBy(d | d.file);
	-- One render has one platform, so every project's document carries the same job.
	if (jobs->exists(j | j.namespace <> jobs->first().namespace or j.image <> jobs->first().image)) {
		assert fatal (false) with log('the projects of one render carry different Vault policy jobs');
	};
	-- No estate-scoped job where the platform names none, or no old-path catalog is applied.
	if (jobs->notEmpty() and held->notEmpty()) {
		var planned : ResolvedPolicyJob := jobs->first();
		-- The documents and everything the pod template runs with: a Job's template never
		-- changes once created, so any change to it is a new name.
		var digest : String := obj(Sequence{
			Tuple{k = 'documents', v = '{' + joined(held->collect(d | str(d.file) + ':' + d.json)) + '}'},
			Tuple{k = 'image', v = str(planned.image)},
			Tuple{k = 'uid', v = planned.uid.toString()},
			Tuple{k = 'gid', v = planned.gid.toString()},
			Tuple{k = 'memory', v = str(planned.memory)},
			Tuple{k = 'cpu', v = str(planned.cpu)},
			Tuple{k = 'deadline', v = str(planned.deadline)},
			Tuple{k = 'eligibleNodes', v = arr(planned.eligibleNodes->collect(n | str(n)))}}).rawDigestOf();
		var named : String := planned.identity + '-'
			+ digest.substring(ALGORITHM.size() + 1, ALGORITHM.size() + NAME_DIGITS);
		var ns : String := namespaces->any(true);
		deployments->first().deliverables += Sequence{'configmap', 'job', 'cronjob', 'serviceaccount', 'networkpolicy'}
			->collect(piece | object PolicyJobFile {
				path := DIRECTORY + piece + '.yaml';
				adapter := if piece = 'networkpolicy' then AdapterName::networking else AdapterName::vaultPolicy endif;
				part := piece;
				name := named;
				namespace := ns;
				job := planned;
				documents := held->collect(d | object PolicyDocument { file := d.file; json := d.json; });
			});
		-- A policy file is listed nowhere while the policy stage is render-only.
		deployments->first().deliverables += object IndexFile {
			path := DIRECTORY + 'kustomization.yaml';
			adapter := AdapterName::kubernetes;
			resources := Sequence{'configmap.yaml', 'cronjob.yaml', 'job.yaml', 'serviceaccount.yaml'}
				->union(catalogs)->sortedBy(r | r);
		};
	};
}

-- A Vault document as the job is handed it: its file name, and its content as
-- canonical JSON. Any other Deliverable is none.
query Deliverable::documentOf() : Tuple(file : String, json : String) =
	if self.oclIsKindOf(VaultPolicyFile) then
		Tuple{file = fileOf(self.path), json = self.oclAsType(VaultPolicyFile).policyJson()}
	else if self.oclIsKindOf(VaultRoleFile) then
		Tuple{file = fileOf(self.path), json = self.oclAsType(VaultRoleFile).roleJson()}
	else if self.oclIsKindOf(GeneratedKeysFile) then
		Tuple{file = fileOf(self.path), json = self.oclAsType(GeneratedKeysFile).keysJson()}
	else if self.oclIsKindOf(CatalogJobFile) and self.oclAsType(CatalogJobFile).part = 'policy' then
		Tuple{file = fileOf(self.path), json = self.oclAsType(CatalogJobFile).job.catalogPolicyJson()}
	else null endif endif endif endif;

-- A catalog as its method is handed it.
query ResolvedCatalog::catalogJson() : String =
	obj(Sequence{
		Tuple{k = 'admin', v = obj(Sequence{
			Tuple{k = 'path', v = str(self.admin.path)},
			Tuple{k = 'user', v = str(self.admin.user)},
			Tuple{k = 'password', v = str(self.admin.password)}})},
		Tuple{k = 'connection', v = str(self.connection)},
		Tuple{k = 'databases', v = arr(self.databases->collect(d | obj(Sequence{
			Tuple{k = 'name', v = str(d.name)},
			Tuple{k = 'owner', v = str(d.owner)},
			Tuple{k = 'data', v = str(d.data)}}))->asSequence())},
		Tuple{k = 'host', v = str(self.host)},
		Tuple{k = 'port', v = self.port.toString()}});

-- A catalog method's own policy: it reads its login, and writes each database role it names.
query ResolvedCatalogJob::catalogPolicyJson() : String =
	obj(Sequence{Tuple{k = 'path', v = obj(Sequence{
		Tuple{k = self.catalog.admin.path, v = capabilities(Sequence{'read'})},
		Tuple{k = 'secret/metadata/' + self.catalog.admin.path.substring(KV_DATA.size() + 1, self.catalog.admin.path.size()), v = capabilities(Sequence{'read'})}}
		->union(self.catalog.databases->collect(d | Sequence{d.owner, d.data})->flatten()
			->collect(r | Tuple{k = 'database/roles/' + r, v = capabilities(Sequence{'create', 'read', 'update'})})
			->asSequence()))}});

-- What each grant may do: the paths a transit or database grant's engine
-- derives, or `read` on a kv grant's path and on the same document's metadata.
query VaultPolicyFile::policyJson() : String =
	obj(Sequence{Tuple{k = 'path', v = obj(self.grants->collect(g | g.allowed())->flatten())}});

query ResolvedGrant::allowed() : Sequence(Tuple(k : String, v : String)) =
	if self.engine <> null then self.paths->collect(p |
		Tuple{k = p.path, v = capabilities(p.allows->asSequence())})
	else Sequence{
		Tuple{k = self.path, v = capabilities(Sequence{'read'})},
		Tuple{k = 'secret/metadata/' + self.path.substring(KV_DATA.size() + 1, self.path.size()),
			v = capabilities(Sequence{'read'})}} endif;

property KV_DATA : String = 'secret/data/';

query capabilities(allows : Sequence(String)) : String =
	obj(Sequence{Tuple{k = 'capabilities', v = arr(allows->collect(a | str(a)))}});

-- Each key the job generates, where, and how.
query GeneratedKeysFile::keysJson() : String =
	obj(Sequence{Tuple{k = 'keys', v = arr(self.keys->collect(x | obj(Sequence{
		Tuple{k = 'path', v = str(x.path)},
		Tuple{k = 'key', v = str(x.key)},
		Tuple{k = 'bytes', v = x.bytes.toString()},
		Tuple{k = 'encoding', v = str(x.encoding)}}
		->union(if x.adoptPath = null then Sequence{} else Sequence{
			Tuple{k = 'adopt', v = obj(Sequence{
				Tuple{k = 'path', v = str(x.adoptPath)},
				Tuple{k = 'key', v = str(x.adoptKey)}})}} endif))))}});

-- The role that binds the identity's ServiceAccount, in its namespace, to the
-- one policy of its name.
query VaultRoleFile::roleJson() : String =
	obj(Sequence{
		Tuple{k = 'bound_service_account_names', v = arr(Sequence{str(self.identity)})},
		Tuple{k = 'bound_service_account_namespaces', v = arr(Sequence{str(self.namespace)})},
		Tuple{k = 'token_policies', v = arr(Sequence{str(self.namespace + '-' + self.identity)})}});

-- The last segment of a path: the name a document is mounted and written under.
query fileOf(path : String) : String = path.substring(path.lastIndexOf('/') + 1, path.size());

-- ------------------------------------------------------------ canonical JSON

-- An object of its entries, in key order.
query obj(entries : Sequence(Tuple(k : String, v : String))) : String =
	'{' + joined(entries->sortedBy(e | e.k)->collect(e | str(e.k) + ':' + e.v)) + '}';

query arr(items : Sequence(String)) : String = '[' + joined(items) + ']';

-- The items, comma-separated; no item is empty, since each is a JSON value.
query joined(items : Sequence(String)) : String =
	items->iterate(i; acc : String = '' | if acc = '' then i else acc + ',' + i endif);

-- A JSON string. A Vault path and a Kubernetes name hold nothing JSON escapes.
query str(s : String) : String = '"' + s + '"';
