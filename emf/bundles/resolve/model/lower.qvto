-- The lowering (spec/v1/10-project-intent.md#the-effective-intent,
-- docs/adr/model/0012-shared-intent-descends-and-is-lowered.md). Source and target are the same metamodel: the shapes
-- differ only in that EffectiveProject and EffectiveApplication carry no
-- SharedIntent. Total, because every refusal it depends on fires before it.
modeltype PI uses 'https://jorisjonkers.dev/deploy-kit/project-intent/1';
modeltype ECORE uses 'http://www.eclipse.org/emf/2002/Ecore';

transformation lower(in source : PI, out target : PI);

main() {
	source.rootObjects()[Project]->map lower();
}

-- An unsettable feature is written only where the source states it: assigning
-- what an unset one reads marks the copy set, with a null or, for an
-- enumeration, its first literal, and the Effective Intent would then state what
-- no author wrote. A null says so for a value; an enumeration has to be asked.
query ECORE::EObject::states(feature : String) : Boolean =
	self.eIsSet(self.eClass().getEStructuralFeature(feature));

mapping Project::lower() : EffectiveProject {
	-- Nobody authors the Effective Intent, so the document's header stays behind.
	project := self.project;
	owner := self.owner;
	applications := self.applications->map lower(self);
}

mapping Application::lower(in prj : Project) : EffectiveApplication {
	id := self.id;
	-- The Processes first: `resolveone` below can only find a copy once it exists.
	processes := self.processes->map lower(self, prj);
	if self.description <> null then description := self.description endif;
	client := self.client.map copy();
	l4Exposure := self.l4Exposure->map copy();
	dashboards := self.dashboards->collect(d | object Dashboard { _from := d._from; });
	alertRules := self.alertRules->collect(r | object AlertRules { _from := r._from; });
	observability := self.observability.map copy();
	exposure := self.exposure->map copy();
	-- How the schema moves defines the Application, so it stays on it.
	migration := self.migration.map copy();
}

mapping Migration::copy() : Migration
	disjuncts ManagedMigration::copy, SelfMigration::copy, NoMigration::copy {}

mapping ManagedMigration::copy() : ManagedMigration {
	changelog := self.changelog;
}

mapping SelfMigration::copy() : SelfMigration {}

mapping NoMigration::copy() : NoMigration {}

mapping Process::lower(in app : Application, in prj : Project) : Process {
	init {
		-- lowest level first, which is what decides every merge below
		var levels : Sequence(Placement) :=
			Sequence{self.placement, app.placement, prj.placement}->select(p | p <> null);
		var quantities : Sequence(Placement) :=
			Sequence{self.placement}->select(p | p <> null);
		var withArch : Sequence(Placement) := levels->select(p | p.arch->notEmpty());
		var withSite : Sequence(Placement) := levels->select(p | p.site <> null);
		var withDisk : Sequence(Placement) := levels->select(p | p.disk <> null);
		var withGpu : Sequence(Placement) := levels->select(p | p.gpu <> null);
		var withCapabilities : Sequence(Placement) :=
			levels->select(p | p.capabilities->notEmpty());
		var budgets : Sequence(String) :=
			Sequence{self.startupBudget, app.startupBudget, prj.startupBudget}
				->select(b | b <> null);
		var cutovers : Sequence(Cutover) :=
			Sequence{self.cutover, app.cutover, prj.cutover}
				->select(c | c <> Cutover::absent);
	}

	-- what identifies the Process, and is shared by nothing
	name := self.name;
	lifecycle := self.lifecycle;
	image := self.image;
	runtime := self.runtime;
	if self.oclAsType(ECORE::EObject).states('engine') then engine := self.engine endif;
	provides := self.provides->map copy();
	sidecars := self.sidecars->map copy();
	probes := self.probes.map copy();
	volumes := self.volumes->map copy();
	replicas := self.replicas.map copy();
	api := self.api.map copy();
	egress := self.egress.map copy();
	vpn := self.vpn.map copy();
	libraries := self.libraries->map copy();
	if self.description <> null then description := self.description endif;
	if self.schedule <> null then schedule := self.schedule endif;
	if self.parked <> null then parked := object Parked { reason := self.parked.reason; } endif;
	command := self.command;
	args := self.args;
	spawns := self.spawns->map copyFor(self);
	if self.rollback <> null then rollback := object Rollback {} endif;

	-- Every copy is keyed on its Process: a mapping's result is cached per source
	-- object, and a containment feature would move one shared copy to the last
	-- Process that asked for it.
	secrets := mergeGrants(mergeGrants(self.secrets, app.secrets), prj.secrets)
		->map copyFor(self);
	dependsOn := mergeEdges(mergeEdges(self.dependsOn, app.dependsOn), prj.dependsOn)
		->map copyFor(self);
	assets := mergeAssets(mergeAssets(self.assets, app.assets), prj.assets)
		->map copyFor(self);
	-- a path is its own whole value, so the union is the merge
	-- A path is its own identity, so the union is the merge, and a lower level's
	-- declaration of a path is the one that holds.
	writablePaths := mergePaths(mergePaths(self.writablePaths, app.writablePaths), prj.writablePaths)
		->map copyFor(self);
	-- The Process's one file, its entries extended by every scope above, or none.
	env := if self.env->union(app.env)->union(prj.env)->isEmpty() then Sequence{}
		else Sequence{self.map envFor(app, prj)} endif;

	-- the single values, from the lowest level that declared one
	if budgets->notEmpty() then startupBudget := budgets->first() endif;
	-- A prepare Process cuts over nothing, so a shared answer does not reach it.
	if self.lifecycle <> Lifecycle::prepare and self.lifecycle <> Lifecycle::scheduled
			and cutovers->notEmpty()
		then cutover := cutovers->first() endif;

	-- Key by key: each dimension from the lowest level that set it, the
	-- quantities from the Process and nowhere else.
	placement := if levels->isEmpty() then null else object Placement {
		if quantities->notEmpty() and quantities->first().memory <> null
			then memory := quantities->first().memory endif;
		if quantities->notEmpty() and quantities->first().cpu <> null
			then cpu := quantities->first().cpu endif;
		arch := if withArch->isEmpty() then Sequence{} else withArch->first().arch endif;
		if withSite->notEmpty() then site := withSite->first().site endif;
		disk := if withDisk->isEmpty() then null
			else withDisk->first().disk.map copyFor(self) endif;
		gpu := if withGpu->isEmpty() then null
			else withGpu->first().gpu.map copyFor(self) endif;
		capabilities := if withCapabilities->isEmpty() then Sequence{}
			else withCapabilities->first().capabilities endif;
	} endif;
}

-- The entries of every file of one scope; no file varies by cluster.
query entriesIn(files : Collection(EnvFile)) : Sequence(EnvVariable) =
	files->collect(f | f.entries)->asSequence();

query mergeEntries(own : Collection(EnvVariable), shared : Collection(EnvVariable))
		: Sequence(EnvVariable) =
	own->asSequence()->union(
		shared->asSequence()->select(e | own->forAll(m | m.name <> e.name)));

mapping Process::envFor(in app : Application, in prj : Project) : EnvFile {
	entries := mergeEntries(
			mergeEntries(entriesIn(self.env), entriesIn(app.env)),
			entriesIn(prj.env))
		->map copyFor(self);
}

mapping EnvVariable::copyFor(in owner : Process) : EnvVariable {
	name := self.name;
	value := self.value.map copyFor(owner);
}

mapping EnvValue::copyFor(in owner : Process) : EnvValue
	disjuncts EnvLiteral::copyFor, Placeholder::copyFor {}

mapping EnvLiteral::copyFor(in owner : Process) : EnvLiteral {
	text := self.text;
}

mapping Placeholder::copyFor(in owner : Process) : Placeholder {
	kind := self.kind;
	-- Qualified: bare `source` is this transformation's input model parameter.
	result.source := self.source;
	if self.oclAsType(ECORE::EObject).states('suffix') then result.suffix := self.suffix endif;
}

-- The derived read path is the identity, so a `kv` grant and a `database` grant
-- never collide. One boolean rather than a query per kind: a query redeclared on
-- each subclass binds statically here, and every grant answered with the base.
query sameGrant(one : Grant, other : Grant) : Boolean =
	(one.oclIsKindOf(KvGrant) and other.oclIsKindOf(KvGrant)
		and one.oclAsType(KvGrant).path = other.oclAsType(KvGrant).path)
	or (one.oclIsKindOf(DatabaseGrant) and other.oclIsKindOf(DatabaseGrant)
		and one.oclAsType(DatabaseGrant).role = other.oclAsType(DatabaseGrant).role)
	or (one.oclIsKindOf(TransitGrant) and other.oclIsKindOf(TransitGrant)
		and one.oclAsType(TransitGrant).key = other.oclAsType(TransitGrant).key);

-- `own` and `shared` rather than `lower`: a parameter named `lower` shadows the
-- transformation itself, and every call on it then resolves against the module.
query mergeGrants(own : Collection(Grant), shared : Collection(Grant)) : Sequence(Grant) =
	own->asSequence()->union(
		shared->asSequence()->select(g | own->forAll(m | not sameGrant(m, g))));

-- `required` is excluded: the same edge declared twice is the same declaration.
query mergeEdges(own : Collection(DependencyEdge), shared : Collection(DependencyEdge))
		: Sequence(DependencyEdge) =
	own->asSequence()->union(
		shared->asSequence()->select(e |
			own->forAll(m | m.application <> e.application or m.surface <> e.surface)));

-- Two files cannot arrive at one path, so where an Asset lands, mounted or
-- seeded, is its identity.
query AssetDeclaration::landsAt() : String =
	if self.oclIsKindOf(Asset) then self.oclAsType(Asset).mountAt
	else self.oclAsType(SeededAsset).seedAt endif;

query mergeAssets(own : Collection(AssetDeclaration), shared : Collection(AssetDeclaration))
		: Sequence(AssetDeclaration) =
	own->asSequence()->union(
		shared->asSequence()->select(a | own->forAll(m | m.landsAt() <> a.landsAt())));

query mergePaths(own : Collection(WritablePathDeclaration), shared : Collection(WritablePathDeclaration))
		: Sequence(WritablePathDeclaration) =
	own->asSequence()->union(
		shared->asSequence()->select(w | own->forAll(m | m.path <> w.path)));

mapping WritablePathDeclaration::copyFor(in owner : Process) : WritablePathDeclaration
	disjuncts PlainPath::copyFor, MemoryPath::copyFor {}

mapping PlainPath::copyFor(in owner : Process) : PlainPath {
	path := self.path;
}

mapping MemoryPath::copyFor(in owner : Process) : MemoryPath {
	path := self.path;
	memory := self.memory;
}

-- A contained object has one container, so everything below is copied rather
-- than referenced: the lowered model holds no pointer into the authored one.

mapping Observability::copy() : Observability {
	scrape := self.scrape.map copy();
}

mapping Scrape::copy() : Scrape {
	path := self.path;
	process := self.process.resolveone(Process);
	surface := self.surface.resolveone(Surface);
}

mapping Exposure::copy() : Exposure {
	name := self.name;
	host := self.host;
	audience := self.audience;
	if self.oclAsType(ECORE::EObject).states('contentPolicy')
		then contentPolicy := self.contentPolicy endif;
	if self.proxied <> null then proxied := self.proxied endif;
	routes := self.routes->map copy();
}

mapping Route::copy() : Route {
	path := self.path;
	match := self.match;
	process := self.process.resolveone(Process);
	surface := self.surface.resolveone(Surface);
	if self.oclAsType(ECORE::EObject).states('audience') then audience := self.audience endif;
	if self.redirectTo <> null then redirectTo := self.redirectTo endif;
	rateLimit := self.rateLimit.map copy();
}

mapping RateLimit::copy() : RateLimit {
	requests := self.requests;
	per := self.per;
}

mapping Surface::copy() : Surface {
	key := self.key;
	value := self.value;
}

mapping Sidecar::copy() : Sidecar {
	name := self.name;
	image := self.image;
	command := self.command;
	args := self.args;
	memory := self.memory;
	cpu := self.cpu;
	volumes := self.volumes->collect(v | object SidecarMount { claim := v.claim; mountAt := v.mountAt; });
	assets := self.assets->collect(a | object SidecarAsset { _from := a._from; mountAt := a.mountAt; });
	if self._init <> null then _init := self._init endif;
}

-- A spawn template is the Process's own, so it is copied whole.
mapping SpawnTemplate::copyFor(in owner : Process) : SpawnTemplate {
	name := self.name;
	image := self.image;
	placement := object SpawnPlacement { memory := self.placement.memory; cpu := self.placement.cpu; };
	provides := self.provides->map copy();
	dependsOn := self.dependsOn->map copyFor(owner);
	egress := self.egress.map copy();
}

mapping Client::copy() : Client {
	signIn := self.signIn;
	if self.exposure <> null then exposure := self.exposure endif;
	if self.label <> null then label := self.label endif;
	if self.description <> null then description := self.description endif;
	if self.iconPath <> null then iconPath := self.iconPath endif;
	if self.launchPath <> null then launchPath := self.launchPath endif;
	redirectPaths := self.redirectPaths;
	if self.protectedPath <> null then protectedPath := self.protectedPath endif;
	if self.backChannelLogoutPath <> null then backChannelLogoutPath := self.backChannelLogoutPath endif;
	if self.oclAsType(ECORE::EObject).states('credential') then credential := self.credential endif;
	roles := self.roles;
}

-- The port's Process and surface are the lowered Process's, as a route's are.
mapping L4Exposure::copy() : L4Exposure {
	address := self.address;
	port := self.port;
	protocol := self.protocol;
	process := self.process.resolveone(Process);
	surface := self.surface.resolveone(Surface);
}

mapping DiskRequest::copyFor(in owner : Process) : DiskRequest {
	media := self.media;
}

mapping GpuRequest::copyFor(in owner : Process) : GpuRequest {
	_class := self._class;
	memory := self.memory;
	vendor := self.vendor;
	model := self.model;
}

mapping DependencyEdge::copyFor(in owner : Process) : DependencyEdge {
	application := self.application;
	surface := self.surface;
	if self.required <> null then required := self.required endif;
	buckets := self.buckets;
	credentials := self.credentials.map copyFor(owner);
}

mapping Credentials::copyFor(in owner : Process) : Credentials {
	if self.oclAsType(ECORE::EObject).states('delivery') then delivery := self.delivery endif;
	if self.mountAt <> null then mountAt := self.mountAt endif;
	if self.fileMode <> null then fileMode := self.fileMode endif;
	rotation := self.rotation.map copyFor(owner);
}

mapping AssetDeclaration::copyFor(in owner : Process) : AssetDeclaration
	disjuncts Asset::copyFor, SeededAsset::copyFor {}

mapping Asset::copyFor(in owner : Process) : Asset {
	_from := self._from;
	mountAt := self.mountAt;
}

mapping SeededAsset::copyFor(in owner : Process) : SeededAsset {
	_from := self._from;
	seedAt := self.seedAt;
}

mapping Volume::copy() : Volume {
	claim := self.claim;
	mountAt := self.mountAt;
	if self.size <> null then size := self.size endif;
	durability := self.durability;
}

mapping LibraryMount::copy() : LibraryMount {
	_library := self._library;
	mountAt := self.mountAt;
	if self.subPath <> null then subPath := self.subPath endif;
	_access := self._access;
}

mapping Egress::copy() : Egress {
	to := self.to;
	reason := self.reason;
}

mapping VpnAttachment::copy() : VpnAttachment {
	forwardedPort := self.forwardedPort;
}

mapping ApiAccess::copy() : ApiAccess {
	reason := self.reason;
	rules := self.rules->collect(r | object ApiRule {
		group := r.group;
		objects := r.objects;
		verbs := r.verbs;
		if r.oclAsType(ECORE::EObject).states('scope') then scope := r.scope endif;
	});
}

mapping Capacity::copy() : Capacity {
	count := self.count;
	reason := self.reason;
	if self.oclAsType(ECORE::EObject).states('across') then across := self.across endif;
}

mapping ProbePolicy::copy() : ProbePolicy
	disjuncts Probes::copy, NoProbes::copy {}

mapping Probes::copy() : Probes {
	readiness := self.readiness.map copy();
	liveness := self.liveness.map copy();
}

mapping NoProbes::copy() : NoProbes {}

mapping Probe::copy() : Probe
	disjuncts HttpProbe::copy, TcpProbe::copy {}

mapping HttpProbe::copy() : HttpProbe {
	path := self.path;
	port := self.port;
}

mapping TcpProbe::copy() : TcpProbe {
	tcp := self.tcp;
}

mapping Grant::copyFor(in owner : Process) : Grant
	disjuncts KvGrant::copyFor, DatabaseGrant::copyFor, TransitGrant::copyFor {}

mapping KvGrant::copyFor(in owner : Process) : KvGrant {
	path := self.path;
	keys := self.keys->map copyFor(owner);
	_access := self._access;
	delivery := self.delivery;
	if self.mountAt <> null then mountAt := self.mountAt endif;
	if self.fileMode <> null then fileMode := self.fileMode endif;
	rotation := self.rotation.map copyFor(owner);
}

mapping KvKey::copyFor(in owner : Process) : KvKey
	disjuncts PlainKey::copyFor, GeneratedKey::copyFor, OptionalKey::copyFor {}

mapping OptionalKey::copyFor(in owner : Process) : OptionalKey {
	name := self.name;
	optional := self.optional;
}

mapping PlainKey::copyFor(in owner : Process) : PlainKey {
	name := self.name;
}

mapping GeneratedKey::copyFor(in owner : Process) : GeneratedKey {
	name := self.name;
	generate := self.generate.map copyFor(owner);
}

mapping Generate::copyFor(in owner : Process) : Generate {
	if self.bytes <> null then bytes := self.bytes endif;
	if self.encoding <> KeyEncoding::absent then encoding := self.encoding endif;
}

mapping DatabaseGrant::copyFor(in owner : Process) : DatabaseGrant {
	engine := self.engine;
	role := self.role;
	delivery := self.delivery;
	if self.mountAt <> null then mountAt := self.mountAt endif;
	if self.fileMode <> null then fileMode := self.fileMode endif;
	rotation := self.rotation.map copyFor(owner);
}

mapping TransitGrant::copyFor(in owner : Process) : TransitGrant {
	engine := self.engine;
	key := self.key;
	operations := self.operations;
	delivery := self.delivery;
	if self.mountAt <> null then mountAt := self.mountAt endif;
	if self.fileMode <> null then fileMode := self.fileMode endif;
	rotation := self.rotation.map copyFor(owner);
}

mapping Rotation::copyFor(in owner : Process) : Rotation {
	tolerates := self.tolerates;
	if self.maxAge <> null then maxAge := self.maxAge endif;
}
