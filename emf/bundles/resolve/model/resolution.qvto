-- The resolution (spec/v1/20-resolved-deployment.md): one project of the lowered
-- union, with the Platform document and the pinned inputs beside it, to its
-- Resolved Deployment. It reads the Effective Intent and never the authored
-- shape, so no derivation has to union three levels for itself
-- (emf/docs/architecture.md#transformation).
--
-- Every derived value is a mapping or a query here. Hashing is the one
-- operation done outside the language, by the `Hashing` black box: a digest
-- is a function of canonical bytes, which OCL has no way to produce.
--
-- An input it cannot derive stops the run with a message naming what is missing,
-- rather than write a model with a gap or a default in it.
import dev.jorisjonkers.deploykit.emf.hashing;

modeltype PI uses 'https://jorisjonkers.dev/deploy-kit/project-intent/1';
modeltype IN uses 'https://jorisjonkers.dev/deploy-kit/pinned-inputs/1';
modeltype RD uses 'https://jorisjonkers.dev/deploy-kit/resolved-deployment/1';
modeltype ECORE uses 'http://www.eclipse.org/emf/2002/Ecore';

transformation resolution(in intent : PI, in pinned : IN, out resolved : RD)
	access library Hashing;


-- The project of the union this run resolves, and the integrity the schema
-- package it was rendered against records: both are inputs, never derived.
configuration property project : String;
configuration property integrity : String;

property estate : Platform = intent.rootObjects()[Platform]->any(true);
property projects : Sequence(EffectiveProject) =
	intent.rootObjects()[EffectiveProject]->sortedBy(p | p.project)->asSequence();
property contract : NodeContract = pinned.rootObjects()[NodeContract]->any(true);
property lock : ImagesLock = pinned.rootObjects()[ImagesLock]->any(true);
property snapshot : ClusterState = pinned.rootObjects()[ClusterState]->any(true);
-- Every proof written beside a project file of the union, and every Asset file.
property proofs : Sequence(ProvenApplication) =
	pinned.rootObjects()[MigrationProof].applications->asSequence();
property assetFiles : Sequence(AssetFile) = pinned.rootObjects()[AssetFile]->asSequence();

-- Where an attached Process reads the port its provider forwards to it.
property FORWARDED_PORT_FILE : String = '/run/vpn/forwarded-port';
-- Why an attached Process reaches public addresses it declared no egress to.
property TUNNEL_REASON : String = 'the VPN\'s tunnel reaches its provider\'s servers';
-- The surface a Release Gate and a Secret Store answer on.
property HTTP_SURFACE : String = 'http';

-- Where every Stable Address lives (spec/v1/16-dependencies.md#the-stable-address).
property STABLE_NAMESPACE : String = 'estate-system';
-- The path of the Reporter's `http` surface that receives Flux's events.
property EVENTS_PATH : String = '/flux';
-- Flux's notification controller, by the `app` label its own install gives its pods.
property FLUX_NOTIFIER : String = 'notification-controller';
-- How many hex digits of an Asset's content digest its name carries.
property CONTENT_DIGITS : Integer = 10;

-- A startup probe polls this often; its threshold covers the budget.
property STARTUP_PERIOD : Integer = 5;
-- The deadline of a Process that declares no startup budget: the substrate's own.
property UNBUDGETED_DEADLINE : Integer = 600;
-- The surface an exporting profile's collector receives on, and a gate answers on.
property OTLP_SURFACE : String = 'otlp';
property DNS_PORT : Integer = 53;
-- The runtime a backup identity's labels name: it runs no Runtime Profile.
property NO_RUNTIME : String = 'none';
-- The identity the Vault policy job runs as.
property POLICY_JOB : String = 'vault-policy';
-- How many hex digits of a revision its tag carries: what the migration Jobs are named by.
property TAG_DIGITS : Integer = 12;

-- What a library's volume and claim both state: a local volume holds a directory, never a size.
property LIBRARY_SIZE : String = '1Gi';

-- Where the catalog of a datastore the old path still runs, and the job that writes its
-- documents, land: estate-scoped, beside the model of each Project that reads it.
property ESTATE_SECRETS : String = 'estate/vso-secrets/';

-- The units an Application's routes wait on: the unit of each Project that declares a proxy one
-- of its exposures' tiers names, unless it is the Application's own
-- (spec/v1/20-resolved-deployment.md#the-reconcile-unit).
query proxiesAfter(app : EffectiveApplication, prj : String) : Sequence(String) =
	app.exposure->collect(e | projectOf(tierFor(e.audience).traefik.id))
		->select(p | p <> null and p <> prj)->collect(p | unitOf(p))->asSequence();

-- Whether a catalog method's datastore is run by a Project on the estate path, whose own
-- resolution plans it.
query ownedOnEstatePath(c : ResolvedCatalogJob) : Boolean =
	projects->exists(prj | not legacy(prj.project) and prj.applications->exists(app |
		app.processes->exists(p | (ownsDatabases(p) or ownsBuckets(p)) and c.identity = p.name + '-catalog'
			and c.namespace = homeNamespace(prj.project, app.id))));

-- Where a Project's own Vault policy job lands, and the documents it writes beside it.
query policyJobRoot(prj : String) : String = 'apps/' + prj + '/vault-policy/';
query policiesOf(prj : String) : String = policyJobRoot(prj) + 'policies/';

-- The unit a Project waits on before a Process of it may hold a credential: the unit of the
-- Platform Project that declares the Secret Store each Project writes its own roles into, unless
-- it is that Project (spec/v1/20-resolved-deployment.md#the-reconcile-unit).
query secretsAfter(prj : String) : Sequence(String) =
	if estate.secretStore = null then Sequence{} else
	let store : String = projectOf(estate.secretStore.id) in
	if store = null or store = prj then Sequence{} else Sequence{unitOf(store)} endif endif;

main() {
	assert fatal (unversioned()->isEmpty())
		with log(unversioned()->first() + ' records no version: E_IMAGE_VERSION_MISSING');
	projects->select(p | p.project = project)->any(true).map deployment();
}

-- Every alias the lock records no version for, sorted
-- (spec/v1/20-resolved-deployment.md#the-images-lock): each refuses the set.
query unversioned() : Sequence(String) =
	lock.images->select(i | i.version = null)->collect(i | i.alias)->sortedBy(a | a)->asSequence();

-- ============================================================== the document

mapping EffectiveProject::deployment() : ResolvedDeployment {
	apiVersion := 'resolved.jorisjonkers.dev/v1';
	kind := 'ResolvedDeployment';
	-- The project's own unit, and every unit it must follow, which this
	-- document carries so `after` is a reference and never a name.
	reconcileUnits := Sequence{self.map unit()}->union(afterOf(self)->collect(n | object ReconcileUnit { name := n; }));
	applications := self.applications->map application(self);
	provenance := self.map provenance();
	policyJob := policyJobOf();
	catalogJobs := catalogJobsOf();
	events := eventsRouteOf();
	deliverables := self.projectFiles()
		->union(self.applications->collect(a | a.applicationFiles(self))->flatten())
		->union(self.vaultFiles())
		->union(self.generatedKeysFiles())
		->union(self.stableAddressFiles());
	end {
		self.edgeFiles(result);
		-- Only a complete element has a revision: it is the digest of all of it.
		result.reconcileUnits->first().after := result.reconcileUnits->excluding(result.reconcileUnits->first());
		-- The revision is the production implementation's: the digest of the
		-- Application's element in that implementation's canonical JSON, which
		-- the rendered tree carries (spec/v1/20-resolved-deployment.md#the-application-revision).
		self.applications->forEach(src) {
			var res : ResolvedApplication := src.resolveone(ResolvedApplication);
			res.revision := res.elementJson(src, self).rawDigestOf();
		};
		-- A migration's Jobs are named by the revision's tag, so only now do they have one.
		result.deliverables[MigrationFile]->forEach(planned) {
			planned.upTag := tagOf(planned.application.revision);
		};
		-- A datastore this project runs on the estate path applies its own catalog from this
		-- project's unit (spec/v1/16-dependencies.md#applying-the-catalog). Its Vault documents
		-- stay the policy job's, planned with it.
		if (not legacy(self.project)) {
			self.applications->forEach(app) {
				app.processes->select(p | ownsDatabases(p) or ownsBuckets(p))->forEach(p) {
					var root : String := 'apps/' + self.project + '/' + app.id + '/';
					result.catalogJobs->select(c | c.identity = p.name + '-catalog'
							and c.namespace = homeNamespace(self.project, app.id))->forEach(c) {
						result.deliverables += c.catalogFilesUnder(root);
						var index : IndexFile := result.deliverables[IndexFile]
							->select(i | i.path = root + 'kustomization.yaml')->any(true);
						-- Every Application's directory has its index: applicationFiles plans one.
						assert fatal (index <> null) with log('no index under ' + root);
						index.resources := index.resources->append(c.identity + '.yaml')->sortedBy(r | r);
						-- Its own policy and role, which this Project's own job writes.
						result.deliverables += object CatalogJobFile {
							path := policiesOf(self.project) + c.role + '.policy.json';
							adapter := AdapterName::vaultPolicy;
							part := 'policy'; job := c; };
						result.deliverables += object VaultRoleFile {
							path := policiesOf(self.project) + c.role + '.role.json';
							adapter := AdapterName::vaultPolicy;
							namespace := c.namespace;
							identity := c.identity; };
					};
				};
			};
		};
		-- The Project's own Vault policy job, where the platform names one and the Project holds
		-- a document for it to write (spec/v1/20-resolved-deployment.md#the-vault-policy-job).
		result.deliverables += policyJobFiles(result.policyJob, result.deliverables->select(d |
			d.path.startsWith(policiesOf(self.project)))->asSequence(), policyJobRoot(self.project), namespaceOf(self.project));
		if (result.deliverables->exists(d | d.path = policyJobRoot(self.project) + 'kustomization.yaml')) {
			var top : IndexFile := result.deliverables[IndexFile]
				->select(i | i.path = 'apps/' + self.project + '/kustomization.yaml')->any(true);
			top.resources := top.resources->append('vault-policy')->sortedBy(r | r);
		};
		-- While a datastore the old path still runs has a catalog that names this Project's
		-- database, this Project's resolution plans that catalog, and the estate-scoped job that
		-- writes its documents in the datastore's namespace, as estate-scoped output beside its own
		-- model (spec/v1/16-dependencies.md#applying-the-catalog). Every Project that reads it
		-- plans the same files, so a render of several writes each once.
		var legacyCatalogs : Sequence(ResolvedCatalogJob) := result.catalogJobs->select(c |
			not ownedOnEstatePath(c) and (c.catalog.databases->exists(db | db.name = self.project + '_db')
				or c.catalog.keys->exists(k | k.name = self.project)))->asSequence();
		if (legacyCatalogs->notEmpty()) {
			-- One estate-scoped job writes one namespace's names: its writer is confined to them.
			assert fatal (legacyCatalogs.namespace->asSet()->size() = 1)
				with log('catalogs the old path runs in more than one namespace');
			legacyCatalogs->forEach(c) {
				result.deliverables += c.catalogFilesUnder(ESTATE_SECRETS);
				result.deliverables += object CatalogJobFile {
					path := ESTATE_SECRETS + 'policies/' + c.role + '.policy.json';
					adapter := AdapterName::vaultPolicy;
					part := 'policy'; job := c; };
				result.deliverables += object VaultRoleFile {
					path := ESTATE_SECRETS + 'policies/' + c.role + '.role.json';
					adapter := AdapterName::vaultPolicy;
					namespace := c.namespace;
					identity := c.identity; };
			};
			result.deliverables += policyJobFiles(result.policyJob, result.deliverables->select(d |
				d.path.startsWith(ESTATE_SECRETS + 'policies/'))->asSequence(), ESTATE_SECRETS,
				legacyCatalogs->first().namespace);
			var estateIndex : IndexFile := result.deliverables[IndexFile]
				->select(i | i.path = ESTATE_SECRETS + 'kustomization.yaml')->any(true);
			if (estateIndex <> null) {
				estateIndex.resources := estateIndex.resources->asSequence()
					->union(legacyCatalogs->collect(c | c.identity + '.yaml')->asSequence())->sortedBy(r | r);
			};
		};
		-- The route Flux's events about this Project's unit take to the Reporter, where the
		-- platform names one: its own Provider and Alert, in Flux's namespace, applied by this
		-- Project's unit (spec/v1/55-delivery.md#rollouts).
		if (result.events <> null) {
			var root : String := 'apps/' + self.project + '/rollout-events/';
			result.deliverables += Sequence{'alert', 'provider'}->collect(piece | object EventsFile {
				path := root + piece + '.yaml';
				adapter := AdapterName::kubernetes;
				part := piece;
				project := self.project;
				events := result.events;
			}.oclAsType(Deliverable));
			result.deliverables += object IndexFile {
				path := root + 'kustomization.yaml';
				adapter := AdapterName::kubernetes;
				resources := Sequence{'alert.yaml', 'provider.yaml'};
			};
			var index : IndexFile := result.deliverables[IndexFile]
				->select(i | i.path = 'apps/' + self.project + '/kustomization.yaml')->any(true);
			index.resources := index.resources->append('rollout-events')->sortedBy(r | r);
		};
	}
}

-- The Reconcile Unit of a project's Applications (spec/v1/20-resolved-deployment.md#the-reconcile-unit).
mapping EffectiveProject::unit() : ReconcileUnit {
	name := unitOf(self.project);
}

query unitOf(prj : String) : String = 'apps-' + prj;

-- The units that must be Ready first: every other project a required edge
-- reaches, and the secrets-provisioning unit wherever a Process holds a grant
-- (spec/v1/20-resolved-deployment.md#the-reconcile-unit). An optional edge
-- orders nothing (spec/v1/55-delivery.md#release-order).
query afterOf(prj : EffectiveProject) : Sequence(String) =
	(prj.applications.processes.dependsOn
		->select(e | not (e.required = false))
		->collect(e | projectOf(e.application))
		->select(other | other <> null and other <> prj.project)
		->collect(other | unitOf(other))
	->union(if prj.applications.processes->exists(p | p.secrets->notEmpty() or holdsClientGrants(p) or p.vpn <> null
				or p.dependsOn->exists(e | reachesDatabase(e)))
			or prj.applications->exists(a | managed(a) or appliesCatalog(a))
		then secretsAfter(prj.project) else Sequence{} endif)
	->union(prj.applications->collect(a | proxiesAfter(a, prj.project))->flatten()))
	->asSet()->sortedBy(n | n)->asSequence();

-- The project of the union that declares `application`, where one does.
query projectOf(application : String) : String =
	let declaring : Sequence(EffectiveProject) =
		projects->select(p | p.applications->exists(a | a.id = application)) in
	if declaring->isEmpty() then null else declaring->first().project endif;

-- One digest per pinned input, then the render hash over them and the schema
-- package's integrity (spec/v1/20-resolved-deployment.md#pinned-inputs).
mapping EffectiveProject::provenance() : Provenance {
	schemaPackageIntegrity := integrity;
	inputDigests := projects->collect(p | object InputDigest {
			input := PinnedInput::intentFragment;
			name := p.project;
			digest := p.oclAsType(ECORE::EObject).digestOf();
		})
		->append(object InputDigest {
			input := PinnedInput::platformIntent;
			name := estate.metadata.project;
			digest := estate.oclAsType(ECORE::EObject).digestOf();
		})
		->append(object InputDigest {
			input := PinnedInput::nodeContract;
			name := contract.cluster;
			digest := contract.oclAsType(ECORE::EObject).digestOf();
		})
		->append(object InputDigest {
			input := PinnedInput::imagesLock;
			name := lock.name;
			digest := lock.oclAsType(ECORE::EObject).digestOf();
		})
		->append(object InputDigest {
			input := PinnedInput::clusterState;
			name := snapshot.cluster;
			digest := snapshot.oclAsType(ECORE::EObject).digestOf();
		});
	end {
		-- The render hash covers everything above it and nothing else, so it is
		-- taken before it is set.
		result.renderHash := result.oclAsType(ECORE::EObject).digestOf();
	}
}

-- =========================================================== the Application

mapping EffectiveApplication::application(in prj : EffectiveProject) : ResolvedApplication {
	id := self.id;
	project := prj.project;
	namespace := namespaceOf(prj.project);
	reconcileUnit := prj.map unit();
	-- The Processes first: everything below refers to them.
	processes := self.processes->map process(self, prj);
	exposure := self.exposure->map exposure(self, prj);
	if self.observability <> null and self.observability.scrape <> null then
		scrape := object ResolvedScrape {
			process := self.observability.scrape.process.resolveone(ResolvedProcess);
			surface := self.observability.scrape.surface.key;
			path := self.observability.scrape.path;
			interval := estate.monitors.interval;
			timeout := estate.monitors.timeout;
			-- What the metrics stack selects its monitors by, as the platform names it.
			labels := estate.monitors.labels->sortedBy(l | l.key)
				->collect(l | object KeyValue { key := l.key; value := l.value; });
		}
	endif;
	releaseGate := if gated(self) then self.map gate() else null endif;
	if self.client <> null then client := self.map clientOf(prj) endif;
	-- Each dashboard file as the set read it, in its Project's folder, for the Grafana
	-- the Platform document names (spec/v1/10-project-intent.md#dashboards).
	if self.dashboards->notEmpty() and estate.telemetry <> null and estate.telemetry.dashboards <> null then
		dashboards := object ResolvedDashboards {
			folder := prj.project;
			instance := estate.telemetry.dashboards.instance->sortedBy(i | i.key)
				->collect(i | object KeyValue { key := i.key; value := i.value; });
			datasource := estate.telemetry.dashboards.datasource;
			files := self.dashboards->collect(d | let read : String = fileOf(prj.project, d._from) in
				object ResolvedDashboard {
					name := self.id + '-' + uidOf(read);
					content := read;
					inputs := inputsOf(read);
				});
		}
	endif;
	if managed(self) then migration := self.map migrationOf(prj) endif;
	alertRules := Sequence{1..self.alertRules->size()}->collect(i | obsAlertRules(self.id, self.alertRules->at(i)._from, fileOf(prj.project, self.alertRules->at(i)._from)));
	if obsAlerts(self) then alerting := obsAlerting(self) endif;
	if obsFlux(self) then fluxScrape := obsFluxScrape() endif;
	-- The operator syncs from the Secret Store wherever a grant or a backup's
	-- off-cluster or peer credential is delivered anywhere but to the Process itself,
	-- and a migration reads its owner credential from the store itself.
	if synced(result) or managed(self) then secretStore := storeEndpoint() endif;
}

-- Whether an Application moves its schema with a changelog the platform's runner applies.
query managed(app : EffectiveApplication) : Boolean =
	app.migration <> null and app.migration.oclIsKindOf(ManagedMigration);

-- The tag of a revision (spec/v1/55-delivery.md#failure-and-undo): its first twelve hex digits.
query tagOf(revision : String) : String = revision.substring(8, 7 + TAG_DIGITS);

query synced(app : ResolvedApplication) : Boolean =
	app.processes->exists(p | p.secrets->notEmpty() or p.vpn <> null
		or p.volumes->exists(v | v.backup <> null
			and (v.backup.credential <> null or v.backup.peer <> null)));

-- A managed migration's plan (spec/v1/20-resolved-deployment.md#the-migration):
-- its locked runner and the user it runs as, what the proof beside the project
-- records about this release (an Application no proof names is a first
-- release), and everything its Jobs run with, each a function of the
-- Application id, the project and the Platform document.
mapping EffectiveApplication::migrationOf(in prj : EffectiveProject) : ResolvedMigration {
	init {
		var runnerImage : LockedImage := locked(self.id + '-migration');
		var proven : ProvenApplication := proofOf(self);
		var held : Sequence(PolicyPeer) := datastoreOf(self);
		var store : PolicyPeer := if held->isEmpty() then unreached(self.id) else held->first() endif;
		var owned : String := prj.project;
	}
	runner := runnerImage.repository + '@' + runnerImage.digest;
	runnerVersion := runnerImage.version;
	uid := runnerImage.uid;
	gid := runnerImage.gid;
	if proven <> null and proven.testedAgainst <> null then testedAgainst := proven.testedAgainst endif;
	nonTransactional := proven <> null and proven.nonTransactional;
	identity := self.id + '-migration';
	deadline := estate.migration.deadline;
	memory := estate.migration.memory;
	cpu := estate.migration.cpu;
	scratch := estate.ephemeral.size;
	-- The runner mounts a writable /tmp and writes no HOME.
	home := HOME_DIR;
	database := object MigratedDatabase {
		host := store.process + '.' + store.namespace + '.svc.cluster.local';
		port := store.port;
		name := owned + '_db';
	};
	-- The runner reaches its datastore as every consumer does, by the label of the surface
	-- the Application's edge names (spec/v1/16-dependencies.md#the-consumer-label).
	consumes := Sequence{datastoreSurfacesOf(self)->first()};
	-- The owner role changes the schema, and only the migration holds it.
	credential := object ResolvedGrant {
		engine := 'database';
		delivery := 'self';
		paths := Sequence{object PolicyPath {
			path := 'database/creds/' + owned + '-owner';
			allows := Sequence{'read'};
		}};
	};
	egress := Sequence{store}->union(storePeers())->append(object PolicyPeer {
		rule := 'cluster-dns';
		namespace := estate.substrate.clusterDns;
		port := DNS_PORT;
	});
}

-- Where the project's database answers
-- (spec/v1/16-dependencies.md#the-database-catalog): each edge of the
-- Application that reaches a Process whose engine owns databases, on the
-- surface that edge names, the first of which is the datastore.
query datastoreOf(app : EffectiveApplication) : Sequence(PolicyPeer) =
	app.processes.dependsOn->collect(e |
		projects->collect(prj | prj.applications->select(a | a.id = e.application).processes
			->select(p | ownsDatabases(p) and p.provides->exists(s | s.key = e.surface))
			->collect(p | object PolicyPeer {
				rule := 'datastore';
				namespace := homeNamespace(prj.project, e.application);
				process := homeProcess(e.application, p.name);
				port := p.provides->select(s | s.key = e.surface)->any(true).value;
			})))->flatten()->asSequence();

-- The same edges' surfaces, as a consumer label names each, in the same order: the first
-- is the datastore's.
query datastoreSurfacesOf(app : EffectiveApplication) : Sequence(String) =
	app.processes.dependsOn->collect(e |
		projects->collect(prj | prj.applications->select(a | a.id = e.application).processes
			->select(p | ownsDatabases(p) and p.provides->exists(s | s.key = e.surface))
			->collect(p | e.application + '.' + e.surface)))->flatten()->asSequence();

-- Whether a Process's inbound edges derive a database.
query ownsDatabases(p : PI::Process) : Boolean =
	p.oclAsType(ECORE::EObject).states('engine') and p.engine = Engine::postgres;

-- Whether a Process's inbound edges name buckets in it: an object store.
query ownsBuckets(p : PI::Process) : Boolean =
	p.oclAsType(ECORE::EObject).states('engine') and p.engine = Engine::s3;

-- The surface a datastore's catalog is applied over: its own, or the one its engine serves.
query catalogSurfaceOf(p : PI::Process) : String =
	let policy : EnginePolicy = enginePolicyOf(p) in
	if policy.catalogSurface <> null then policy.catalogSurface else policy.surface endif;

-- Whether an Application runs a datastore whose engine applies a catalog, where the platform
-- names the Vault policy job: the method's role is written first
-- (spec/v1/16-dependencies.md#applying-the-catalog).
query appliesCatalog(app : EffectiveApplication) : Boolean =
	estate.policyJob <> null and estate.engines.postgres <> null and estate.engines.postgres.catalog <> null
		and app.processes->exists(p | ownsDatabases(p));

query unreached(application : String) : PolicyPeer {
	assert fatal (false) with log(application + ': a migration whose Application reaches no surface of the datastore holding its database is not checked yet');
	return null;
}

-- The image the lock holds for `alias`, or E_UNLOCKED_IMAGE refused the set.
query locked(alias : String) : LockedImage =
	let found : Sequence(LockedImage) = lock.images->select(i | i.alias = alias)->asSequence() in
	if found->isEmpty() then unlocked(alias) else found->first() endif;

query unlocked(alias : String) : LockedImage {
	assert fatal (false) with log(alias + ' is not locked: E_UNLOCKED_IMAGE');
	return null;
}

-- The Vault policy job (spec/v1/20-resolved-deployment.md#the-vault-policy-job):
-- derived where the platform names it and a Secret Store answers, as one
-- identity in the Secret Store's own namespace. Every project's document carries
-- the same one, because it belongs to none of them.
query policyJobOf() : ResolvedPolicyJob =
	if estate.policyJob = null or estate.secretStore = null or storePeers()->isEmpty() then null else
	let own : LockedImage = locked(estate.policyJob.image) in
	object ResolvedPolicyJob {
		identity := POLICY_JOB;
		namespace := storePeers()->first().namespace;
		image := own.repository + '@' + own.digest;
		imageVersion := own.version;
		uid := own.uid;
		gid := own.gid;
		role := estate.policyJob.role;
		address := storeEndpoint();
		memory := estate.policyJob.memory;
		cpu := estate.policyJob.cpu;
		deadline := inSeconds(seconds(estate.policyJob.deadline).floor());
		eligibleNodes := estateJobNodes();
		egress := storePeers()->union(Sequence{object PolicyPeer {
			rule := 'cluster-dns'; namespace := estate.substrate.clusterDns; port := DNS_PORT; }});
	} endif;

-- The nodes a derived estate Job may land on
-- (spec/v1/14-platform-intent.md#the-vault-policy-job): every node that fits what its one
-- container asks for and holds no sdcard medium, since every unit that holds a grant waits
-- on it.
query estateJobNodes() : Sequence(String) =
	contract.nodes->select(n | mebibytes(n.allocatable.memory) >= mebibytes(estate.policyJob.memory)
		and millicores(n.allocatable.cpu) >= millicores(estate.policyJob.cpu)
		and not n.disks->exists(d | d.media = 'sdcard'))->collect(n | n.name)->asSequence();

-- The methods that apply each datastore's database catalog
-- (spec/v1/20-resolved-deployment.md#the-catalog-methods): where the engine names one and the
-- platform names the Vault policy job, which writes each method's own role. Every project's
-- document carries the same ones, as it carries the policy job.
query catalogJobsOf() : Sequence(ResolvedCatalogJob) =
	if policyJobOf() = null then Sequence{}
	else projects->collect(prj | prj.applications->collect(app | app.processes
		->select(p | (ownsDatabases(p) or ownsBuckets(p)) and enginePolicyOf(p) <> null
			and enginePolicyOf(p).catalog <> null and catalogSurfaceOf(p) <> null)
		->collect(p | if ownsBuckets(p) then bucketCatalogJobOf(prj.project, app.id, p)
			else catalogJobOf(prj.project, app.id, p) endif)))
		->flatten()->select(j | j <> null)->asSequence() endif;

-- The projects on the estate path whose Processes name buckets in one object store, each with
-- the buckets it names, as the store holds them (spec/v1/16-dependencies.md#the-bucket-catalog).
query bucketReadersOf(application : String) : Sequence(Tuple(name : String, buckets : Sequence(String))) =
	projects->select(r | not legacy(r.project))->sortedBy(r | r.project)->collect(r |
		Tuple{name = r.project, buckets = r.applications.processes.dependsOn
			->select(e | e.application = application)->collect(e | e.buckets)->flatten()
			->collect(b | r.project + '-' + b)->asSet()->sortedBy(b | b)->asSequence()})
		->select(k | k.buckets->notEmpty())->asSequence();

-- An object store's method: its catalog is the key each reading project is given, written by
-- an admin token, the derived one on the estate path or the ledger's while its project is legacy.
query bucketCatalogJobOf(prj : String, application : String, p : PI::Process) : ResolvedCatalogJob =
	let ns : String = homeNamespace(prj, application) in
	let proc : String = homeProcess(application, p.name) in
	let readers : Sequence(Tuple(name : String, buckets : Sequence(String))) = bucketReadersOf(application) in
	let tokens : Sequence(AdminToken) = stated(application)
		->select(l | l.admin <> null and l.admin.oclIsKindOf(AdminToken))
		->collect(l | l.admin.oclAsType(AdminToken))->asSequence() in
	if readers->isEmpty() or (legacy(prj) and tokens->isEmpty()) then null else
	let own : LockedImage = locked(enginePolicyOf(p).catalog) in
	let surface : String = catalogSurfaceOf(p) in
	let surfacePort : Integer = p.provides->select(s | s.key = surface)->any(true).value in
	let named : String = p.name + '-catalog' in
	object ResolvedCatalogJob {
		identity := named;
		namespace := ns;
		image := own.repository + '@' + own.digest;
		imageVersion := own.version;
		uid := own.uid;
		gid := own.gid;
		role := ns + '-' + named;
		address := storeEndpoint();
		memory := estate.policyJob.memory;
		cpu := estate.policyJob.cpu;
		deadline := inSeconds(seconds(estate.policyJob.deadline).floor());
		eligibleNodes := estateJobNodes();
		catalog := object ResolvedCatalog {
			host := proc + '.' + ns + '.svc.cluster.local';
			port := surfacePort;
			admin := if legacy(prj) then object CatalogAdmin {
					path := tokens->first().path;
					token := tokens->first().token;
				} else object CatalogAdmin {
					path := 'secret/data/' + prj + '/' + p.name + '/catalog';
					token := 'token';
				} endif;
			keys := readers->collect(k | object CatalogKey {
				name := k.name;
				path := 'secret/data/' + k.name + '/' + p.name + '/s3';
				buckets := k.buckets;
			});
		};
		consumes := Sequence{application + '.' + surface};
		policy := catalog.policy();
		egress := Sequence{object PolicyPeer {
				rule := 'datastore'; namespace := ns; process := proc; port := surfacePort; }}
			->union(storePeers())->append(object PolicyPeer {
				rule := 'cluster-dns'; namespace := estate.substrate.clusterDns; port := DNS_PORT; });
	} endif;

-- Whether a project's database is still the old path's.
query legacy(prj : String) : Boolean =
	estate.handover <> null and estate.handover.legacy->includes(prj);

-- One datastore's method, where an estate-path project reads a database from it and it has a
-- login to sign in with: the old path's while its project is legacy, the derived one after.
query catalogJobOf(prj : String, application : String, p : PI::Process) : ResolvedCatalogJob =
	let ns : String = homeNamespace(prj, application) in
	let proc : String = homeProcess(application, p.name) in
	let readers : Sequence(String) = projects->select(r | not legacy(r.project)
		and r.applications->exists(a | let d : Sequence(PolicyPeer) = datastoreOf(a) in
			d->notEmpty() and d->first().namespace = ns and d->first().process = proc))
		->collect(r | r.project)->sortedBy(n | n)->asSequence() in
	let logins : Sequence(AdminLogin) = stated(application)
		->select(l | l.admin <> null and l.admin.oclIsKindOf(AdminLogin))
		->collect(l | l.admin.oclAsType(AdminLogin))->asSequence() in
	if readers->isEmpty() or (legacy(prj) and logins->isEmpty()) then null else
	let own : LockedImage = locked(estate.engines.postgres.catalog) in
	let surfacePort : Integer = p.provides->select(s | s.key = estate.engines.postgres.surface)->any(true).value in
	let named : String = p.name + '-catalog' in
	object ResolvedCatalogJob {
		identity := named;
		namespace := ns;
		image := own.repository + '@' + own.digest;
		imageVersion := own.version;
		uid := own.uid;
		gid := own.gid;
		role := ns + '-' + named;
		address := storeEndpoint();
		memory := estate.policyJob.memory;
		cpu := estate.policyJob.cpu;
		deadline := inSeconds(seconds(estate.policyJob.deadline).floor());
		eligibleNodes := estateJobNodes();
		catalog := object ResolvedCatalog {
			host := proc + '.' + ns + '.svc.cluster.local';
			port := surfacePort;
			connection := p.name;
			admin := if legacy(prj) then object CatalogAdmin {
					path := logins->first().path;
					user := logins->first().user;
					password := logins->first().password;
				} else object CatalogAdmin {
					path := 'secret/data/' + prj + '/' + p.name + '/catalog';
					user := 'user';
					password := 'password';
				} endif;
			databases := readers->collect(r | object CatalogDatabase {
				name := r + '_db';
				owner := r + '-owner';
				data := r + '-data';
			});
		};
		-- The method reaches the datastore as every consumer does, by its surface's label.
		consumes := Sequence{application + '.' + estate.engines.postgres.surface};
		policy := catalog.policy();
		egress := Sequence{object PolicyPeer {
				rule := 'datastore'; namespace := ns; process := proc; port := surfacePort; }}
			->union(storePeers())->append(object PolicyPeer {
				rule := 'cluster-dns'; namespace := estate.substrate.clusterDns; port := DNS_PORT; });
	} endif;

-- The Release Gate's endpoint: its `http` surface, which the platform names.
-- Where Flux's events about every Project's unit go (spec/v1/55-delivery.md#rollouts):
-- the Reporter's `http` surface, where the platform names a Reporter. The Reporter links
-- only to an Application declared beside the gate, so the address is that one's.
query eventsRouteOf() : ResolvedEvents =
	if estate.delivery = null or estate.delivery.reporter = null then null
	else object ResolvedEvents {
		namespace := estate.bootstrap.flux.sourceRef.substringBefore('/');
		address := 'http://' + surfaceAddress(estate.delivery.reporter.id, HTTP_SURFACE) + EVENTS_PATH;
	} endif;

query gateEndpoint() : String =
	let address : String = if estate.delivery = null then null
		else surfaceAddress(estate.delivery.gate.id, HTTP_SURFACE) endif in
	if address = null then ungated() else 'http://' + address endif;

query ungated() : String {
	assert fatal (false) with log('a blue/green Process under a platform that names no Release Gate is E_UNKNOWN_RELEASE_GATE');
	return null;
}

-- The Secret Store's endpoint: its `http` surface, which the platform names.
query storeEndpoint() : String =
	let address : String = if estate.secretStore = null then null
		else surfaceAddress(estate.secretStore.id, HTTP_SURFACE) endif in
	if address = null then unstored() else 'http://' + address endif;

query unstored() : String {
	assert fatal (false) with log('a grant under a platform that names no Secret Store');
	return null;
}

-- Whether any Process of the Application switches blue-green.
query gated(app : EffectiveApplication) : Boolean =
	app.processes->exists(p | switchesBlueGreen(app, p));

-- Only a serving Process switches at all: a job or a prepare Process has no switchover.
query switchesBlueGreen(app : EffectiveApplication, p : PI::Process) : Boolean =
	p.lifecycle = Lifecycle::application and switchoverOf(app, p) = Switchover::blueGreen;

-- The release-gate inputs a blue/green switch reads
-- (spec/v1/20-resolved-deployment.md#the-release-gate): one member per
-- blue/green Process that publishes readiness, the platform's analysis cadence,
-- and the slowest member's deadline.
mapping EffectiveApplication::gate() : ReleaseGate {
	init {
		var waiting : Sequence(PI::Process) := self.processes->select(p |
			switchesBlueGreen(self, p) and readinessOf(p) <> null)->asSequence();
		var moved : String := self.id;
		var proven : ProvenApplication := proofOf(self);
	}
	assert fatal (waiting->notEmpty())
		with log('a blue/green Application that publishes no readiness is E_RELEASE_UNIT_NO_READINESS');
	assert fatal (estate.delivery <> null)
		with log('a blue/green Process under a platform with no delivery policy is E_NO_DELIVERY_POLICY');
	endpoint := gateEndpoint();
	deadline := inSeconds(waiting->collect(p | deadlineOf(p))->max());
	analysis := object GateAnalysis {
		interval := estate.delivery.analysis.interval;
		iterations := estate.delivery.analysis.iterations;
		threshold := estate.delivery.analysis.threshold;
		errorRate := estate.delivery.analysis.errorRate;
		latency := estate.delivery.analysis.latency;
	};
	members := waiting->collect(p | object GateMember {
		process := p.resolveone(ResolvedProcess);
		readiness := readinessOf(p).target();
		checks := if exportsTelemetry(p) then Sequence{AnalysisCheck::errorRate, AnalysisCheck::latency}
			else Sequence{} endif;
		waitsFor := waitsForOf(self, p)->collect(t | object GateProvider {
			application := t.application;
			process := t.process;
		});
	});
	-- What the gate starts and may undo, where the Application has a migration.
	if managed(self) then migration := object GateMigration {
		identity := moved + '-migration';
		if proven <> null and proven.testedAgainst <> null then testedAgainst := proven.testedAgainst endif;
		nonTransactional := proven <> null and proven.nonTransactional;
	} endif;
}

-- What a member waits for before its new version starts
-- (spec/v1/55-delivery.md#release-order): every Process of another Application of its own
-- Project that one of its required edges reaches and that switches stop-start, by
-- Application and then Process. A provider in another Project is its Reconcile Unit's to
-- order, and a blue-green one keeps its old version serving.
query waitsForOf(app : EffectiveApplication, p : PI::Process)
		: Sequence(Tuple(application : String, process : String)) =
	let home : String = projectOf(app.id) in
	-- The member's own Application is among them, and holds no stop-start Process: an
	-- Application switches as one, or E_RELEASE_UNIT_MIXED_CUTOVER refused it.
	projects->select(prj | prj.project = home).applications
		->collect(a | a.processes
			->select(q | q.lifecycle = Lifecycle::application and q.cutover = PI::Cutover::interrupted
				and p.dependsOn->exists(e | not (e.required = false) and e.application = a.id
					and q.provides->exists(s | s.key = e.surface)))
			->collect(q | Tuple{application = a.id, process = q.name}))->flatten()
		-- A space sorts before any character a name may hold.
		->sortedBy(t | t.application + ' ' + t.process)->asSequence();

-- What the proof beside the project records of an Application's release, or nothing.
query proofOf(app : EffectiveApplication) : ProvenApplication =
	proofs->select(a | a.id = app.id)->any(true);

-- ================================================================ the Process

mapping PI::Process::process(in app : EffectiveApplication, in prj : EffectiveProject)
		: ResolvedProcess {
	init {
		var own : LockedImage := locked(self.image);
		var declared : Probes := if self.probes <> null and self.probes.oclIsKindOf(Probes)
			then self.probes.oclAsType(Probes) else null endif;
	}

	name := self.name;
	-- The Vault role and the ServiceAccount are both the Process's own name.
	identity := self.name;
	lifecycle := self.lifecycle.spelling();
	image := own.repository + '@' + own.digest;
	imageVersion := own.version;
	uid := own.uid;
	gid := own.gid;
	if self.cutover <> PI::Cutover::absent then cutover := self.cutover.resolvedCutover() endif;
	if self.lifecycle = Lifecycle::application then switchover := switchoverOf(app, self) endif;
	-- Flagger serves a blue-green Process from a primary it names and labels after the Process.
	serving := if self.servesFromPrimary(app) then self.name + '-primary' else self.name endif;
	servingLabel := if self.servesFromPrimary(app) then 'app.kubernetes.io/name'
		else 'app.kubernetes.io/instance' endif;
	deadline := inSeconds(deadlineOf(self));
	-- A scheduled run that starts more than the start deadline late is skipped.
	if self.schedule <> null then schedule := self.schedule endif;
	if self.schedule <> null then startDeadline := '300s' endif;
	replicas := if self.parked <> null then 0 else if self.replicas = null then 1 else self.replicas.count endif endif;
	parked := self.parked <> null;
	spread := self.replicas <> null and self.replicas.oclAsType(ECORE::EObject).states('across');
	arguments := self.args->asSequence()->union(edgeArgsOf(self));
	-- A path held in memory is memory the container holds.
	memory := let held : Real = self.writablePaths->select(w | w.oclIsKindOf(MemoryPath))
			->collect(w | mebibytes(w.oclAsType(MemoryPath).memory))->sum() in
		if held = 0 then self.placement.memory else memoryOf(mebibytes(self.placement.memory) + held) endif;
	cpu := self.placement.cpu;
	if self.placement.gpu <> null then gpu := gpuOf(self) endif;
	if self.vpn <> null then vpn := vpnOf(self) endif;
	hardening := estate.hardening.spelling();
	secrets := self.secrets->collect(g | g.resolvedFor(self))->union(self.edgeCredentials(app, prj))->union(edgeGrantsOf(self))->union(obsReceiverGrants(self, app))->union(self.clientGrants(app))->union(bucketKeysOf(self, prj));
	-- The pod authenticates only where a grant is delivered `self`, or where it
	-- holds Kubernetes API access.
	priorityClass := priorityOf(self, app, prj);
	identityToken := self.api <> null or self.secrets->exists(g | g.delivery = Delivery::selfDelivery)
		or self.edgeCredentials(app, prj)->exists(g | g.delivery = 'self')
		or self.clientGrants(app)->notEmpty()
		or self.spawns->notEmpty();
	-- The platform admits the holder, or E_PROCESS_RBAC_GRANT refused it, so the
	-- block that says where the API answers is there.
	-- A spawn template derives access to create its pods in the Process's own namespace.
	if self.api <> null or self.spawns->notEmpty() then api := object ResolvedApiAccess {
		reason := if self.api = null then 'it creates the pods its spawn templates declare' else self.api.reason endif;
		rules := (if self.api = null then Sequence{} else self.api.rules->asSequence() endif)->collect(r | object ResolvedApiRule {
			group := r.group;
			objects := r.objects;
			verbs := r.verbs->collect(v | v.toString());
			-- A rule reaches the cluster unless it says its own namespace.
			scope := if r.scope = ApiScope::_namespace then RuleScope::_namespace else RuleScope::cluster endif;
		})->union(if self.spawns->isEmpty() then Sequence{} else Sequence{
			object ResolvedApiRule { group := 'core'; objects := Sequence{'pods'};
				verbs := Sequence{'get', 'list', 'watch', 'create', 'delete'}; scope := RuleScope::_namespace; },
			object ResolvedApiRule { group := 'core'; objects := Sequence{'pods/log'};
				verbs := Sequence{'get'}; scope := RuleScope::_namespace; }} endif);
		server := estate.apiAccess.server->collect(range | object AdmittedRange {
			cidr := range.cidr;
			port := range.port;
		});
	} endif;
	if self.egress <> null then internetEgress := object InternetEgress { reason := self.egress.reason; } endif;
	if self.egress = null and edgeAcme(self) then internetEgress := object InternetEgress { reason := ACME_REASON; } endif;
	if self.egress = null and self.vpn <> null then internetEgress := object InternetEgress { reason := TUNNEL_REASON; } endif;
	component := self.runtime.spelling();
	if declared <> null and declared.readiness <> null then readiness := declared.readiness.cadenced() endif;
	if declared <> null and declared.liveness <> null then liveness := declared.liveness.cadenced() endif;
	-- The startup probe polls liveness, so readiness alone derives none.
	if declared <> null and declared.liveness <> null and self.startupBudget <> null then
		startup := object StartupProbe {
			target := declared.liveness.target();
			period := inSeconds(STARTUP_PERIOD);
			timeout := estate.probes.timeout;
			failures := ceiling(seconds(self.startupBudget) / STARTUP_PERIOD);
		}
	endif;
	-- A surface exposed on a node's own address listens on the host's port too.
	surfaces := self.provides->collect(s | object ResolvedSurface {
		name := s.key;
		port := s.value;
		hostPort := l4Of(self)->select(e | e.surface = s and addressOf(e.address).oclIsKindOf(NodeAddress)
				and e.port = s.value and e.protocol = L4Protocol::tcp)
			->collect(e | e.port)->any(true);
	});
	l4Services := l4ServicesOf(self);
	-- A Process that serves DNS resolves through the platform's upstream nameservers.
	if servesDns(self) then nameservers := estate.substrate.upstreamNameservers endif;
	nodePorts := edgeNodePortsOf(self);
	placement := object ResolvedPlacement {
		eligibleNodes := contract.nodes->select(n | eligible(self, n))->collect(n | n.name);
		-- A claim the snapshot records as bound holds the Process to that node.
		if (boundOf(self) <> null) {
			boundTo := boundOf(self).node;
			_from := PinnedInput::clusterState;
		} endif;
	};
	volumes := self.volumes->collect(v | v.resolvedFor(self))->union(edgeVolumesOf(self));
	libraries := self.libraries->collect(m | m.resolvedFor(prj));
	-- A seeded Asset lands on a volume or a writable path through the seeder's init step.
	assets := self.assets->collect(a | a.resolvedFor(self, prj));
	if self.assets->exists(a | a.oclIsKindOf(SeededAsset)) and estate.seeder <> null then
		seeder := self.seederOf(prj) endif;
	sidecars := self.sidecars->collect(c | object ResolvedSidecar {
		name := c.name;
		image := locked(c.image).repository + '@' + locked(c.image).digest;
		imageVersion := locked(c.image).version;
		memory := c.memory;
		cpu := c.cpu;
		-- An init step runs to completion before the Process starts.
		_init := c._init = true;
		-- A volume of the Process, where the sidecar says; then a file beside the project,
		-- mounted read-only from the Process's Asset ConfigMap.
		mounts := c.volumes->collect(v | object ContainerMount { name := v.claim; mountAt := v.mountAt; })
			->union(c.assets->collect(a | let read : String = fileOf(prj.project, a._from) in object ContainerMount {
			name := self.name + '-' + spelled(a._from) + '-'
				+ read.textDigestOf().substring(8, 7 + CONTENT_DIGITS);
			mountAt := a.mountAt;
			subPath := a._from.substring(a._from.lastIndexOf('/') + 1, a._from.size());
			readOnly := true;
		}));
		if mountsTmp(self) and not namesHome(self, prj) then home := HOME_DIR endif;
	});
	dependencies := self.dependsOn->collect(e | edgeOf(e, owner(self)));
	-- An edge to an Application's surface reaches a pod, which admits the label; one to a
	-- Registered Unmanaged Surface reaches an address.
	consumes := result.dependencies->select(d | d.peers->notEmpty())
		->collect(d | d.application + '.' + d.surface);
	-- A path held in memory is sized by what it holds; every other by the ephemeral policy.
	writablePaths := self.writablePaths->collect(w | object WritablePath {
		path := w.path;
		size := if w.oclIsKindOf(MemoryPath) then w.oclAsType(MemoryPath).memory
			else estate.ephemeral.size endif;
		memory := w.oclIsKindOf(MemoryPath);
	});
	-- A spawn template's pods run on its image, labelled for its Process and the surfaces it consumes.
	spawns := self.spawns->collect(t | object ResolvedSpawn {
		name := self.name + '-' + t.name;
		surfaces := t.provides->collect(s | object ResolvedSurface { name := s.key; port := s.value; });
		dependencies := t.dependsOn->collect(e | edgeOf(e, owner(self)));
		egress := Sequence{object PolicyPeer { rule := 'cluster-dns'; namespace := estate.substrate.clusterDns; port := DNS_PORT; }};
		if t.egress <> null then internetEgress := object InternetEgress { reason := t.egress.reason; } endif;
	});
	environment := environmentOf(self, prj)->union(edgeEnvOf(self))
		->union(self.spawns->collect(t | Sequence{
			object EnvEntry { name := spawnVariable(t.name, 'IMAGE');
				value := locked(t.image).repository + '@' + locked(t.image).digest; },
			object EnvEntry { name := spawnVariable(t.name, 'LABELS');
				value := Sequence{'deploy-kit.jorisjonkers.dev/spawned-from=' + self.name + '-' + t.name}
					->union(t.dependsOn->collect(e | 'consumes.deploy-kit.jorisjonkers.dev/' + e.application + '.' + e.surface + '=true'))
					->iterate(l; acc : String = '' | if acc = '' then l else acc + ',' + l endif); }})->flatten())
		->sortedBy(e | e.name);
	if mountsTmp(self) and not namesHome(self, prj) then home := HOME_DIR endif;
	addedPrivileges := lowPrivileges(result);
}

-- `progressDeadlineSeconds`: three budgets, floored to a whole second, or for a
-- prepare Process the budget itself, rounded up so it is never cut short.
query deadlineOf(p : PI::Process) : Integer =
	(if p.startupBudget = null then UNBUDGETED_DEADLINE
	else if p.lifecycle = Lifecycle::prepare then ceiling(seconds(p.startupBudget))
	else (seconds(p.startupBudget) * 3).floor() endif endif) + imagePull();

-- The substrate's image pull, rounded up to a whole second, which every derived deadline
-- allows since it runs from before the image is on the node; nothing where none is stated.
query imagePull() : Integer =
	if estate.substrate.imagePull = null then 0 else ceiling(seconds(estate.substrate.imagePull)) endif;

-- How the new version replaces the old (spec/v1/55-delivery.md#switchover).
query PI::Process::servesFromPrimary(app : EffectiveApplication) : Boolean =
	self.lifecycle = Lifecycle::application and switchoverOf(app, self) = Switchover::blueGreen;

query switchoverOf(app : EffectiveApplication, p : PI::Process) : Switchover =
	-- A parked Process runs no pod, so it has no release to gate: it stops and starts.
	if p.cutover = PI::Cutover::interrupted or p.parked <> null then Switchover::stopStart
	else if estate.delivery <> null and estate.delivery.machinery->exists(m | m.id = app.id)
		then Switchover::rolling
	else Switchover::blueGreen endif endif;

query readinessOf(p : PI::Process) : Probe =
	if p.probes <> null and p.probes.oclIsKindOf(Probes)
		then p.probes.oclAsType(Probes).readiness else null endif;

-- Readiness and liveness take the Platform document's cadence.
query Probe::cadenced() : ResolvedProbe = object ResolvedProbe {
	target := self.target();
	period := estate.probes.period;
	timeout := estate.probes.timeout;
	failures := estate.probes.failures;
};

query Probe::target() : ProbeTarget =
	if self.oclIsKindOf(HttpProbe) then
		object HttpTarget {
			path := self.oclAsType(HttpProbe).path;
			port := self.oclAsType(HttpProbe).port;
		}.oclAsType(ProbeTarget)
	else
		object TcpTarget { tcp := self.oclAsType(TcpProbe).tcp; }.oclAsType(ProbeTarget)
	endif;

-- The binding the snapshot records for a claim the Process holds, where one does.
query boundOf(p : PI::Process) : Binding =
	let bound : Sequence(Binding) =
		snapshot.bindings->select(b | p.volumes->exists(v | v.claim = b.claim))->asSequence() in
	if bound->isEmpty() then null else bound->first() endif;

-- ==================================================================== grants

-- The Secret a grant's value is synced to: the Process, then the path below the mount.
-- One grant per object store whose buckets the Process's edges name
-- (spec/v1/16-dependencies.md#the-bucket-catalog): `read` on its project's key,
-- synced to the environment its key coordinates read.
query bucketKeysOf(p : PI::Process, prj : EffectiveProject) : Sequence(ResolvedGrant) =
	p.dependsOn->select(e | e.buckets->notEmpty())
		->collect(e | projects.applications->select(a | a.id = e.application).processes
			->select(q | q.provides->exists(s | s.key = e.surface))->collect(q | q.name))->flatten()
		->asOrderedSet()->collect(store | let keyPath : String = 'secret/data/' + prj.project + '/' + store + '/s3' in
			object ResolvedGrant {
				path := keyPath;
				keys := Sequence{'access-key-id', 'secret-access-key'};
				_access := 'read';
				delivery := 'env';
				destination := destinationOf(p.name, keyPath);
			})->asSequence();

query destinationOf(holder : String, path : String) : String =
	holder + '-' + (if path.startsWith('secret/data/') and path.size() > 12 then path.substring(13, path.size()) else path endif)
		.replaceAll('/', '-');

-- The credential the Process's first edge to a database derives
-- (spec/v1/10-project-intent.md#migration): the project's data role, or its
-- owner role where the Application migrates itself, delivered as the edge says.
query PI::Process::edgeCredentials(app : EffectiveApplication, prj : EffectiveProject) : Sequence(ResolvedGrant) =
	let edges : Sequence(DependencyEdge) = self.dependsOn->select(e | reachesDatabase(e))->asSequence() in
	if edges->isEmpty() then Sequence{} else
	let edge : DependencyEdge = edges->first() in
	let credential : String = 'database/creds/' + credentialRole(app, prj) in
	let deliveredAs : String = if edge.credentials = null then 'self'
		else if edge.credentials.delivery = Delivery::env then 'env'
		else if edge.credentials.delivery = Delivery::file then 'file' else 'self' endif endif endif in
	Sequence{object ResolvedGrant {
		engine := 'database';
		delivery := deliveredAs;
		paths := Sequence{object PolicyPath { path := credential; allows := Sequence{'read'}; }};
		if deliveredAs <> 'self' then destination := destinationOf(self.name, credential) endif;
		-- The schema refused a file credential without both.
		if deliveredAs = 'file' then mountAt := edge.credentials.mountAt endif;
		if deliveredAs = 'file' then fileMode := edge.credentials.fileMode endif;
		if edge.credentials <> null and edge.credentials.rotation.tolerates = Tolerance::restart then
			restartTargets := Sequence{self.name}
		endif;
	}} endif;

-- The role a Process's edge to its project's database derives.
query credentialRole(app : EffectiveApplication, prj : EffectiveProject) : String =
	prj.project + (if app.migration <> null and app.migration.oclIsKindOf(SelfMigration) then '-owner' else '-data' endif);

-- Whether an edge reaches a surface of a Process whose engine owns databases.
query reachesDatabase(e : DependencyEdge) : Boolean =
	projects.applications->exists(a | a.id = e.application
		and a.processes->exists(q | ownsDatabases(q) and q.provides->exists(s | s.key = e.surface)));

-- A `kv` grant keeps its path and keys; a `transit` or `database` grant becomes
-- the paths its policy covers. A rotation that tolerates only a restart restarts
-- the Process in place, and a reload restarts nothing.
query Grant::resolvedFor(p : PI::Process) : ResolvedGrant = object ResolvedGrant {
	delivery := self.delivery.spelling();
	if (self.oclIsKindOf(KvGrant)) {
		path := self.oclAsType(KvGrant).path;
		keys := self.oclAsType(KvGrant).keys.name;
		generated := self.oclAsType(KvGrant).keys->select(k | k.oclIsKindOf(GeneratedKey))
			->collect(k | k.oclAsType(GeneratedKey).resolved());
		_access := self.oclAsType(KvGrant)._access.spelling();
		if self.delivery <> Delivery::selfDelivery then
			destination := destinationOf(p.name, self.oclAsType(KvGrant).path)
		endif;
	} elif (self.oclIsKindOf(TransitGrant)) {
		engine := 'transit';
		-- `read` is the key's public part and versions, which the key itself serves.
		paths := self.oclAsType(TransitGrant).operations->collect(o | object PolicyPath {
			path := if o = TransitOp::read then 'transit/keys/' + self.oclAsType(TransitGrant).key
				else if o = TransitOp::rotate then 'transit/keys/' + self.oclAsType(TransitGrant).key + '/rotate'
				else 'transit/' + o.spelling() + '/' + self.oclAsType(TransitGrant).key endif endif;
			allows := Sequence{if o = TransitOp::read then 'read' else 'update' endif};
		});
	} else {
		engine := 'database';
		paths := Sequence{object PolicyPath {
			path := 'database/creds/' + self.oclAsType(DatabaseGrant).role;
			allows := Sequence{'read'};
		}};
	} endif;
	if self.mountAt <> null then mountAt := self.mountAt endif;
	if self.fileMode <> null then fileMode := self.fileMode endif;
	-- A synced value restarts its consumer once the operator syncs it, whatever the rotation
	-- tolerates; read by the Process itself, a rotation restarts it, and a reload restarts nothing.
	-- A scheduled Process reads its values afresh on every run, so nothing restarts it.
	if p.lifecycle <> Lifecycle::scheduled
			and (self.delivery <> Delivery::selfDelivery or self.rotation.tolerates = Tolerance::restart) then
		restartTargets := Sequence{p.name}
	endif;
};

-- =================================================================== volumes

-- A volume, and the backup its Durability Class derives
-- (spec/v1/10-project-intent.md#volumes): `reconstructible` earns none.
query Volume::resolvedFor(p : PI::Process) : ResolvedVolume = object ResolvedVolume {
	claim := self.claim;
	mountAt := self.mountAt;
	size := self.size;
	durability := self.durability.resolvedDurability();
	if self.durability <> PI::DurabilityClass::reconstructible then backup := self.backupFor(p) endif;
};

-- A library the Process mounts, resolved against the Platform document that
-- declares it (spec/v1/10-project-intent.md#libraries): every mounted library
-- is declared, or E_UNKNOWN_LIBRARY refused it.
query LibraryMount::resolvedFor(prj : EffectiveProject) : ResolvedLibraryMount = object ResolvedLibraryMount {
	_library := self._library;
	claim := 'library-' + self._library;
	volume := namespaceOf(prj.project) + '-' + self._library;
	node := libraryOf(self._library).node;
	path := libraryOf(self._library).path;
	gid := libraryOf(self._library).gid;
	mountAt := self.mountAt;
	if self.subPath <> null then subPath := self.subPath endif;
	_access := if self._access = LibraryAccess::write then 'write' else 'read' endif;
};

-- The library the Platform document declares under `name`, or null.
query libraryOf(name : String) : LibraryDeclaration =
	estate.libraries->select(l | l.key = name)->collect(l | l.value)->any(true);

query Volume::backupFor(p : PI::Process) : BackupPlan =
	let policy : DurabilityPolicy = if self.durability = PI::DurabilityClass::recoverable
		then estate.durability.recoverable else estate.durability.irreplaceable endif in
	let methodImage : LockedImage = locked(engineMethod(p)) in
	-- A method that reads the volume alone runs as the Process that wrote it.
	let runAs : LockedImage = if dumpedSurface(p) = null then locked(p.image) else methodImage endif in
	let holder : String = p.name + '-backup' in
	if policy = null or policy.schedule = null or policy.retain = null
		then unplanned(self.claim) else
	object BackupPlan {
		schedule := policy.schedule;
		retain := policy.retain;
		method := methodImage.repository + '@' + methodImage.digest;
		methodVersion := methodImage.version;
		uid := runAs.uid;
		gid := runAs.gid;
		identity := holder;
		claim := self.claim + '-backup';
		egress := backupEgress(p);
		-- A method that dumps over the network is told where, and logs in with
		-- a credential derived from the Process, which only its backups hold.
		if (dumpedSurface(p) <> null) {
			peer := object BackupPeer {
				host := p.name + '.' + namespaceOf(owner(p)) + '.svc.cluster.local';
				port := p.provides->select(s | s.key = dumpedSurface(p))->any(true).value;
				credential := object ResolvedGrant {
					path := backupCredentialOf(p);
					_access := 'read';
					delivery := 'env';
					destination := destinationOf(holder, backupCredentialOf(p));
				};
			};
		} endif;
		if (policy.offCluster <> null) {
			destinations := policy.offCluster.egress->collect(range | object AdmittedRange {
				cidr := range.cidr;
				port := range.port;
			});
			offCluster := policy.offCluster.destination;
			-- Where the copy lands below the destination, and the key it is encrypted to.
			offClusterPath := owner(p) + '/' + p.name + '/' + self.claim;
			offClusterRecipient := policy.offCluster.recipient;
			credential := object ResolvedGrant {
				path := policy.offCluster.credential;
				_access := 'read';
				delivery := 'env';
				destination := destinationOf(holder, policy.offCluster.credential);
			};
		} endif;
	} endif;

-- Where a method that dumps a Process over the network reads the credential it
-- logs in with: one path per Process, which its name keeps distinct within its project.
query backupCredentialOf(p : PI::Process) : String =
	'secret/data/' + owner(p) + '/' + p.name + '/backup';

query unplanned(claim : String) : BackupPlan {
	assert fatal (false) with log(claim + ': its Durability Class derives a backup, and the platform names no schedule and retention for it');
	return null;
}

-- The backup method the platform names for the Process's engine, an image alias.
-- What a backup identity's own policy admits
-- (spec/v1/16-dependencies.md#the-backup-identitys-policy): the Process it
-- dumps, on the surface the engine's method connects to, and the cluster's DNS.
-- A method that reads the volume alone names no surface. Never the Secret
-- Store: the operator reads the backup's credential for it.
query backupEgress(p : PI::Process) : Sequence(PolicyPeer) =
	(if dumpedSurface(p) = null then Sequence{} else Sequence{object PolicyPeer {
		rule := 'datastore';
		namespace := namespaceOf(owner(p));
		process := p.name;
		port := p.provides->select(s | s.key = dumpedSurface(p))->any(true).value;
	}} endif)
	->union(Sequence{object PolicyPeer { rule := 'cluster-dns'; namespace := estate.substrate.clusterDns; port := DNS_PORT; }});

-- The surface the platform names for the Process's engine, where the Process is
-- backed up at all and its method dumps one.
query dumpedSurface(p : PI::Process) : String =
	if not p.oclAsType(ECORE::EObject).states('engine')
		or not p.volumes->exists(v | v.durability <> PI::DurabilityClass::reconstructible) then null
	else policySurface(enginePolicyOf(p)) endif;

-- The platform's policy for the Process's engine.
query enginePolicyOf(p : PI::Process) : EnginePolicy =
	if p.engine = Engine::postgres then estate.engines.postgres
	else if p.engine = Engine::rabbitmq then estate.engines.rabbitmq
	else if p.engine = Engine::valkey then estate.engines.valkey
	else if p.engine = Engine::mongo then estate.engines.mongo
	else if p.engine = Engine::s3 then estate.engines.s3
	else estate.engines.files endif endif endif endif endif;

query policySurface(policy : EnginePolicy) : String =
	if policy = null then null else policy.surface endif;

-- The project a Process is declared in.
query owner(p : PI::Process) : String =
	projects->select(prj | prj.applications.processes->includes(p))->first().project;

-- The Application a Process belongs to.
query applicationOf(p : PI::Process) : String =
	projects.applications->select(a | a.processes->includes(p))->first().id;

-- Where the handover ledger states the old path runs `application`: one
-- location, or none (spec/v1/14-platform-intent.md#handover-ledger).
query stated(application : String) : Sequence(ServingLocation) =
	if estate.handover = null then Sequence{}
	else estate.handover.serving->select(l | l.application = application)->asSequence() endif;

-- Where one Process of `application` serves: its project's namespace under its
-- own name, or, while its project is legacy, where the ledger states it runs.
query homeNamespace(prj : String, application : String) : String =
	if stated(application)->isEmpty() then namespaceOf(prj)
	else stated(application)->first().namespace endif;

query homeProcess(application : String, process : String) : String =
	if stated(application)->isEmpty() then process
	else if stated(application)->first().instance = null then process
	else stated(application)->first().instance endif endif;

query engineMethod(p : PI::Process) : String =
	if not p.oclAsType(ECORE::EObject).states('engine') then unengined(p)
	else enginePolicyOf(p).backup endif;

query unengined(p : PI::Process) : String {
	assert fatal (false) with log(p.name + ' backs a volume up and declares no engine: E_DURABILITY_WITHOUT_ENGINE');
	return null;
}

-- ==================================================================== Assets

-- A settings file, by a name its content changes
-- (spec/v1/10-project-intent.md#assets): the Process, the file, and the first
-- digits of the content's digest.
query AssetDeclaration::resolvedFor(p : PI::Process, prj : EffectiveProject) : ResolvedAsset =
	let found : Sequence(AssetFile) =
		assetFiles->select(f | f.project = prj.project and f._from = self._from)->asSequence() in
	let file : AssetFile = if found->isEmpty() then unfiled(self._from) else found->first() endif in
	-- Only a placeholder of a kind the model reads is one; a `${VAR}` the image itself expands is text.
	if file.content.matches('(?s).*\\$\\{(secret|dependency|exposure|identity|client):.*') then unplaced(self._from) else
	object ResolvedAsset {
		name := p.name + '-' + spelled(self._from) + '-'
			+ file.content.textDigestOf().substring(8, 7 + CONTENT_DIGITS);
		_from := self._from;
		if self.oclIsKindOf(Asset) then mountAt := self.oclAsType(Asset).mountAt endif;
		if self.oclIsKindOf(SeededAsset) then seedAt := self.oclAsType(SeededAsset).seedAt endif;
		content := file.content;
	} endif;

-- The init step that seeds a Process's Assets onto its volumes and writable paths
-- (spec/v1/10-project-intent.md#assets): each file is staged beside its place and moved
-- over it, the copy it replaces kept as `.superseded`.
query PI::Process::seederOf(prj : EffectiveProject) : ResolvedSeeder =
	let seeded : Sequence(ResolvedAsset) = self.assets->select(a | a.oclIsKindOf(SeededAsset))
		->collect(a | a.resolvedFor(self, prj))->asSequence() in
	let seedImage : LockedImage = locked(estate.seeder.image) in
	object ResolvedSeeder {
		image := seedImage.repository + '@' + seedImage.digest;
		imageVersion := seedImage.version;
		memory := estate.seeder.memory;
		cpu := estate.seeder.cpu;
		command := Sequence{'/bin/sh', '-c',
			Sequence{'set -eu', 'umask 077'}->union(seeded->collect(a | seedScriptOf(a))->flatten())
				->iterate(line; acc : String = '' | if acc = '' then line else acc + '\n' + line endif)};
		mounts := seeded->collect(a | object ContainerMount { name := a.name; mountAt := '/seed/' + a.name; readOnly := true; })
			->union(self.volumes->select(v | seeded->exists(a | a.seedAt.startsWith(v.mountAt + '/')))
				->collect(v | object ContainerMount { name := v.claim; mountAt := v.mountAt; }))
			->union(self.writablePaths->select(w | seeded->exists(a | a.seedAt.startsWith(w.path + '/')))
				->collect(w | object ContainerMount { name := writableOf(w.path); mountAt := w.path; }));
	};

query seedScriptOf(a : ResolvedAsset) : Sequence(String) =
	let place : String = quotedWord(a.seedAt) in
	let staged : String = quotedWord(a.seedAt + '.seeding') in
	Sequence{
		'mkdir -p ' + quotedWord(a.seedAt.substring(1, a.seedAt.lastIndexOf('/') - 1)),
		'if [ -e ' + place + ' ]; then cp -p ' + place + ' ' + quotedWord(a.seedAt + '.superseded') + '; fi',
		'cp ' + quotedWord('/seed/' + a.name + '/' + a._from.substring(a._from.lastIndexOf('/') + 1, a._from.size()))
			+ ' ' + staged,
		'chmod 0600 ' + staged,
		'mv ' + staged + ' ' + place};

-- A word the shell reads as it stands.
query quotedWord(word : String) : String = '\'' + word.replaceAll('\'', '\'\\\\\'\'') + '\'';

-- The volume a writable path is, named after it.
query writableOf(path : String) : String =
	'writable-' + path.substring(2, path.size()).toLower().replaceAll('[^a-z0-9]+', '-');

-- The endpoint the edge asks a tier's forward-auth at: its provider's Stable
-- Address on the surface, at the port its Process provides it on, and the path
-- (spec/v1/14-platform-intent.md#tiers).
query ForwardAuth::endpoint() : String =
	let port : Integer = self.provider.processes.provides
		->select(s | s.key = self.surface)->any(true).value in
	'http://' + self.provider.id + '-' + self.surface + '.' + STABLE_NAMESPACE + '.svc.cluster.local:'
		+ port.toString() + self.path;

-- The content of a file the project names, read from beside it.
query fileOf(project : String, source : String) : String =
	let found : Sequence(AssetFile) =
		assetFiles->select(f | f.project = project and f._from = source)->asSequence() in
	if found->isEmpty() then unfiled(source).content else found->first().content endif;

-- A dashboard's own uid: the top-level key of its JSON, as Grafana exports it.
query uidOf(content : String) : String =
	let at : Integer = content.indexOf('\n  "uid": "') in
	if at <= 0 then null else
	let rest : String = content.substring(at + 11, content.size()) in
	rest.substring(1, rest.indexOf('"') - 1) endif;

-- The data source inputs a vendored dashboard declares, by name.
query inputsOf(content : String) : Sequence(String) =
	let at : Integer = content.indexOf('"__inputs"') in
	if at <= 0 then Sequence{} else
	let rest : String = content.substring(at, content.size()) in
	let segment : String = rest.substring(1, rest.indexOf(']')) in
	segment.tokenize('}')->select(e | e.indexOf('"type": "datasource"') > 0 and e.indexOf('"name": "') > 0)
		->collect(e | let named : String = e.substring(e.indexOf('"name": "') + 9, e.size()) in
			named.substring(1, named.indexOf('"') - 1))->asSequence() endif;

query spawnVariable(template : String, what : String) : String =
	'SPAWN_' + template.toUpper().replaceAll('[^A-Z0-9]', '_') + '_' + what;

query unfiled(source : String) : AssetFile {
	assert fatal (false) with log(source + ': an Asset whose file is not beside its project');
	return null;
}

query unplaced(source : String) : ResolvedAsset {
	assert fatal (false) with log(source + ': a placeholder in an Asset is not resolved yet');
	return null;
}

-- An Asset's file name, spelled as the part of an object name it becomes.
query spelled(path : String) : String =
	path.substring(path.lastIndexOf('/') + 1, path.size()).toLower().replaceAll('[^a-z0-9]+', '-');

-- ===================================================================== edges

-- A dependency edge resolved against the union, then the platform's register
-- of providers (spec/v1/16-dependencies.md#dependency-edges): the pair names one
-- Process, one port and one address, and the peer a policy admits. `consumer`
-- is the project holding the edge, whose namespace the alias lives in.
query edgeOf(e : DependencyEdge, consumer : String) : ResolvedEdge =
	let providers : Sequence(Tuple(project : String, process : PI::Process)) =
		projects->collect(prj | prj.applications->select(a | a.id = e.application).processes
			->select(p | p.provides->exists(s | s.key = e.surface))
			->collect(p | Tuple{project = prj.project, process = p}))->flatten() in
	if providers->notEmpty() then
		let first : Tuple(project : String, process : PI::Process) = providers->first() in
		let at : Integer = first.process.provides->select(s | s.key = e.surface)->any(true).value in
		let host : String = homeProcess(e.application, first.process.name) + '.'
			+ homeNamespace(first.project, e.application) + '.svc.cluster.local' in
		object ResolvedEdge {
			application := e.application;
			surface := e.surface;
			address := dialled(e, host, consumer) + ':' + at.toString();
			target := aliasTarget(e, host, consumer);
			peers := Sequence{object PolicyPeer {
				namespace := homeNamespace(first.project, e.application);
				process := homeProcess(e.application, first.process.name);
				port := at;
			}};
		}
	else
		let registered : Sequence(Provider) = estate.providers
			->select(r | r.name = e.application and r.surfaces->exists(s | s.key = e.surface))->asSequence() in
		if registered->isEmpty() then unprovided(e) else
		let host : String = registered->first().address in
		object ResolvedEdge {
			application := e.application;
			surface := e.surface;
			address := dialled(e, host, consumer) + ':'
				+ registered->first().surfaces->select(s | s.key = e.surface)->any(true).value.toString();
			target := aliasTarget(e, host, consumer);
		} endif
	endif;

-- Where a provider's surface is served, before any alias: its Process's Service in
-- its home namespace, or the address the platform registers for it.
query homeHostOf(e : DependencyEdge) : String =
	let providers : Sequence(Tuple(project : String, process : PI::Process)) =
		projects->collect(prj | prj.applications->select(a | a.id = e.application).processes
			->select(p | p.provides->exists(s | s.key = e.surface))
			->collect(p | Tuple{project = prj.project, process = p}))->flatten() in
	if providers->notEmpty() then
		homeProcess(e.application, providers->first().process.name) + '.'
			+ homeNamespace(providers->first().project, e.application) + '.svc.cluster.local'
	else
		let registered : Sequence(Provider) = estate.providers
			->select(r | r.name = e.application and r.surfaces->exists(s | s.key = e.surface))->asSequence() in
		if registered->isEmpty() then null else registered->first().address endif
	endif;

-- The Stable Addresses the project's aliases point at
-- (spec/v1/16-dependencies.md#the-stable-address): one ExternalName Service per
-- surface, in the estate's own namespace, naming where the surface is served.
query EffectiveProject::stableAddressFiles() : Sequence(Deliverable) =
	let root : String = 'estate/stable-addresses/' in
	let aliased : Sequence(DependencyEdge) =
		self.applications.processes.dependsOn->asSequence()
			->select(e | homeHostOf(e) <> null and not isLiteral(homeHostOf(e))) in
	let named : Sequence(DependencyEdge) =
		aliased->select(e | aliased->select(o | o.application = e.application and o.surface = e.surface)
			->first() = e)->sortedBy(e | e.application + '-' + e.surface) in
	if named->isEmpty() then Sequence{} else
	Sequence{
		object StableAddressFile {
			path := root + 'services.yaml';
			adapter := AdapterName::kubernetes;
			namespace := STABLE_NAMESPACE;
			addresses := named->collect(e | object Alias { name := e.application + '-' + e.surface; target := homeHostOf(e); });
		}.oclAsType(Deliverable),
		object NamespaceFile {
			path := root + 'namespace.yaml';
			adapter := AdapterName::kubernetes;
			namespace := STABLE_NAMESPACE;
		}.oclAsType(Deliverable),
		object IndexFile {
			path := root + 'kustomization.yaml';
			adapter := AdapterName::kubernetes;
			resources := Sequence{'namespace.yaml', 'services.yaml'};
		}.oclAsType(Deliverable)} endif;

-- The name an edge's alias holds: what its consumer dials, up to the port.
query aliasName(e : ResolvedEdge) : String = e.address.substring(1, e.address.lastIndexOf(':') - 1);

-- The suffix a Service in `consumer`'s own namespace carries.
query localSuffix(consumer : String) : String = '.' + namespaceOf(consumer) + '.svc.cluster.local';

query isLocal(host : String, consumer : String) : Boolean = host.endsWith(localSuffix(consumer));

-- An IP, which no name can stand for.
query isLiteral(host : String) : Boolean = host.replaceAll('[0-9.]', '') = '' or host.indexOf(':') > 0;

-- What the consumer dials (spec/v1/16-dependencies.md#the-alias): a provider in
-- its own namespace by its own Service name, an IP as it stands, anything else by
-- its alias.
query dialled(e : DependencyEdge, host : String, consumer : String) : String =
	if isLocal(host, consumer) then host.substring(1, host.size() - localSuffix(consumer).size())
	else if isLiteral(host) then host
	else aliasNameOf(e, consumer) endif endif;

-- Where an alias points, on an edge that derives one: the surface's Stable
-- Address, so a provider that moves changes the Stable Address alone, never a
-- consumer's render (spec/v1/16-dependencies.md#the-stable-address).
query aliasTarget(e : DependencyEdge, host : String, consumer : String) : String =
	if isLocal(host, consumer) or isLiteral(host) then null
	else e.application + '-' + e.surface + '.' + STABLE_NAMESPACE + '.svc.cluster.local' endif;

-- The alias's name: the Application Id, or the Id and the surface where the
-- project's edges name several surfaces of it, since a name carries no port.
query aliasNameOf(e : DependencyEdge, consumer : String) : String =
	let surfaces : Set(String) = projects->select(prj | prj.project = consumer).applications.processes.dependsOn
		->select(d | d.application = e.application)->collect(d | d.surface)->asSet() in
	if surfaces->size() > 1 then e.application + '-' + e.surface else e.application endif;

query unprovided(e : DependencyEdge) : ResolvedEdge {
	assert fatal (false) with log(e.application + '.' + e.surface + ': no provider in the union');
	return null;
}

-- ============================================================== eligibility

-- The copies a node must fit: a continuous Process runs its new version beside its old one.
query copiesOf(p : PI::Process) : Integer =
	if p.cutover = PI::Cutover::continuous then 2 else 1 endif;

-- Eligibility, not bin-packing: each Process against allocatable alone, on every
-- dimension it declared (spec/v1/20-resolved-deployment.md#layer-2-does-not-assign-a-node).
-- What one copy asks for is the Process and its sidecars together.
query requestedMemory(p : PI::Process) : Real =
	p.sidecars->collect(c | mebibytes(c.memory))->sum() + mebibytes(p.placement.memory)
		+ (if p.vpn = null or estate.vpn = null then 0 else mebibytes(estate.vpn.memory) endif);

query requestedCpu(p : PI::Process) : Integer =
	p.sidecars->collect(c | millicores(c.cpu))->sum() + millicores(p.placement.cpu)
		+ (if p.vpn = null or estate.vpn = null then 0 else millicores(estate.vpn.cpu) endif);

query eligible(p : PI::Process, n : Node) : Boolean =
	mebibytes(n.allocatable.memory) >= requestedMemory(p) * copiesOf(p)
	and millicores(n.allocatable.cpu) >= requestedCpu(p) * copiesOf(p)
	and (p.placement.arch->isEmpty() or p.placement.arch->exists(a | a.spelling() = n.arch))
	and (p.placement.site = null or p.placement.site = n.site)
	and p.placement.capabilities->forAll(c | n.capabilities->includes(c))
	and (p.placement.gpu = null or matchingCards(p, n)->notEmpty())
	and (p.placement.disk = null or n.disks->exists(d |
		p.placement.disk.media->exists(m | m.spelling() = d.media)))
	-- A library the Process mounts holds it to the library's node.
	and p.libraries->forAll(m | libraryOf(m._library) <> null and libraryOf(m._library).node = n.name)
	-- Its L4 exposures hold it to the sites of its pools and the nodes of its node addresses.
	and l4Of(p)->forAll(e | let a : L4AddressDeclaration = addressOf(e.address) in
		if a.oclIsKindOf(PoolAddress) then a.oclAsType(PoolAddress).site = n.site
		else a.oclAsType(NodeAddress).node = n.name endif);

-- The L4 exposures of the Process's Application that reach it.
query l4Of(p : PI::Process) : Sequence(Tuple(address : String, port : Integer, protocol : L4Protocol, surface : Surface)) =
	p.oclAsType(ECORE::EObject).eContainer().oclAsType(EffectiveApplication).l4Exposure
		->select(e | e.process = p)
		->collect(e | Tuple{address = e.address, port = e.port, protocol = e.protocol, surface = e.surface})
		->asSequence()->union(tierL4Of(p));

-- The L4 Address the Platform document names.
query addressOf(name : String) : L4AddressDeclaration =
	estate.l4Addresses->select(a | a.key = name)->any(true).value;

-- A Process's Services on the pools it is exposed on, one per address, each port by port
-- (spec/v1/16-dependencies.md#l4-exposure).
query l4ServicesOf(p : PI::Process) : Sequence(ResolvedL4Service) =
	let pooled : Sequence(Tuple(address : String, port : Integer, protocol : L4Protocol, surface : Surface)) = l4Of(p)->select(e | addressOf(e.address).oclIsKindOf(PoolAddress)) in
	pooled.address->asSet()->sortedBy(a | a)->collect(address | object ResolvedL4Service {
		name := p.name + '-' + address;
		pool := address;
		ports := pooled->select(e | e.address = address)
			->sortedBy(e | e.port * 2 + (if e.protocol = L4Protocol::tcp then 0 else 1 endif))
			->collect(e | object L4Port {
				name := e.protocol.toString() + '-' + e.port.toString();
				port := e.port;
				protocol := e.protocol.toString().toUpper();
				targetPort := e.surface.value;
			});
	})->asSequence();

-- The VPN container beside an attached Process (spec/v1/20-resolved-deployment.md#the-vpn-attachment):
-- the platform's image and quantities, its settings with the three values derived from the
-- Process sorted in among them, and the credential only it reads. E_NO_VPN_POLICY refused an
-- attachment with no Platform `vpn`.
-- One key per Process: a provider takes a key for one device, so two tunnels on one key knock
-- each other off.
query credentialOf(p : PI::Process) : String =
	estate.vpn.credential + '/' + owner(p) + '-' + p.name;

query vpnOf(p : PI::Process) : ResolvedVpn =
	let policy : VpnPolicy = estate.vpn in
	let locks : LockedImage = locked(policy.image) in
	let ports : Sequence(Integer) = p.provides->collect(s | s.value)->asSet()->sortedBy(n | n)->asSequence() in
	let fromProcess : Sequence(Tuple(name : String, value : String)) =
		(if ports->isEmpty() then Sequence{} else Sequence{Tuple{name = 'FIREWALL_INPUT_PORTS',
			value = ports->iterate(n; acc : String = '' | if acc = '' then n.toString() else acc + ',' + n.toString() endif)}} endif)
		->union(Sequence{Tuple{name = 'VPN_PORT_FORWARDING', value = if p.vpn.forwardedPort then 'on' else 'off' endif}})
		->union(if p.vpn.forwardedPort then Sequence{Tuple{name = 'VPN_PORT_FORWARDING_UP_COMMAND',
			value = '/bin/sh -c \'echo {{PORT}} > ' + FORWARDED_PORT_FILE + '\''}} else Sequence{} endif) in
	let settings : Sequence(Tuple(name : String, value : String)) =
		policy.settings->collect(e | Tuple{name = e.key, value = e.value})->asSequence() in
	object ResolvedVpn {
		image := locks.repository + '@' + locks.digest;
		imageVersion := locks.version;
		memory := policy.memory;
		cpu := policy.cpu;
		forwardedPort := p.vpn.forwardedPort;
		environment := settings->union(fromProcess)->sortedBy(t | t.name)->collect(t | object EnvEntry {
			name := t.name;
			value := t.value;
		});
		credential := object ResolvedGrant {
			path := credentialOf(p);
			_access := 'read';
			delivery := 'env';
			destination := destinationOf(p.name + '-vpn', credentialOf(p));
		};
	};

-- The node's cards that match every term the Process's `gpu` declares.
query matchingCards(p : PI::Process, n : Node) : OrderedSet(Gpu) =
	n.gpus->select(g |
		(p.placement.gpu._class = null or g._class = p.placement.gpu._class)
		and (p.placement.gpu.memory = null or g.memoryMib >= mebibytes(p.placement.gpu.memory))
		and (p.placement.gpu.vendor->isEmpty() or p.placement.gpu.vendor->includes(g.vendor))
		and (p.placement.gpu.model->isEmpty() or p.placement.gpu.model->includes(g.model)));

-- The Platform's entry for the vendor of the cards the Process may land on:
-- E_GPU_VENDOR_AMBIGUOUS and E_NO_GPU_POLICY refused anything but one.
query gpuOf(p : PI::Process) : ResolvedGpu =
	let vendor : String = contract.nodes->select(n | eligible(p, n))
		->collect(n | matchingCards(p, n))->flatten()->any(true).vendor in
	let policy : GpuVendorPolicy = estate.gpus->select(g | g.key = vendor)->collect(g | g.value)->any(true) in
	object ResolvedGpu {
		resource := policy.resource;
		runtimeClass := policy.runtimeClass;
	};

-- =============================================================== environment

-- The env file a render for the platform's cluster reads: the base, overlaid by
-- that cluster's own file; then the Runtime Profile's values.
query environmentOf(p : PI::Process, prj : EffectiveProject) : Sequence(EnvEntry) =
	let authored : Sequence(EnvEntry) = authoredOf(p)->collect(v | v.entry(prj)),
		profile : Sequence(EnvEntry) = profileOf(p) in
	if authored->exists(a | profile->exists(f | f.name = a.name))
		then unwritten(p)
		else authored->union(profile) endif;

-- A Runtime Profile key written in an env file is a build error the checks do not
-- make yet, so the run stops rather than carry two values for one name.
query unwritten(p : PI::Process) : Sequence(EnvEntry) {
	assert fatal (false) with log(p.name + ' writes a Runtime Profile key in an env file');
	return Sequence{};
}

query authoredOf(p : PI::Process) : Sequence(EnvVariable) =
	p.env->collect(f | f.entries)->asSequence();

query EnvVariable::entry(prj : EffectiveProject) : EnvEntry =
	if self.value.oclIsKindOf(EnvLiteral) then
		object EnvEntry { name := self.name; value := self.value.oclAsType(EnvLiteral).text; }
	else
		self.value.oclAsType(Placeholder).entryFor(self.name, prj)
	endif;

-- A placeholder's value (spec/v1/10-project-intent.md#secret-references): one
-- key of a grant, one coordinate of the Process's own edge, one field of an
-- exposure the union declares, or the Process's own identity; any literal text
-- after it is kept, except after a secret.
query Placeholder::entryFor(variable : String, prj : EffectiveProject) : EnvEntry =
	let owner : PI::Process = self.oclAsType(ECORE::EObject).eContainer().eContainer().eContainer()
			.oclAsType(PI::Process) in
	let suffix : String = if self.suffix = null then '' else self.suffix endif in
	if self.kind = PlaceholderKind::secret and self.source.lastIndexOf('#') <= 0 then
		unresolved(variable, 'a secret placeholder names no key')
	else if self.kind = PlaceholderKind::secret then
		let cut : Integer = self.source.lastIndexOf('#') in
		let secretPath : String = self.source.substring(1, cut - 1) in
		let secretKey : String = self.source.substring(cut + 1, self.source.size()) in
		if owner.secrets->exists(g | g.oclIsKindOf(KvGrant) and g.oclAsType(KvGrant).path = secretPath
				and g.delivery = Delivery::env and g.oclAsType(KvGrant).keys.name->includes(secretKey)) then
			object EnvEntry {
				name := variable;
				-- A key the Process may start without is optional in the Secret it reads.
				secret := object SecretReference {
					path := secretPath;
					key := secretKey;
					optional := owner.secrets->exists(g | g.oclIsKindOf(KvGrant) and g.oclAsType(KvGrant).path = secretPath
						and g.oclAsType(KvGrant).keys->exists(k | k.oclIsKindOf(OptionalKey) and k.name = secretKey));
				};
			}
		else unresolved(variable, 'a placeholder no env grant of the Process holds is E_UNAUTHORISED_SECRET_REFERENCE') endif
	else if self.kind = PlaceholderKind::dependency and self.source.lastIndexOf('.') > 0
			and Sequence{'accessKeyId', 'secretAccessKey'}->includes(
				self.source.substring(self.source.lastIndexOf('.') + 1, self.source.size())) then
		-- A key to an object store is read from the project's key to the store the edge names
		-- buckets in (spec/v1/16-dependencies.md#the-bucket-catalog).
		let application : String = self.source.substring(1, self.source.lastIndexOf('.') - 1) in
		let coordinate : String = self.source.substring(self.source.lastIndexOf('.') + 1, self.source.size()) in
		let edge : DependencyEdge = owner.dependsOn->select(e | e.application = application)->any(true) in
		let store : String = projects.applications->select(a | a.id = application).processes
			->select(p | p.provides->exists(s | s.key = edge.surface))->any(true).name in
		object EnvEntry {
			name := variable;
			secret := object SecretReference {
				path := 'secret/data/' + prj.project + '/' + store + '/s3';
				key := if coordinate = 'accessKeyId' then 'access-key-id' else 'secret-access-key' endif;
			};
		}
	else if self.kind = PlaceholderKind::dependency and self.source.lastIndexOf('.') > 0
			and Sequence{'username', 'password'}->includes(self.source.substring(self.source.lastIndexOf('.') + 1, self.source.size())) then
		-- A login is read from the Secret the edge's credential is synced to, or
		-- E_UNRESOLVED_PLACEHOLDER refused the placeholder.
		object EnvEntry {
			name := variable;
			secret := object SecretReference {
				path := 'database/creds/' + credentialRole(
					owner.oclAsType(ECORE::EObject).eContainer().oclAsType(EffectiveApplication), prj);
				key := self.source.substring(self.source.lastIndexOf('.') + 1, self.source.size());
			};
		}
	else
		object EnvEntry { name := variable; value := self.textFor(owner, prj) + suffix; }
	endif endif endif endif;

query Placeholder::textFor(owner : PI::Process, prj : EffectiveProject) : String =
	if self.kind = PlaceholderKind::dependency then dependencyValue(self.source, owner)
	else if self.kind = PlaceholderKind::exposure then exposureValue(self.source)
	-- A Client hands its own Application the issuer it signs in with and its id, the Application Id.
	else if self.kind = PlaceholderKind::client and self.source = 'issuer' then estate.signIn.issuer
	else if self.kind = PlaceholderKind::client and self.source = 'id'
		then owner.oclAsType(ECORE::EObject).eContainer().oclAsType(EffectiveApplication).id
	else if self.source = 'namespace' then namespaceOf(prj.project)
	-- The Secret Store has no namespaces, so the Vault role's name carries the one the Process
	-- is unique in; the ServiceAccount is the Process's own name.
	else if self.source = 'vaultRole' then namespaceOf(prj.project) + '-' + owner.name
	else owner.name endif endif endif endif endif endif;

-- `${dependency:<application>.<coordinate>}`: one coordinate of the Process's own edge.
query dependencyValue(source : String, owner : PI::Process) : String =
	if source.lastIndexOf('.') <= 0 then
		unresolvedText(source, 'a dependency placeholder names no coordinate') else
	let cut : Integer = source.lastIndexOf('.') in
	let application : String = source.substring(1, cut - 1) in
	let coordinate : String = source.substring(cut + 1, source.size()) in
	let edges : Sequence(DependencyEdge) = owner.dependsOn->select(e | e.application = application)->asSequence() in
	if edges->size() <> 1 or (coordinate <> 'host' and coordinate <> 'port' and coordinate <> 'endpoint')
		then unresolvedText(source, 'a dependency placeholder names no one edge of the Process and no coordinate of it')
	else
		let address : String = edgeOf(edges->first(), owner(owner)).address in
		let colon : Integer = address.lastIndexOf(':') in
		-- An object store is reached over HTTP at what the edge dials.
		if coordinate = 'endpoint' then 'http://' + address
		else if coordinate = 'host' then address.substring(1, colon - 1)
		else address.substring(colon + 1, address.size()) endif endif
	endif endif;

-- `${exposure:<application>.<name>#<field>}`: one field of an exposure the union declares.
query exposureValue(source : String) : String =
	if source.lastIndexOf('#') <= 0 or source.substring(1, source.lastIndexOf('#') - 1).lastIndexOf('.') <= 0 then
		unresolvedText(source, 'an exposure placeholder names no field of an exposure') else
	let hash : Integer = source.lastIndexOf('#') in
	let head : String = source.substring(1, hash - 1) in
	let dot : Integer = head.lastIndexOf('.') in
	let application : String = head.substring(1, dot - 1) in
	let name : String = head.substring(dot + 1, head.size()) in
	let field : String = source.substring(hash + 1, source.size()) in
	let exposures : Sequence(Exposure) = projects.applications->select(a | a.id = application)
		.exposure->select(e | e.name = name)->asSequence() in
	if exposures->isEmpty() or not Sequence{'url', 'host', 'scheme'}->includes(field)
		then unresolvedText(source, 'an exposure placeholder names no exposure of the union and no field of it')
	else
		let exposure : Exposure = exposures->first() in
		let scheme : String = if tierFor(exposure.audience).listener = Listener::tls then 'https' else 'http' endif in
		if field = 'host' then exposure.host
		else if field = 'scheme' then scheme
		else scheme + '://' + exposure.host endif endif
	endif endif;

query unresolved(variable : String, message : String) : EnvEntry {
	assert fatal (false) with log(variable + ': ' + message);
	return null;
}

query unresolvedText(source : String, message : String) : String {
	assert fatal (false) with log(source + ': ' + message);
	return null;
}

-- The Runtime Profile's values (spec/v1/10-project-intent.md#runtime-profiles).
query profileOf(p : PI::Process) : Sequence(EnvEntry) =
	if not exportsTelemetry(p) then Sequence{}
	else
		Sequence{object EnvEntry { name := 'DEPLOYMENT_ENVIRONMENT'; value := estate.metadata.cluster; }}
		->union(if collectorEndpoint() = null then Sequence{}
			else Sequence{object EnvEntry { name := 'OTEL_EXPORTER_OTLP_ENDPOINT'; value := collectorEndpoint(); }} endif)
		->append(object EnvEntry { name := 'OTEL_SERVICE_NAME'; value := p.name; })
		->union(if p.provides->size() = 1
			then Sequence{object EnvEntry { name := 'PORT'; value := p.provides->any(true).value.toString(); }}
			else Sequence{} endif)
	endif;

-- Whether a runtime's profile exports telemetry and HTTP server metrics.
query exportsTelemetry(p : PI::Process) : Boolean =
	p.runtime = Runtime::jvm or p.runtime = Runtime::node or p.runtime = Runtime::python;

-- The named collector's `otlp` surface, where the platform names one and the
-- union declares it (spec/v1/14-platform-intent.md#telemetry).
query collectorEndpoint() : String =
	if estate.telemetry = null then null
	else let address : String = surfaceAddress(estate.telemetry.collector.id, OTLP_SURFACE) in
		if address = null then null else 'http://' + address endif
	endif;

-- The in-cluster address of the Process of `application` that provides `surface`.
query surfaceAddress(application : String, surface : String) : String =
	let providers : Sequence(Tuple(project : String, process : PI::Process)) =
		projects->collect(prj | prj.applications->select(a | a.id = application).processes
			->select(p | p.provides->exists(s | s.key = surface))
			->collect(p | Tuple{project = prj.project, process = p}))->flatten() in
	if providers->isEmpty() then null
	else let first : Tuple(project : String, process : PI::Process) = providers->first() in
		homeProcess(application, first.process.name) + '.' + homeNamespace(first.project, application)
			+ '.svc.cluster.local:' + first.process.provides->select(s | s.key = surface)->any(true).value.toString()
	endif;

-- ================================================================== exposure

-- The priority class a Process runs at (spec/v1/14-platform-intent.md#priority): the
-- data class for one that runs an engine, the critical class for the foundation and
-- the Applications the platform names, none otherwise.
query priorityOf(p : PI::Process, app : EffectiveApplication, prj : EffectiveProject) : String =
	let policy : PriorityPolicy = estate.priority in
	if policy = null then null
	else if p.engine <> Engine::absent then policy.data.name
	else if foundation()->includes(prj.project + '/' + app.id)
			or policy.criticalApplications->exists(a | heldName(a) = prj.project + '/' + app.id)
		then policy.critical.name
	else null endif endif endif;

-- `<project>/<application>` of an Application a document declares.
query heldName(a : Application) : String =
	a.oclAsType(ECORE::EObject).eContainer().oclAsType(Project).project + '/' + a.id;

-- The Applications the Platform document names in a privileged role.
query foundation() : Set(String) =
	let none : Sequence(Application) = Sequence{} in
	estate.tiers->collect(t | t.traefik)->asSequence()
		->union(if estate.delivery = null then none
			else estate.delivery.machinery->asSequence()->append(estate.delivery.gate) endif)
		->union(if estate.delivery = null or estate.delivery.reporter = null then none
			else Sequence{estate.delivery.reporter} endif)
		->union(if estate.apiAccess = null then none else estate.apiAccess.holders->asSequence() endif)
		->union(if estate.telemetry = null then none
			else Sequence{estate.telemetry.collector, estate.telemetry.metrics} endif)
		->union(if estate.secretStore = null then none else Sequence{estate.secretStore} endif)
		->union(if estate.signIn = null then none else Sequence{estate.signIn.provider} endif)
		->collect(a | heldName(a))->asSet();

-- The tier carrying an audience, or E_NO_TIER_FOR_AUDIENCE refused the set.
query tierFor(audience : Audience) : Tier =
	estate.tiers->select(t | t.audiences->includes(audience))->first();

mapping Exposure::exposure(in app : EffectiveApplication, in prj : EffectiveProject)
		: ResolvedExposure {
	name := self.name;
	host := self.host;
	tier := tierFor(self.audience).name;
	listener := if tierFor(self.audience).listener = Listener::tls then 'tls' else 'plain' endif;
	certificates := if tierFor(self.audience).certificates = CertificateSource::acme then 'acme' else 'none' endif;
	proxyApplication := tierFor(self.audience).traefik.id;
	proxyNamespace := homeNamespace(projectOf(tierFor(self.audience).traefik.id),
		tierFor(self.audience).traefik.id);
	ingressClass := tierFor(self.audience).ingressClass;
	-- The name the tier publishes the host behind, or, where the exposure is not
	-- proxied, the tier's own address (spec/v1/14-platform-intent.md#tiers).
	dns := let named : TierDns = tierFor(self.audience).dns in
		if named = null then null
		else if self.proxied = false then object ExposureDns { target := named.direct; proxied := false; }
		else object ExposureDns { target := named.target; proxied := named.proxied; } endif endif;
	routes := self.routes->collect(r | object ResolvedRoute {
		path := r.path;
		match := r.match.resolvedMatch();
		audience := r.audienceOf(self).spelling();
		precedence := precedenceOf(r, self.routes);
		process := r.process.resolveone(ResolvedProcess);
		surface := r.surface.key;
		middleware := middlewareOf(r, self, app, prj);
	});
}

query Route::audienceOf(exposure : Exposure) : Audience =
	if self.audience <> Audience::absent then self.audience else exposure.audience endif;

-- Where a route sorts: every `exact` before any `prefix`, a longer prefix before
-- a shorter one, and its precedence is one more than the distinct ranks before it.
query rankOf(r : Route) : Integer =
	if r.match = PI::Match::exact then -1000000 else -r.path.size() endif;

query precedenceOf(r : Route, routes : Collection(Route)) : Integer =
	routes->collect(o | rankOf(o))->asSet()->select(k | k < rankOf(r))->size() + 1;

-- The chain the tier, the audience and the content profile derive, each step named as the route
-- names its Middleware: a shared one in the proxy's namespace, by its kind and content policy, or
-- a route's own beside its IngressRoute, by the route's position.
query middlewareOf(r : Route, exposure : Exposure, app : EffectiveApplication, prj : EffectiveProject)
		: Sequence(MiddlewareStep) =
	let proxy : String = homeNamespace(projectOf(tierFor(exposure.audience).traefik.id),
		tierFor(exposure.audience).traefik.id) in
	let own : String = app.id + '-' + exposure.name + '-' + exposure.routes->indexOf(r).toString() in
	(if r.audienceOf(exposure) = Audience::authenticated and asksTheGate(app, exposure)
		then Sequence{object MiddlewareStep {
			kind := MiddlewareKind::forwardAuth;
			endpoint := tierFor(r.audienceOf(exposure)).forwardAuth.endpoint();
			name := 'forward-auth';
			namespace := proxy;
		}}
		else Sequence{} endif)
	->append(object MiddlewareStep {
		kind := MiddlewareKind::securityHeaders;
		if exposure.oclAsType(ECORE::EObject).states('contentPolicy')
			then contentPolicy := exposure.contentPolicy.spelling() endif;
		name := if contentPolicy = null then 'security-headers'
			else 'security-headers-' + contentPolicy endif;
		namespace := proxy;
	})
	->union(if r.redirectTo = null then Sequence{}
		else Sequence{object MiddlewareStep {
			kind := MiddlewareKind::redirect;
			redirectTo := r.redirectTo;
			name := own + '-redirect';
			namespace := namespaceOf(prj.project);
		}} endif)
	-- A client that has sent nothing may send its whole allowance at once, and the
	-- tier decides which address a client is counted by.
	->union(if r.rateLimit = null then Sequence{}
		else Sequence{object MiddlewareStep {
			kind := MiddlewareKind::rateLimit;
			allowance := r.rateLimit.requests;
			per := r.rateLimit.per;
			burst := r.rateLimit.requests;
			clientAddress := if tierFor(r.audienceOf(exposure)).oclAsType(ECORE::EObject).states('proxiedBy')
				then 'cloudflare' else 'connection' endif;
			name := own + '-rate-limit';
			namespace := namespaceOf(prj.project);
		}} endif);

-- ============================================================ the path plan

-- What every project writes: its namespace, the index over it, the
-- default-deny that selects every pod and belongs to no Process, and the
-- operator's connection to the Secret Store where any Application syncs from it.
query EffectiveProject::projectFiles() : Sequence(Deliverable) =
	let root : String = 'apps/' + self.project + '/' in
	let stores : Sequence(ResolvedApplication) = self.applications
		->collect(a | a.resolveone(ResolvedApplication))->select(a | a.secretStore <> null) in
	-- Every library a Process of the project mounts, once, by name.
	let mounts : Sequence(ResolvedLibraryMount) = self.applications
		->collect(a | a.processes)->flatten()->collect(p | p.resolveone(ResolvedProcess))
		->collect(p | p.libraries)->flatten()->asSequence() in
	let held : Sequence(ResolvedLibraryMount) = mounts->collect(m | m._library)->asOrderedSet()
		->sortedBy(n | n)->collect(n | mounts->select(m | m._library = n)->first()) in
	-- Every edge of the project that derives an alias, once per name it dials.
	let aliased : Sequence(ResolvedEdge) = self.applications
		->collect(a | a.processes)->flatten()->collect(p | p.resolveone(ResolvedProcess))
		->collect(p | p.dependencies)->flatten()->select(e | e.target <> null)->asSequence() in
	let names : Sequence(String) = aliased->collect(e | aliasName(e))->asOrderedSet()->sortedBy(n | n)->asSequence() in
	Sequence{
		object NamespaceFile {
			path := root + 'namespace.yaml';
			adapter := AdapterName::kubernetes;
			namespace := namespaceOf(self.project);
		}.oclAsType(Deliverable),
		object IndexFile {
			path := root + 'kustomization.yaml';
			adapter := AdapterName::kubernetes;
			resources := Sequence{'namespace.yaml'}->union(self.applications->collect(a | a.id))
				->union(if stores->isEmpty() then Sequence{} else Sequence{'vaultconnection.yaml'} endif)
				->union(if held->isEmpty() then Sequence{} else Sequence{'libraries.yaml'} endif)
				->union(if names->isEmpty() then Sequence{} else Sequence{'aliases.yaml'} endif)
				->sortedBy(r | r);
		}.oclAsType(Deliverable),
		object NetworkPolicyFile {
			path := root + 'networkpolicy.yaml';
			adapter := AdapterName::networking;
		}.oclAsType(Deliverable)
	}
	->union(if held->isEmpty() then Sequence{} else Sequence{object LibraryFile {
			path := root + 'libraries.yaml';
			adapter := AdapterName::kubernetes;
			namespace := namespaceOf(self.project);
			size := LIBRARY_SIZE;
			libraries := held;
		}.oclAsType(Deliverable)} endif)
	->union(if names->isEmpty() then Sequence{} else Sequence{object AliasFile {
			path := root + 'aliases.yaml';
			adapter := AdapterName::kubernetes;
			namespace := namespaceOf(self.project);
			aliases := names->collect(n | object Alias {
				name := n;
				target := aliased->select(e | aliasName(e) = n)->first().target;
			});
		}.oclAsType(Deliverable)} endif)
	->union(if stores->isEmpty() then Sequence{} else Sequence{object ConnectionFile {
			path := root + 'vaultconnection.yaml';
			adapter := AdapterName::vso;
			namespace := stores->first().namespace;
			address := stores->first().secretStore;
		}.oclAsType(Deliverable)} endif);

-- What one Application writes under its own directory: its index over every
-- file below that a kustomization applies, the workloads of its Processes, the
-- Canaries of those that switch blue-green and the Services of those that do
-- not, their identities, their claims, the Release Gate's inputs where it is
-- gated and its Asset ConfigMaps, its backups, its monitor
-- where it is scraped, what the operator syncs for it, and one policy per
-- Process. A file that would hold no object is not written.
query EffectiveApplication::applicationFiles(prj : EffectiveProject) : Sequence(Deliverable) =
	let root : String = 'apps/' + prj.project + '/' + self.id + '/' in
	let served : Sequence(ResolvedProcess) = self.processes->collect(p | p.resolveone(ResolvedProcess)) in
	let blueGreen : Sequence(ResolvedProcess) =
		self.processes->select(p | switchesBlueGreen(self, p))->collect(p | p.resolveone(ResolvedProcess)) in
	-- A blue-green Process's Services are Flagger's, save the L4 Services of its pools.
	let reached : Sequence(ResolvedProcess) = served->select(p |
		(p.switchover <> Switchover::blueGreen and p.surfaces->notEmpty()) or p.l4Services->notEmpty()) in
	-- An api block with no rules binds no role: the token alone finds the API.
	let holding : Sequence(ResolvedProcess) = served->select(p | p.api <> null and p.api.rules->notEmpty()) in
	let claimed : Sequence(ResolvedProcess) = served->select(p | p.volumes->notEmpty()) in
	let configured : Sequence(ResolvedProcess) = served->select(p | p.assets->notEmpty()) in
	let backedUp : Sequence(ResolvedProcess) = served->select(p | p.volumes->exists(v | v.backup <> null)) in
	let synced : Sequence(SecretHolder) = served->collect(p | holdersOf(p))->flatten() in
	let scaled : Sequence(ResolvedProcess) = served->select(p | p.replicas > 1) in
	let moved : ResolvedApplication = self.resolveone(ResolvedApplication) in
	let monitor : Sequence(Deliverable) = monitorOf(self, root) in
	let files : Sequence(Deliverable) = self.routeFiles(root)->union(
		Sequence{object WorkloadFile {
			path := root + 'workload.yaml';
			adapter := AdapterName::kubernetes;
			processes := served;
			controller := controllerOf(self.processes->first());
			strategy := strategyOf(self.processes->first());
		}.oclAsType(Deliverable)}
		->union(if blueGreen->notEmpty() then Sequence{object SwitchoverFile {
				path := root + 'canary.yaml';
				adapter := AdapterName::kubernetes;
				processes := blueGreen;
			}.oclAsType(Deliverable)} else Sequence{} endif)
		->union(if reached->notEmpty() then Sequence{object ServiceFile {
				path := root + 'service.yaml';
				adapter := AdapterName::kubernetes;
				processes := reached;
			}.oclAsType(Deliverable)} else Sequence{} endif)
		->append(object IdentityFile {
				path := root + 'serviceaccount.yaml';
				adapter := AdapterName::kubernetes;
				processes := served;
			}.oclAsType(Deliverable))
		->union(if claimed->notEmpty() then Sequence{object ClaimFile {
				path := root + 'pvc.yaml';
				adapter := AdapterName::kubernetes;
				processes := claimed;
			}.oclAsType(Deliverable)} else Sequence{} endif)
		->union(if configured->notEmpty() or gated(self) or self.exposure->notEmpty() then Sequence{object ConfigMapFile {
				path := root + 'configmap.yaml';
				adapter := AdapterName::kubernetes;
				application := self.resolveone(ResolvedApplication);
				processes := configured;
				-- The element as the Release Gate reads it: canonical JSON, on one line.
				releaseGate := if gated(self) then self.resolveone(ResolvedApplication).releaseGate.json() else null endif;
				externalChecks := self.externalChecks(prj);
			}.oclAsType(Deliverable)} else Sequence{} endif)
		->union(if self.client = null then Sequence{} else Sequence{object ClientFile {
				path := root + 'client.yaml';
				application := moved;
			}.oclAsType(Deliverable)} endif)
		->union(if self.resolveone(ResolvedApplication).dashboards = null then Sequence{} else
			Sequence{object DashboardFile {
				path := root + 'dashboards.yaml';
				adapter := AdapterName::grafana;
				application := self.resolveone(ResolvedApplication);
			}.oclAsType(Deliverable)} endif)
		->union(if self.alertRules->isEmpty() then Sequence{} else Sequence{object AlertRulesFile {path := root + 'alertrules.yaml'; adapter := AdapterName::prometheus; application := self.resolveone(ResolvedApplication);}.oclAsType(Deliverable)} endif)
		->union(if obsAlerts(self) then Sequence{object AlertingFile {path := root + 'alertmanagerconfig.yaml'; adapter := AdapterName::prometheus; application := self.resolveone(ResolvedApplication);}.oclAsType(Deliverable)} else Sequence{} endif)
		->union(if obsFlux(self) then Sequence{object FluxMonitorFile {path := root + 'flux-podmonitor.yaml'; adapter := AdapterName::prometheus; application := self.resolveone(ResolvedApplication);}.oclAsType(Deliverable)} else Sequence{} endif)
		->union(if backedUp->notEmpty() then Sequence{object BackupFile {
				path := root + 'backup.yaml';
				adapter := AdapterName::kubernetes;
				processes := backedUp;
			}.oclAsType(Deliverable)} else Sequence{} endif)
		->union(if scaled->notEmpty() then Sequence{object BudgetFile {
				path := root + 'pdb.yaml';
				adapter := AdapterName::kubernetes;
				processes := scaled;
			}.oclAsType(Deliverable)} else Sequence{} endif)
		->union(if moved.migration <> null then Sequence{object MigrationFile {
				path := root + 'migration.yaml';
				adapter := AdapterName::kubernetes;
				application := moved;
				-- A down returns to the revision the release was proven against; a first release has none.
				if moved.migration.testedAgainst <> null then downTag := tagOf(moved.migration.testedAgainst) endif;
				role := moved.namespace + '-' + moved.migration.identity;
			}.oclAsType(Deliverable)} else Sequence{} endif)
		->union(if holding->notEmpty() then Sequence{object RbacFile {
				path := root + 'rbac.yaml';
				adapter := AdapterName::kubernetes;
				processes := holding;
			}.oclAsType(Deliverable)} else Sequence{} endif)
		->union(monitor)
		->union(if synced->notEmpty() then Sequence{object SecretFile {
				path := root + 'vso.yaml';
				adapter := AdapterName::vso;
				application := self.resolveone(ResolvedApplication);
				holders := synced;
			}.oclAsType(Deliverable)} else Sequence{} endif)) in
	Sequence{object IndexFile {
			path := root + 'kustomization.yaml';
			adapter := AdapterName::kubernetes;
			-- A policy file is listed nowhere while the policy stage is render-only.
			resources := files->collect(f | f.path.substring(root.size() + 1, f.path.size()))->sortedBy(f | f);
		}.oclAsType(Deliverable)}
	->union(files)
	->append(object NetworkPolicyFile {
			path := root + 'networkpolicy.yaml';
			adapter := AdapterName::networking;
			policies := self.processes->collect(p | object ProcessPolicy {
				process := p.resolveone(ResolvedProcess);
				ingress := ingressOf(p, self);
				egress := egressOf(p);
			});
			migration := moved.migration;
		}.oclAsType(Deliverable));

-- The monitor of a scraped Application (spec/v1/30-deliverables.md#adapters): a
-- blue-green Process is scraped by its pods, because its Services are Flagger's
-- and the canary's pods must be scraped for the Release Gate's checks; a
-- stop-start one by a ServiceMonitor over the Service the render gives it.
query monitorOf(app : EffectiveApplication, root : String) : Sequence(Deliverable) =
	if app.observability = null or app.observability.scrape = null then Sequence{} else
	let scraped : ResolvedProcess = app.observability.scrape.process.resolveone(ResolvedProcess) in
	let monitored : MonitorKind = if scraped.switchover <> Switchover::blueGreen
		then MonitorKind::serviceMonitor else MonitorKind::podMonitor endif in
	Sequence{object MonitorFile {
		path := root + (if monitored = MonitorKind::serviceMonitor then 'servicemonitor.yaml' else 'podmonitor.yaml' endif);
		adapter := AdapterName::prometheus;
		process := scraped;
		surface := app.observability.scrape.surface.key;
		scrapePath := app.observability.scrape.path;
		interval := estate.monitors.interval;
		timeout := estate.monitors.timeout;
		kind := monitored;
	}.oclAsType(Deliverable)} endif;

-- The identities of one Process that sync a grant
-- (spec/v1/16-dependencies.md#what-a-grant-confers): the Process itself for each
-- grant delivered anywhere but to itself, and its backup identity for the
-- off-cluster credential its backups share and the one its method dumps the
-- Process with. A Process that syncs nothing holds nothing here.
query holdersOf(p : ResolvedProcess) : Sequence(SecretHolder) =
	(if processGrants(p)->forAll(g | g.destination = null) then Sequence{} else
	Sequence{object SecretHolder {
		identity := p.identity;
		component := p.component;
		grants := processGrants(p)->select(g | g.destination <> null);
	}} endif)
	->union(if backupGrants(p)->isEmpty() then Sequence{} else Sequence{object SecretHolder {
		identity := p.volumes->select(v | v.backup <> null)->first().backup.identity;
		component := NO_RUNTIME;
		grants := backupGrants(p);
	}} endif);

-- What a Process's own identity holds: its grants, and the VPN's credential
-- where it attaches, which the VPN container beside it reads.
query processGrants(p : ResolvedProcess) : Sequence(ResolvedGrant) =
	p.secrets->asSequence()->union(if p.vpn = null then Sequence{} else Sequence{p.vpn.credential} endif);

-- What a Process's backup identity holds: the off-cluster credential, where a
-- backup copies off-cluster, then the peer's, where its method dumps over the
-- network, which every backup of the Process shares.
query backupGrants(p : ResolvedProcess) : Sequence(ResolvedGrant) =
	let plans : Sequence(BackupPlan) = p.volumes->select(v | v.backup <> null).backup->asSequence() in
	(if backupOf(p) = null then Sequence{} else Sequence{backupOf(p).credential} endif)
	->union(if plans->isEmpty() or plans->first().peer = null then Sequence{}
		else Sequence{plans->first().peer.credential} endif);

-- The plan whose off-cluster credential every backup of one Process shares, where one has it.
query backupOf(p : ResolvedProcess) : BackupPlan =
	let credentialed : Sequence(ResolvedVolume) =
		p.volumes->select(v | v.backup <> null and v.backup.credential <> null)->asSequence() in
	if credentialed->isEmpty() then null else credentialed->first().backup endif;

-- The controller every serving Process runs under, and the strategy from
-- `cutover`; the templates spell both.
-- A scheduled Process runs from a CronJob, which has no rollout strategy.
query controllerOf(p : PI::Process) : ControllerKind =
	if p.lifecycle = Lifecycle::scheduled then ControllerKind::cronJob else ControllerKind::deployment endif;

query strategyOf(p : PI::Process) : String =
	if p.lifecycle = Lifecycle::scheduled then 'none'
	else if p.cutover = PI::Cutover::interrupted then 'Recreate' else 'RollingUpdate' endif endif;

-- Who may reach a Process (spec/v1/16-dependencies.md#the-derived-allow-set):
-- the proxy of the tier each route's audience reaches, the metrics stack where
-- the Process is scraped, every pod carrying the consumer label of one of its
-- surfaces, its own backup identity and Flux's notifier, each at that surface's
-- port. One named peer per namespace, Process and port, the first time it is
-- reached.
query ingressOf(p : PI::Process, app : EffectiveApplication) : Sequence(PolicyPeer) =
	named(app.exposure->collect(e | e.routes->select(r | r.process = p)->collect(r |
		peersOf(tierFor(r.audienceOf(e)).traefik.id, r.surface.value, 'tier-proxy')))->flatten()
	->union(if app.observability <> null and app.observability.scrape <> null
			and app.observability.scrape.process = p and estate.telemetry <> null
		then peersOf(estate.telemetry.metrics.id, app.observability.scrape.surface.value, 'metrics-stack')
		else Sequence{} endif))
	->union(consumersOf(p, app))
	->union(named(backupsOf(p)->union(eventsOf(p, app))))
	-- A blue-green Process that publishes readiness is a gate member, and admits the
	-- Release Gate's own requests on its first surface
	-- (spec/v1/16-dependencies.md#the-member-label).
	->union(if switchesBlueGreen(app, p) and readinessOf(p) <> null and estate.delivery <> null
			and p.provides->notEmpty()
		then named(peersOf(estate.delivery.gate.id, p.provides->first().value, 'release-gate'))
		else Sequence{} endif)
	-- A port exposed on an L4 Address admits any client at the Process's own port.
	->union(l4Of(p)->sortedBy(e | e.surface.value * 2 + (if e.protocol = L4Protocol::tcp then 0 else 1 endif))
		->collect(e | Tuple{port = e.surface.value, udp = e.protocol = L4Protocol::udp})
		->asOrderedSet()->collect(t | object PolicyPeer {
			rule := 'l4';
			cidr := '0.0.0.0/0';
			port := t.port;
			if t.udp then protocol := 'UDP' endif;
		})->asSequence());

-- Each peer a policy names, once, in the order first reached.
query named(peers : Sequence(Tuple(rule : String, namespace : String, process : String, port : Integer)))
		: Sequence(PolicyPeer) =
	peers->asOrderedSet()->asSequence()
	->collect(peer | object PolicyPeer {
		rule := peer.rule;
		namespace := peer.namespace;
		process := peer.process;
		port := peer.port;
	});

-- Flux's events about every Project's unit (spec/v1/55-delivery.md#rollouts): its
-- notification controller reaches the Reporter where the Provider sends them, the first
-- Process of the Reporter that provides the surface.
query eventsOf(p : PI::Process, app : EffectiveApplication)
		: Sequence(Tuple(rule : String, namespace : String, process : String, port : Integer)) =
	if estate.delivery = null or estate.delivery.reporter = null
			or estate.delivery.reporter.id <> app.id then Sequence{}
	else let receivers : Sequence(PI::Process) =
			app.processes->select(c | c.provides->exists(s | s.key = HTTP_SURFACE))->asSequence() in
		if receivers->isEmpty() or receivers->first() <> p then Sequence{}
		else Sequence{Tuple{rule = 'flux-events',
			namespace = estate.bootstrap.flux.sourceRef.substringBefore('/'),
			process = FLUX_NOTIFIER,
			port = p.provides->select(s | s.key = HTTP_SURFACE)->any(true).value}} endif endif;

-- The Process's own backup identity, on the surface its backups dump.
query backupsOf(p : PI::Process)
		: Sequence(Tuple(rule : String, namespace : String, process : String, port : Integer)) =
	if dumpedSurface(p) = null then Sequence{} else Sequence{Tuple{rule = 'backup',
		namespace = namespaceOf(owner(p)), process = p.name + '-backup',
		port = p.provides->select(s | s.key = dumpedSurface(p))->any(true).value}} endif;

-- Every pod carrying the consumer label of a surface this Process provides, whoever
-- declares it (spec/v1/16-dependencies.md#the-consumer-label): read off the Process's
-- own surfaces, never off the union's edges, so a consumer added or removed leaves the
-- policy as it is.
query consumersOf(p : PI::Process, app : EffectiveApplication) : Sequence(PolicyPeer) =
	p.provides->collect(s | object PolicyPeer {
		rule := 'consumer';
		consumes := app.id + '.' + s.key;
		port := s.value;
	})->asSequence();

-- What a Process may reach beyond its edges: the cluster's DNS, and the Secret
-- Store where it holds a grant.
query egressOf(p : PI::Process) : Sequence(PolicyPeer) =
	let app : EffectiveApplication = p.oclAsType(ECORE::EObject).eContainer().oclAsType(EffectiveApplication) in
	-- A Process that serves DNS resolves through the upstream nameservers, never the cluster's DNS.
	(if servesDns(p) then Sequence{} else
		Sequence{object PolicyPeer { rule := 'cluster-dns'; namespace := estate.substrate.clusterDns; port := DNS_PORT; }} endif)
	->union(if p.secrets->isEmpty() and not edgeAcme(p) and not holdsClientGrants(p) then Sequence{} else storePeers() endif)
	-- The Release Gate reaches every gate member's pods (spec/v1/16-dependencies.md#the-member-label).
	->union(if estate.delivery <> null and estate.delivery.gate.id = app.id
		then Sequence{object PolicyPeer { rule := 'gate-members'; port := 0; }} else Sequence{} endif)
	->union(obsScrapeEgress(app));

-- Whether a Process serves DNS on an L4 port and resolves through the platform's upstream nameservers.
query servesDns(p : PI::Process) : Boolean =
	estate.substrate.upstreamNameservers->notEmpty()
		and p.oclAsType(ECORE::EObject).eContainer().oclAsType(EffectiveApplication).l4Exposure
			->exists(e | e.process = p and e.port = DNS_PORT);

-- The one Process of the Secret Store that answers on `http`, at its own port.
query storePeers() : Sequence(PolicyPeer) =
	let providers : Sequence(Tuple(project : String, process : PI::Process)) =
		projects->collect(prj | prj.applications->select(a | a.id = estate.secretStore.id).processes
			->select(p | p.provides->exists(s | s.key = HTTP_SURFACE))
			->collect(p | Tuple{project = prj.project, process = p}))->flatten() in
	if providers->isEmpty() then Sequence{} else
		let first : Tuple(project : String, process : PI::Process) = providers->first() in
		Sequence{object PolicyPeer {
			rule := 'secret-store';
			namespace := homeNamespace(first.project, estate.secretStore.id);
			process := homeProcess(estate.secretStore.id, first.process.name);
			port := first.process.provides->select(s | s.key = HTTP_SURFACE)->any(true).value;
		}}
	endif;

-- Every Process of `application` in the union, at `port`, as a value.
query peersOf(application : String, at : Integer, admits : String)
		: Sequence(Tuple(rule : String, namespace : String, process : String, port : Integer)) =
	projects->collect(prj | prj.applications->select(a | a.id = application).processes
		->collect(p | Tuple{rule = admits, namespace = homeNamespace(prj.project, application),
			process = homeProcess(application, p.name), port = at}))
		->flatten();

-- The port of `application`'s Process that provides this surface.
query String::portOf(application : String) : Integer =
	projects.applications->select(a | a.id = application).processes.provides
		->select(s | s.key = self)->any(true).value;

-- The routes an exposure gives the tier proxy, in the tier's own directory of
-- the estate-scoped edge, and one index per tier over every route in it. The
-- index lists the resolved project's routes: composing the whole estate's edge
-- is the composed estate's (JorisJonkers-dev/deploy-kit#203).
-- Each exposure's IngressRoute, in its Application's own directory and namespace, so a
-- Project's routes are its own and its unit applies them (spec/v1/30-deliverables.md#adapters).
query EffectiveApplication::routeFiles(root : String) : Sequence(Deliverable) =
	self.exposure->collect(e |
		let tier : Tier = tierFor(e.audience) in
		object IngressRouteFile {
			path := root + 'route-' + e.name + '.yaml';
			adapter := AdapterName::traefik;
			exposure := e.resolveone(ResolvedExposure);
			entryPoint := if tier.listener = Listener::tls then 'websecure' else 'web' endif;
			-- A tier issuing through acme names its own resolver, and a tls listener ends TLS.
			if tier.certificates = CertificateSource::acme then certificateResolver := tier.name endif;
			terminatesTls := tier.listener = Listener::tls;
		}.oclAsType(Deliverable))->asSequence();

-- An Application's external checks (spec/v1/14-platform-intent.md#the-foundation-is-declared):
-- one Gatus endpoint per route of each exposure, which fails on a 5xx or on no answer.
query EffectiveApplication::externalChecks(prj : EffectiveProject) : String =
	if self.exposure->isEmpty() then null else
	obj(Sequence{Tuple{k = 'endpoints', v = arr(self.exposure->collect(e | e.routes->collect(r | obj(Sequence{
		Tuple{k = 'name', v = str(self.id + '-' + e.name + '-' + e.routes->indexOf(r).toString())},
		Tuple{k = 'group', v = str(prj.project)},
		Tuple{k = 'url', v = str((if tierFor(e.audience).listener = Listener::tls then 'https' else 'http' endif)
			+ '://' + e.host + r.path)},
		Tuple{k = 'conditions', v = arr(Sequence{str('[STATUS] < 500')})}})))->flatten())}}) endif;

-- Per identity that holds a grant, one Vault policy over every grant it holds
-- and one Kubernetes auth role bound to it, estate-scoped by namespace: the
-- Process for all of its grants, and its backup identity for its credentials.
query EffectiveProject::vaultFiles() : Sequence(Deliverable) =
	self.applications->collect(a | a.resolveone(ResolvedApplication))->collect(app |
		app.processes->collect(p |
			(if processGrants(p)->isEmpty() then Sequence{} else
				vaultFilesOf(policiesOf(self.project), app.namespace, p.identity, processGrants(p)) endif)
			->union(if backupGrants(p)->isEmpty() then Sequence{} else
				vaultFilesOf(policiesOf(self.project), app.namespace,
					p.volumes->select(v | v.backup <> null)->first().backup.identity,
					backupGrants(p)) endif))
		->union(if app.migration = null then Sequence{} else
			vaultFilesOf(policiesOf(self.project), app.namespace, app.migration.identity, Sequence{app.migration.credential}) endif))
		->flatten();

-- A generated key with its defaults filled in: 32 bytes, as hex.
query GeneratedKey::resolved() : ResolvedGeneratedKey = object ResolvedGeneratedKey {
	key := self.name;
	bytes := if self.generate.bytes = null then 32 else self.generate.bytes endif;
	encoding := if self.generate.encoding = KeyEncoding::base64 then 'base64'
		else if self.generate.encoding = KeyEncoding::base64url then 'base64url' else 'hex' endif endif;
	-- The schema held the location to one path and one key, split at its `#`.
	adoptPath := if self.generate.adopt = null then null
		else self.generate.adopt.substring(1, self.generate.adopt.indexOf('#') - 1) endif;
	adoptKey := if self.generate.adopt = null then null
		else self.generate.adopt.substring(self.generate.adopt.indexOf('#') + 1, self.generate.adopt.size()) endif;
};

-- The keys the Vault policy job generates for the project, once each, in path
-- then key order: a grant every Process inherits names its keys once.
query EffectiveProject::generatedKeysFiles() : Sequence(Deliverable) =
	let apps : Sequence(ResolvedApplication) =
		self.applications->collect(a | a.resolveone(ResolvedApplication))->asSequence() in
	let held : Sequence(Tuple(path : String, key : String, bytes : Integer, encoding : String, adoptPath : String, adoptKey : String)) =
		apps.processes.secrets->select(g | g.path <> null)->collect(g | g.generated->collect(k |
			Tuple{path = g.path, key = k.key, bytes = k.bytes, encoding = k.encoding,
				adoptPath = k.adoptPath, adoptKey = k.adoptKey}))
		->asSet()->asSequence() in
	let sorted : Sequence(Tuple(path : String, key : String, bytes : Integer, encoding : String, adoptPath : String, adoptKey : String)) =
		held.path->asSet()->sortedBy(p | p)->collect(p | held->select(t | t.path = p)->sortedBy(t | t.key))
			->asSequence() in
	if sorted->isEmpty() then Sequence{} else Sequence{
		object GeneratedKeysFile {
			path := policiesOf(self.project) + apps->first().namespace + '.generated.json';
			adapter := AdapterName::vaultPolicy;
			keys := sorted->collect(t | object ResolvedGeneratedKey {
				path := t.path;
				key := t.key;
				bytes := t.bytes;
				encoding := t.encoding;
				adoptPath := t.adoptPath;
				adoptKey := t.adoptKey;
			});
		}.oclAsType(Deliverable)} endif;

query vaultFilesOf(policies : String, ns : String, holder : String, held : Sequence(ResolvedGrant)) : Sequence(Deliverable) =
	-- Each document is written under the name Vault holds it by, so two identities that derive
	-- one name claim one path.
	let stem : String = policies + ns + '-' + holder in
	Sequence{
		object VaultPolicyFile {
			path := stem + '.policy.json';
			adapter := AdapterName::vaultPolicy;
			namespace := ns;
			identity := holder;
			grants := held;
			paths := held->collect(g | g.allowedPaths())->flatten();
		}.oclAsType(Deliverable),
		object VaultRoleFile {
			path := stem + '.role.json';
			adapter := AdapterName::vaultPolicy;
			namespace := ns;
			identity := holder;
		}.oclAsType(Deliverable)
	};

query routeFile(app : EffectiveApplication, exposure : Exposure) : String =
	app.id + '-' + exposure.name + '.yaml';

-- ================================================================ spellings

query namespaceOf(prj : String) : String = prj + '-system';

-- Whether the source states `feature`: an unset enumeration reads as its first literal.
query ECORE::EObject::states(feature : String) : Boolean =
	self.eIsSet(self.eClass().getEStructuralFeature(feature));

query inSeconds(n : Integer) : String = n.toString() + 's';

query ceiling(r : Real) : Integer = -((-r).floor());

-- A duration in seconds: `20s`, `30ms`, `5m` or `2h`.
query seconds(d : String) : Real =
	if d.endsWith('ms') then d.substring(1, d.size() - 2).toReal() / 1000
	else if d.endsWith('s') then d.substring(1, d.size() - 1).toReal()
	else if d.endsWith('m') then d.substring(1, d.size() - 1).toReal() * 60
	else if d.endsWith('h') then d.substring(1, d.size() - 1).toReal() * 3600
	else unread('a duration', d) endif endif endif endif;

-- A quantity no spelling of the model reads: the checks refuse it before
-- resolution, so reaching here is a defect, and it stops the run.
query unread(what : String, q : String) : Real {
	assert fatal (false) with log(q + ' is not ' + what + ' the model reads');
	return 0;
}

-- A cpu quantity in millicores: `50m`, or `2` whole cores.
query millicores(q : String) : Integer =
	if q.endsWith('m') then q.substring(1, q.size() - 1).toInteger() else q.toInteger() * 1000 endif;

-- A memory quantity in MiB: `256Mi`, `2Gi`, `1Ti`, or bytes with no unit.
-- A quantity in MiB, written as the production implementation writes it.
query memoryOf(mib : Real) : String =
	let whole : Integer = mib.round() in
	if whole.mod(1024) = 0 then (whole.div(1024)).toString() + 'Gi' else whole.toString() + 'Mi' endif;

query mebibytes(q : String) : Real =
	if q.endsWith('Mi') then q.substring(1, q.size() - 2).toReal()
	else if q.endsWith('Gi') then q.substring(1, q.size() - 2).toReal() * 1024
	else if q.endsWith('Ti') then q.substring(1, q.size() - 2).toReal() * 1024 * 1024
	else if q.matches('[0-9]+') then q.toReal() / (1024 * 1024)
	else unread('a memory quantity', q) endif endif endif endif;

query PI::Cutover::resolvedCutover() : RD::Cutover =
	if self = PI::Cutover::continuous then RD::Cutover::continuous else RD::Cutover::interrupted endif;

query PI::Match::resolvedMatch() : RD::Match =
	if self = PI::Match::exact then RD::Match::exact else RD::Match::prefix endif;


query Audience::spelling() : String =
	if self = Audience::anonymous then 'anonymous'
	else if self = Audience::authenticated then 'authenticated'
	else if self = Audience::internal then 'internal' else 'lan' endif endif endif;

query ContentPolicy::spelling() : String =
	if self = ContentPolicy::strict then 'strict'
	else if self = ContentPolicy::admin then 'admin' else 'workflow' endif endif;

-- `static` is a keyword of the language, so it is the literal no comparison names.
query Runtime::spelling() : String =
	if self = Runtime::jvm then 'jvm'
	else if self = Runtime::python then 'python'
	else if self = Runtime::node then 'node'
	else if self = Runtime::none then 'none' else 'static' endif endif endif endif;

query HardeningClass::spelling() : String = 'restricted';

query Lifecycle::spelling() : String =
	if self = Lifecycle::application then 'application' else if self = Lifecycle::job then 'job'
	else if self = Lifecycle::scheduled then 'scheduled' else 'prepare' endif endif endif;

query Delivery::spelling() : String =
	if self = Delivery::env then 'env' else if self = Delivery::file then 'file' else 'self' endif endif;

query AccessTier::spelling() : String =
	if self = AccessTier::read then 'read'
	else if self = AccessTier::selfRenew then 'self-renew'
	else if self = AccessTier::selfRoll then 'self-roll' else 'custody' endif endif endif;

query TransitOp::spelling() : String =
	if self = TransitOp::sign then 'sign'
	else if self = TransitOp::verify then 'verify'
	else if self = TransitOp::encrypt then 'encrypt'
	else if self = TransitOp::decrypt then 'decrypt' else 'rotate' endif endif endif endif;

query PI::DurabilityClass::resolvedDurability() : RD::DurabilityClass =
	if self = PI::DurabilityClass::reconstructible then RD::DurabilityClass::reconstructible
	else if self = PI::DurabilityClass::recoverable then RD::DurabilityClass::recoverable
	else RD::DurabilityClass::irreplaceable endif endif;

query Arch::spelling() : String = if self = Arch::amd64 then 'amd64' else 'arm64' endif;

query Media::spelling() : String =
	if self = Media::nvme then 'nvme' else if self = Media::ssd then 'ssd' else 'hdd' endif endif;

-- =================================================== the production element

-- An Application's element as the production implementation writes it in
-- `resolved.json`, without the keys that are not its own decisions, in that
-- implementation's canonical JSON: keys sorted, no white space, absent values
-- left out. Its digest is the revision, which the rendered tree carries, so
-- the two implementations must compute it from the same text.
query ResolvedApplication::elementJson(src : EffectiveApplication, prj : EffectiveProject) : String =
	let after : Sequence(String) = appAfterOf(src, prj) in
	obj(Sequence{
		Tuple{k = 'id', v = str(self.id)},
		Tuple{k = 'project', v = str(self.project)},
		Tuple{k = 'namespace', v = str(self.namespace)},
		Tuple{k = 'reconcileUnit', v = str(self.reconcileUnit.name)},
		Tuple{k = 'reconcileAfter', v = if after->isEmpty() then null else arr(after->collect(n | str(n))) endif},
		Tuple{k = 'alertClass', v = opt(self.alertClass)},
		Tuple{k = 'scrape', v = if self.scrape = null then null else obj(Sequence{
			Tuple{k = 'process', v = str(self.scrape.process.name)},
			Tuple{k = 'surface', v = str(self.scrape.surface)},
			Tuple{k = 'path', v = str(self.scrape.path)},
			Tuple{k = 'interval', v = str(self.scrape.interval)},
			Tuple{k = 'timeout', v = str(self.scrape.timeout)},
			Tuple{k = 'labels', v = if self.scrape.labels->isEmpty() then null
				else obj(self.scrape.labels->collect(l | Tuple{k = l.key, v = str(l.value)})) endif}}) endif},
		Tuple{k = 'releaseGate', v = if self.releaseGate = null then null else self.releaseGate.json() endif},
		Tuple{k = 'migration', v = if self.migration = null then null else obj(Sequence{
			Tuple{k = 'runner', v = str(self.migration.runner)},
			Tuple{k = 'runnerVersion', v = opt(self.migration.runnerVersion)},
			Tuple{k = 'uid', v = num(self.migration.uid)},
			Tuple{k = 'gid', v = num(self.migration.gid)},
			Tuple{k = 'testedAgainst', v = opt(self.migration.testedAgainst)},
			Tuple{k = 'nonTransactional', v = bool(self.migration.nonTransactional)},
			Tuple{k = 'identity', v = str(self.migration.identity)},
			Tuple{k = 'deadline', v = str(self.migration.deadline)},
			Tuple{k = 'memory', v = str(self.migration.memory)},
			Tuple{k = 'cpu', v = str(self.migration.cpu)},
			Tuple{k = 'scratch', v = str(self.migration.scratch)},
			Tuple{k = 'database', v = obj(Sequence{
				Tuple{k = 'host', v = str(self.migration.database.host)},
				Tuple{k = 'port', v = num(self.migration.database.port)},
				Tuple{k = 'name', v = str(self.migration.database.name)}})},
			Tuple{k = 'consumes', v = arr(self.migration.consumes->collect(c | str(c)))},
			Tuple{k = 'credential', v = self.migration.credential.json()},
			Tuple{k = 'egress', v = arr(self.migration.egress->collect(x | x.json()))}}) endif},
		Tuple{k = 'alertRules', v = if self.alertRules->isEmpty() then null else arr(Sequence{1..self.alertRules->size()}->collect(i | obsAlertRulesJson(self.alertRules->at(i), src.alertRules->at(i)._from))) endif},
		Tuple{k = 'alerting', v = if self.alerting = null then null else obsAlertingJson(self.alerting) endif},
		Tuple{k = 'fluxScrape', v = if self.fluxScrape = null then null else obsFluxJson(self.fluxScrape) endif},
		Tuple{k = 'secretStore', v = opt(self.secretStore)},
		Tuple{k = 'dashboards', v = if self.dashboards = null then null else obj(Sequence{
			Tuple{k = 'folder', v = str(self.dashboards.folder)},
			Tuple{k = 'datasource', v = str(self.dashboards.datasource)},
			Tuple{k = 'instance', v = obj(self.dashboards.instance->collect(i | Tuple{k = i.key, v = str(i.value)}))},
			Tuple{k = 'files', v = arr(src.dashboards->collect(d | let content : String = fileOf(prj.project, d._from) in
				obj(Sequence{
					Tuple{k = 'uid', v = str(uidOf(content))},
					Tuple{k = 'from', v = str(d._from)},
					Tuple{k = 'content', v = str(content)},
					Tuple{k = 'inputs', v = arr(inputsOf(content)->collect(x | str(x)))}})))}}) endif},
		Tuple{k = 'exposure', v = if self.exposure->isEmpty() then null
			else arr(self.exposure->collect(e | e.json())) endif},
		Tuple{k = 'client', v = if self.client = null then null else self.client.json() endif},
		Tuple{k = 'processes', v = arr(self.processes->collect(p | p.json()))}
	});

-- The units an Application must follow, as the production implementation
-- records them per Application: every other project its edges reach, and the
-- secrets unit wherever one of its Processes holds a grant.
query appAfterOf(app : EffectiveApplication, prj : EffectiveProject) : Sequence(String) =
	(app.processes.dependsOn
		-- An optional edge orders nothing (spec/v1/55-delivery.md#release-order).
		->select(e | not (e.required = false))
		->collect(e | projectOf(e.application))
		->select(other | other <> null and other <> prj.project)
		->collect(other | unitOf(other))
	->union(if app.processes->exists(p | p.secrets->notEmpty() or holdsClientGrants(p) or p.vpn <> null
			or p.dependsOn->exists(e | reachesDatabase(e)))
			or managed(app) or appliesCatalog(app)
		then secretsAfter(prj.project) else Sequence{} endif)
	->union(proxiesAfter(app, prj.project)))
	->asSet()->sortedBy(n | n)->asSequence();

query ReleaseGate::json() : String = obj(Sequence{
	Tuple{k = 'endpoint', v = str(self.endpoint)},
	Tuple{k = 'deadline', v = str(self.deadline)},
	Tuple{k = 'analysis', v = obj(Sequence{
		Tuple{k = 'errorRate', v = str(self.analysis.errorRate)},
		Tuple{k = 'interval', v = str(self.analysis.interval)},
		Tuple{k = 'iterations', v = num(self.analysis.iterations)},
		Tuple{k = 'latency', v = str(self.analysis.latency)},
		Tuple{k = 'threshold', v = num(self.analysis.threshold)}})},
	Tuple{k = 'members', v = arr(self.members->collect(m | obj(Sequence{
		Tuple{k = 'process', v = str(m.process.name)},
		Tuple{k = 'readiness', v = m.readiness.json()},
		Tuple{k = 'checks', v = if m.checks->isEmpty() then null
			else arr(m.checks->collect(c | str(c.spelling()))) endif},
		Tuple{k = 'waitsFor', v = if m.waitsFor->isEmpty() then null
			else arr(m.waitsFor->collect(w | obj(Sequence{
				Tuple{k = 'application', v = str(w.application)},
				Tuple{k = 'process', v = str(w.process)}}))) endif}})))},
	Tuple{k = 'migration', v = if self.migration = null then null else obj(Sequence{
		Tuple{k = 'identity', v = str(self.migration.identity)},
		Tuple{k = 'testedAgainst', v = opt(self.migration.testedAgainst)},
		Tuple{k = 'nonTransactional', v = bool(self.migration.nonTransactional)}}) endif},
	Tuple{k = 'protectedPath', v = opt(self.protectedPathOf())},
	Tuple{k = 'protectedBy', v = opt(self.protectedByOf())}
});

query ResolvedExposure::json() : String = obj(Sequence{
	Tuple{k = 'name', v = str(self.name)},
	Tuple{k = 'host', v = str(self.host)},
	Tuple{k = 'tier', v = str(self.tier)},
	Tuple{k = 'listener', v = str(self.listener)},
	Tuple{k = 'certificates', v = str(self.certificates)},
	Tuple{k = 'ingressClass', v = opt(self.ingressClass)},
	Tuple{k = 'dns', v = if self.dns = null then null else obj(Sequence{
		Tuple{k = 'target', v = str(self.dns.target)},
		Tuple{k = 'proxied', v = bool(self.dns.proxied)}}) endif},
	Tuple{k = 'proxy', v = obj(Sequence{
		Tuple{k = 'application', v = str(self.proxyApplication)},
		Tuple{k = 'namespace', v = str(self.proxyNamespace)}})},
	Tuple{k = 'routes', v = arr(self.routes->collect(r | obj(Sequence{
		Tuple{k = 'path', v = str(r.path)},
		Tuple{k = 'match', v = str(r.match.spelling())},
		Tuple{k = 'process', v = str(r.process.name)},
		Tuple{k = 'surface', v = str(r.surface)},
		Tuple{k = 'audience', v = str(r.audience)},
		Tuple{k = 'precedence', v = num(r.precedence)},
		Tuple{k = 'middleware', v = arr(r.middleware->collect(m | obj(Sequence{
			Tuple{k = 'kind', v = str(m.kind.spelling())},
			Tuple{k = 'contentPolicy', v = opt(m.contentPolicy)},
			Tuple{k = 'endpoint', v = opt(m.endpoint)},
			Tuple{k = 'redirectTo', v = opt(m.redirectTo)},
			Tuple{k = 'allowance', v = if m.allowance = null then null else num(m.allowance) endif},
			Tuple{k = 'per', v = opt(m.per)},
			Tuple{k = 'burst', v = if m.burst = null then null else num(m.burst) endif},
			Tuple{k = 'clientAddress', v = opt(m.clientAddress)}})))}})))}
});

query ResolvedProcess::json() : String =
	let policy : Sequence(ProcessPolicy) = self.oclAsType(ECORE::EObject).eContainer().eContainer()
		.oclAsType(ResolvedDeployment).deliverables[NetworkPolicyFile].policies
		->select(pp | pp.process = self)->asSequence() in
	let ingress : Sequence(PolicyPeer) = if policy->isEmpty() then Sequence{} else policy->first().ingress->asSequence() endif in
	let egress : Sequence(PolicyPeer) = if policy->isEmpty() then Sequence{} else policy->first().egress->asSequence() endif in
	obj(Sequence{
		Tuple{k = 'name', v = str(self.name)},
		Tuple{k = 'lifecycle', v = str(self.lifecycle)},
		Tuple{k = 'runtime', v = str(self.component)},
		Tuple{k = 'identity', v = str(self.identity)},
		Tuple{k = 'image', v = str(self.image)},
		Tuple{k = 'imageVersion', v = opt(self.imageVersion)},
		Tuple{k = 'uid', v = num(self.uid)},
		Tuple{k = 'gid', v = num(self.gid)},
		Tuple{k = 'cutover', v = if self.oclAsType(ECORE::EObject).states('cutover')
			then str(self.cutover.spelling()) else null endif},
		Tuple{k = 'switchover', v = if self.oclAsType(ECORE::EObject).states('switchover')
			then str(self.switchover.spelling()) else null endif},
		Tuple{k = 'command', v = let src : PI::Process = self.invresolveone(PI::Process) in
			if src = null or src.command->isEmpty() then null else arr(src.command->collect(x | str(x))) endif},
		Tuple{k = 'args', v = if self.arguments->isEmpty() then null else arr(self.arguments->collect(x | str(x))) endif},
		Tuple{k = 'schedule', v = opt(self.schedule)},
		Tuple{k = 'startDeadline', v = opt(self.startDeadline)},
		Tuple{k = 'deadline', v = str(self.deadline)},
		Tuple{k = 'replicas', v = num(self.replicas)},
		Tuple{k = 'parked', v = if self.parked then bool(true) else null endif},
		Tuple{k = 'spreadAcross', v = if self.spread then str('node') else null endif},
		Tuple{k = 'memory', v = str(self.memory)},
		Tuple{k = 'cpu', v = str(self.cpu)},
		Tuple{k = 'gpu', v = if self.gpu = null then null else obj(Sequence{
			Tuple{k = 'resource', v = str(self.gpu.resource)},
			Tuple{k = 'runtimeClass', v = str(self.gpu.runtimeClass)}}) endif},
		Tuple{k = 'vpn', v = if self.vpn = null then null else obj(Sequence{
			Tuple{k = 'image', v = str(self.vpn.image)},
			Tuple{k = 'imageVersion', v = opt(self.vpn.imageVersion)},
			Tuple{k = 'memory', v = str(self.vpn.memory)},
			Tuple{k = 'cpu', v = str(self.vpn.cpu)},
			Tuple{k = 'forwardedPort', v = bool(self.vpn.forwardedPort)},
			Tuple{k = 'environment', v = arr(self.vpn.environment->collect(x | obj(Sequence{
				Tuple{k = 'name', v = str(x.name)},
				Tuple{k = 'value', v = str(x.value)}})))},
			Tuple{k = 'credential', v = self.vpn.credential.json()}}) endif},
		Tuple{k = 'hardening', v = str(self.hardening)},
		Tuple{k = 'priorityClass', v = opt(self.priorityClass)},
		Tuple{k = 'nameservers', v = if self.nameservers->isEmpty() then null else arr(self.nameservers->collect(x | str(x))) endif},
		Tuple{k = 'l4Exposure', v = let src : PI::Process = self.invresolveone(PI::Process) in
			if src = null or l4Of(src)->isEmpty() then null else arr(l4Of(src).address->asSet()->sortedBy(a | a)
				->collect(address | let declared : L4AddressDeclaration = addressOf(address) in obj(Sequence{
					Tuple{k = 'address', v = str(address)},
					Tuple{k = 'kind', v = str(declared.kind)},
					Tuple{k = 'node', v = if declared.oclIsKindOf(NodeAddress) then str(declared.oclAsType(NodeAddress).node) else null endif},
					Tuple{k = 'site', v = if declared.oclIsKindOf(PoolAddress) then str(declared.oclAsType(PoolAddress).site) else null endif},
					Tuple{k = 'range', v = if declared.oclIsKindOf(PoolAddress) then str(declared.oclAsType(PoolAddress).range) else null endif},
					Tuple{k = 'service', v = if declared.oclIsKindOf(PoolAddress) then str(src.name + '-' + address) else null endif},
					Tuple{k = 'ports', v = arr(l4Of(src)->select(e | e.address = address)
						->sortedBy(e | e.port * 2 + (if e.protocol = L4Protocol::tcp then 0 else 1 endif))
						->collect(e | obj(Sequence{
							Tuple{k = 'name', v = str(e.protocol.toString() + '-' + e.port.toString())},
							Tuple{k = 'port', v = num(e.port)},
							Tuple{k = 'protocol', v = str(e.protocol.toString())},
							Tuple{k = 'surface', v = str(e.surface.key)},
							Tuple{k = 'targetPort', v = num(e.surface.value)}})))}}))) endif},
		Tuple{k = 'identityToken', v = bool(self.identityToken)},
		Tuple{k = 'internetEgress', v = if self.internetEgress = null then null else obj(Sequence{
			Tuple{k = 'reason', v = str(self.internetEgress.reason)}}) endif},
		Tuple{k = 'api', v = if self.api = null then null else obj(Sequence{
			Tuple{k = 'reason', v = str(self.api.reason)},
			Tuple{k = 'rules', v = arr(self.api.rules->collect(r | obj(Sequence{
				Tuple{k = 'group', v = str(r.group)},
				Tuple{k = 'objects', v = arr(r.objects->collect(x | str(x)))},
				Tuple{k = 'verbs', v = arr(r.verbs->collect(x | str(x)))},
				Tuple{k = 'scope', v = str(if r.scope = RuleScope::_namespace then 'namespace' else 'cluster' endif)}})))},
			Tuple{k = 'server', v = arr(self.api.server->collect(x | obj(Sequence{
				Tuple{k = 'cidr', v = str(x.cidr)},
				Tuple{k = 'port', v = num(x.port)}})))}}) endif},
		Tuple{k = 'readiness', v = if self.readiness = null then null else self.readiness.json() endif},
		Tuple{k = 'liveness', v = if self.liveness = null then null else self.liveness.json() endif},
		Tuple{k = 'startup', v = if self.startup = null then null else self.startup.json() endif},
		Tuple{k = 'placement', v = obj(Sequence{
			Tuple{k = 'eligibleNodes', v = arr(self.placement.eligibleNodes->collect(n | str(n)))},
			Tuple{k = 'boundTo', v = opt(self.placement.boundTo)},
			Tuple{k = 'from', v = if self.placement.boundTo = null then null else str(self.placement._from.spelling()) endif}})},
		Tuple{k = 'volumes', v = if self.volumes->isEmpty() then null else arr(self.volumes->collect(x | x.json())) endif},
		Tuple{k = 'libraries', v = if self.libraries->isEmpty() then null else arr(self.libraries->collect(x | obj(Sequence{
			Tuple{k = 'library', v = str(x._library)},
			Tuple{k = 'claim', v = str(x.claim)},
			Tuple{k = 'volume', v = str(x.volume)},
			Tuple{k = 'node', v = str(x.node)},
			Tuple{k = 'path', v = str(x.path)},
			Tuple{k = 'gid', v = num(x.gid)},
			Tuple{k = 'mountAt', v = str(x.mountAt)},
			Tuple{k = 'subPath', v = opt(x.subPath)},
			Tuple{k = 'access', v = str(x._access)}}))) endif},
		Tuple{k = 'secrets', v = if self.secrets->isEmpty() then null else arr(self.secrets->collect(x | x.json())) endif},
		Tuple{k = 'assets', v = if self.assets->isEmpty() then null else arr(self.assets->collect(x | obj(Sequence{
			Tuple{k = 'name', v = str(x.name)},
			Tuple{k = 'from', v = str(x._from)},
			Tuple{k = 'mountAt', v = opt(x.mountAt)},
			Tuple{k = 'seedAt', v = opt(x.seedAt)},
			Tuple{k = 'content', v = str(x.content)}}))) endif},
		Tuple{k = 'seeder', v = if self.seeder = null then null else obj(Sequence{
			Tuple{k = 'image', v = str(self.seeder.image)},
			Tuple{k = 'imageVersion', v = opt(self.seeder.imageVersion)},
			Tuple{k = 'memory', v = str(self.seeder.memory)},
			Tuple{k = 'cpu', v = str(self.seeder.cpu)}}) endif},
		Tuple{k = 'sidecars', v = if self.sidecars->isEmpty() then null else arr(self.sidecars->collect(x |
			let src : Sidecar = self.invresolveone(PI::Process).sidecars->select(c | c.name = x.name)->any(true) in
			obj(Sequence{
			Tuple{k = 'name', v = str(x.name)},
			Tuple{k = 'image', v = str(x.image)},
			Tuple{k = 'imageVersion', v = opt(x.imageVersion)},
			Tuple{k = 'command', v = if src.command->isEmpty() then null else arr(src.command->collect(c | str(c))) endif},
			Tuple{k = 'args', v = if src.args->isEmpty() then null else arr(src.args->collect(c | str(c))) endif},
			Tuple{k = 'memory', v = str(x.memory)},
			Tuple{k = 'cpu', v = str(x.cpu)},
			Tuple{k = 'volumes', v = if src.volumes->isEmpty() then null else arr(src.volumes->collect(m | obj(Sequence{
				Tuple{k = 'claim', v = str(m.claim)}, Tuple{k = 'mountAt', v = str(m.mountAt)}}))) endif},
			Tuple{k = 'assets', v = if src.assets->isEmpty() then null else arr(src.assets->collect(m | obj(Sequence{
				Tuple{k = 'from', v = str(m._from)}, Tuple{k = 'mountAt', v = str(m.mountAt)}}))) endif},
			Tuple{k = 'init', v = if x._init then bool(true) else null endif}}))) endif},
		Tuple{k = 'dependencies', v = if self.dependencies->isEmpty() then null else arr(self.dependencies->collect(x | obj(Sequence{
			Tuple{k = 'application', v = str(x.application)},
			Tuple{k = 'surface', v = str(x.surface)},
			Tuple{k = 'address', v = str(x.address)},
			Tuple{k = 'target', v = opt(x.target)},
			Tuple{k = 'peers', v = if x.peers->isEmpty() then null else arr(x.peers->collect(q | q.json())) endif}}))) endif},
		Tuple{k = 'consumes', v = if self.consumes->isEmpty() then null else arr(self.consumes->collect(c | str(c))) endif},
		Tuple{k = 'writablePaths', v = if self.writablePaths->isEmpty() then null else arr(self.writablePaths->collect(x | obj(Sequence{
			Tuple{k = 'path', v = str(x.path)},
			Tuple{k = 'size', v = str(x.size)},
			Tuple{k = 'medium', v = if x.memory then str('memory') else null endif}}))) endif},
		Tuple{k = 'environment', v = if self.environment->isEmpty() then null else arr(self.environment->collect(x | obj(Sequence{
			Tuple{k = 'name', v = str(x.name)},
			Tuple{k = 'value', v = opt(x.value)},
			Tuple{k = 'secret', v = if x.secret = null then null else obj(Sequence{
				Tuple{k = 'path', v = str(x.secret.path)},
				Tuple{k = 'key', v = str(x.secret.key)}}) endif}}))) endif},
		Tuple{k = 'surfaces', v = if self.surfaces->isEmpty() then null else arr(self.surfaces->collect(x | obj(Sequence{
			Tuple{k = 'name', v = str(x.name)},
			Tuple{k = 'port', v = num(x.port)}}))) endif},
		-- An L4 client is the adapter's to admit, read off the exposure; the element carries the exposure.
		Tuple{k = 'ingress', v = let own : Sequence(PolicyPeer) = ingress->reject(x | x.rule = 'l4') in
			if own->isEmpty() then null else arr(own->collect(x | x.json())) endif},
		Tuple{k = 'egress', v = arr(egress->collect(x | x.json()))}
	});

query ProbeTarget::fields() : Sequence(Tuple(k : String, v : String)) =
	if self.oclIsKindOf(HttpTarget) then Sequence{
		Tuple{k = 'path', v = str(self.oclAsType(HttpTarget).path)},
		Tuple{k = 'port', v = num(self.oclAsType(HttpTarget).port)}}
	else Sequence{Tuple{k = 'tcp', v = num(self.oclAsType(TcpTarget).tcp)}} endif;

query ProbeTarget::json() : String = obj(self.fields());

query ResolvedProbe::json() : String = obj(self.target.fields()->union(Sequence{
	Tuple{k = 'period', v = str(self.period)},
	Tuple{k = 'timeout', v = str(self.timeout)},
	Tuple{k = 'failures', v = num(self.failures)}}));

query StartupProbe::json() : String = obj(self.target.fields()->union(Sequence{
	Tuple{k = 'period', v = str(self.period)},
	Tuple{k = 'timeout', v = str(self.timeout)},
	Tuple{k = 'failures', v = num(self.failures)}}));

query PolicyPeer::json() : String = obj(Sequence{
	Tuple{k = 'rule', v = opt(self.rule)},
	Tuple{k = 'namespace', v = opt(self.namespace)},
	Tuple{k = 'process', v = opt(self.process)},
	Tuple{k = 'consumes', v = opt(self.consumes)},
	-- The gate's members are pods, not one port.
	Tuple{k = 'port', v = if self.rule = 'gate-members' then null else num(self.port) endif}});

query ResolvedVolume::json() : String = obj(Sequence{
	Tuple{k = 'claim', v = str(self.claim)},
	Tuple{k = 'mountAt', v = str(self.mountAt)},
	Tuple{k = 'size', v = str(self.size)},
	Tuple{k = 'durability', v = str(self.durability.spelling())},
	Tuple{k = 'backup', v = if self.backup = null then null else obj(Sequence{
		Tuple{k = 'schedule', v = str(self.backup.schedule)},
		Tuple{k = 'retain', v = num(self.backup.retain)},
		Tuple{k = 'offCluster', v = if self.backup.offCluster = null then null else obj(Sequence{
			Tuple{k = 'destination', v = str(self.backup.offCluster)},
			Tuple{k = 'path', v = str(self.backup.offClusterPath)},
			Tuple{k = 'recipient', v = str(self.backup.offClusterRecipient)}}) endif},
		Tuple{k = 'method', v = str(self.backup.method)},
		Tuple{k = 'methodVersion', v = opt(self.backup.methodVersion)},
		Tuple{k = 'uid', v = num(self.backup.uid)},
		Tuple{k = 'gid', v = num(self.backup.gid)},
		Tuple{k = 'identity', v = str(self.backup.identity)},
		Tuple{k = 'claim', v = str(self.backup.claim)},
		Tuple{k = 'credential', v = if self.backup.credential = null then null else self.backup.credential.json() endif},
		Tuple{k = 'peer', v = if self.backup.peer = null then null else obj(Sequence{
			Tuple{k = 'host', v = str(self.backup.peer.host)},
			Tuple{k = 'port', v = num(self.backup.peer.port)},
			Tuple{k = 'credential', v = self.backup.peer.credential.json()}}) endif},
		Tuple{k = 'egress', v = arr(self.backup.egress->collect(x | x.json()))},
		Tuple{k = 'destinations', v = if self.backup.destinations->isEmpty() then null
			else arr(self.backup.destinations->collect(x | obj(Sequence{
				Tuple{k = 'cidr', v = str(x.cidr)},
				Tuple{k = 'port', v = num(x.port)}}))) endif}}) endif}});

query ResolvedGrant::json() : String = obj(Sequence{
	Tuple{k = 'path', v = opt(self.path)},
	Tuple{k = 'keys', v = if self.keys->isEmpty() then null else arr(self.keys->collect(x | str(x))) endif},
	Tuple{k = 'access', v = opt(self._access)},
	Tuple{k = 'client', v = opt(self.clientNamed())},
	Tuple{k = 'engine', v = opt(self.engine)},
	Tuple{k = 'paths', v = if self.paths->isEmpty() then null else arr(self.paths->collect(x | obj(Sequence{
		Tuple{k = 'path', v = str(x.path)},
		Tuple{k = 'allows', v = arr(x.allows->collect(a | str(a)))}}))) endif},
	Tuple{k = 'delivery', v = str(self.delivery)},
	Tuple{k = 'destination', v = opt(self.destination)},
	Tuple{k = 'mountAt', v = opt(self.mountAt)},
	Tuple{k = 'fileMode', v = opt(self.fileMode)},
	Tuple{k = 'restartTargets', v = if self.restartTargets->isEmpty() then null
		else arr(self.restartTargets->collect(x | str(x))) endif},
	Tuple{k = 'generated', v = if self.generated->isEmpty() then null
		else arr(self.generated->collect(x | obj(Sequence{
			Tuple{k = 'key', v = str(x.key)},
			Tuple{k = 'bytes', v = num(x.bytes)},
			Tuple{k = 'encoding', v = str(x.encoding)},
			Tuple{k = 'adopt', v = if x.adoptPath = null then null else obj(Sequence{
				Tuple{k = 'path', v = str(x.adoptPath)},
				Tuple{k = 'key', v = str(x.adoptKey)}}) endif}}))) endif}});

-- ================================================ a Vault policy job's files

-- One Vault policy job's files under `root`, its objects in `ns`, handed the documents among
-- `held` and named by their digest and everything its pod runs with: a Job's template never
-- changes once created, so any change to either is a new name. None where it holds no document.
query policyJobFiles(planned : ResolvedPolicyJob, held : Sequence(Deliverable), root : String, ns : String) : Sequence(Deliverable) =
	let docs : Sequence(Tuple(file : String, json : String)) = held
		->collect(d | d.documentOf())->select(d | d <> null)->asSequence()->sortedBy(d | d.file) in
	if planned = null or docs->isEmpty() then Sequence{} else
	let digest : String = obj(Sequence{
		Tuple{k = 'documents', v = '{' + joined(docs->collect(d | str(d.file) + ':' + d.json)) + '}'},
		Tuple{k = 'image', v = str(planned.image)},
		Tuple{k = 'uid', v = planned.uid.toString()},
		Tuple{k = 'gid', v = planned.gid.toString()},
		Tuple{k = 'memory', v = str(planned.memory)},
		Tuple{k = 'cpu', v = str(planned.cpu)},
		Tuple{k = 'deadline', v = str(planned.deadline)},
		Tuple{k = 'eligibleNodes', v = arr(planned.eligibleNodes->collect(n | str(n)))}}).rawDigestOf() in
	let named : String = planned.identity + '-'
		+ digest.substring(ALGORITHM.size() + 1, ALGORITHM.size() + NAME_DIGITS) in
	Sequence{'configmap', 'job', 'cronjob', 'serviceaccount', 'networkpolicy'}
		->collect(piece | object PolicyJobFile {
			path := root + piece + '.yaml';
			adapter := if piece = 'networkpolicy' then AdapterName::networking else AdapterName::vaultPolicy endif;
			part := piece;
			name := named;
			namespace := ns;
			job := planned;
			documents := docs->collect(d | object PolicyDocument { file := d.file; json := d.json; });
		}.oclAsType(Deliverable))
	-- A policy file is listed nowhere while the policy stage is render-only.
	->append(object IndexFile {
		path := root + 'kustomization.yaml';
		adapter := AdapterName::kubernetes;
		resources := Sequence{'configmap.yaml', 'cronjob.yaml', 'job.yaml', 'serviceaccount.yaml'};
	}.oclAsType(Deliverable)) endif;

-- A Vault document as a job is handed it: its file name, and its content as canonical JSON.
-- Any other Deliverable is none.
query Deliverable::documentOf() : Tuple(file : String, json : String) =
	if self.oclIsKindOf(VaultPolicyFile) then
		Tuple{file = fileOf(self.path), json = self.oclAsType(VaultPolicyFile).policyJson()}
	else if self.oclIsKindOf(VaultRoleFile) then
		Tuple{file = fileOf(self.path), json = self.oclAsType(VaultRoleFile).roleJson()}
	else if self.oclIsKindOf(GeneratedKeysFile) then
		Tuple{file = fileOf(self.path), json = self.oclAsType(GeneratedKeysFile).keysJson()}
	else if self.oclIsKindOf(CatalogJobFile) and self.oclAsType(CatalogJobFile).part = 'policy' then
		Tuple{file = fileOf(self.path), json = self.oclAsType(CatalogJobFile).job.catalogPolicyJson()}
	else null endif endif endif endif;

-- A catalog method's own policy: it reads its login, and writes each database role it names.
query ResolvedCatalogJob::catalogPolicyJson() : String = pathsJson(self.policy);

-- A catalog method's own policy: it reads its login and its metadata, and creates, reads and
-- updates each database role the catalog names, in the catalog's order.
query ResolvedCatalog::policy() : Sequence(PolicyPath) =
	Sequence{allowing(self.admin.path, Sequence{'read'}),
		allowing('secret/metadata/' + self.admin.path.substring(KV_DATA.size() + 1, self.admin.path.size()),
			Sequence{'read'})}
	->union(self.databases->collect(d | Sequence{d.owner, d.data})->flatten()
		->collect(r | allowing('database/roles/' + r, Sequence{'create', 'read', 'update'}))->asSequence())
	->union(self.keys->collect(k | allowing(k.path, Sequence{'create', 'read', 'update'}))->asSequence());

-- What each grant may do: the paths a transit or database grant's engine derives, or `read` on
-- a kv grant's path and on the same document's metadata.
query VaultPolicyFile::policyJson() : String = pathsJson(self.paths);

query pathsJson(paths : Collection(PolicyPath)) : String =
	obj(Sequence{Tuple{k = 'path', v = obj(paths->collect(p |
		Tuple{k = p.path, v = capabilities(p.allows->asSequence())})->asSequence())}});

-- What a grant allows: its engine's own paths, or `read` on a kv grant's document and on the same
-- document's metadata.
query ResolvedGrant::allowedPaths() : Sequence(PolicyPath) =
	if self.engine <> null or self.paths->notEmpty() then self.paths->collect(p | allowing(p.path, p.allows->asSequence()))
	else Sequence{allowing(self.path, Sequence{'read'}),
		allowing('secret/metadata/' + self.path.substring(KV_DATA.size() + 1, self.path.size()),
			Sequence{'read'})} endif;

query allowing(at : String, capabilities : Sequence(String)) : PolicyPath =
	object PolicyPath { path := at; allows := capabilities; };

property KV_DATA : String = 'secret/data/';

query capabilities(allows : Sequence(String)) : String =
	obj(Sequence{Tuple{k = 'capabilities', v = arr(allows->collect(a | str(a)))}});

-- Each key a job generates, where, and how.
query GeneratedKeysFile::keysJson() : String =
	obj(Sequence{Tuple{k = 'keys', v = arr(self.keys->collect(x | obj(Sequence{
		Tuple{k = 'path', v = str(x.path)},
		Tuple{k = 'key', v = str(x.key)},
		Tuple{k = 'bytes', v = x.bytes.toString()},
		Tuple{k = 'encoding', v = str(x.encoding)}}
		->union(if x.adoptPath = null then Sequence{} else Sequence{
			Tuple{k = 'adopt', v = obj(Sequence{
				Tuple{k = 'path', v = str(x.adoptPath)},
				Tuple{k = 'key', v = str(x.adoptKey)}})}} endif))))}});

-- The role that binds the identity's ServiceAccount, in its namespace, to the one policy of its name.
query VaultRoleFile::roleJson() : String =
	obj(Sequence{
		Tuple{k = 'bound_service_account_names', v = arr(Sequence{str(self.identity)})},
		Tuple{k = 'bound_service_account_namespaces', v = arr(Sequence{str(self.namespace)})},
		Tuple{k = 'token_policies', v = arr(Sequence{str(self.namespace + '-' + self.identity)})}});

-- The last segment of a path: the name a document is mounted and written under.
query fileOf(path : String) : String = path.substring(path.lastIndexOf('/') + 1, path.size());

-- ===================================================== a catalog method's files

-- How many hex digits of a digest a derived name carries, after the algorithm it opens with.
property ALGORITHM : String = 'sha256:';
property NAME_DIGITS : Integer = 12;

-- A catalog method's objects and its own policy, under one directory: its Job is named by the
-- digest of the catalog and of everything its pod runs with, so a changed one is a new Job.
query ResolvedCatalogJob::catalogFilesUnder(root : String) : Sequence(Deliverable) =
	let catalog : String = self.catalog.catalogJson() in
	let digest : String = obj(Sequence{
		Tuple{k = 'catalog', v = catalog},
		Tuple{k = 'image', v = str(self.image)},
		Tuple{k = 'uid', v = self.uid.toString()},
		Tuple{k = 'gid', v = self.gid.toString()},
		Tuple{k = 'memory', v = str(self.memory)},
		Tuple{k = 'cpu', v = str(self.cpu)},
		Tuple{k = 'deadline', v = str(self.deadline)},
		Tuple{k = 'eligibleNodes', v = arr(self.eligibleNodes->collect(n | str(n)))}}).rawDigestOf() in
	Sequence{
		object CatalogJobFile {
			path := root + self.identity + '.yaml';
			adapter := AdapterName::kubernetes;
			part := 'objects';
			name := self.identity + '-' + digest.substring(ALGORITHM.size() + 1, ALGORITHM.size() + NAME_DIGITS);
			catalogJson := catalog;
			job := self;
		}.oclAsType(Deliverable),
		object CatalogJobFile {
			path := root + self.identity + '-networkpolicy.yaml';
			adapter := AdapterName::networking;
			part := 'networkpolicy';
			job := self;
		}.oclAsType(Deliverable)};

-- A catalog as its method is handed it.
query ResolvedCatalog::catalogJson() : String =
	if self.keys->notEmpty() then obj(Sequence{
		Tuple{k = 'admin', v = obj(Sequence{
			Tuple{k = 'path', v = str(self.admin.path)},
			Tuple{k = 'token', v = str(self.admin.token)}})},
		Tuple{k = 'host', v = str(self.host)},
		Tuple{k = 'keys', v = arr(self.keys->collect(x | obj(Sequence{
			Tuple{k = 'buckets', v = arr(x.buckets->collect(b | str(b))->asSequence())},
			Tuple{k = 'name', v = str(x.name)},
			Tuple{k = 'path', v = str(x.path)}}))->asSequence())},
		Tuple{k = 'port', v = self.port.toString()}})
	else obj(Sequence{
		Tuple{k = 'admin', v = obj(Sequence{
			Tuple{k = 'path', v = str(self.admin.path)},
			Tuple{k = 'user', v = str(self.admin.user)},
			Tuple{k = 'password', v = str(self.admin.password)}})},
		Tuple{k = 'connection', v = str(self.connection)},
		Tuple{k = 'databases', v = arr(self.databases->collect(d | obj(Sequence{
			Tuple{k = 'name', v = str(d.name)},
			Tuple{k = 'owner', v = str(d.owner)},
			Tuple{k = 'data', v = str(d.data)}}))->asSequence())},
		Tuple{k = 'host', v = str(self.host)},
		Tuple{k = 'port', v = self.port.toString()}}) endif;

-- ===================================================== canonical JSON text

-- An object of the entries whose value is present, in key order.
query obj(entries : Sequence(Tuple(k : String, v : String))) : String =
	'{' + joined(entries->select(e | e.v <> null)->sortedBy(e | e.k)->collect(e | str(e.k) + ':' + e.v)) + '}';

query arr(items : Sequence(String)) : String = '[' + joined(items) + ']';

-- The items, comma-separated; no item is empty, since each is a JSON value.
query joined(items : Sequence(String)) : String =
	items->iterate(i; acc : String = '' | if acc = '' then i else acc + ',' + i endif);

-- A JSON string, escaped as JSON.stringify escapes it.
query str(s : String) : String =
	'"' + s.substituteAll('\\', '\\\\').substituteAll('"', '\\"').substituteAll('\n', '\\n')
		.substituteAll('\r', '\\r').substituteAll('\t', '\\t') + '"';

query opt(s : String) : String = if s = null then null else str(s) endif;

query num(n : Integer) : String = n.toString();

query bool(b : Boolean) : String = if b then 'true' else 'false' endif;

query Switchover::spelling() : String =
	if self = Switchover::blueGreen then 'blue-green'
	else if self = Switchover::stopStart then 'stop-start' else 'rolling' endif endif;

query RD::Cutover::spelling() : String =
	if self = RD::Cutover::continuous then 'continuous' else 'interrupted' endif;

query RD::Match::spelling() : String = if self = RD::Match::exact then 'exact' else 'prefix' endif;

query MiddlewareKind::spelling() : String =
	if self = MiddlewareKind::forwardAuth then 'forward-auth'
	else if self = MiddlewareKind::securityHeaders then 'security-headers'
	else if self = MiddlewareKind::redirect then 'redirect' else 'rate-limit' endif endif endif;

query RD::DurabilityClass::spelling() : String =
	if self = RD::DurabilityClass::reconstructible then 'reconstructible'
	else if self = RD::DurabilityClass::recoverable then 'recoverable' else 'irreplaceable' endif endif;

query PinnedInput::spelling() : String =
	if self = PinnedInput::clusterState then 'cluster-state'
	else if self = PinnedInput::nodeContract then 'node-contract'
	else if self = PinnedInput::imagesLock then 'images-lock'
	else if self = PinnedInput::platformIntent then 'platform-intent' else 'intent-fragment' endif endif endif endif;

query AnalysisCheck::spelling() : String =
	if self = AnalysisCheck::errorRate then 'error-rate' else 'latency' endif;

-- ================================================================== edge
-- edge: a tier's proxy (spec/v1/14-platform-intent.md#tiers): the L4 ports, the claim, the token,
-- the arguments and the shared Middlewares its tiers derive on it, which no project file writes.

property ACME_REASON : String = 'ACME issuance and its DNS challenge';
property ACME_CLAIM : String = 'acme';
property ACME_MOUNT : String = '/acme';
property ACME_SIZE : String = '16Mi';
property DNS_TOKEN_KEY : String = 'CF_DNS_API_TOKEN';

-- The surfaces a listener's ports are answered on.
query listenerSurfaces(l : Listener) : Sequence(String) =
	if l = Listener::tls then Sequence{'web', 'websecure'} else Sequence{'web'} endif;

-- The Process of an Application that provides every surface a listener names, if any does.
query listenedBy(app : EffectiveApplication, l : Listener) : String =
	app.processes->select(q | listenerSurfaces(l)->forAll(s | q.provides->exists(e | e.key = s)))
		->collect(q | q.name)->any(true);

-- The tiers whose proxy is this Process.
query edgeTiersOf(p : PI::Process) : Sequence(Tier) =
	let app : EffectiveApplication = p.oclAsType(ECORE::EObject).eContainer().oclAsType(EffectiveApplication) in
	let prj : EffectiveProject = app.oclAsType(ECORE::EObject).eContainer().oclAsType(EffectiveProject) in
	estate.tiers->select(t | heldName(t.traefik) = prj.project + '/' + app.id
		and listenedBy(app, t.listener) = p.name)->asSequence();

-- Whether the Process answers an acme tier.
query edgeAcme(p : PI::Process) : Boolean =
	edgeTiersOf(p)->exists(t | t.certificates = CertificateSource::acme);

-- The L4 exposures its tiers derive: each port the listener derives, on the tier's address.
query tierL4Of(p : PI::Process) : Sequence(Tuple(address : String, port : Integer, protocol : L4Protocol, surface : Surface)) =
	edgeTiersOf(p)->select(t | t.address <> null)->collect(t |
		listenerSurfaces(t.listener)->collect(s | Tuple{address = t.address,
			port = if s = 'web' then 80 else 443 endif, protocol = L4Protocol::tcp,
			surface = p.provides->select(e | e.key = s)->any(true)}))->asSequence();

-- The ports on a node's own address that are not a surface's own number over TCP.
query edgeNodePortsOf(p : PI::Process) : Sequence(L4Port) =
	l4Of(p)->select(e | addressOf(e.address).oclIsKindOf(NodeAddress)
			and not (e.protocol = L4Protocol::tcp and e.port = e.surface.value))
		->sortedBy(e | e.port * 2 + (if e.protocol = L4Protocol::tcp then 0 else 1 endif))
		->collect(e | object L4Port {
			name := e.protocol.toString() + '-' + e.port.toString();
			port := e.port;
			protocol := e.protocol.toString().toUpper();
			targetPort := e.surface.value;
		})->asSequence();

query edgeVolumesOf(p : PI::Process) : Sequence(ResolvedVolume) =
	if edgeAcme(p) then Sequence{object ResolvedVolume {
		claim := ACME_CLAIM;
		mountAt := ACME_MOUNT;
		size := ACME_SIZE;
		durability := RD::DurabilityClass::reconstructible;
	}} else Sequence{} endif;

query edgeGrantsOf(p : PI::Process) : Sequence(ResolvedGrant) =
	if edgeAcme(p) then Sequence{object ResolvedGrant {
		path := estate.acme.token;
		keys := Sequence{DNS_TOKEN_KEY};
		_access := 'read';
		delivery := 'env';
		destination := destinationOf(p.name, estate.acme.token);
		restartTargets := Sequence{p.name};
	}} else Sequence{} endif;

query edgeEnvOf(p : PI::Process) : Sequence(EnvEntry) =
	if edgeAcme(p) then Sequence{object EnvEntry {
		name := DNS_TOKEN_KEY;
		secret := object SecretReference { path := estate.acme.token; key := DNS_TOKEN_KEY; };
	}} else Sequence{} endif;

query edgeSurfacePort(p : PI::Process, name : String) : Integer =
	p.provides->select(e | e.key = name)->collect(e | e.value)->any(true);

-- A tier proxy's static configuration, as Traefik's arguments
-- (spec/v1/30-deliverables.md#the-edge-proxy), after the authored ones.
query edgeArgsOf(p : PI::Process) : Sequence(String) =
	let app : EffectiveApplication = p.oclAsType(ECORE::EObject).eContainer().oclAsType(EffectiveApplication) in
	let prj : EffectiveProject = app.oclAsType(ECORE::EObject).eContainer().oclAsType(EffectiveProject) in
	let t : Tier = estate.tiers->select(x | heldName(x.traefik) = prj.project + '/' + app.id
		and x.ingressClass <> null)->any(true) in
	if t = null or edgeSurfacePort(p, 'web') = null then Sequence{} else
	let websecure : Integer = edgeSurfacePort(p, 'websecure') in
	let admin : Integer = edgeSurfacePort(p, 'admin') in
	Sequence{'--entryPoints.web.address=:' + edgeSurfacePort(p, 'web').toString() + '/tcp'}
	->union(if websecure = null then Sequence{}
		else Sequence{'--entryPoints.websecure.address=:' + websecure.toString() + '/tcp'} endif)
	->union(if t.listener = Listener::tls and websecure <> null
		then Sequence{'--entryPoints.websecure.http.tls=true'} else Sequence{} endif)
	->union(if admin = null then Sequence{} else Sequence{
		'--entryPoints.traefik.address=:' + admin.toString() + '/tcp',
		'--ping=true', '--ping.entryPoint=traefik',
		'--metrics.prometheus=true', '--metrics.prometheus.entryPoint=traefik'} endif)
	->union(Sequence{'--providers.kubernetescrd=true',
		'--providers.kubernetescrd.ingressClass=' + t.ingressClass,
		'--providers.kubernetescrd.allowCrossNamespace=true',
		'--providers.kubernetescrd.allowEmptyServices=true'})
	->union(if t.certificates = CertificateSource::acme then Sequence{
		'--certificatesresolvers.' + t.name + '.acme.email=' + estate.acme.email,
		'--certificatesresolvers.' + t.name + '.acme.storage=' + ACME_MOUNT + '/' + t.name + '.json',
		'--certificatesresolvers.' + t.name + '.acme.dnschallenge.provider=' + estate.acme.dnsProvider.toString()}
		else Sequence{} endif)
	->union(Sequence{'--log.format=json', '--accesslog=true', '--accesslog.format=json'})
	endif;

-- The Middlewares every route names, in the namespace of the Project's tier proxies, rendered once
-- by the first proxy by name, with the forward-auth the first tier of the namespace names; and its
-- place in that Application's index.
helper EffectiveProject::edgeFiles(inout plan : ResolvedDeployment) : OclVoid {
	var proxies : Sequence(String) := estate.tiers->collect(t | heldName(t.traefik))
		->select(h | h.startsWith(self.project + '/'))->asSet()->asSequence()->sortedBy(h | h);
	if (proxies->notEmpty()) {
		var home : String := proxies->first().substring(self.project.size() + 2, proxies->first().size());
		var asked : Tier := estate.tiers->select(t | t.forwardAuth <> null
			and heldName(t.traefik).startsWith(self.project + '/'))->any(true);
		plan.deliverables += object SharedMiddlewareFile {
			path := 'apps/' + self.project + '/' + home + '/middlewares.yaml';
			adapter := AdapterName::traefik;
			namespace := namespaceOf(self.project);
			application := home;
			if (asked <> null) {
				forwardAuth := object ForwardAuthEndpoint { address := asked.forwardAuth.endpoint(); };
			} endif;
			policies := Sequence{
				object ContentPolicyHeaders { name := 'strict'; contentSecurityPolicy := 'default-src \'self\''; },
				object ContentPolicyHeaders { name := 'admin';
					contentSecurityPolicy := 'default-src \'self\'; style-src \'self\' \'unsafe-inline\''; },
				object ContentPolicyHeaders { name := 'workflow';
					contentSecurityPolicy := 'default-src \'self\'; connect-src \'self\' https:'; }};
		};
		var index : IndexFile := plan.deliverables[IndexFile]
			->select(i | i.path = 'apps/' + self.project + '/' + home + '/kustomization.yaml')->any(true);
		if (index <> null) {
			index.resources := index.resources->append('middlewares.yaml')->sortedBy(m | m);
		};
	};
}

-- ==================================================================== observability
-- observability: rule groups, the Alertmanager's routing, and Flux's metrics scrape.

query obsAlerts(app : EffectiveApplication) : Boolean =
	estate.monitoring <> null and estate.monitoring.alertmanager.id = app.id;

query obsFlux(app : EffectiveApplication) : Boolean =
	estate.bootstrap.flux.metrics <> null and estate.telemetry <> null and estate.telemetry.metrics.id = app.id;

query obsFluxScrape() : ResolvedFluxScrape =
	object ResolvedFluxScrape {
		namespace := estate.bootstrap.flux.sourceRef.substringBefore('/');
		port := estate.bootstrap.flux.metrics.port;
		path := estate.bootstrap.flux.metrics.path;
		interval := estate.monitors.interval;
		timeout := estate.monitors.timeout;
		labels := estate.monitors.labels->sortedBy(l | l.key)
			->collect(l | object KeyValue { key := l.key; value := l.value; });
	};

query obsAlerting(app : EffectiveApplication) : ResolvedAlerting =
	object ResolvedAlerting {
		routes := estate.monitoring.routes->collect(r | object AlertRoute {
			severity := r.severity; receiver := r.receiver; repeat := r.repeat; });
		receivers := estate.monitoring.receivers->collect(r | object AlertReceiver {
			name := r.name;
			secret := destinationOf(app.processes->first().name, r.discord.webhook.path);
			key := r.discord.webhook.key; });
	};

-- The rule name: the Application, then the file's base name without its extension.
query obsRuleName(app : String, source : String) : String =
	let base : String = source.substring(source.lastIndexOf('/') + 1, source.size()) in
	app + '-' + (if base.endsWith('.yaml') then base.substring(1, base.size() - 5)
		else if base.endsWith('.yml') then base.substring(1, base.size() - 4) else base endif endif)
		.toLower().replaceAll('[^a-z0-9-]', '-');

-- A rule-group file as indented lines, without blanks and comments.
query obsLines(content : String) : Sequence(Tuple(n : Integer, t : String)) =
	content.tokenize('\n')->select(l | l.trim().size() > 0 and not l.trim().startsWith('#'))
		->collect(l | Tuple{n = l.size() - l.replaceAll('^ +', '').size(), t = l.trim()})->asSequence();

query obsBare(t : String) : String =
	if t.startsWith('- ') then t.substring(3, t.size()).trim() else t endif;

query obsUnquote(s : String) : String =
	if s.size() >= 2 and ((s.startsWith('"') and s.endsWith('"')) or (s.startsWith('\'') and s.endsWith('\'')))
	then s.substring(2, s.size() - 1) else s endif;

query obsKey(t : String) : String =
	let b : String = obsBare(t) in b.substring(1, b.indexOf(':') - 1);

query obsValue(t : String) : String =
	let b : String = obsBare(t) in obsUnquote(b.substring(b.indexOf(':') + 1, b.size()).trim());

-- The last line of the span that starts at `i`, among the lines that start `marks`.
query obsEnd(marks : Sequence(Integer), i : Integer, last : Integer) : Integer =
	let later : Sequence(Integer) = marks->select(x | x > i)->asSequence() in
	if later->isEmpty() then last else later->first() - 1 endif;

query obsAlertRules(app : String, source : String, content : String) : ResolvedAlertRules =
	let ls : Sequence(Tuple(n : Integer, t : String)) = obsLines(content) in
	let gs : Sequence(Integer) = Sequence{1..ls->size()}->select(i | ls->at(i).t.startsWith('- name:'))->asSequence() in
	object ResolvedAlertRules {
		name := obsRuleName(app, source);
		groups := gs->collect(g | let gEnd : Integer = obsEnd(gs, g, ls->size()) in
			let rs : Sequence(Integer) = Sequence{g + 1..gEnd}->select(i | ls->at(i).t.startsWith('- alert:'))->asSequence() in
			object AlertRuleGroup {
				name := obsValue(ls->at(g).t);
				rules := rs->collect(r | let rEnd : Integer = obsEnd(rs, r, gEnd) in
					let fields : Integer = ls->at(r).n + 2 in
					let top : Sequence(Integer) = Sequence{r..rEnd}->select(j | ls->at(j).n = fields or j = r)->asSequence() in
					object AlertRule {
						alert := obsValue(ls->at(r).t);
						expr := obsValue(ls->at(top->select(j | obsBare(ls->at(j).t).startsWith('expr:'))->first()).t);
						duration := let d : Sequence(Integer) = top->select(j | obsBare(ls->at(j).t).startsWith('for:'))->asSequence() in
							if d->isEmpty() then null else obsValue(ls->at(d->first()).t) endif;
						labels := obsMap(ls, r, rEnd, 'labels', fields);
						annotations := obsMap(ls, r, rEnd, 'annotations', fields);
					});
			});
	};

-- The entries of the mapping `key` at `indent`, within lines from..to.
query obsMap(ls : Sequence(Tuple(n : Integer, t : String)), lo : Integer, hi : Integer, heading : String, indent : Integer) : Sequence(KeyValue) =
	let at : Sequence(Integer) = Sequence{lo..hi}->select(j | ls->at(j).n = indent and ls->at(j).t = heading + ':')->asSequence() in
	if at->isEmpty() then Sequence{} else
	let start : Integer = at->first() in
	Sequence{start + 1..hi}->select(j | Sequence{start + 1..j}->forAll(m | ls->at(m).n > indent))
		->collect(j | object KeyValue { key := obsKey(ls->at(j).t); value := obsValue(ls->at(j).t); })->asSequence() endif;

query obsKvJson(items : Sequence(KeyValue)) : String =
	if items->isEmpty() then null else obj(items->collect(i | Tuple{k = i.key, v = str(i.value)})) endif;

query obsAlertRulesJson(rules : ResolvedAlertRules, source : String) : String =
	obj(Sequence{
		Tuple{k = 'from', v = str(source)},
		Tuple{k = 'groups', v = arr(rules.groups->collect(g | obj(Sequence{
			Tuple{k = 'name', v = str(g.name)},
			Tuple{k = 'rules', v = arr(g.rules->collect(r | obj(Sequence{
				Tuple{k = 'alert', v = str(r.alert)},
				Tuple{k = 'expr', v = str(r.expr)},
				Tuple{k = 'for', v = opt(r.duration)},
				Tuple{k = 'labels', v = obsKvJson(r.labels->asSequence())},
				Tuple{k = 'annotations', v = obsKvJson(r.annotations->asSequence())}}))->asSequence())}}))->asSequence())}});

query obsAlertingJson(alerting : ResolvedAlerting) : String =
	obj(Sequence{
		Tuple{k = 'receivers', v = arr(alerting.receivers->collect(r | obj(Sequence{
			Tuple{k = 'name', v = str(r.name)},
			Tuple{k = 'discord', v = obj(Sequence{
				Tuple{k = 'secret', v = str(r.secret)},
				Tuple{k = 'key', v = str(r.key)}})}}))->asSequence())},
		Tuple{k = 'routes', v = arr(alerting.routes->collect(r | obj(Sequence{
			Tuple{k = 'severity', v = str(r.severity)},
			Tuple{k = 'receiver', v = str(r.receiver)},
			Tuple{k = 'repeat', v = str(r.repeat)}}))->asSequence())}});

query obsFluxJson(flux : ResolvedFluxScrape) : String =
	obj(Sequence{
		Tuple{k = 'namespace', v = str(flux.namespace)},
		Tuple{k = 'port', v = num(flux.port)},
		Tuple{k = 'path', v = str(flux.path)},
		Tuple{k = 'interval', v = str(flux.interval)},
		Tuple{k = 'timeout', v = str(flux.timeout)},
		Tuple{k = 'labels', v = obsKvJson(flux.labels->asSequence())}});

-- Each receiver's webhook, read onto the Alertmanager's first Process through the one secret delivery.
query obsReceiverGrants(p : PI::Process, app : EffectiveApplication) : Sequence(ResolvedGrant) =
	if not obsAlerts(app) or app.processes->first() <> p then Sequence{} else
	estate.monitoring.receivers->collect(r | object ResolvedGrant {
		path := r.discord.webhook.path;
		keys := Sequence{r.discord.webhook.key};
		_access := 'read';
		delivery := 'env';
		destination := destinationOf(p.name, r.discord.webhook.path);
	})->asSequence() endif;

-- What the metrics stack scrapes: every Application's scrape target, where it runs, in one
-- order, then Flux's controllers on the port the bootstrap set records.
query obsScrapeEgress(app : EffectiveApplication) : Sequence(PolicyPeer) =
	if estate.telemetry = null or estate.telemetry.metrics.id <> app.id then Sequence{} else
	let targets : Sequence(Tuple(rule : String, namespace : String, process : String, port : Integer)) =
		projects->collect(prj | prj.applications->select(a | a.observability <> null and a.observability.scrape <> null)
			->collect(a | Tuple{rule = 'peer', namespace = homeNamespace(prj.project, a.id),
				process = homeProcess(a.id, a.observability.scrape.process.name),
				port = a.observability.scrape.surface.value}))->flatten() in
	named(targets->asOrderedSet()->asSequence()->sortedBy(t | t.namespace + ' ' + t.process + ' ' + t.port.toString())->asSequence())
	->union(if estate.bootstrap.flux.metrics = null then Sequence{} else Sequence{object PolicyPeer {
		rule := 'flux-metrics';
		namespace := estate.bootstrap.flux.sourceRef.substringBefore('/');
		port := estate.bootstrap.flux.metrics.port;
	}} endif)
	endif;

-- ============================================================ identity: sign-in

-- identity: the exposure an Application's Client names, or the only one it declares.
query clientExposureOf(app : EffectiveApplication) : Exposure =
	if app.client.oclAsType(ECORE::EObject).states('exposure')
		then app.exposure->select(e | e.name = app.client.exposure)->any(true)
		else app.exposure->any(true) endif;

-- identity: the Client an Application's `client` block derives (spec/v1/17-sign-in.md#the-client).
mapping EffectiveApplication::clientOf(in prj : EffectiveProject) : ResolvedClient {
	init {
		var hostName : String := clientExposureOf(self).host;
	}
	signIn := self.client.signIn.toString();
	host := hostName;
	-- A token Client has no tile, so nothing launches it.
	if self.client.signIn <> SignInMode::token then
		launchUrl := 'https://' + hostName + (if self.client.oclAsType(ECORE::EObject).states('launchPath')
			then self.client.launchPath else '/' endif)
	endif;
	if self.client.oclAsType(ECORE::EObject).states('iconPath') then
		iconUrl := 'https://' + hostName + self.client.iconPath endif;
	redirectUris := self.client.redirectPaths->collect(p | 'https://' + hostName + p);
	if self.client.oclAsType(ECORE::EObject).states('credential') then
		credential := self.client.credential.toString() endif;
	if self.client.oclAsType(ECORE::EObject).states('credential') and self.client.credential = ClientCredential::secret then
		secretPath := clientSecretPath(prj.project, self.id) endif;
	roles := Sequence{'user'}->union(self.client.roles->asSequence());
	if self.client.oclAsType(ECORE::EObject).states('label') then label := self.client.label endif;
	if self.client.oclAsType(ECORE::EObject).states('description') then description := self.client.description endif;
}

-- identity: where a Client holding a secret keeps it, in its Application's own namespace subtree.
query clientSecretPath(prj : String, application : String) : String =
	'secret/data/' + namespaceOf(prj) + '/' + application + '/client';

-- identity: every Client of the union holding a secret, by its credential path, in path order.
query clientSecrets() : Sequence(Tuple(client : String, path : String)) =
	projects->collect(prj | prj.applications->select(a | a.client <> null
			and a.client.oclAsType(ECORE::EObject).states('credential')
			and a.client.credential = ClientCredential::secret)
		->collect(a | Tuple{client = a.id, path = clientSecretPath(prj.project, a.id)}))
	->flatten()->sortedBy(c | c.path)->asSequence();

-- identity: whether an Application is the sign-in provider, whose Processes write every Client credential.
query providerHolds(app : EffectiveApplication) : Boolean =
	estate.signIn <> null and projects->exists(prj | prj.applications->includes(app)
		and prj.project + '/' + app.id = heldName(estate.signIn.provider));

query holdsClientGrants(p : PI::Process) : Boolean =
	providerHolds(p.oclAsType(ECORE::EObject).eContainer().oclAsType(EffectiveApplication))
		and clientSecrets()->notEmpty();

-- identity: the grants a Client derives on a Process of its provider: write on every client
-- credential of the union, delivered to no one (the provider reads it through its own token).
query PI::Process::clientGrants(app : EffectiveApplication) : Sequence(ResolvedGrant) =
	if not providerHolds(app) then Sequence{} else
	clientSecrets()->collect(c | object ResolvedGrant {
		delivery := 'self';
		paths := Sequence{object PolicyPath { path := c.path; allows := Sequence{'create', 'read', 'update'}; }};
	}) endif;

-- identity: the Client a grant of the provider writes, found by the path it holds.
query ResolvedGrant::clientNamed() : String =
	if self.engine <> null or self.path <> null or self.paths->size() <> 1 then null else
	let found : Sequence(Tuple(client : String, path : String)) =
		clientSecrets()->select(c | c.path = self.paths->first().path) in
	if found->isEmpty() then null else found->first().client endif endif;

-- identity: whether an exposure's authenticated routes ask the tier's forward-auth: only where the
-- Client that names the exposure is gated.
query asksTheGate(app : EffectiveApplication, exposure : Exposure) : Boolean =
	if app.client = null then true
	else if clientExposureOf(app) <> exposure then true
	else app.client.signIn = SignInMode::gated endif endif;

-- identity: the Application a gate belongs to, as the source reads it.
query ReleaseGate::sourceOf() : EffectiveApplication =
	let id : String = self.oclAsType(ECORE::EObject).eContainer().oclAsType(ResolvedApplication).id in
	projects->select(p | p.project = project).applications->select(a | a.id = id)->any(true);

-- identity: a native Client's protected path, which the gate asks anonymously before it switches.
query ReleaseGate::protectedPathOf() : String =
	let app : EffectiveApplication = self.sourceOf() in
	if app.client = null or app.client.signIn <> SignInMode::native then null
	else app.client.protectedPath endif;

-- identity: the Process the longest Route of the Client's exposure takes that path to.
query ReleaseGate::protectedByOf() : String =
	let app : EffectiveApplication = self.sourceOf() in
	if self.protectedPathOf() = null then null else
	let path : String = self.protectedPathOf() in
	let reaching : Sequence(Route) = clientExposureOf(app).routes->select(r | r.redirectTo = null
		and (if r.match = PI::Match::exact then path = r.path else path.startsWith(r.path) endif))->asSequence() in
	if reaching->isEmpty() then null
	else reaching->sortedBy(r | -r.path.size())->first().process.name endif endif;

-- identity: the Client as the element records it.
query ResolvedClient::json() : String = obj(Sequence{
	Tuple{k = 'signIn', v = str(self.signIn)},
	Tuple{k = 'host', v = str(self.host)},
	Tuple{k = 'launchUrl', v = opt(self.launchUrl)},
	Tuple{k = 'iconUrl', v = opt(self.iconUrl)},
	Tuple{k = 'redirectUris', v = if self.redirectUris->isEmpty() then null
		else arr(self.redirectUris->collect(u | str(u))) endif},
	Tuple{k = 'credential', v = opt(self.credential)},
	Tuple{k = 'secretPath', v = opt(self.secretPath)},
	Tuple{k = 'roles', v = arr(self.roles->collect(r | str(r)))},
	Tuple{k = 'label', v = opt(self.label)},
	Tuple{k = 'description', v = opt(self.description)}
});

-- ================================================================== posture
-- posture (1.3.1): a low port earns NET_BIND_SERVICE, and a writable /tmp is the home
-- (docs/adr/model/0141).

property HOME_DIR : String = '/tmp';
property FIRST_UNPRIVILEGED_PORT : Integer = 1024;

-- Whether the Process's container mounts a writable /tmp.
query mountsTmp(p : PI::Process) : Boolean =
	p.writablePaths->exists(w | w.path = HOME_DIR) or p.volumes->exists(v | v.mountAt = HOME_DIR);

-- Whether the container's own variables name HOME, which an authored one wins.
query namesHome(p : PI::Process, prj : EffectiveProject) : Boolean =
	environmentOf(p, prj)->exists(e | e.name = 'HOME');

-- NET_BIND_SERVICE, where the container listens below 1024.
query lowPrivileges(p : ResolvedProcess) : Sequence(String) =
	if p.surfaces->exists(s | s.port < FIRST_UNPRIVILEGED_PORT)
			or p.nodePorts->exists(x | x.targetPort < FIRST_UNPRIVILEGED_PORT)
		then Sequence{'NET_BIND_SERVICE'} else Sequence{} endif;
