# collections/data/platform/env/postgres/base.env
#
# Per Process, like every env file
# (docs/adr/model/0013-configuration-is-dotenv-at-three-scopes.md). A third-party image
# with runtime: none receives no profile values at all, so this file is short.
# The single secret placeholder is consumed by the postgres-exporter sidecar.
#
# The Application this Process belongs to is declared in the data project's Intent
# Fragment, platform/data.project.yml, alongside platform-rabbitmq and platform-valkey
# (docs/adr/model/0009-intent-is-authored-one-file-per-project.md) -- reproduced as
# examples/data/data.project.yml. Sharing that file couples nothing: the three
# Applications release independently
# (docs/adr/model/0052-an-application-is-the-release-unit.md).

POSTGRES_DB=postgres
POSTGRES_USER=postgres

# The exporter's connection string. The string between ${secret: and # BYTE-
# MATCHES the `path:` of the Process-level grant in data.yml
# (docs/adr/model/0030-secret-delivery-is-env-file-or-self.md) -- mount and KV `data/` segment
# included, and pointing at the exporter's own split path rather than the old
# shared document. Without that grant this line is an unauthorised reference;
# without this line the grant is a dead grant.
DATA_SOURCE_NAME=${secret:secret/data/platform/postgres/exporter#datasource}
