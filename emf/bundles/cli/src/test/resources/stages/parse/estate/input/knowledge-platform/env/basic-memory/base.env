# Basic Memory. The git-sync sidecar shares the pod's environment, so its
# variables are here too.
BASIC_MEMORY_PROJECT_ROOT=/vault
BASIC_MEMORY_HOME=/vault
BASIC_MEMORY_DEFAULT_PROJECT=main
BASIC_MEMORY_DISABLE_PERMALINKS=true
BASIC_MEMORY_ENSURE_FRONTMATTER_ON_SYNC=false
BASIC_MEMORY_SEMANTIC_EMBEDDING_CACHE_DIR=/app/.basic-memory/fastembed
BASIC_MEMORY_CONFIG_DIR=/app/.basic-memory
BASIC_MEMORY_SYNC_CHANGES=true
BASIC_MEMORY_SYNC_DELAY=1000
BASIC_MEMORY_LOG_LEVEL=INFO

# git-sync: the vault repository it keeps /vault in step with.
VAULT_CLONE_URL=git@github.com:JorisJonkers-dev/knowledge-vault.git
VAULT_DIR=/vault
VAULT_BRANCH=main
VAULT_SSH_KEY_PATH=/run/secrets/knowledge-vault/id_ed25519
VAULT_AUTHOR_NAME=basic-memory-vault
VAULT_AUTHOR_EMAIL=basicmemory@knowledge.local
GIT_CONFIG_COUNT=1
GIT_CONFIG_KEY_0=safe.directory
GIT_CONFIG_VALUE_0=/vault
POLL_SECONDS=10
PUSH=true
LOG_LEVEL=INFO
