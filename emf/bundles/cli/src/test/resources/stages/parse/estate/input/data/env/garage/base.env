# collections/data/platform/env/garage/base.env
#
# Garage reads its cluster secret and admin token from these two variables in
# place of its configuration file, so the file stays an Asset with nothing
# secret in it.
GARAGE_RPC_SECRET=${secret:secret/data/platform/garage#rpc-secret}
GARAGE_ADMIN_TOKEN=${secret:secret/data/platform/garage#admin-token}
