    <applications id="loki">
      <processes startupBudget="30s" cutover="interrupted" name="loki" image="loki" runtime="none">
        <placement memory="512Mi" cpu="100m"/>
        <provides key="http" value="3100"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/ready" port="3100"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/ready" port="3100"/>
        </probes>
        <volumes claim="loki" mountAt="/loki" size="10Gi"/>
      </processes>
    </applications>
    <applications id="tempo">
      <processes startupBudget="30s" cutover="interrupted" name="tempo" image="tempo" runtime="none">
        <placement memory="512Mi" cpu="100m"/>
        <provides key="http" value="3200"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/ready" port="3200"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/ready" port="3200"/>
        </probes>
        <volumes claim="tempo" mountAt="/var/tempo" size="10Gi"/>
      </processes>
    </applications>
    <applications id="pyroscope">
      <processes startupBudget="30s" cutover="interrupted" name="pyroscope" image="pyroscope" runtime="none">
        <placement memory="512Mi" cpu="100m"/>
        <provides key="http" value="4040"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/ready" port="4040"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/ready" port="4040"/>
        </probes>
        <volumes claim="pyroscope" mountAt="/data" size="10Gi"/>
      </processes>
    </applications>
    <applications id="gatus">
      <processes startupBudget="30s" cutover="interrupted" name="gatus" image="gatus" runtime="none">
        <placement memory="64Mi" cpu="20m"/>
        <provides key="http" value="8080"/>
        <sidecars name="checks" image="gatus-checks" memory="32Mi" cpu="10m"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/health" port="8080"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/health" port="8080"/>
        </probes>
        <api reason="the checks sidecar watches every Project's external-checks ConfigMap, cluster-wide">
          <rules group="core">
            <objects>configmaps</objects>
            <verbs>get</verbs>
            <verbs>list</verbs>
            <verbs>watch</verbs>
          </rules>
        </api>
      </processes>
    </applications>
    <applications id="alloy">
      <processes startupBudget="30s" cutover="continuous" name="alloy" image="alloy" runtime="none">
        <placement memory="256Mi" cpu="50m"/>
        <provides key="http" value="12345"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/-/ready" port="12345"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/-/ready" port="12345"/>
        </probes>
        <api reason="Alloy tails every pod's log through the API, cluster-wide">
          <rules group="core">
            <objects>pods</objects>
            <objects>pods/log</objects>
            <objects>namespaces</objects>
            <verbs>get</verbs>
            <verbs>list</verbs>
            <verbs>watch</verbs>
          </rules>
        </api>
      </processes>
    </applications>
    <applications id="alertmanager">
      <processes startupBudget="30s" cutover="continuous" name="alertmanager" image="alertmanager" runtime="none">
        <writablePaths xsi:type="projectintent:PlainPath" path="/alertmanager"/>
        <placement memory="128Mi" cpu="50m"/>
        <provides key="http" value="9093"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/-/ready" port="9093"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/-/healthy" port="9093"/>
        </probes>
      </processes>
    </applications>
  </projectintent:Project>
