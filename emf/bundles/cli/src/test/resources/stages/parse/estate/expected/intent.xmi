  <projectintent:Project apiVersion="intent.jorisjonkers.dev/v1" kind="Project" schemaVersion="1.0.0" project="secrets" owner="joris">
    <applications id="vault">
      <processes startupBudget="30s" cutover="interrupted" name="vault" image="vault" runtime="none">
        <placement memory="256Mi" cpu="100m"/>
        <provides key="http" value="8200"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/v1/sys/health" port="8200"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/v1/sys/health" port="8200"/>
        </probes>
      </processes>
    </applications>
    <applications id="vault-secrets-operator">
      <processes startupBudget="30s" cutover="interrupted" name="vault-secrets-operator" image="vault-secrets-operator" runtime="none">
        <placement memory="128Mi" cpu="50m"/>
        <provides key="metrics" value="8080"/>
        <provides key="health" value="8081"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/healthz" port="8081"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/healthz" port="8081"/>
        </probes>
        <api reason="the operator syncs every grant's sync object into its Secret, cluster-wide, and restarts the Processes a rotation names">
          <rules group="secrets.hashicorp.com">
            <objects>vaultstaticsecrets</objects>
            <objects>vaultstaticsecrets/status</objects>
            <objects>vaultdynamicsecrets</objects>
            <objects>vaultdynamicsecrets/status</objects>
            <objects>vaultauths</objects>
            <objects>vaultauths/status</objects>
            <objects>vaultconnections</objects>
            <objects>vaultconnections/status</objects>
            <verbs>get</verbs>
            <verbs>list</verbs>
            <verbs>watch</verbs>
            <verbs>create</verbs>
            <verbs>update</verbs>
            <verbs>patch</verbs>
            <verbs>delete</verbs>
          </rules>
          <rules group="core">
            <objects>secrets</objects>
            <verbs>get</verbs>
            <verbs>list</verbs>
            <verbs>watch</verbs>
            <verbs>create</verbs>
            <verbs>update</verbs>
            <verbs>patch</verbs>
            <verbs>delete</verbs>
          </rules>
          <rules group="core">
            <objects>serviceaccounts/token</objects>
            <verbs>create</verbs>
          </rules>
          <rules group="apps">
            <objects>deployments</objects>
            <objects>statefulsets</objects>
            <objects>daemonsets</objects>
            <verbs>get</verbs>
            <verbs>list</verbs>
            <verbs>watch</verbs>
            <verbs>patch</verbs>
          </rules>
          <rules group="core">
            <objects>events</objects>
            <verbs>create</verbs>
            <verbs>patch</verbs>
          </rules>
        </api>
      </processes>
    </applications>
  </projectintent:Project>
  <projectintent:Project apiVersion="intent.jorisjonkers.dev/v1" kind="Project" schemaVersion="1.0.0" project="utility" owner="joris">
    <applications id="adguard">
      <l4Exposure address="lan-dns" port="53" protocol="udp" process="/14/@applications.0/@processes.0" surface="/14/@applications.0/@processes.0/@provides.1"/>
      <l4Exposure address="lan-dns" port="53" process="/14/@applications.0/@processes.0" surface="/14/@applications.0/@processes.0/@provides.1"/>
      <processes startupBudget="30s" cutover="continuous" name="adguard" image="adguard" runtime="none">
        <assets xsi:type="projectintent:SeededAsset" from="config/adguard/AdGuardHome.yaml" seedAt="/opt/adguardhome/conf/AdGuardHome.yaml"/>
        <writablePaths xsi:type="projectintent:MemoryPath" path="/opt/adguardhome/work" memory="128Mi"/>
        <writablePaths xsi:type="projectintent:PlainPath" path="/opt/adguardhome/conf"/>
        <placement memory="128Mi" cpu="50m">
          <capabilities>adguard</capabilities>
        </placement>
        <provides key="http" value="3000"/>
        <provides key="dns" value="5353"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/login.html" port="3000"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/login.html" port="3000"/>
        </probes>
        <replicas count="2" reason="the LAN keeps its resolver while one node is down" across="node"/>
        <egress reason="answers the LAN from a DNS-over-HTTPS upstream"/>
      </processes>
    </applications>
    <applications id="headlamp">
      <exposure name="lan" host="dashboard.lan.jorisjonkers.dev" audience="lan">
        <routes path="/" process="/14/@applications.1/@processes.0" surface="/14/@applications.1/@processes.0/@provides.0"/>
      </exposure>
      <processes startupBudget="30s" cutover="continuous" name="headlamp" image="headlamp" runtime="none">
        <placement memory="128Mi" cpu="50m"/>
        <provides key="http" value="4466"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/" port="4466"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/" port="4466"/>
        </probes>
        <api reason="it acts on the API with each signed-in user's own token, and holds nothing of its own"/>
      </processes>
    </applications>
  </projectintent:Project>
