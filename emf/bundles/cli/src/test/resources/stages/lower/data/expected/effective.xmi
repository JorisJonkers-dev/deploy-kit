<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:projectintent="https://jorisjonkers.dev/deploy-kit/project-intent/1">
  <projectintent:EffectiveProject project="data" owner="joris">
    <applications id="platform-postgres">
      <observability alertClass="page">
        <scrape process="/0/@applications.0/@processes.0" surface="/0/@applications.0/@processes.0/@provides.1" path="/metrics"/>
      </observability>
      <processes startupBudget="60s" cutover="interrupted" name="postgres" image="postgres" runtime="none" engine="postgres">
        <secrets xsi:type="projectintent:KvGrant" path="secret/data/platform/postgres/exporter">
          <rotation/>
          <keys xsi:type="projectintent:PlainKey" name="datasource"/>
        </secrets>
        <assets from="config/postgresql.conf" mountAt="/etc/postgresql/postgresql.conf"/>
        <writablePaths>/var/run/postgresql</writablePaths>
        <writablePaths>/tmp</writablePaths>
        <env>
          <entries name="POSTGRES_DB">
            <value xsi:type="projectintent:EnvLiteral" text="postgres"/>
          </entries>
          <entries name="POSTGRES_USER">
            <value xsi:type="projectintent:EnvLiteral" text="postgres"/>
          </entries>
          <entries name="DATA_SOURCE_NAME">
            <value xsi:type="projectintent:Placeholder" source="secret/data/platform/postgres/exporter#datasource"/>
          </entries>
        </env>
        <placement memory="2Gi" cpu="500m">
          <arch>amd64</arch>
          <disk>
            <media>nvme</media>
            <media>ssd</media>
          </disk>
        </placement>
        <provides key="postgres" value="5432"/>
        <provides key="metrics" value="9187"/>
        <sidecars name="postgres-exporter" image="postgres-exporter" memory="64Mi" cpu="10m"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:TcpProbe" tcp="5432"/>
          <liveness xsi:type="projectintent:TcpProbe" tcp="5432"/>
        </probes>
        <volumes claim="postgres-data" mountAt="/var/lib/postgresql/data" size="20Gi" durability="irreplaceable"/>
      </processes>
    </applications>
    <applications id="platform-rabbitmq">
      <observability alertClass="urgent">
        <scrape process="/0/@applications.1/@processes.0" surface="/0/@applications.1/@processes.0/@provides.2" path="/metrics"/>
      </observability>
      <exposure name="management" host="rabbitmq.jorisjonkers.dev" audience="authenticated">
        <routes path="/" process="/0/@applications.1/@processes.0" surface="/0/@applications.1/@processes.0/@provides.1"/>
      </exposure>
      <processes startupBudget="120s" cutover="interrupted" name="rabbitmq" image="rabbitmq" runtime="none" engine="rabbitmq">
        <placement memory="2Gi" cpu="500m"/>
        <provides key="amqp" value="5672"/>
        <provides key="management" value="15672"/>
        <provides key="metrics" value="15692"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:TcpProbe" tcp="5672"/>
          <liveness xsi:type="projectintent:TcpProbe" tcp="5672"/>
        </probes>
        <volumes claim="rabbitmq-data" mountAt="/var/lib/rabbitmq" size="20Gi" durability="recoverable"/>
      </processes>
    </applications>
    <applications id="platform-valkey">
      <processes startupBudget="30s" cutover="interrupted" name="valkey" image="valkey" runtime="none">
        <placement memory="256Mi" cpu="50m"/>
        <provides key="redis" value="6379"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:TcpProbe" tcp="6379"/>
          <liveness xsi:type="projectintent:TcpProbe" tcp="6379"/>
        </probes>
        <volumes claim="valkey-data" mountAt="/data" size="2Gi"/>
      </processes>
    </applications>
  </projectintent:EffectiveProject>
  <projectintent:EffectiveProject project="delivery" owner="joris">
    <applications id="flagger">
      <processes startupBudget="30s" cutover="continuous" name="flagger" image="flagger" runtime="none">
        <dependsOn application="release-gate" surface="http"/>
        <writablePaths>/tmp</writablePaths>
        <placement memory="64Mi" cpu="10m"/>
        <provides key="http" value="8080"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/healthz" port="8080"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/healthz" port="8080"/>
        </probes>
        <api reason="Flagger switches every blue-green Process, so it scales its Deployment, generates its Services and copies, and records the Canary">
          <rules group="flagger.app">
            <objects>canaries</objects>
            <objects>canaries/status</objects>
            <verbs>get</verbs>
            <verbs>list</verbs>
            <verbs>watch</verbs>
            <verbs>update</verbs>
            <verbs>patch</verbs>
          </rules>
          <rules group="apps">
            <objects>deployments</objects>
            <verbs>get</verbs>
            <verbs>list</verbs>
            <verbs>watch</verbs>
            <verbs>create</verbs>
            <verbs>update</verbs>
            <verbs>patch</verbs>
            <verbs>delete</verbs>
          </rules>
          <rules group="autoscaling">
            <objects>horizontalpodautoscalers</objects>
            <verbs>get</verbs>
            <verbs>list</verbs>
            <verbs>watch</verbs>
            <verbs>create</verbs>
            <verbs>update</verbs>
            <verbs>patch</verbs>
            <verbs>delete</verbs>
          </rules>
          <rules group="core">
            <objects>services</objects>
            <objects>configmaps</objects>
            <verbs>get</verbs>
            <verbs>list</verbs>
            <verbs>watch</verbs>
            <verbs>create</verbs>
            <verbs>update</verbs>
            <verbs>patch</verbs>
            <verbs>delete</verbs>
          </rules>
          <rules group="core">
            <objects>secrets</objects>
            <verbs>get</verbs>
          </rules>
          <rules group="core">
            <objects>events</objects>
            <verbs>create</verbs>
            <verbs>update</verbs>
            <verbs>patch</verbs>
          </rules>
        </api>
      </processes>
    </applications>
    <applications id="release-gate">
      <processes startupBudget="10s" cutover="continuous" name="release-gate" image="release-gate" runtime="none">
        <placement memory="64Mi" cpu="25m"/>
        <provides key="http" value="8080"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/readyz" port="8080"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/healthz" port="8080"/>
        </probes>
        <api reason="the Release Gate answers Flagger from what the cluster holds, so it reads each gated Application's inputs, Canaries, Deployments, Jobs and pods; it finds the gated Applications by listing ConfigMaps, keeps each one's release record in a ConfigMap of its own, unsuspends the migration Jobs it starts, and deletes a gated Application's Vault sync objects of an older revision once it serves the new one">
          <rules group="core">
            <objects>configmaps</objects>
            <verbs>get</verbs>
            <verbs>list</verbs>
            <verbs>create</verbs>
            <verbs>update</verbs>
          </rules>
          <rules group="core">
            <objects>pods</objects>
            <verbs>list</verbs>
          </rules>
          <rules group="apps">
            <objects>deployments</objects>
            <verbs>get</verbs>
          </rules>
          <rules group="batch">
            <objects>jobs</objects>
            <verbs>list</verbs>
            <verbs>patch</verbs>
          </rules>
          <rules group="flagger.app">
            <objects>canaries</objects>
            <verbs>get</verbs>
          </rules>
          <rules group="secrets.hashicorp.com">
            <objects>vaultauths</objects>
            <objects>vaultstaticsecrets</objects>
            <objects>vaultdynamicsecrets</objects>
            <verbs>list</verbs>
            <verbs>delete</verbs>
          </rules>
        </api>
      </processes>
    </applications>
    <applications id="collector">
      <processes startupBudget="10s" cutover="interrupted" name="collector" image="collector" runtime="none">
        <placement memory="64Mi" cpu="10m"/>
        <provides key="http" value="8080"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/readyz" port="8080"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/fresh" port="8080"/>
        </probes>
        <api reason="the Collector captures where each bound claim and each rendered pod is, so it lists the three kinds that say so, cluster-wide, and writes nothing">
          <rules group="core">
            <objects>persistentvolumes</objects>
            <objects>persistentvolumeclaims</objects>
            <objects>pods</objects>
            <verbs>get</verbs>
            <verbs>list</verbs>
          </rules>
        </api>
      </processes>
    </applications>
    <applications id="reporter">
      <processes startupBudget="10s" cutover="interrupted" name="reporter" image="reporter" runtime="none">
        <placement memory="64Mi" cpu="10m"/>
        <provides key="http" value="8080"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/readyz" port="8080"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/healthz" port="8080"/>
        </probes>
        <api reason="the Reporter reads every Project's unit and every Canary again on start and on an interval, to correct a status an event it missed left behind, and writes nothing">
          <rules group="kustomize.toolkit.fluxcd.io">
            <objects>kustomizations</objects>
            <verbs>get</verbs>
            <verbs>list</verbs>
            <verbs>watch</verbs>
          </rules>
          <rules group="flagger.app">
            <objects>canaries</objects>
            <verbs>get</verbs>
            <verbs>list</verbs>
            <verbs>watch</verbs>
          </rules>
        </api>
      </processes>
    </applications>
  </projectintent:EffectiveProject>
  <projectintent:EffectiveProject project="edge" owner="joris">
    <applications id="traefik-public">
      <processes startupBudget="20s" cutover="continuous" name="traefik-public" image="traefik" runtime="none">
        <writablePaths>/tmp</writablePaths>
        <placement memory="128Mi" cpu="50m">
          <capabilities>public-ingress</capabilities>
        </placement>
        <provides key="web" value="8000"/>
        <provides key="websecure" value="8443"/>
        <provides key="admin" value="8080"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/ping" port="8080"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/ping" port="8080"/>
        </probes>
      </processes>
    </applications>
    <applications id="traefik-lan">
      <processes startupBudget="20s" cutover="continuous" name="traefik-lan" image="traefik" runtime="none">
        <writablePaths>/tmp</writablePaths>
        <placement memory="128Mi" cpu="50m">
          <capabilities>lan-ingress</capabilities>
        </placement>
        <provides key="web" value="8000"/>
        <provides key="admin" value="8080"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/ping" port="8080"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/ping" port="8080"/>
        </probes>
      </processes>
    </applications>
  </projectintent:EffectiveProject>
  <projectintent:EffectiveProject project="observability" owner="joris">
    <applications id="otel-collector">
      <processes startupBudget="20s" cutover="continuous" name="otel-collector" image="otel-collector" runtime="none">
        <placement memory="256Mi" cpu="50m"/>
        <provides key="otlp" value="4317"/>
        <provides key="health" value="13133"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/" port="13133"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/" port="13133"/>
        </probes>
      </processes>
    </applications>
    <applications id="prometheus">
      <processes startupBudget="60s" cutover="continuous" name="prometheus" image="prometheus" runtime="none">
        <writablePaths>/prometheus</writablePaths>
        <placement memory="512Mi" cpu="100m"/>
        <provides key="http" value="9090"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/-/ready" port="9090"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/-/healthy" port="9090"/>
        </probes>
      </processes>
    </applications>
  </projectintent:EffectiveProject>
  <projectintent:EffectiveProject project="secrets" owner="joris">
    <applications id="vault">
      <processes startupBudget="30s" cutover="interrupted" name="vault" image="vault" runtime="none">
        <placement memory="256Mi" cpu="100m"/>
        <provides key="http" value="8200"/>
        <probes xsi:type="projectintent:Probes">
          <readiness xsi:type="projectintent:HttpProbe" path="/v1/sys/health" port="8200"/>
          <liveness xsi:type="projectintent:HttpProbe" path="/v1/sys/health" port="8200"/>
        </probes>
      </processes>
    </applications>
  </projectintent:EffectiveProject>
</xmi:XMI>
