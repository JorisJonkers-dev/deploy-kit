module dev.jorisjonkers.deploykit.emf.syntax.GenerateSkeleton

import org.eclipse.xtext.xtext.generator.*
import org.eclipse.xtext.xtext.generator.model.project.*

var rootPath = ".."
var generated = "${rootPath}/syntax/target/generated-sources/xtext"

// Every Java file this writes, stubs included, lands under target/ and is
// never committed (emf/docs/architecture.md#metamodels).
Workflow {
	component = XtextGenerator {
		configuration = {
			project = StandardProjectConfig {
				baseName = "syntax"
				rootPath = rootPath
				runtime = {
					src = generated
					srcGen = generated
					ecoreModel = "${rootPath}/syntax/target/generated-sources/xtext-model"
					root = "${rootPath}/syntax"
				}
				runtimeTest = { enabled = false }
				eclipsePlugin = { enabled = false }
				createEclipseMetaData = false
			}
			code = {
				encoding = "UTF-8"
				lineDelimiter = "\n"
				preferXtendStubs = false
			}
		}
		language = StandardLanguage {
			name = "dev.jorisjonkers.deploykit.emf.syntax.Skeleton"
			grammarUri = "classpath:/dev/jorisjonkers/deploykit/emf/syntax/Skeleton.xtext"
			fileExtensions = "skeleton"
			serializer = { generateStub = false }
			validator = { generateStub = false }
			scopeProvider = { generateStub = false }
			generator = { generateStub = false }
		}
	}
}
