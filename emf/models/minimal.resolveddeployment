<?xml version="1.0" encoding="UTF-8"?>
<!--
  The `minimal` case as a Resolved Deployment model, written and reviewed by
  hand (issue #87).

  It is NOT an oracle. `spec/v1/examples/minimal/expected/resolved.json` binds
  the production implementation only, because the two implementations shape
  layer 2 differently on purpose (emf/docs/architecture.md#metamodels). This
  file is what the QVT-Operational resolution produces for minimal:
  ResolutionTest holds the transformation's output equal to it (#90). The
  Acceleo templates were first run against it (#94); they now render the
  transformation's output, and no test reads this file as its input (#96).

  Every value here is derivable from `spec/v1/examples/minimal/notes.project.yml`,
  the project files of the foundation it composes with, and the Platform document
  and pinned inputs beside them. The digests are what the transformation
  computes. The revision is the production implementation's, the digest of the
  Application's element in its canonical JSON, because the rendered tree carries
  it; the provenance's digests are over this model's own form, and bind this
  implementation only.
-->
<resolveddeployment:ResolvedDeployment
    xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns:resolveddeployment="https://jorisjonkers.dev/deploy-kit/resolved-deployment/1"
    apiVersion="resolved.jorisjonkers.dev/v1" kind="ResolvedDeployment">

  <!--
    One digest per pinned input, each over the canonical form of the model read
    from it, and the render hash over them: what the transformation computes
    through its one black box, and not the production implementation's digests,
    which are over a different shape (spec/v1/20-resolved-deployment.md#pinned-inputs).
  -->
  <provenance renderHash="sha256:513e289cd214746314009ea36c6de5529c10654f8fbf4ebaf9941f2e8c215968" schemaPackageIntegrity="sha256:5e6f7a8b5e6f7a8b5e6f7a8b5e6f7a8b5e6f7a8b5e6f7a8b5e6f7a8b5e6f7a8b">
    <inputDigests input="intent-fragment" name="delivery" digest="sha256:0fefb45a0d33f5a4c3d36ba970bd3d1c27aa375ab2677b6f76dbd58c716b6082"/>
    <inputDigests input="intent-fragment" name="edge" digest="sha256:273c64ecd8c35ab69918664735661764e44e8e3ad04a58a11ab92dcb52ec1f4a"/>
    <inputDigests input="intent-fragment" name="notes" digest="sha256:252e68be274ac566d591709794fbfed79b35e24cabaa38e39d90242e3e3893df"/>
    <inputDigests input="intent-fragment" name="observability" digest="sha256:aac790f0f921ce56ea5fb7af1f5a85c48c2122fbcbd99923124aafe063f6594c"/>
    <inputDigests input="intent-fragment" name="secrets" digest="sha256:3b6b608aa89a7beebed377772c9905705861c2609f1c262a5ddcb757b70bcecc"/>
    <inputDigests input="platform-intent" name="jorisjonkers.dev" digest="sha256:bcce015e0202af1a849172a59d112e7c57992dc6524d70f4c3d4a2a8eb513dd5"/>
    <inputDigests input="node-contract" name="production" digest="sha256:fca4a95a8fe6158bd2f4f73b48c416c5a2e5892ed8727d91b046666abebd5e11"/>
    <inputDigests input="images-lock" name="estate" digest="sha256:c90b71a8ad863de3ed3c2598d636d906aca639918531531ff26c8cfb88f993fd"/>
    <inputDigests input="cluster-state" name="production" digest="sha256:3d79e6d048f4209938fa9ca9ac1feba8ba1c34f0741546419605eab8468df06b"/>
  </provenance>

  <!-- notes holds no dependency and no grant, so its unit follows nothing. -->
  <reconcileUnits name="apps-notes"/>

  <!--
    The Vault policy job the platform names, in the Secret Store's namespace
    (spec/v1/20-resolved-deployment.md#the-vault-policy-job). Every project's
    document carries the same one; minimal holds no grant, so its render holds
    no document for the job to write and plans no file for it.
  -->
  <policyJob identity="vault-policy" namespace="secrets-system" image="ghcr.io/jorisjonkers-dev/delivery/vault-policy@sha256:c5e7a9b1d3f5c7e9a1b3d5f7c9e1a3b5d7f9c1e3a5b7d9f1c3e5a7b9d1f3c5e7" uid="65532" gid="65532" role="policy-admin" address="http://vault.secrets-system.svc.cluster.local:8200" memory="64Mi" cpu="10m" deadline="120s">
    <egress rule="secret-store" namespace="secrets-system" process="vault" port="8200"/>
    <egress rule="cluster-dns" namespace="kube-system" port="53"/>
  </policyJob>

  <applications id="notes" revision="sha256:493fb16ace2e5e7bebf96ea8490f20c2f1dd82fbbf8ce4a9d6b67963b0bcb048" project="notes" namespace="notes-system"
      alertClass="business-hours" reconcileUnit="//@reconcileUnits.0">
    <releaseGate endpoint="http://release-gate.delivery-system.svc.cluster.local:8080" deadline="60s">
      <!-- The Platform document's cadence, carried for the Release Gate. -->
      <analysis interval="30s" iterations="4" threshold="3"/>
      <members process="//@applications.0/@processes.0">
        <readiness xsi:type="resolveddeployment:HttpTarget" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            path="/healthz/ready" port="8080"/>
        <!-- The node profile exposes HTTP server metrics. -->
        <checks>error-rate</checks>
        <checks>latency</checks>
      </members>
    </releaseGate>

    <exposure name="public" host="notes.jorisjonkers.dev" tier="public-frankfurt"
        listener="tls" certificates="acme" proxyApplication="traefik-public" proxyNamespace="edge-system">
      <!-- One prefix route, so precedence is 1 and nothing competes with it. -->
      <routes path="/" match="prefix" audience="anonymous" precedence="1"
          process="//@applications.0/@processes.0" surface="http">
        <!-- Anonymous, so no forward-auth; `contentPolicy: strict` is authored. -->
        <middleware kind="security-headers" contentPolicy="strict"/>
      </routes>
    </exposure>

    <!-- The metrics stack scrapes it at the platform's cadence. -->
    <scrape process="//@applications.0/@processes.0" surface="http" path="/metrics" interval="30s" timeout="10s"/>

    <processes name="notes-api" identity="notes-api" lifecycle="application"
        image="ghcr.io/jorisjonkers-dev/notes/notes-api@sha256:9c1e5a4b7d2f8e3a6b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a"
        uid="1000" gid="1000" cutover="continuous" switchover="blue-green" deadline="60s" replicas="1"
        memory="256Mi" cpu="50m" hardening="restricted" identityToken="false"
        component="node">
      <readiness period="10s" timeout="5s" failures="3">
        <target xsi:type="resolveddeployment:HttpTarget" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            path="/healthz/ready" port="8080"/>
      </readiness>
      <liveness period="10s" timeout="5s" failures="3">
        <target xsi:type="resolveddeployment:HttpTarget" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            path="/healthz/live" port="8080"/>
      </liveness>
      <!-- 5s x 4 is the 20s budget the Process declares. -->
      <startup period="5s" timeout="5s" failures="4">
        <target xsi:type="resolveddeployment:HttpTarget" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            path="/healthz/live" port="8080"/>
      </startup>
      <surfaces name="http" port="8080"/>
      <!--
        Nothing narrows the set: this Process declares no arch, no capability,
        no disk medium and holds no volume, so every node the contract
        publishes is eligible.
      -->
      <placement eligibleNodes="enschede-t1000-1 enschede-rx7900xtx-1 enschede-gtx-960m-1 enschede-pi-1 enschede-pi-2 enschede-pi-3 frankfurt-contabo-1"/>
      <environment name="DEPLOYMENT_ENVIRONMENT" value="production"/>
      <environment name="NODE_ENV" value="production"/>
      <environment name="NOTES_PAGE_SIZE" value="50"/>
      <environment name="OTEL_EXPORTER_OTLP_ENDPOINT" value="http://otel-collector.observability-system.svc.cluster.local:4317"/>
      <environment name="OTEL_SERVICE_NAME" value="notes-api"/>
      <environment name="PORT" value="8080"/>
    </processes>
  </applications>

  <!--
    One entry per file the templates write, each with the path layer 2 assigned
    it. The project's share is the tree under spec/v1/examples/minimal/rendered/,
    and the route under estate/ is estate-scoped, in spec/v1/examples/_estate/rendered/.
  -->
  <deliverables xsi:type="resolveddeployment:NamespaceFile" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      path="apps/notes/namespace.yaml" adapter="kubernetes" namespace="notes-system"/>
  <deliverables xsi:type="resolveddeployment:IndexFile" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      path="apps/notes/kustomization.yaml" adapter="kubernetes" resources="namespace.yaml notes"/>
  <!-- The project's default-deny: it selects every pod, and belongs to no Process. -->
  <deliverables xsi:type="resolveddeployment:NetworkPolicyFile" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      path="apps/notes/networkpolicy.yaml" adapter="networking"/>
  <deliverables xsi:type="resolveddeployment:IndexFile" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      path="apps/notes/notes/kustomization.yaml" adapter="kubernetes"
      resources="canary.yaml configmap.yaml podmonitor.yaml serviceaccount.yaml workload.yaml"/>
  <deliverables xsi:type="resolveddeployment:WorkloadFile" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      path="apps/notes/notes/workload.yaml" adapter="kubernetes" processes="//@applications.0/@processes.0"
      controller="Deployment" strategy="RollingUpdate"/>
  <deliverables xsi:type="resolveddeployment:SwitchoverFile" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      path="apps/notes/notes/canary.yaml" adapter="kubernetes" processes="//@applications.0/@processes.0"/>
  <deliverables xsi:type="resolveddeployment:IdentityFile" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      path="apps/notes/notes/serviceaccount.yaml" adapter="kubernetes" processes="//@applications.0/@processes.0"/>
  <!-- What the Release Gate reads of the Application: its release-gate inputs, as canonical JSON. -->
  <deliverables xsi:type="resolveddeployment:ConfigMapFile" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      path="apps/notes/notes/configmap.yaml" adapter="kubernetes" application="//@applications.0"
      releaseGate="{&quot;analysis&quot;:{&quot;interval&quot;:&quot;30s&quot;,&quot;iterations&quot;:4,&quot;threshold&quot;:3},&quot;deadline&quot;:&quot;60s&quot;,&quot;endpoint&quot;:&quot;http://release-gate.delivery-system.svc.cluster.local:8080&quot;,&quot;members&quot;:[{&quot;checks&quot;:[&quot;error-rate&quot;,&quot;latency&quot;],&quot;process&quot;:&quot;notes-api&quot;,&quot;readiness&quot;:{&quot;path&quot;:&quot;/healthz/ready&quot;,&quot;port&quot;:8080}}]}"/>
  <deliverables xsi:type="resolveddeployment:MonitorFile" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      path="apps/notes/notes/podmonitor.yaml" adapter="prometheus" process="//@applications.0/@processes.0"
      surface="http" scrapePath="/metrics" interval="30s" timeout="10s" kind="PodMonitor"/>
  <deliverables xsi:type="resolveddeployment:NetworkPolicyFile" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      path="apps/notes/notes/networkpolicy.yaml" adapter="networking">
    <policies process="//@applications.0/@processes.0">
      <!-- The edge and the metrics stack reach it; nothing else does. -->
      <ingress rule="tier-proxy" namespace="edge-system" process="traefik-public" port="8080"/>
      <ingress rule="metrics-stack" namespace="observability-system" process="prometheus" port="8080"/>
      <!-- The cluster's DNS: a namespace, not a Process the union declares. -->
      <egress rule="cluster-dns" namespace="kube-system" port="53"/>
    </policies>
  </deliverables>
  <deliverables xsi:type="resolveddeployment:IngressRouteFile" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      path="estate/edge/public-frankfurt/notes-public.yaml" adapter="traefik" exposure="//@applications.0/@exposure.0"
      entryPoint="websecure" certificateResolver="acme"/>
  <deliverables xsi:type="resolveddeployment:IndexFile" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      path="estate/edge/public-frankfurt/kustomization.yaml" adapter="kubernetes" resources="notes-public.yaml"/>
</resolveddeployment:ResolvedDeployment>
