@jorisjonkers-dev:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
# No dependency's lifecycle script runs on install, locally or in CI
# (RULE-072 in docs/architecture-rules.md). A script named with `npm run`
# still runs; only install hooks and pre/post hooks are skipped.
ignore-scripts=true
