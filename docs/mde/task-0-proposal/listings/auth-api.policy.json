{
  "name": "auth-api",
  "policy": {
    "path": {
      "secret/data/platform/postgres/auth": { "capabilities": ["read"] },
      "secret/metadata/platform/postgres/auth": { "capabilities": ["read", "list"] },
      "secret/data/auth-api": { "capabilities": ["read"] },
      "secret/metadata/auth-api": { "capabilities": ["read", "list"] },
      "transit/sign/auth-api-jwt": { "capabilities": ["update"] },
      "transit/keys/auth-api-jwt/rotate": { "capabilities": ["update"] }
    }
  }
}
